{
  "name": "insurancesupport-astro",
  "type": "module",
  "version": "1.0.0",
  "description": "Insurance Support Online — Astro migration from Next.js",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && (npx pagefind --site dist || echo 'Pagefind skipped - continuing build')",
    "preview": "astro preview",
    "astro": "astro",
    "postbuild": "node ./scripts/generate-sitemap.js && node ./scripts/indexnow-notify.js"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/tailwind": "^5.1.5",
    "@rolldown/pluginutils": "^1.0.1",
    "@tailwindcss/typography": "^0.5.14",
    "astro": "^5.18.2",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.460.0",
    "marked": "^18.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sitemap": "^9.0.1",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "turndown": "^7.1.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "sharp@0.33.5": true
  }
}
