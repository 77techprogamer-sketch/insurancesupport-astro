        border-radius: 5px;
        position: absolute;
        right: 2rem;
        top: 2rem;
        width: 3rem;
        height: 3rem;
        z-index: 2;
        -webkit-transition: 0.5s;
        transition: 0.5s;
        cursor: pointer;
