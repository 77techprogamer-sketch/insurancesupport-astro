<!-- FAQ Schema -->

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [

    {
      "@type": "Question",
      "name": "What is sum insured in health insurance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sum insured is the maximum amount that an insurance company will pay in the event of a claim in a policy year. Suppose you have an annual sum insured of ₹10 lakhs and your hospitalisation bill amounts to ₹12 lakhs. In this case, your insurer will pay up to ₹10 lakhs as per the policy’s terms and conditions."
      }
    },
    {
      "@type": "Question",
      "name": "What do you mean by a pre-existing disease?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A pre-existing disease refers to any health condition or illness diagnosed about 36-48 months prior to buying a health insurance policy. You need to complete the applicable waiting period before your policy starts covering the disclosed pre-existing disease."
      }
    },
    {
      "@type": "Question",
      "name": "What do you mean by waiting period?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Waiting period is the specified period of time you need to wait before you can enjoy coverage for certain illnesses, treatments or pre-existing diseases."
      }
    },
    {
      "@type": "Question",
      "name": "If I increase my sum insured at the time of renewal, does a waiting period apply?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The increased sum insured will attract a waiting period."
      }
    },
    {
      "@type": "Question",
      "name": "My employer provides me with a health insurance. Do I still need one?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. While having a corporate health insurance is helpful, the coverage ends when you switch jobs. Therefore, it is important to insure yourself with a comprehensive health insurance to ensure continuous, customisable coverage."
      }
    },
    {
      "@type": "Question",
      "name": "From what age can I include my children in the plan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can include your children aged 90 days to 30 years in your family floater health insurance policy."
      }
    },
    {
      "@type": "Question",
      "name": "Which is the best health insurance policy for me?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It depends on your needs. For example, you can opt for a family floater health insurance if you want to cover multiple family members under a single policy. However, you can also opt for an individual health insurance policy for wider coverage."
      }
    },
    {
      "@type": "Question",
      "name": "What is the advantage of buying health insurance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Health insurance not only protects you from rising medical costs but also provides cashless hospitalisation, day care treatments, wellness programmes, health check-ups, etc. Apart from this, you can also get tax benefits on your health insurance policy under the old tax regime."
      }
    },
    {
      "@type": "Question",
      "name": "Can a person have more than one health insurance policy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. You can buy multiple health insurance policies to cover your medical costs. If one insurer rejects your claim, there is still a chance that others may accept as per their terms and conditions."
      }
    },
    {
      "@type": "Question",
      "name": "How does lifestyle (smoking/alcohol consumption) affect health insurance premium?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Smoking or drinking regularly may increase the chances of health issues in the future and health insurance companies factor it into their underwriting and pricing structure."
      }
    },
    {
      "@type": "Question",
      "name": "What is the right age to buy a health insurance policy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Health insurance premiums are generally lower when you are young and healthy. This helps you save money. Additionally, buying early helps you complete waiting periods for specific illnesses before you might actually need them."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between sum insured and sum assured?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sum insured is the maximum amount you can get when you file a health insurance claim whereas sum assured is the fixed payout paid under a life insurance policy on death or maturity."
      }
    },
    {
      "@type": "Question",
      "name": "Is health insurance mandatory in India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No, but it is strongly recommended as health insurance policy protects you against rising healthcare costs."
      }
    },
    {
      "@type": "Question",
      "name": "Can NRIs or foreigners living in India buy health insurance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, NRIs can buy medical insurance for themselves and their families (spouse, children and parents) residing in India, subject to underwriting norms."
      }
    },
    {
      "@type": "Question",
      "name": "Can minors buy health insurance independently?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Minors cannot buy a health insurance policy. Parents can cover their children aged 90 days to 30 years under their family floater health insurance."
      }
    },
    {
      "@type": "Question",
      "name": "Does health insurance cover OPD expenses?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, OPD expenses are covered only if you have opted for the OPD+ rider or BeFit add-on with your ICICI Lombard health insurance policy."
      }
    },
    {
      "@type": "Question",
      "name": "Is health insurance valid outside India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most health insurance policies offer usually domestic coverage. However, you can opt for Worldwide Cover add-on to get international coverage."
      }
    },
    {
      "@type": "Question",
      "name": "Can I change the nominee during the policy term?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. You can change or update your nominee by submitting an endorsement request via your insurer’s website or mobile app."
      }
    },
    {
      "@type": "Question",
      "name": "Are daycare procedures covered under health insurance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Day care procedures/treatment are one of the basic covers offered by ICICI Lombard health insurance policies."
      }
    },
    {
      "@type": "Question",
      "name": "Does health insurance cover modern treatments like robotic surgery?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Elevate health insurance covers robotic surgeries under its Technological Advancements and Treatments cover."
      }
    },
    {
      "@type": "Question",
      "name": "Are diagnostic tests like MRI, CT scan and PET scan covered?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, health insurance policies cover diagnostic tests when they are part of hospitalisation and medically necessary."
      }
    },
    {
      "@type": "Question",
      "name": "Is home treatment or domiciliary hospitalisation covered?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, if treatment is taken at home due to medical necessity and subject to policy conditions."
      }
    },
    {
      "@type": "Question",
      "name": "Are alternative treatments like AYUSH covered?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, ICICI Lombard health insurance covers AYUSH treatments."
      }
    },
    {
      "@type": "Question",
      "name": "Does health insurance cover maternity expenses?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can get coverage for maternity expenses by opting the Maternity Benefit (add-on) available under our Elevate health insurance."
      }
    },
    {
      "@type": "Question",
      "name": "Are ambulance charges covered in health insurance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. ICICI Lombard health insurance covers road ambulance expenses."
      }
    },
    {
      "@type": "Question",
      "name": "Which diseases are permanently excluded from health insurance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Depends on your health insurance policy. You can go through the exclusions listed in your policy document for detailed information."
      }
    },
    {
      "@type": "Question",
      "name": "What to do if I am admitted to a non-network hospital?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When you get treatment at a non-network hospital, you need to pay for the medical costs out of your pocket first and later raise the bills with your insurer for reimbursement. You can also check with your insurer to avail cashless treatment through the ‘Cashless Everywhere’ Initiative."
      }
    },
    {
      "@type": "Question",
      "name": "How does the GST waiver affect my health insurance premium?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "With the 18% GST waiver, you now pay only the premium amount for your health insurance and no additional taxes. All this without compromising on coverage!"
      }
    },
    {
      "@type": "Question",
      "name": "Will my existing health insurance policy also receive the GST benefit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. All existing health policies that are due for renewal will be GST-free."
      }
    },
    {
      "@type": "Question",
      "name": "How much GST do I have to pay on health insurance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Effective 22nd September 2025, GST on health insurance has been reduced to 0%. This means your health insurance is GST-free."
      }
    },
    {
      "@type": "Question",
      "name": "Does premium increase every year with age?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Premiums typically increase with age as the risk of health issues increases over time."
      }
    },
    {
      "@type": "Question",
      "name": "Is it cheaper to buy health insurance at a younger age?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Buying health insurance early helps to lock in coverage at a comparatively lower premium."
      }
    },
    {
      "@type": "Question",
      "name": "Does choosing a higher deductible reduce premium?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, opting for a higher voluntary deductible amount can lower your health insurance premium."
      }
    },
    {
      "@type": "Question",
      "name": "Are discounts available for buying multi-year health insurance plans?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. ICICI Lombard offers a 10% discount on 2-year policies and a 15% discount on 3-, 4-, or 5-year health insurance (Elevate)."
      }
    },
    {
      "@type": "Question",
      "name": "How many years do we need to pay for health insurance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You need to pay health insurance premium for as long as you want continuous coverage and uninterrupted benefits."
      }
    },
    {
      "@type": "Question",
      "name": "Can I buy health insurance in EMIs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. You can pay health insurance premium in monthly, quarterly or half-yearly instalments."
      }
    },
    {
      "@type": "Question",
      "name": "How long does health insurance claim settlement take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It differs from insurer to insurer. ICICI Lombard generally settles both cashless and reimbursement claims within the timelines prescribed by the IRDAI, subject to document submission."
      }
    },
    {
      "@type": "Question",
      "name": "How to avail a cashless treatment?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It’s simple to file a cashless claim with ICICI Lombard. Just follow these steps: Get admitted to a network hospital. Inform ICICI Lombard through the hospital’s insurance desk or our website/IL TakeCare App, and submit the pre-authorisation form. Once approved, we will settle the hospital bills as per policy terms. For detailed info, please click here: https://www.icicilombard.com/health-insurance/health-claim/"
      }
    },
    {
      "@type": "Question",
      "name": "What are the documents needed to file a reimbursement claim?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You need to submit a duly filled claims form, ID proof, bank details, discharge summary, final hospital and pharmacy bills, investigation reports, and any other documents requested by your insurer."
      }
    },
    {
      "@type": "Question",
      "name": "Can I track my health insurance claim status online?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, you can easily track the status of your health insurance claim on our website and IL TakeCare App."
      }
    },
    {
      "@type": "Question",
      "name": "What is the maximum number of claims allowed in a year?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can file multiple claims under a health insurance policy as long as they fall within the sum insured and adhere to policy terms."
      }
    },
    {
      "@type": "Question",
      "name": "Can I increase my sum insured at the time of renewal?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. You can increase your sum insured to your health insurance policy during renewal (subject to payment of additional premium for the enhanced sum insured)."
      }
    },
    {
      "@type": "Question",
      "name": "Do waiting periods reset after renewal?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No, waiting periods do not reset as long as you renew your health insurance policy on time."
      }
    },
    {
      "@type": "Question",
      "name": "Is medical test required again at the time of renewal?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Generally, medical tests are not required at the time of policy renewal. Check with your insurer for more information."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if I miss my health insurance renewal date?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Missing your renewal date can lead to your health insurance policy lapse and loss of benefits."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a grace period for health insurance renewal?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, ICICI Lombard offers a grace period of 30 days. You need to renew your health insurance policy during this period to retain your policy coverage and benefits."
      }
    },
    {
      "@type": "Question",
      "name": "Can I port my health insurance policy at renewal without losing benefits?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, you can easily port your health insurance policy without losing your accrued waiting period and benefits."
      }
    }

  ]
}
