    $(document).ready(function () {
        // Email id validation
        $(document).on("keyup paste keypress", ".email-val", function (e) {
            var pattern = /^[a-zA-Z0-9.@_-]*$/;
            var value = this.value;
            var currentValue = String.fromCharCode(e.which);
            if (currentValue && !pattern.test(currentValue)) return false;
        });
    });
</script>


