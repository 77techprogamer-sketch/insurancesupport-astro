<script async="">
$(document).ready(function () {

    if ($(window).width() <= 767){
        $(".mainWrapper.healthFreshlook .zeroHassleWrapp").hide();
        $(".stickyvideo-wrap").hide();
    }

    $(".il-scrollable-tabs .il-tab-head li").click(function(){
        if ($(window).width() <= 767) {
            $(".stickyvideo-wrap").hide();
            $(".mainWrapper.healthFreshlook .zeroHassleWrapp").hide();
        }
    });

    $(".bk_btn_widgt").click(function () {
        if ($(window).width() <= 767) {
            $(".stickyvideo-wrap").show();
            $(".mainWrapper.healthFreshlook .zeroHassleWrapp").show();
        }
    });

    tabs();
    });
function tabs() {
    $(document).on("click", ".js-tab-head li", function (e) {
        var t, i, s;
        if ((e.preventDefault(), (t = $(this)), (bar = $(t).siblings(".bar")), (currindex = t.index()), (i = $(this).parents(".js-tab-wrap")), (s = $(i).find(".tab-content-body .tab-content")), !t.hasClass("active"))) {
            t.addClass("active").siblings().removeClass("active"), s.removeClass("active"), s.eq(currindex).addClass("active");
            var a = t.position().left;
            bar.animate(
                {
                    left: a,
                },
                500,
                function () {}
            );
        }
    });
}
</script>

