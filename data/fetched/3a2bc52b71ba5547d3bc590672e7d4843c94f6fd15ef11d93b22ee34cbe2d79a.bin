<app-hospital-search-roots></app-hospital-search-roots>
<link rel="stylesheet" href="/docs/default-source/apps/hospitalsearchangular/prod/js/styles-66426c92df222c8d.css">
<script>
const jsFiles = [
    '/docs/default-source/apps/hospitalsearchangular/prod/js/runtime-c76467fca304631c.js',
    '/docs/default-source/apps/hospitalsearchangular/prod/js/polyfills-92b856c18a390204.js',
  '/docs/default-source/apps/hospitalsearchangular/prod/js/main-4a34126c2efd50c4.js'
];

function lazyLoadScripts(paths) {
  paths.forEach(path => {
    const script = document.createElement('script');
    script.src = path;
    script.type = 'text/javascript';
    script.defer = true; // Ensures the script runs in order and doesn't block HTML parsing
    
    // Optional: Log when a specific file finishes loading
    script.onload = () => console.log(`Loaded script: ${path}`);
    script.onerror = () => console.error(`Failed to load script: ${path}`);

    // Append the script to the end of the body
    document.body.appendChild(script);
  });
}

window.addEventListener('load', () => {
  setTimeout(() => {
    lazyLoadScripts(jsFiles);
  }, 5000); // Loads the files after 5 seconds
});
</script>

</div><div class='sfContentBlock'><section class="section-content" id="cashless-health-ins">
    <div class="il-container">
        <div class="img-cont-sec">  
            <div class="cont-sec">
                <h2 class="heading2">Cashless Everywhere with
                ICICI Lombard Health Insurance </h2>

                <p class="text">With ICICI Lombard health insurance, you can avail <a href="https://www.icicilombard.com/health-insurance/cashless" class="link">cashless hospitalisation</a> across India at a hospital of your choice. During a medical emergency or planned treatment, you can visit any hospital—network or non‑network—and access cashless services as per policy terms. We settle the approved claim amount directly with the hospital so you don’t have to arrange money upfront. This helps you focus on timely care and reduces financial stress.  </p>

            </div>
            <div class="img-sec">
                <img src="/docs/default-source/assets/marketing/images/health-revamp/cashless-everywhere.webp" alt="Health Insurance - Cashless Hospitalisation With ICICI Lombard" title="Health Insurance - Cashless Hospitalisation With ICICI Lombard">
            </div>
        </div>
    </div>
</section>


<section class="section-content bg-gray tab-wrap" id="health-cover">
    <div class="il-container">
        <h2 class="heading2 align-center">What is Covered and Not Covered Under Health Insurance?</h2>
        <p class="sub-txt align-center mid-width">We offer health insurance policies that combine wide coverage with flexibility. You get access to a large network of hospitals, quick cashless claim settlements and round-the-clock support. Our policies also offer preventive care and wellness benefits. Here’s why millions of customers choose our health insurance products </p>
        <div class="tab-block">
            <div class="tab-sec">
                <ul>
                    <li class="active" data-rel="inclusion"><span>What’s Covered </span></li>
                    <li data-rel="exclusion" class=""><span>What’s Not Covered </span></li>
                </ul>
            </div>
            <div class="tab-data">
                <div class="tab-cont active" id="inclusion">
            
                    <ul class="list-block check-list2 grid-list">
                        <li class="flex-list">
                            <h4 class="heading4">Hospitalisation Expenses</h4>
                            <p class="text">Covers medical expenses incurred during your hospitalisation as per your health insurance policy.</p>
                        </li>
                        <li class="flex-list">
                            <h4 class="heading4">AYUSH Treatment</h4>
                            <p class="text">Covers expenses for Ayurveda, Yoga, Unani, Siddha and Homeopathy (AYUSH) treatments.</p>
                        </li>
                        <li class="flex-list">
                            <h4 class="heading4">Technological Advancements and Treatments</h4>
                            <p class="text">Covers expenses for modern treatments like immunotherapy, robotic surgeries, Deep Brain stimulation, etc.</p>
                        </li>
                        <li class="flex-list">
                            <h4 class="heading4">Pre and Post Hospitalisation Expenses</h4>
                            <p class="text">Covers medical expenses incurred for a specified period before hospitalisation and after discharge.</p>
                        </li>
                        <li class="flex-list">
                            <h4 class="heading4">Domiciliary hospitalisation</h4>
                            <p class="text">Covers the cost of getting treated at home as per your health insurance policy’s terms and conditions.</p>
                        </li>
                        <li class="flex-list">
                            <h4 class="heading4">Day Care Treatment</h4>
                            <p class="text">Covers minor treatments requiring less than 24 hours of hospitalisation.</p>
                        </li>
                        <li class="flex-list">
                            <h4 class="heading4">Donor Expenses</h4>
                            <p class="text">Covers the organ donor’s hospitalisation expenses. </p>
                        </li>
                         <li class="flex-list">
                            <h4 class="heading4">Emergency ambulance</h4>
                            <p class="text">Covers expenses incurred for availing domestic ambulance services during emergencies.</p>
                        </li>
                         <li class="flex-list">
                            <h4 class="heading4">Reset Benefit</h4>
                            <p class="text">Enjoy unlimited restoration of your sum insured for any disease or injury.</p>
                        </li>
                        <li class="flex-list">
                            <h4 class="heading4">Wellness Program</h4>
                            <p class="text">Get rewarded with discounts and other deals for having an active lifestyle.</p>
                        </li>
                         <li class="flex-list">
                            <h4 class="heading4">Loyalty Bonus</h4>
                            <p class="text">Get 20% increase in annual sum insured on renewing your health insurance policy.</p>
                        </li>
                         <li class="flex-list">
                            <h4 class="heading4">Bariatric Surgery</h4>
                            <p class="text">Covers medical expenses incurred for bariatric surgery or procedure.</p>
                        </li>
                    </ul>
                </div>
                <div class="tab-cont" id="exclusion">

                    <ul class="list-block cross-list grid-list">
                        <li class="flex-list">
                            <h4 class="heading4">Pre-existing diseases</h4>
                            <p class="text">Does not cover treatment of pre-existing conditions during waiting period.</p>
                        </li>
                        <li class="flex-list">
                            <h4 class="heading4">Specific Waiting period</h4>
                            <p class="text">Treatment of certain specified and listed diseases during waiting period is not covered.</p>
                        </li>
                        <li class="flex-list">
                            <h4 class="heading4">Initial Waiting Period</h4>
                            <p class="text">Does not cover hospitalisation for any illness within 30 days of policy start date (except for accidents).</p>
                        </li>
                        <li class="flex-list">
                            <h4 class="heading4">90-day Waiting Period</h4>
                            <p class="text">Does not cover the treatment of certain illnesses like BP, diabetes and heart conditions within 90 days of policy issuance.</p>
                        </li>
                        <li class="flex-list">
                            <h4 class="heading4">Self-inflicted Injuries</h4>
                            <p class="text">Health insurance does not cover treatment for intentional self-injury.</p>
                        </li>

                        <li class="flex-list">
                            <h4 class="heading4">Investigational Expenses</h4>
                            <p class="text">Hospitalisation for diagnostics and evaluation purposes is not covered.</p>
                        </li>
                        <li class="flex-list">
                            <h4 class="heading4">Change-of-gender treatments</h4>
                            <p class="text">Does not cover treatment or surgery expenses incurred to change one’s gender.</p>
                        </li>
                        <li class="flex-list">
                            <h4 class="heading4">Cosmetic/Plastic Surgery</h4>
                            <p class="text">Our health insurance policies do not cover cosmetic or plastic surgery unless it is medically necessary.</p>
                        </li>
                    </ul>
                </div>
            </div>
            <p class="note-txt">Note: This is not an exhaustive list. Please go through the <a href="/downloads" class="link" target="_blank">policy wording</a> for detailed list of inclusions and exclusions. </p>
        </div>
        
    </div>
</section>

