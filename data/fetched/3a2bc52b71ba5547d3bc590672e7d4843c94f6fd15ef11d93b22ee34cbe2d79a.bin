    .more-quotes-wrapper {
    border-radius: 10px;
    box-shadow: 0 5px 8px 1px rgb(0 0 0 / 15%);
    border: solid 1px #cbcdce;
    background-color: #ffffff;
    width: 86%;
    position: absolute;
    bottom: 21px;
    margin: auto;
    left: 0;
    right: 0;
    color: #282828;
    z-index: 2;
    }
    .more-quotes-wrapper span.quote-title {
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 0.8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
