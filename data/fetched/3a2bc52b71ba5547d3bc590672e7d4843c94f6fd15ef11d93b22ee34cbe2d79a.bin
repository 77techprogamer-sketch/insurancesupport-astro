<script>
     $(window).scroll(function () {
        if ($(window).width() < 767) {
            var body_scroll = $(window).scrollTop();
            if (body_scroll > 1200) {
                $(".btnwarpp").removeClass("get-fixed");
                $(".il-blue-sticky").css("display", "flex");
            } else {
                $(".il-blue-sticky").css("display", "none");
                $(".btnwarpp").addClass("get-fixed");
            }
        }
    });
$(document).ready(function(){
    $(document).on("click", "#getTop", function (event) {
            event.preventDefault(); 
            $(".il-blue-sticky").hide();
            $(".btnwarpp").addClass("get-fixed");
            $("html, body").animate({ scrollTop: 0 }, "800");
        });
});
</script>
