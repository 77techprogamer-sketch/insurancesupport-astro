<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "HowTo",
  "name": "How to Make a Claim for Your Health Insurance?",
  "description": "You can easily file a health insurance claim with ICICI Lombard. Choose a cashless claim if you get treated at a network hospital or opt for a reimbursement claim if you receive treatment at a non-network hospital.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Cashless Claim",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Visit the nearest network hospital."
        },
        {
          "@type": "HowToStep",
          "text": "The hospital needs to send your pre-authorisation request up to 48 hours before a planned hospitalisation or within 24 hours of emergency hospitalisation."
        },
        {
          "@type": "HowToStep",
          "text": "We will process your cashless hospitalisation request as per the policy terms and conditions."
        },
        {
          "@type": "HowToStep",
          "text": "You can go ahead with the treatment once the hospital receives approval from our end."
        },
        {
          "@type": "HowToStep",
          "text": "After your treatment is done, we will directly settle your admissible hospitalisation bill. You can track your claim status on the IL TakeCare App."
        }
      ]
    },
    {
      "@type": "HowToStep",
      "name": "Reimbursement Claim",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Get medical treatment at any hospital of your choice and pay the bills upfront."
        },
        {
          "@type": "HowToStep",
          "text": "You can raise a health insurance reimbursement claim via our website or IL TakeCare App."
        },
        {
          "@type": "HowToStep",
          "text": "Submit a duly filled claim form along with self-attested supporting documents (in PDF/ JPEG format) on the app or website."
        },
        {
          "@type": "HowToStep",
          "text": "You can also send these documents to the following address: ICICI Lombard General Insurance Co. Ltd, Varun Towers-II, 1st, 4th (Half), 5th and 6th floors, Opp. Hyderabad Public School, Begum pet, Hyderabad, Telangana 500016."
        },
        {
          "@type": "HowToStep",
          "text": "We’ll reimburse the admissible claim amount to your bank account."
        }
      ]
    }
  ]
}
</script>
