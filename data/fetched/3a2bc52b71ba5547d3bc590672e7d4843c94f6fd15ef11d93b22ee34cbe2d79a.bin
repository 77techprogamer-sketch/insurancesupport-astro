<style>
    @media (min-width: 992px) {
        .il-sticky-wrap {
            clear: both;
            border-radius: 32px 32px 0 0;
            background: linear-gradient(90deg, #b8494c 0%, #b8494c 100%);
            position: fixed;
            bottom: 0;
            width: 100%;
            left: 0;
            right: 0;
            z-index: 2;
            display: none;
            padding: 2.5rem 3rem;
            animation: slideUp 0.5s forwards ease-out;
        }


        @keyframes slideUp {
    0% {
        transform: translateY(100%); /* Start position: fully below the container */
        opacity: 0;
    }
    100% {
        transform: translateY(0); /* End position: original position */
        opacity: 1;
    }
}
        .il-sticky-wrap .il-sticky-flx {
            display: flex;
            align-items: center;
                    justify-content: space-evenly;
        gap: 1rem;
        }

        .il-sticky-flx > p {
            font-size: 1.8rem;
            line-height: 29px;
            font-weight: 900;
            color: #fff;
        }

        .il-landing-btn button {
            padding: 1.3rem 8rem;
            border-radius: 8px;
            font-weight: 700;
        }

        .il-health-label p {
            font-size: 1.4rem;
            font-weight: 700;
            line-height: 24px;
            color: #fff;
        }

        .il-health-label p strong,
        .il-health-label strong {
            font-size: 2rem;
            color: #fff;
            font-weight: 800;
        }

        .il-health-label strong {
        }

        .il-health-label sup {
            color: #fff !important;
        }

        span.line-divdr {
            background: #ff8a89;
            height: 50px;
            display: flex;
            width: 1px;
        }
        body .scrollTop {
            background: url(data:image/svg+xml;base64,);
        }
    }
    @media (max-width: 991px) {
        .il-sticky-wrap {
            display: none !important;
        }
    }

@media (min-width: 768px) {
    .container {
        width: 100%;
    }
}
@media (min-width: 992px) {
    .container {
        width: 100%;
    }
}
@media (min-width: 1360px) {
    .container {
        width: 1360px;
    }
}
.il-close-sticky {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    position: absolute;
    top: 12px;
    right: 15px;
    border: 1px solid #fff;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    background: transparent; /* Keeps background clean */
}

/* Drawing the X lines */
.il-close-sticky:before,
.il-close-sticky:after {
    position: absolute;
    content: " ";
    height: 16px;
    width: 2px;
    background-color: #fff; /* Line color */
    border-radius: 5px;
}

.il-close-sticky:before {
    transform: rotate(45deg);
}

.il-close-sticky:after {
    transform: rotate(-45deg);
}

/* Hover/Active states: Force colors to remain white */
.il-close-sticky:hover, 
.il-close-sticky:active, 
.il-close-sticky:focus {
    border-color: #fff !important;
    background-color: transparent !important;
    text-decoration: none;
    outline: none;
}

.il-close-sticky:hover:before,
.il-close-sticky:hover:after {
    background-color: #fff !important;
}
</style>

<script>
    $(window).scroll(function () {
        if ($(window).width() > 768 && !sessionStorage.getItem('stickyClosed')) {
            var body_scroll = $(window).scrollTop();
            if (body_scroll > 800) {
                $(".il-sticky-wrap").show();
                $(".scrollTop").css("bottom", "115px");
                $(".imgWrapp").css("bottom", "115px");
            } else {
                $(".il-sticky-wrap").hide();
                $(".scrollTop").css("bottom", "27px");
                $(".imgWrapp").css("bottom", "27px");
            }
        }
    });

    $(document).ready(function () {
        $(document).on("click", ".il-landing-btn button", function (event) {
            event.preventDefault();
            $("html, body").animate({ scrollTop: 150 }, "800");
        });

        // Close button logic inside
        $(document).on("click", "#closeSticky", function (e) {
            e.preventDefault();
            sessionStorage.setItem('stickyClosed', 'true'); 
            $(".il-sticky-wrap").hide();
            $(".scrollTop").css("bottom", "27px");
            $(".imgWrapp").css("bottom", "27px");
        });
    });
</script>

