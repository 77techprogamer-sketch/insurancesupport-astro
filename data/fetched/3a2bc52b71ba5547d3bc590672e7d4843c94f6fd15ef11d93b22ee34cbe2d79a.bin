    }
    20%,
    40%,
    60%,
    80% {
    -webkit-transform: translate3d(10px, 0, 0);
    transform: translate3d(10px, 0, 0)
    }
    }
    @keyframes shakeX {
    0%,
    to {
    -webkit-transform: translateZ(0);
    transform: translateZ(0)
    }
    10%,
    30%,
    50%,
    70%,
    90% {
