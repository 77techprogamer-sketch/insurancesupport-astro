<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "HowTo",
  "name": "How to Buy Health Insurance Online?",
  "description": "Buying health insurance online is quite straightforward. Just follow the below steps:",
  "step": [
    {
      "@type": "HowToStep",
      "text": "Visit the health insurance section of the ICICI Lombard website."
    },
    {
      "@type": "HowToStep",
      "text": "Enter basic information such as contact details, proposer's information, pre-existing illness details etc."
    },
    {
      "@type": "HowToStep",
      "text": "Customise your policy by choosing the desired sum insured, policy terms, and other information."
    },
    {
      "@type": "HowToStep",
      "text": "Make an online payment using our secure payment gateway."
    },
    {
      "@type": "HowToStep",
      "text": "Visit our website and click on ‘Health Insurance’."
    },
    {
      "@type": "HowToStep",
      "text": "Choose a health insurance policy, select the number of people you want to insure, provide contact details and click on ‘Get quote’."
    },
    {
      "@type": "HowToStep",
      "text": "Pick the desired sum insured, health insurance plan and add-on covers as per your needs."
    },
    {
      "@type": "HowToStep",
      "text": "Check coverage details/policy documents and click on ‘Buy Now’."
    },
    {
      "@type": "HowToStep",
      "text": "Choose the policy tenure (ranging from one to five years). Pro tip: Choose a long-term policy to save on premium."
    },
    {
      "@type": "HowToStep",
      "text": "Review the premium break-up and complete your KYC."
    },
    {
      "@type": "HowToStep",
      "text": "Pay the required premium. You’ll receive the digital policy copy on your email and WhatsApp number."
    }
  ]
}
