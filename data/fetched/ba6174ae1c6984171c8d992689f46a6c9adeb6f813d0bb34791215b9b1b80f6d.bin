            }
            catch (err) {
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({ 
                    'event': 'errorpopup', 
                    'statusmessage': err.message 
                });
            }
        }, dynamicDelay); 
    });
</script>

