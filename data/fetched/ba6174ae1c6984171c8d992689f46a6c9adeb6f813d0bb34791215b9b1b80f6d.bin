        margin: 0;
    }

    .iltc-sec .iltc-content {
        display: flex;
        justify-content: space-between;
        flex-direction: row;
        width: 75%;
    }

    .iltc-content .content-sec {
        padding-left: 10px;
    }

    .iltc-sec .iltc-btn {
        width: 25%;
        display: flex;
        align-items: end;
    }

    .iltc-wrapper .iltc-sec {
        display: flex;
        justify-content: space-between;
        flex-direction: row;
    }

    .iltc-btn .install-btn a {
        border: 1px solid #ec6625;
        font-size: 1.2rem;
        color: #ec6625;
        font-weight: bold;
        padding: 7px 0;
        display: block;
        width: 100%;
        border-radius: 30px;
    }

    .iltc-btn .install-btn {
        width: 100%;
        max-width: 82px;
        text-align: center;
        margin: 0 auto;
    }

    .iltc-wrapper {
        padding: 10px 0;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 99999;
        background: #ffffff;
        display: none;
    }

    .closebtn-wrapper {
        position: absolute;
        right: 5px;
        top: 2px;
    }

    .closebtn-wrapper img {
        width: 8px;
        height: 8px;
    }

    .closebtn-wrapper a {
        padding: 5px 5px;
