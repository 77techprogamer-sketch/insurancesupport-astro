        -webkit-transition: opacity 0.2s;
        transition: opacity 0.2s;
        visibility: hidden;
        opacity: 0;
        z-index: 10;
    }
    .bankinfo-popup-wrap .popoverlay.active {
        opacity: 1;
        overflow: auto;
        z-index: 100000;
        height: 100%;
        width: 100%;
        visibility: visible;
    }
    .bankinfo-popup-wrap .popup.light {
        max-width: 1024px;
        opacity: 1;
        width: 100%;
        padding: 0;
    }
    .bankinfo-popup-wrap .popup {
        margin: 7.5rem auto;
        -webkit-border-radius: 1.5rem;
        border-radius: 1.5rem;
        position: relative;
        background: #fff;
        opacity: 0;
