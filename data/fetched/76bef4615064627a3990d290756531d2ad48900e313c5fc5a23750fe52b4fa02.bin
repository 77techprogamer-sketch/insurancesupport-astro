<script>

    $(function () {
        tab();
    });


    function tab() {

        $(document).on("click", ".js-tab-head-fire li", function (e) {

            var t, i, s;
            if ((e.preventDefault(), (t = $(this)), (bar = $(t).siblings(".bar")), (currindex = t.index()), (i = $(this).parents(".faq-block")), (s = $(i).find(".slide-tab-content-body .slide-tab-content")), !t.hasClass("active"))) {
                t.addClass("active").siblings().removeClass("active"), s.removeClass("active"), s.eq(currindex).addClass("active");
                var a = t.position().left;
                bar.animate({
                    left: a,
                },
                    500,
                    function () { }
                );
            }
        });
    }
$(document).ready(function () {
  $("#toggle-btn").click(function () {
    const $content = $(".mobile-hidden-content");
    const isHidden = !$content.hasClass("show-on-mobile");

    // Toggle content visibility
    $content.toggleClass("show-on-mobile");

    // Toggle button text
    this.textContent = isHidden ? "Read Less" : "Read More";

    // Toggle rotation class
    $(this).toggleClass("rotated", isHidden);

    // Scroll when hiding content (Read Less)
    if (!isHidden) {
      // Delay to allow DOM layout change
      setTimeout(() => {
        document.getElementById("scrollTarget").scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
      }, 50);
    }
  });
});


  

</script>

