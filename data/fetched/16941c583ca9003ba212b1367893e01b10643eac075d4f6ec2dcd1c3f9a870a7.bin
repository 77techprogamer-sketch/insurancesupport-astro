</div><div class='sfContentBlock'><div class="midWrappHAP">
    <!-- Get your questions regarding BeFit Cover answered  start -->
    <section class="section-content bg-lightgray activate-booster-faq" id="Faq">
        <div class="container">
            <div class="row">
                <div class="col-xs-12 befit_faq text-center">
                    <h2>Frequently asked questions</h2>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 text-center">
                    <div class="faq-wrap js-tab-wrap ui-tabs-modify">
                        
                        <div class="tab-content-body">
                            <!-- General start -->
                            <div class="tab-content active">
                                <div class="accordion-card">
                                    <div class="accordion-title">
                                        <h3>How does deductible work in a super top-up policy? </h3>
                                    </div>
                                    <div class="accordion-panel">
                                        <span>
                                            The deductible amount applies on an aggregate basis for all hospitalisation expenses during the policy year. It is the amount that you must pay before the top-up coverage kicks  in.  The top-up coverage kicks in when the base policy coverage is exhausted.
                                        </span>
                                    </div>
                                </div>
                                <div class="accordion-card">
                                    <div class="accordion-title">
                                        <h3>Can I buy Activate Booster without an existing health insurance policy?</h3>
                                    </div>
                                    <div class="accordion-panel">
                                        <span>
                                            Yes, you can purchase the Activate Booster with or without an existing health insurance policy. It is also available as a standalone product, giving you the flexibility to choose it regardless of your current insurance status.
                                        </span>
                                    </div>
                                </div>
                                <div class="accordion-card">
                                    <div class="accordion-title">
                                        <h3>Are there any waiting periods applicable for claim? </h3>
                                    </div>
                                    <div class="accordion-panel">
                                        <span>
                                            Yes, depending on your health insurance policy, there may be waiting period applicable for certain types of diseases/claims. Read the policy documents carefully to know more. 
                                        </span>
                                    </div>
                                </div>

                                


                            </div>
                            <!-- General end -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
