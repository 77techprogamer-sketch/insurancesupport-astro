        margin: 0;
        color: #212121;
        font-size: 1.2rem;
        font-weight: 700;
        line-height: normal;
        padding-bottom: 1.2rem;
    }
    .additional-details-input .additional-radio-block {
        display: flex;
        gap: 24px;
    }
    .additional-details-input .il-radio-block {
        margin-bottom: 0;
    }
    .additional-details-input .ui-radio-group {
        font-size: 1.4rem;
    }
    .additional-details-input .custom-dropdown-list {
        overflow: auto;
    }
