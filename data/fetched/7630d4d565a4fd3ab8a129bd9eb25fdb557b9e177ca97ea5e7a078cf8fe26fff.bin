    }
    .bankinfo-popup-wrap .primary-btn:focus {
        outline: none;
        color: #fff;
    }
    .bankinfo-popup-wrap .secondary-btn {
        position: relative;
        cursor: pointer;
        overflow: hidden;
        padding: 1.3rem 2.4rem 1.3rem;
        font-size: 1.6rem;
        border-radius: 5px;
        text-decoration: none;
        outline: none;
        border: 1px solid #ec6625;
        font-weight: 700;
        text-align: center;
        background: #fff;
        color: #ec6625;
        display: inline-block;
        width: fit-content;
    }
    .bankinfo-popup-wrap .secondary-btn:hover {
        position: relative;
        background: #fff2eb;
        border: 1px solid #ec6625;
        color: #ec6625;
    }
    .bankinfo-popup-wrap .secondary-btn:focus-visible {
        position: relative;
        background: #fff9f6;
