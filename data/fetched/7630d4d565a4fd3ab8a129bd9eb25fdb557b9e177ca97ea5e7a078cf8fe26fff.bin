}

.motorWidgetWrap .tabWrapper ul li .subTitle{
    font-size: 1.4rem;
    font-weight: bold;
    color: #6c6c6c;
    display: block;
}

 .motorWidgetWrap .tabContent .ui-form-block {
    display: none;
} 

.motorWidgetWrap .form-box {
    border-radius: 0;
    border: none;
}

.motorWidgetWrap .tabWrapper {
