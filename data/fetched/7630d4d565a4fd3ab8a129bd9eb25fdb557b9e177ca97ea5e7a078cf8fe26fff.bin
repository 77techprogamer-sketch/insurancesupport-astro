                                </g>
                            </g>
                        </g>
                    </g>
                </svg>
            </td>
            <td>
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 13 13">
                    <g fill="none" fill-rule="evenodd" stroke-linecap="round">
                        <g stroke="#B02A30" stroke-width="2">
                            <g>
                                <g>
                                    <g>
                                        <path d="M10.252 0.288L0.252 10.288" transform="translate(-1081.000000, -2244.000000) translate(312.000000, 2059.000000) translate(702.000000, 111.000000) translate(68.000000, 75.000000)"></path>
                                        <path d="M10.252 0.288L0.252 10.288" transform="translate(-1081.000000, -2244.000000) translate(312.000000, 2059.000000) translate(702.000000, 111.000000) translate(68.000000, 75.000000) translate(5.251655, 5.288361) scale(-1, 1) translate(-5.251655, -5.288361)"></path>
                                    </g>
                                </g>
                            </g>
                        </g>
                    </g>
                </svg>
            </td>
        </tr>
        <tr>
            <td>Natural calamities</td>
            <td>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="12" viewBox="0 0 16 12">
                    <g fill="none" fill-rule="evenodd" stroke-linecap="round" stroke-linejoin="round">
                        <g stroke="#26BA40" stroke-width="2">
                            <g>
                                <g>
                                    <path d="M67 80.251L71.246 85 81 75" transform="translate(-666.000000, -2244.000000) translate(312.000000, 2059.000000) translate(288.000000, 111.000000)"></path>
                                </g>
                            </g>
                        </g>
                    </g>
                </svg>
            </td>
