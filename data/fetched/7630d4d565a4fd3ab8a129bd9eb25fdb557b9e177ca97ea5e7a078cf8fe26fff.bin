    text-align: left;
}

.awardWrap h4 {
    font-size: 2rem;
    font-weight: 500;
    color: #fff;
}

.awardWrap h3 {
    font-size: 2.8rem;
    font-weight: 600;
    color: #fff;
}

.motorWidgetWrap > ul > li {
    font-size: 2.4rem;
    font-weight: normal;
    color: #fff;
}

.motorWidgetWrap ul li span {
    margin-right: 15px;
}

.motorWidgetWrap .tabWrapper ul li.active {
    background: #fff5ed;
