/** GLobal Variable **/
var regEmail = /^(([^<>()\[\]\.,;:\s@\"]+(\.[^<>()\[\]\.,;:\s@\"]+)*)|(\".+\"))@(([^<>()[\]\.,;:\s@\"]+\.)+[^<>()[\]\.,;:\s@\"]{2,4})$/i;
var regMobile = /^[6-9]{1}[0-9]{9}$/;
/** GLobal Variable **/


//  eventsValidation();
 
 
$(document).on('keydown', '.tel', function(e) { 46 == e.keyCode || 8 == e.keyCode || 9 == e.keyCode || 27 == e.keyCode || 13 == e.keyCode || 65 == e.keyCode && e.ctrlKey === !0 || e.keyCode >= 35 && e.keyCode <= 39 || (e.shiftKey || (e.keyCode < 48 || e.keyCode > 57) && (e.keyCode < 96 || e.keyCode > 105)) && e.preventDefault() });
$(document).on('keyup keypress', '.tel', function(e) {
    var regex = /^[0-9\.]$/;
    var str = $(this).val();
    var subStr = str.substr(str.length - 1);
    if (!regex.test(subStr)) {

        if (str.length > 0) {
            $(this).val(str.substr(0, (str.length - 1)));
        } else {
            $(this).val();
        }

    }

});

/*errorshowhide*/
function showError(el) {
    $(el).parents('#register-vehile').find('.ui-error').show();
    $(el).parents('#valid-mobile').find('.ui-error').show();
    $(el).parents('#valid-email').find('.ui-error').show();
}

function hideError(el) {
    $(el).parents('#register-vehile').find('.ui-error').hide();
    $(el).parents('#valid-mobile').find('.ui-error').hide();
    $(el).parents('#valid-email').find('.ui-error').hide();
}
/*errorshowhide*/


function ErrorOnFocus(el) {
    var $this = el;

    if ($this.hasClass('#register-vehile')) {
        if ($this.val() == '' || $this.val().length < 3) {
            showError($this);
        } else {
            hideError($this);
        }
    }
    if ($this.hasClass('#valid-mobile')) {
        if (!regMobile.test($this.val())) {
            showError($this);
        } else {
            hideError($this);
        }
    }
    if ($this.hasClass('#valid-email')) {
        if (!regEmail.test($this.val())) {
            showError($this);
        } else {
            hideError($this);
        }
    }
	
	
	   if ($this.hasClass('valid-checkbox')) {
        if (!regcheckbox.test($this.val())) {
            showError($this);
        } else {
            hideError($this);
        }
    }
  
}


function eventsValidation() {
    $(document).on('click', '.jsTransToPers', function() {
		if(insuredDetails()){
		$('#C087_ctl00_ctl00_C004_ctl00_ctl00_textBox_write').val($('#register-vehile').val());
			$('#C087_ctl00_ctl00_C003_ctl00_ctl00_textBox_write').val($('#valid-mobile').val());
			$('#C087_ctl00_ctl00_C001_ctl00_ctl00_textBox_write').val($('#valid-email').val());
			$("#C087_ctl00_ctl00_C002").trigger('click');
       }
    });  
    
 

    $('.val-req').on('focusout', function() {
        ErrorOnFocus($(this));
    });

    $('.val-req').on('keypress change', function() {
        hideError($(this));
    });
    
}

function insuredDetails() {
    var valid = true,
        inName = $('#register-vehile'),
        inMobilenum = $('#valid-mobile'),
        inEmailid = $('#valid-email'),
		incheckbox = $('.valid-checkbox');

    if (inName.val() == '') {
        showError(inName);
        valid = false;
    }
    if (!regMobile.test(inMobilenum.val())) {
        showError(inMobilenum);
        valid = false;
    }
    if (!regEmail.test(inEmailid.val())) {
        showError(inEmailid);
        valid = false;
    }
	
	
	if(!incheckbox.is(":checked")){
		showError(incheckbox);
		valid = false;
	}
	 
 
 return valid;

}

