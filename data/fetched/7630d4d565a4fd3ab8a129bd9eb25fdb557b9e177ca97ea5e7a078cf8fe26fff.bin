    }
    .bankinfo-popup-wrap .primary-btn {
        position: relative;
        cursor: pointer;
        overflow: hidden;
        color: #fff;
        padding: 1.5rem 2.4rem 1.3rem;
        font-size: 1.6rem;
        background: #ec6625;
        border-radius: 5px;
        text-decoration: none;
        outline: none;
        font-weight: 700;
        text-align: center;
        display: inline-block;
