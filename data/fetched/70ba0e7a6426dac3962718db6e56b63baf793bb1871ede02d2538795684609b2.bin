  overflow: hidden;
  z-index: 10;
}

/* gradient background with right-side notch cut inward */
.landing-ribbon {
  height: 26px;
  background: linear-gradient(90deg, #018F48 6.16%, #015D2F 75.36%);
  padding: 0 28px 0 26px;
  display: flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
  clip-path: polygon(0 0, 100% 0, calc(100% - 14px) 50%, 100% 100%, 0 100%);
}

.ribbon-icon-wrap img {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
}

.ribbon-text {
  color: var(--Global-white-000, white);
