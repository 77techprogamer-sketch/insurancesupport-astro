    20%,
    40%,
    60%,
    80% {
    -webkit-transform: translate3d(10px, 0, 0);
    transform: translate3d(10px, 0, 0)
    }
    }
    .animate__shakeX {
    -webkit-animation-name: shakeX;
    animation-name: shakeX
    }
    .toggle-panel-wrapper {
    width: 272px;
    position: fixed;
    bottom: 0;
    left: 30px;
    z-index: 9999;
    }
    a.redirectUrl {
