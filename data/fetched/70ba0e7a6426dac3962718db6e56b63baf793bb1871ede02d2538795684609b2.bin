  function RefreshCaptcha() {
    var img = document.getElementById("imgCaptcha");
    img.src = "/CustomService/captcha.ashx?query=" + Math.random();
  }
  $(document).ready(function () {
    $("#dv1").attr('disabled', 'disabled');
  });
  var $window = $(window),
  currentWindowSize
  currentWindowSize = $window.width();
  if ((currentWindowSize <= 767)) {
    /*footer accordion*/
    $('.footcontact').find('ul').slideUp();
    $('.accord_footer_mobile').find('ul:first').slideDown();

    $('.footcontact>span.f_head').click(function (e) {
      e.preventDefault();
      if ($(this).hasClass('p_active')) {
        $(this).removeClass('p_active').next('ul').slideUp();
      }
      else {
        $('.footcontact>span.f_head').next('ul').slideUp();
        $(this).addClass('p_active').next('ul').slideDown();
        $(this).siblings('span').removeClass('p_active').next('ul').slideUp();
      }
    });
    $('.accord_footer_mobile .footcontact:eq(0)>ul').show();
    $('.charms').removeClass('open-side');
    /*ends here*/
  }
  else {
    setTimeout(function () {
      $('.charms').removeClass('open-side');
      $('.call_back_form,.pagesharing').removeClass('active');
    }, 3000000);
  }

  $(window).on("load",function () {
    $('#start-date').datepicker("option","showOtherMonths",false);
    $('#end-date').datepicker("option","showOtherMonths",false);
    if($(window).width()<767){
      $('[data-height="banner"]').on('click',function(e){
        e.preventDefault();
        var banner = $('.widgetSectn').outerHeight(true);
        $('.travel_insurance .tr_banner').css({'min-height':banner });
      })
    }
  });
  $(document).ready(function () {
    var hashes = window.location.href.slice(window.location.href.indexOf('?') + 1);
    $('.selectOptn a').removeClass('active');
    $('.optDetials').show();
    if(hashes.indexOf('opt=hb') >= 0)
    {
      $('.byNw').addClass('active');
      $('.extP, .renewP').hide();
      $('.buyNew').fadeIn();
      if($(window).width() <= 767){
        $('.widgetSectn .overlay, .widgetSectn .optDetials').show();
        $('.widgetSectn .optDetials').animate({left: "0"});
        $(window).scrollTop(0);
      }
    }
    else if(hashes.indexOf('opt=pp') >= 0)
    {
      $('.renewPly').addClass('active');
      $('.renewP').fadeIn();
      $('.buyNew, .extP').hide();
      if($(window).width() <= 767){
        $('.widgetSectn .overlay, .widgetSectn .optDetials').show();
        $('.widgetSectn .optDetials').animate({left: "0"});
        $(window).scrollTop(0);
      }
    }
    else if(hashes.indexOf('opt=chi') >= 0)
    {
      $('.exPly').addClass('active');
      $('.extP').fadeIn();
      $('.buyNew, .renewP').hide();
      if($(window).width() <= 767){
        $('.widgetSectn .overlay, .widgetSectn .optDetials').show();
        $('.widgetSectn .optDetials').animate({left: "0"});
        $(window).scrollTop(0);
      }
    }
    else{
     if($(window).width() <= 767){
      $('.widgetSectn .optDetials').css({left: "-100%"});
      $('.widgetSectn .optDetials').hide();
      $(window).scrollTop(0);
      $('.overlay').hide();
    }
    $('.exPly').addClass('active');
    $('.extP').fadeIn();
    $('.buyNew, .renewP').hide();
  }
});
  (function ($, window, document) {
