<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{
    "@type": "Question",
    "name": "Why do I need to insure my car?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "You need a car insurance to protect you and your four-wheeler during any untoward incidents. While a third-party car insurance is compulsory for all car owners in India, an own damage car insurance covers you in case of accidents, theft and fire."
    }
  },{
    "@type": "Question",
    "name": "What are the different types of car insurance policies?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "There are three types of car insurance policies, namely third-party car insurance, own damage car insurance and comprehensive car insurance."
    }
  },{
    "@type": "Question",
    "name": "What are the benefits of buying car insurance online?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "When you buy car insurance online, you get an instant coverage, easy customisation and better discounts. You also have the advantage of choosing from multiple payment options, e.g. credit card (Visa, Master, AMEX card), net banking, debit card etc."
    }
  },{
    "@type": "Question",
    "name": "How quickly can I buy/renew car insurance online?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "It takes just a few minutes to buy or renew car insurance online. You just have to enter your vehicle registration number, contact information and select the covers you need. Once you make the payment, you receive an instant car insurance policy."
    }
  },{
    "@type": "Question",
    "name": "What are the various types of vehicles that I can insure online?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "You can buy car insurance online for private cars, including petrol, diesel and CNG, and electric vehicles."
    }
  },{
    "@type": "Question",
    "name": "Do I need a valid PUC to drive in India?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes, you need to have a valid and effective PUC, and/or fitness certificate, to drive your vehicle and stay compliant with the law."
    }
  },{
    "@type": "Question",
    "name": "Can I skip the ₹15 lakh Personal Accident cover for owner in my car insurance policy?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes, but only if you already have an existing personal accident cover or accidental cover rider in your life/term insurance.

