<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to File a Cashless Car Insurance Claim?",
  "description": "Accidents can be stressful but filing a cashless car insurance claim shouldn’t be. That’s why ICICI Lombard offers a seamless claims experience. Just follow these steps:",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Inform About Incident",
      "text": "Inform us about the accident via website, IL TakeCare app, toll-free number 1800 2666 or WhatsApp: 7738282666. Share basic details like your policy number, chassis/vehicle registration number and the nature of damage."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Visit Network Garage",
      "text": "Take your car to one of our network garages to avail the benefit of cashless repairs. With this, you don’t have to make any upfront payment for the repairs (subject to policy terms and conditions)."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Submit Documents",
      "text": "Upload or submit documents such as car registration certificate (RC), driving licence, filled claim form and FIR (for theft cases), and other as requested by the insurer."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Complete Video Survey",
      "text": "Complete your video survey using the InstaSpect# on our IL TakeCare App. This will help us assess the damage and speed up the claim process."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": "Claim Settlement",
      "text": "Once your car is repaired, we settle the bill directly with the network garage as per policy terms. You only need to pay for deductibles or non-covered items."
    }
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Buy Car Insurance Online?",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Step 1",
      "text": "Visit our website or IL TakeCare App."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Step 2",
      "text": "Enter your car registration number."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Step 3",
      "text": "Select the type of coverage you want for your car."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Step 4",
      "text": "Personalise your coverage with useful add-ons like Zero Depreciation, IL Smart Assist, etc."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": "Step 5",
      "text": "Review and complete payment for your car insurance policy online."
    }
