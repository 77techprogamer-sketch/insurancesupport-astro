</div><div class='sfContentBlock'><script>
    document.addEventListener('DOMContentLoaded', function() {
        // Delay execution by 5 seconds (5000 milliseconds)
        let isMobile = window.innerWidth < 767;
        let dynamicDelay = isMobile ? 7000 : 5000;
        setTimeout(function() {
            try {
                // Your static, hardcoded data structure
                let data = {
                    event: 'custom_event',
                    eventCategory: 'page_loaded_successfully',
                    eventAction: 'NA',
                    eventLabel: 'NA'
                };

                console.log(data);
                
                // Safe push to the dataLayer
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push(data);      
            }
            catch (err) {
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({ 
                    'event': 'errorpopup', 
                    'statusmessage': err.message 
                });
            }
        }, dynamicDelay); 
    });
</script>

</div><div class='sfContentBlock'><script type="text/javascript">
    window.addEventListener("load", function () {
        window.ymConfig = {
            bot: "x1725620362017",
            host: "https://cloud.yellow.ai",
        };

        (function () {
            var w = window;
            var ic = w.YellowMessenger;

            if (typeof ic === "function") {
                ic("reattach_activator");
                ic("update", window.ymConfig);
            } else {
                var d = document;
                var i = function () {
                    i.c(arguments);
                };

                function loadYellowMessenger() {
                    var e = d.createElement("script");
                    e.type = "text/javascript";
                    e.async = true;
                    e.src = "https://cdn.yellowmessenger.com/plugin/widget-v2/latest/dist/main.min.js";

                    e.onload = function () {
                        applyCustomStyles();
                    };

                    var t = d.getElementsByTagName("script")[0];
                    t.parentNode.insertBefore(e, t);
                }

                i.q = [];
                i.c = function (e) {
                    i.q.push(e);
                };

                w.YellowMessenger = i;

                loadYellowMessenger();
            }
        })();

        function applyCustomStyles() {
            try {
                var frameDocument = window.frames && window.frames.ymIframe && window.frames.ymIframe.document;

                if (!frameDocument || !frameDocument.head) return;

                var newStyleElement = frameDocument.createElement("style");
                newStyleElement.innerHTML = `
          #chatOptions .option.vertical-qr {
            min-width: 100%;
          }

          #chatOptions .option.vertical-qr.vertical-qr-center {
            left: 0;
            margin-left: 0;
          }
        `;

                frameDocument.head.appendChild(newStyleElement);
            } catch (e) {
                console.warn("Unable to apply Yellow Messenger iframe styles", e);
            }
        }

        function openYellowBot() {
            try {
                if (window.YellowMessengerPlugin && typeof window.YellowMessengerPlugin.openBot === "function") {
                    window.YellowMessengerPlugin.openBot();
                }
            } catch (e) {}
        }

        function handleYellowBotClosed() {
            window.addEventListener("message", function (eventData) {
                try {
                    var data = eventData.data;

                    if (typeof data !== "object") {
                        data = JSON.parse(data);
                    }

                    if (data && data.event_code === "ym-bot-closed") {
                        var ymCircle = document.getElementById("ymDivCircle");
                        if (ymCircle) {
                            ymCircle.style.display = "none";
                        }
                    }
                } catch (e) {}
            });
        }

        handleYellowBotClosed();
        var token = window.location.href.split("#")[1];

        if (token === "newUser" && window.getUserFeedback && typeof window.getUserFeedback.open === "function") {
            window.getUserFeedback.open();
            $(".ilOverlay").show();
        }
    });
</script>

