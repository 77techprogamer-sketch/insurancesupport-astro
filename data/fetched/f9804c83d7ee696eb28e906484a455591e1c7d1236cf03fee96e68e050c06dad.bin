}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Download Your Car Insurance Policy Copy Online?",
  "description": "After you buy car insurance online, ICICI Lombard shares the policy documents on your registered email ID and mobile number. You can also download them by following these steps:",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Log In",
      "text": "Visit our website or download our IL TakeCare App and log in with your registered mobile number."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Policy Dashboard",
      "text": "You can see all of your ICICI Lombard policies in the ‘My Policies’ or Policy Dashboard section."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Download Policy Document",
      "text": "Choose the relevant car insurance policy and tap on “Download Policy Document”. And that’s it."
    }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Renew Car Insurance Online?",
  "description": "Renewing your car insurance online is quite simple and hassle-free. You can complete the entire process within minutes, without any paperwork. Just follow the below steps:",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Visit Our Website",
      "text": "Visit our website, click on the “Renewal” tab and select “Car Policy Renewal”. Alternatively, you can directly visit our renewal page."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Fill Details",
      "text": "Enter details like your car registration number or policy number."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Check Coverage",
      "text": "Review your coverage details and make changes like adjust IDV or opt for add-ons."
    },
    {
