    <!-- Plan Details -->
<section class="plan_highlight plan_details" id="planPolicyTerm">
	<article class="container">
	        <h3>Plan Details</h3>
      		<ul class="chi_tab">
			<li class="chi_tab_nav  active" data-tab="tab1">Policy Terms</li>
			<li class="chi_tab_nav" data-tab="tab2">Exclusions</li>
			<span aria-hidden="true" role="presentation" class="glider"></span>
		</ul>
		<aside class="tab_content policy_term_section active" id="tab1">	
						<table cellpadding="0" cellspacing="0" class="plan-details-table" width="100%">
	<tbody>
		<tr>
			<th colspan="2" role="rowheader">Minimum Entry Age</th>
		</tr>
		<tr>
			<td>Adult</td>
			<td>18 years to 99 years</td>
		</tr>
		<tr>
			<td>Child</td>
			<td>90 days to 24 years</td>
		</tr>
		<tr>
			<td>Exit Age</td>
			<td>Lifelong</td>
		</tr>
		<tr>
			<th colspan="2" role="rowheader">Cover Type</th>
		</tr>
		<tr>
			<td>Individual</td>
			<td>Maximum up to 6 persons</td>
		</tr>
		<tr>
			<td>Family Floater</td>
			<td>Maximum up to 2A2C</td>
		</tr>
		<tr>
			<td>Tenure Options</td>
			<td>1/2/3 Years</td>
		</tr>
		<tr>
			<th colspan="2" role="rowheader">Waiting Period</th>
		</tr>
		<tr>
			<td>Waiting Period for Unforeseen Accidents</td>
			<td>0 days (coverage starts from midnight)</td>
		</tr>
		<tr>
			<td>Initial Waiting Period</td>
			<td>30 days (coverage starts from 31st day)</td>
		</tr>
		<tr>
			<td>Named Ailment Waiting Period</td>
			<td>2 years</td>
		</tr>
		<tr>
			<td>Waiting Period due to pre-existing diseases</td>
			<td>3 years</td>
		</tr>
		<tr>
			<td>Relationship Covered</td>
			<td>Self, spouse, son, daughter, father, mother, mother-in-law, father-in-law, grandfather, grandmother</td>
		</tr>
	</tbody>
</table>
