                <ul class="rating_count" style="">
                    <li>
                        <h2>4.8&nbsp;<img alt="Product Reviews and Ratings" class="lazy" data-src="/docs/default-source/assets/product-bundle/il-travel/images/star-rating.webp"></h2>
                    </li>
