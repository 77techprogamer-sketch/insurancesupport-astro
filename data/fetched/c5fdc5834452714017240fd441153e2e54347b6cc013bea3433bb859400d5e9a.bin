<!-- FAQ Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [

    {
      "@type": "Question",
      "name": "How does travel insurance protect me during medical emergencies abroad?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Travel insurance provides coverage for hospitalisation expenses, emergency dental treatment, medical evacuation and repatriation based on policy terms and conditions."
      }
    },
    {
      "@type": "Question",
      "name": "What risks do Indian travellers usually overlook while travelling internationally?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Some of the commonly overlooked risks include baggage delays/loss, trip interruption, missed/cancelled flights, etc."
      }
    },
    {
      "@type": "Question",
      "name": "Is travel insurance useful even if I am travelling for a short duration?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, because travel insurance covers a range of medical and trip-related contingencies, which can happen even during short international trips."
      }
    },
    {
      "@type": "Question",
      "name": "Can one travel insurance policy cover multiple countries in a single trip?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, you just need to list all the destinations you plan to visit while buying your travel insurance policy. This ensures you’ll be covered for your entire multi-country trip."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if I travel without international travel insurance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Travel insurance provides coverage for sudden medical expenses and travel-related losses, thereby ensuring you can travel worry-free. Besides, many countries have made travel insurance a mandatory requirement for their visa process."
      }
    },
    {
      "@type": "Question",
      "name": "Does travel insurance offer assistance beyond medical emergencies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, travel insurance also offers coverage for common carrier delay, damage to baggage during transit, passport loss, personal accidents and more."
      }
    },
    {
      "@type": "Question",
      "name": "How early should I buy travel insurance before my trip?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "While it’s best to buy travel insurance as early as possible, you typically need to purchase it at least 1–2 days before your departure for the policy to be valid."
      }
    },
    {
      "@type": "Question",
      "name": "Can I buy travel insurance for parents travelling without me?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, you can purchase a travel insurance policy for parents travelling independently. Just ensure to provide all the details accurately."
      }
    },
    {
      "@type": "Question",
      "name": "Is travel insurance valid if my travel dates change after purchase?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, you can modify your travel dates after the policy purchase. You can also extend your travel policy, subject to payment of additional premium and underwriting rules."
      }
    },
    {
      "@type": "Question",
      "name": "Is travel insurance mandatory for everyone?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Travel insurance is mandatory when you want to visit certain countries (like Schengen countries). However, it is highly recommended to have travel insurance to secure yourself against travel-related risks."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to buy travel insurance for short trips as well?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. It is always good to be insured against the unpredictable - like lost passport/baggage or medical emergency. Travel insurance will help you tackle such situations with ease."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if my travel insurance expires?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If your travel insurance policy expires while you’re still on your international trip, then you will no longer be covered for different travel and medical-related contingencies. That’s why it is important to ensure that your travel insurance covers the entire duration of your trip abroad."
      }
    },
    {
      "@type": "Question",
      "name": "How can I cancel my travel insurance policy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can easily cancel your travel insurance before your trip start date. Just get in touch with us via our toll free number 1800 2666, email ID customersupport@icicilombard.com or the IL TakeCare App."
      }
    },
    {
      "@type": "Question",
      "name": "Are outpatient medical expenses covered under travel insurance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, if you opt for Outpatient Treatment for Illness and Injury Add-on. This add-on cover is available under our TripSecure+ travel insurance policy."
      }
    },
    {
      "@type": "Question",
      "name": "Will my policy cover treatment taken at non-network hospitals overseas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, travel insurance also covers emergency treatments undertaken at non-network hospitals abroad."
      }
    },
    {
      "@type": "Question",
      "name": "Does travel insurance cover theft of valuables like laptops or mobile phones?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, but only if the insured member has opted for the Electronic Equipment Loss add-on. The coverage offered is subject to policy terms and conditions."
      }
    },
    {
      "@type": "Question",
      "name": "Are adventure activities automatically covered?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No, adventure activities are only covered under the Adventure Sports add-on."
      }
    },
    {
      "@type": "Question",
      "name": "Are airline delays and missed connections covered under the policy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, travel insurance covers common carrier delays and missed connections subject to policy terms and conditions."
      }
    },
    {
      "@type": "Question",
      "name": "Will my policy cover emergency dental treatment during travel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, our travel insurance covers emergency dental treatment for sudden acute pain."
      }
    },
    {
      "@type": "Question",
      "name": "Does travel insurance cover baggage delay beyond a specific number of hours?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, travel insurance offers a fixed allowance when your checked-in baggage is delayed by the airline by more than six consecutive hours."
      }
    },
    {
      "@type": "Question",
      "name": "Are ambulance charges abroad covered under travel insurance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, if the ambulance services are medically necessary and within policy limits."
      }
    },
    {
      "@type": "Question",
      "name": "Will my travel insurance cover any pre-existing disease?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our TripSecure+ travel insurance provides coverage for pre-existing conditions via the Pre-existing disease add-on cover."
      }
    },
    {
      "@type": "Question",
      "name": "What is accidental death coverage in travel insurance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under this cover, a lump sum amount is paid if the insured dies or becomes disabled while getting on, off, or traveling in a public/common carrier during the policy period."
      }
    },
    {
      "@type": "Question",
      "name": "What is the validity period of travel insurance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The validity of your travel insurance depends on your trip duration. It usually starts from your date of departure and ends when you return. For more details, read the policy documents."
      }
    }

  ]
}
</script>
<!-- FAQ Schema End-->

