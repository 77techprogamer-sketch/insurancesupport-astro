        <div class="container">
            <div class="containersection">
                <div class="row">
                    <div class="col-xs-12">
                        <h2 class="befit_cover">Coverage of ICICI Lombard's MaxProtect 1 crore health insurance policy</h2>
                    </div>
                </div>
                <div class="row">
                    <div>
                        <div class="tab-wrap js-tab-wrap pad-top2 pad-bottom2 inc-exc-tab">
