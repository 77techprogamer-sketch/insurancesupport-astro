    }
    .bankinfo-popup-wrap .primary-btn-disabled {
        background: #c9c9c9;
        pointer-events: none;
        position: relative;
        cursor: not-allowed;
        overflow: hidden;
        padding: 1.3rem 2.4rem;
        font-size: 1.6rem;
        border-radius: 5px;
        text-decoration: none;
        outline: none;
        border: 0;
        font-weight: 700;
        text-align: center;
        color: #fff;
        border: 1px solid #c9c9c9;
