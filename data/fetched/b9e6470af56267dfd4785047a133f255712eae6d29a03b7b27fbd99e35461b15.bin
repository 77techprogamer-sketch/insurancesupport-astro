    }
    .locate-hospital-sec .network-hospital-block{
        padding: 2.4rem 1rem 4rem;
    }
    .network-hospital-block .search-radiobtn-block{
        gap: 10px;
        justify-content: space-between;
    }
    .locate-hospital-block p.locate-tnc{
        font-size: 1.3rem;
        margin-bottom: 2.4rem;
    }

}


