---
import MobileStickyBar from '../components/MobileStickyBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/globals.css';
import FloatingCTA from '../components/FloatingCTA.tsx';
import Chatbot from '../components/Chatbot.astro';
import GeoBanner from '../components/GeoBanner';

// Define Indian languages and their regions for hreflang
const INDIAN_LANGUAGES = ['en', 'hi', 'bn', 'ta', 'te', 'mr', 'gu', 'kn', 'ml', 'pa'];
const langRegion = {
  'en': 'en-IN',
  'hi': 'hi-IN',
  'bn': 'bn-IN',
  'ta': 'ta-IN',
  'te': 'te-IN',
  'mr': 'mr-IN',
  'gu': 'gu-IN',
  'kn': 'kn-IN',
  'ml': 'ml-IN',
  'pa': 'pa-IN'
};

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  keywords?: string;
  canonical?: string;
  dateModified?: string;
  geoRegion?: string;
  geoPlaceName?: string;
  geoPosition?: string;
  skipDefaultHreflang?: boolean;
  pageLang?: string;   // e.g. "hi-IN", "bn-IN" — defaults to "en-IN"
  ogLocale?: string;   // e.g. "hi_IN", "bn_IN" — defaults to "en_IN"
}

const { title, description = "Insurance Support by Hari Kotian provides insurance guidance and claim assistance from Bengaluru.", ogImage: pageOgImage, noIndex = false, keywords, canonical, dateModified, geoRegion = "IN-KA", geoPlaceName = "Bengaluru", geoPosition = "13.0159;77.5522", skipDefaultHreflang = false, pageLang = "en-IN", ogLocale = "en_IN" } = Astro.props;

// Google typically truncates meta descriptions at ~155 characters (desktop).
// Truncate on a safe word boundary so CTAs/keywords aren't cut mid-word in the SERP.
// The full description is still used inside the page content where applicable.
const META_DESC_MAX = 150;
function truncateDesc(desc) {
  if (!desc) return desc;
  const plain = String(desc);
  if (plain.length <= META_DESC_MAX) return plain;
  const cut = plain.slice(0, META_DESC_MAX);
  const lastSpace = cut.lastIndexOf(' ');
  const trimmed = lastSpace > 60 ? cut.slice(0, lastSpace) : cut;
  return trimmed.replace(/[\s,.;:]+$/,'') + '…';
}
const metaDescription = truncateDesc(description);

const siteName = "Insurance Support";
const siteUrl = "https://insurancesupport.online"; // no trailing slash — avoids double-slash in concatenations

const phoneNumber = "+91-9986634506";
const phoneE164 = "+919986634506"; // full E.164 for schema & tel links

// Dedup: if title already contains the brand, don't append it again (prevents "X | Insurance Support | Insurance Support")
// Also collapse double occurrences of "| Insurance Support" into a single instance.
let cleanTitle = title;
if (cleanTitle && cleanTitle.includes(`${siteName} | ${siteName}`)) {
  // Replace any duplicate "| Insurance Support | Insurance Support" with a single instance
  const dupPattern = new RegExp(`\\s*\\|\\s*${siteName}\\s*\\|\\s*${siteName}`);
  cleanTitle = cleanTitle.replace(dupPattern, ` | ${siteName}`);
}
const fullTitle = cleanTitle ? (cleanTitle.includes(siteName) ? cleanTitle : `${cleanTitle} | ${siteName}`) : `${siteName} — Insurance Guidance and Claim Support in Bengaluru`;

const ogImage = pageOgImage || `${siteUrl}/og-image.png`;

// Updated organization schema with full phone, corrected areaServed types, and full Google Maps URL
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "@id": `${siteUrl}/#organization`,
  "name": "Insurance Support",
  "description": "Insurance guidance and claim assistance provided by Hari Kotian from Bengaluru.",
  "url": siteUrl,
  "logo": `${siteUrl}/logo.png`,
  "sameAs": ["https://g.page/r/CRDgJanrKjRhEBM/review"],
  "telephone": phoneE164,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Bahubali Nagar, Jalahalli",
    "addressLocality": "Bengaluru",
    "addressRegion": "Karnataka",
    "postalCode": "560013",
    "addressCountry": "IN"
  },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Bengaluru" },
    { "@type": "AdministrativeArea", "name": "Koramangala" },
    { "@type": "AdministrativeArea", "name": "Indiranagar" },
    { "@type": "AdministrativeArea", "name": "Whitefield" },
    { "@type": "State", "name": "Karnataka" },
    { "@type": "Country", "name": "IN" }
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": phoneE164,
    "contactType": "customer service",
    "availableLanguage": ["English", "Hindi", "Bengali", "Tamil", "Telugu", "Marathi", "Gujarati", "Kannada", "Malayalam"],
    "hoursAvailable": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "09:00",
      "closes": "21:00"
    }
  },
  "founder": {
    "@type": "Person",
    "@id": `${siteUrl}/about/#person`,
    "name": "Hari Kotian",
    "telephone": phoneE164,
    "url": `${siteUrl}/about/`,
    "worksFor": { "@id": `${siteUrl}/#organization` }
  }
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}/about/#person`,
  "name": "Hari Kotian",
  "url": `${siteUrl}/about/`,
  "jobTitle": "Insurance advisor",
  "worksFor": { "@id": `${siteUrl}/#organization` },
  "hasCredential": {
    "@type": "EducationalOccupationalCredential",
    "credentialCategory": "license",
    "name": "IRDAI insurance agent registration",
    "identifier": "0149161D",
    "recognizedBy": {
      "@type": "Organization",
      "name": "Insurance Regulatory and Development Authority of India",
      "url": "https://irdai.gov.in/"
    }
  },
  "knowsAbout": ["Life insurance", "Health insurance", "Motor insurance", "Insurance claims", "Policy review"]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "name": siteName,
  "url": siteUrl,
  "publisher": {
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": "Insurance Support",
    "url": siteUrl
  },
  "author": {
    "@type": "Person",
    "@id": `${siteUrl}/about/#person`,
    "name": "Hari Kotian",
    "url": `${siteUrl}/about/`
  }
};

const pageSchema = dateModified ? {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical || Astro.url.href}#webpage`,
  "url": canonical || Astro.url.href,
  "name": title,
  "dateModified": dateModified,
  "isPartOf": { "@id": `${siteUrl}/#website` },
  "publisher": { "@id": `${siteUrl}/#organization` }
} : null;
---

<!doctype html>
<html lang={pageLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={metaDescription} />
    <meta name="author" content="Hari Kotian" />
        <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical || Astro.url.href} />
    <link rel="author" href="https://insurancesupport.online/about" />
    {!skipDefaultHreflang && (
          <>
            <link rel="alternate" hreflang="en-IN" href={canonical || Astro.url.href} />
            <link rel="alternate" hreflang="x-default" href={canonical || `${siteUrl}/`} />
            {/* Only add language variants on non-English pages */}
            {pageLang && pageLang !== 'en-IN' && (
              <>
                {INDIAN_LANGUAGES.map(lang => (
                  <link 
                    rel="alternate" 
                    hreflang={langRegion[lang] || `${lang}-IN`} 
                    href={`https://insurancesupport.online/blog/${lang}/${translatedFrom || Astro.params.slug}/`} 
                  />
                ))}
              </>
            )}
          </>
        )}
    <meta name="geo.region" content={geoRegion} />
    <meta name="geo.placename" content={geoPlaceName} />
    <meta name="geo.position" content={geoPosition} />
    <meta name="ICBM" content={geoPosition} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical || Astro.url.href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage || `${siteUrl}/og-image.png`} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical || Astro.url.href} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage || `${siteUrl}/og-image.png`} />
    <meta name="google-site-verification" content="V1MQKb60VcWmP7f4u2x7yN1zR5aJ9bL0kD" />
    <meta name="msvalidate.01" content="551FF3A8CD7B8225D53FAB718B3051E2" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Insurance Support | Expert Insurance Guides & Tips" href="/rss.xml" />
    <link rel="describedby" type="text/plain" href="/llms.txt" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <link rel="preconnect" href="https://www.clarity.ms" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <!-- Fonts load non-blocking via media="print"; /scripts/analytics.js flips it to "all"
         after load. (Inline event-handler attributes are blocked by the production CSP.) -->
    <link id="google-fonts-css" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" media="print" />
    <script type="application/ld+json" set:html={JSON.stringify([organizationSchema, websiteSchema, personSchema, ...(pageSchema ? [pageSchema] : [])])} />
    <!-- Analytics: GA4 (G-JP67H399V2) + Google Ads (AW-18269976114) + GTM (GTM-P8DZ6MRQ).
         Loaded from an external file because the production CSP (public/_headers)
         blocks inline scripts. Also enables the gtag() stub used by contact.astro
         and the lead-magnet components for conversion events. -->
    <script src="/scripts/analytics.js" is:inline defer></script>
  <script src="/scripts/webmcp.js" defer></script>
</head>
  <body class="font-sans text-base antialiased pb-16 md:pb-0" style="scroll-padding-top: 5rem;">
    <!-- Skip link for accessibility -->
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:rounded-lg" aria-label="Skip to main content">Skip to main content</a>
    <Header />
    <GeoBanner client:visible />
    <slot />
    <Footer />
    <MobileStickyBar />
    <FloatingCTA client:idle />
    <Chatbot />
    <script src="/scripts/reveal.js" is:inline defer></script>
    <!-- Microsoft Clarity (v9dto5m10l) now loads from /scripts/analytics.js (CSP-safe). -->
  </body>
</html>
