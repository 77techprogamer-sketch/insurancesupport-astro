---
import MobileStickyBar from '../components/MobileStickyBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/globals.css';
import FloatingCTA from '../components/FloatingCTA.tsx';
import Chatbot from '../components/Chatbot.astro';
import GeoBanner from '../components/GeoBanner';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  keywords?: string;
  canonical?: string;
  geoRegion?: string;
  geoPlaceName?: string;
  geoPosition?: string;
  skipDefaultHreflang?: boolean;
  pageLang?: string;   // e.g. "hi-IN", "bn-IN" — defaults to "en-IN"
  ogLocale?: string;   // e.g. "hi_IN", "bn_IN" — defaults to "en_IN"
}

const { title, description = "Insurance Support by Hari Kotian — IRDAI-certified insurance advisor. 25+ years of expertise in life, health, motor & all insurance types. Claim recovery experts.", ogImage: pageOgImage, noIndex = false, keywords, canonical, geoRegion = "IN-KA", geoPlaceName = "Bengaluru", geoPosition = "13.0159;77.5522", skipDefaultHreflang = false, pageLang = "en-IN", ogLocale = "en_IN" } = Astro.props;

const siteName = "Insurance Support";
const siteUrl = "https://insurancesupport.online"; // no trailing slash — avoids double-slash in concatenations

const phoneNumber = "+91-9986634506";
const phoneE164 = "+919986634506"; // full E.164 for schema & tel links

// Dedup: if title already contains the brand, don't append it again (prevents "X | Insurance Support | Insurance Support")
// Also collapse double occurrences of "| Insurance Support" into a single instance.
let cleanTitle = title;
if (cleanTitle && cleanTitle.includes(`${siteName} | ${siteName}`)) {
  // Replace any duplicate "| Insurance Support | Insurance Support" with a single instance
  const dupPattern = new RegExp(`\\s*\\|\\s*${siteName}\\s*\\|\\s*${siteName}`);
  cleanTitle = cleanTitle.replace(dupPattern, ` | ${siteName}`);
}
const fullTitle = cleanTitle ? (cleanTitle.includes(siteName) ? cleanTitle : `${cleanTitle} | ${siteName}`) : `${siteName} — IRDAI Certified Insurance Advisor in Bengaluru`;

const ogImage = pageOgImage || `${siteUrl}/og-image.png`;

// Updated organization schema with full phone, corrected areaServed types, and full Google Maps URL
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "name": "Insurance Support",
  "url": siteUrl,
  "logo": `${siteUrl}/logo.png`,
  "sameAs": [
    "https://www.google.com/maps/place/Insurance+Support/@13.0159,77.5522,17z/data=!4m6!3m5!1s0x3bae1670c7b5d5f3:0x8b5e8c5f5c5f5c5f!8m2!3d13.0159!4d77.5544!16s%2Fg%2F11c5f5c5f"
  ],
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Bengaluru" },
    { "@type": "AdministrativeArea", "name": "Koramangala" },
    { "@type": "AdministrativeArea", "name": "Indiranagar" },
    { "@type": "AdministrativeArea", "name": "Whitefield" },
    { "@type": "State", "name": "Karnataka" },
    { "@type": "Country", "name": "IN" }
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": phoneE164,
    "contactType": "customer service",
    "availableLanguage": ["English", "Hindi", "Bengali", "Tamil", "Telugu", "Marathi", "Gujarati", "Kannada", "Malayalam"],
    "hoursAvailable": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "09:00",
      "closes": "21:00"
    }
  },
  "founder": {
    "@type": "Person",
    "name": "Hari Kotian",
    "jobTitle": "IRDAI Certified Insurance Advisor",
    "telephone": phoneE164,
    "worksFor": {
      "@type": "Organization",
      "name": "Insurance Support"
    },
    "sameAs": [
      "https://insurancesupport.online/about"
    ]
  }
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteName,
  "url": siteUrl,
  "publisher": {
    "@type": "Organization",
    "name": "Insurance Support",
    "url": siteUrl
  },
  "author": {
    "@type": "Person",
    "name": "Hari Kotian",
    "url": `${siteUrl}/about`
  }
};
---

<!doctype html>
<html lang={pageLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="Hari Kotian" />
        <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical || Astro.url.href} />
    <link rel="author" href="https://insurancesupport.online/about" />
    {!skipDefaultHreflang && (
          <>
            <link rel="alternate" hreflang="en-IN" href={canonical || Astro.url.href} />
            <link rel="alternate" hreflang="x-default" href={canonical || `${siteUrl}/`} />
            {/* Only add language variants on non-English pages */}
            {pageLang && pageLang !== 'en-IN' && (
              <>
                {INDIAN_LANGUAGES.map(lang => (
                  <link 
                    rel="alternate" 
                    hreflang={langRegion[lang] || `${lang}-IN`} 
                    href={`https://insurancesupport.online/blog/${lang}/${translatedFrom || Astro.params.slug}/`} 
                  />
                ))}
              </>
            )}
          </>
        )}
    <meta name="geo.region" content={geoRegion} />
    <meta name="geo.placename" content={geoPlaceName} />
    <meta name="geo.position" content={geoPosition} />
    <meta name="ICBM" content={geoPosition} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical || Astro.url.href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage || `${siteUrl}/og-image.png`} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical || Astro.url.href} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage || `${siteUrl}/og-image.png`} />
    <meta name="google-site-verification" content="V1MQKb60VcWmP7f4u2x7yN1zR5aJ9bL0kD" />
    <meta name="msvalidate.01" content="551FF3A8CD7B8225D53FAB718B3051E2" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Insurance Support | Expert Insurance Guides & Tips" href="/rss.xml" />
    <link rel="describedby" type="text/plain" href="/llms.txt" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <link rel="preconnect" href="https://www.clarity.ms" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <script type="application/ld+json" set:html={JSON.stringify([organizationSchema, websiteSchema])} />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-JP67H399V2"></script>
    <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag("js",new Date());gtag("config","G-JP67H399V2")</script>
    <!-- Google Ads Conversion Tracking -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18269976114"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18269976114');
      // GA4 Conversion Event Configuration
      gtag('config', 'C_VUjrXbcHzNo', {
        "on": "visible",
        "vars": {
          "event_name": "conversion",
          "send_to": ["AW-18269976114/6yFgCKyx8uQcELLs5odE"]
        }
      });
    </script>
    <script async>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({"gtm.start":new Date().getTime(),event:"gtm.js"});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!="dataLayer"?"&l="+l:"";j.async=true;j.src="https://www.googletagmanager.com/gtm.js?id="+i+dl;f.parentNode.insertBefore(j,f);})(window,document,"script","dataLayer","GTM-P8DZ6MRQ")</script>
  <script src="/scripts/webmcp.js" defer></script>
</head>
  <body class="font-sans text-base antialiased pb-16 md:pb-0" style="scroll-padding-top: 5rem;">
    <!-- Skip link for accessibility -->
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:rounded-lg" aria-label="Skip to main content">Skip to main content</a>
    <Header />
    <GeoBanner client:visible />
    <slot />
    <Footer />
    <MobileStickyBar />
    <FloatingCTA client:idle />
    <Chatbot />
    <script src="/scripts/reveal.js" is:inline defer></script>
    <!-- Analytics Scripts (deferred to end of body for performance) -->
    <script defer>
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "v9dto5m10l");
    </script>
  </body>
</html>