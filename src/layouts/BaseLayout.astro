---
import MobileStickyBar from '../components/MobileStickyBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/globals.css';
import FloatingCTA from '../components/FloatingCTA.tsx';
import Chatbot from '../components/Chatbot.astro';
import GeoBanner from '../components/GeoBanner';

// Define Indian languages and their regions for hreflang
const INDIAN_LANGUAGES = ['en', 'hi', 'bn', 'ta', 'te', 'mr', 'gu', 'kn', 'ml', 'pa'];
const langRegion = {
  'en': 'en-IN',
  'hi': 'hi-IN',
  'bn': 'bn-IN',
  'ta': 'ta-IN',
  'te': 'te-IN',
  'mr': 'mr-IN',
  'gu': 'gu-IN',
  'kn': 'kn-IN',
  'ml': 'ml-IN',
  'pa': 'pa-IN',
};

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  keywords?: string;
  canonical?: string;
  dateModified?: string;
  geoRegion?: string;
  geoPlaceName?: string;
  geoPosition?: string;
  skipDefaultHreflang?: boolean;
  pageLang?: string;   // e.g. "hi-IN", "bn-IN" — defaults to "en-IN"
  ogLocale?: string;   // e.g. "hi_IN", "bn_IN" — defaults to "en_IN"
  pageType?: string;  // e.g. "homepage", "service", "city", "location", "compare", "faq", "blog-index", "search"
}

const pageLocale = Astro.props.ogLocale || 'en_IN';
const pageLangCode = Astro.props.pageLang || 'en-IN';
const pageMetaRegion = Astro.props.geoRegion || 'IN-KA';
const pageMetaPlace = Astro.props.geoPlaceName || 'Bengaluru';
const pageMetaPosition = Astro.props.geoPosition || '13.0159;77.5522';
const pageDescription = Astro.props.description || 'Insurance Support by Hari Kotian provides insurance guidance and claim assistance from Bengaluru.';
const pageOgImage = Astro.props.ogImage || 'https://insurancesupport.online/og-image.png';
const pageNoIndex = Astro.props.noIndex || false;
const pageCanonical = Astro.props.canonical || Astro.url.href;
const pageDateModified = Astro.props.dateModified;
const pageKeywords = Astro.props.keywords;
const pageTitle = Astro.props.title;
const pageSkipDefaultHreflang = Astro.props.skipDefaultHreflang != null ? Astro.props.skipDefaultHreflang : false;

import { PAGE_KEYWORDS } from '../data/page-keywords';

const mergedProps = Astro.props as Props;

// Google typically truncates meta descriptions at ~155 characters (desktop).
// Truncate on a safe word boundary so CTAs/keywords aren't cut mid-word in the SERP.
// The full description is still used inside the page content where applicable.
const META_DESC_MAX = 150;
function truncateDesc(desc) {
  if (!desc) return desc;
  const plain = String(desc);
  if (plain.length <= META_DESC_MAX) return plain;
  const cut = plain.slice(0, META_DESC_MAX);
  const lastSpace = cut.lastIndexOf(' ');
  const trimmed = lastSpace > 60 ? cut.slice(0, lastSpace) : cut;
  return (trimmed.endsWith(',') || trimmed.endsWith(';') || trimmed.endsWith(':') || trimmed.endsWith('.')) ? trimmed.slice(0, -1) : trimmed;
}

const metaDescription = truncateDesc(pageDescription);
const siteName = "Insurance Support";
const siteUrl = "https://insurancesupport.online";
const phoneNumber = "+91-9986634506";
const phoneE164 = "+919986634506";


const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "@id": `${siteUrl}/#organization`,
  "name": siteName,
  "url": siteUrl,
  "logo": `${siteUrl}/logo.png`,
  "sameAs": [
    "https://www.facebook.com/insurancesupport",
    "https://twitter.com/insurancesup",
    "https://www.linkedin.com/company/insurancesupport",
    "https://www.youtube.com/channel/UCXhYJ9c5y6y6y6y6y6y6y6y",
    "https://www.google.com/maps/place/Insurance+Support+Online/@13.0159,77.5522,17z/data=!4m6!3m5!1s0x3bae1670c7b5d5f3:0x8b5e8c5f5c5f5c5f!8m2!3d13.0159!4d77.5544"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": phoneE164,
    "contactType": "customer service",
    "availableLanguage": ["English", "Hindi", "Kannada", "Tamil", "Telugu", "Marathi", "Gujarati", "Malayalam"],
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Bahubali Nagar, Jalahalli, Bengaluru, Karnataka 560013",
    "addressLocality": "Bengaluru",
    "addressRegion": "Karnataka",
    "postalCode": "560013",
    "addressCountry": "IN",
  },
  "areaServed": {
    "@type": "State",
    "name": "Karnataka",
    "url": "https://insurancesupport.online/cities/bengaluru/",
  },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": siteName,
  "alternateName": "Insurance Support Online",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${siteUrl}/search/?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}/about-hari-kotian/#person`,
  "name": "Hari Kotian",
  "givenName": "Hari",
  "familyName": "Kotian",
  "jobTitle": "IRDAI-Registered Insurance Advisor",
  "description": "IRDAI-registered insurance advisor (Reg No: 0149161D) with 25+ years of experience helping families and businesses across India with insurance planning, policy review, and claim support.",
  "url": `${siteUrl}/about-hari-kotian/`,
  "image": `${siteUrl}/images/hari-kotian-profile.jpg`,
  "telephone": phoneE164,
  "email": "hari@insurancesupport.online",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Bahubali Nagar, Jalahalli, Bengaluru, Karnataka 560013",
    "addressLocality": "Bengaluru",
    "addressRegion": "Karnataka",
    "postalCode": "560013",
    "addressCountry": "IN",
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 13.0159,
    "longitude": 77.5522,
  },
  "sameAs": [
    "https://www.facebook.com/harikotian",
    "https://twitter.com/harikotian",
    "https://www.linkedin.com/in/harikotian",
    "https://www.youtube.com/channel/UCXhYJ9c5y6y6y6y6y6y6y6y",
  ],
  "hasCredential": {
    "@type": "Organization",
    "name": "IRDAI",
    "identifier": "0149161D",
    "url": "https://www.irdai.gov.in/",
    "description": "Insurance Regulatory and Development Authority of India - registration number 0149161D"
  },
};

const locationSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${siteUrl}/#local-business`,
  "name": "Insurance Support",
  "description": "Insurance guidance and claim assistance provided by Hari Kotian from Bengaluru.",
  "url": siteUrl,
  "telephone": phoneE164,
  "email": "hari@insurancesupport.online",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Bahubali Nagar, Jalahalli, Bengaluru, Karnataka 560013",
    "addressLocality": "Bengaluru",
    "addressRegion": "Karnataka",
    "postalCode": "560013",
    "addressCountry": "IN",
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 13.0159,
    "longitude": 77.5522,
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
    ],
    "opens": "09:00",
    "closes": "18:00",
  },
  "priceRange": "₹1000 - ₹50000",
  "paymentAccepted": "Cash, Credit Card, Debit Card, Net Banking, UPI",
  "servesCuisine": "Insurance Services",
  "areaServed": {
    "@type": "State",
    "name": "Karnataka",
    "url": "https://insurancesupport.online/cities/bengaluru/"
  }
};

const mergedKeywords = PAGE_KEYWORDS[mergedProps.pageType] ?? [];
const combinedKeywords = mergedKeywords.length > 0 && pageKeywords
  ? [...new Set([...mergedKeywords, ...pageKeywords.split(',').map(k => k.trim()).filter(Boolean)])].join(', ')
  : mergedKeywords.length > 0
    ? mergedKeywords.join(', ')
    : '';
---

<!doctype html>
<html lang={pageLangCode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content="Hari Kotian" />
    <meta name="robots" content={pageNoIndex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={pageCanonical} />
    <link rel="author" href="https://insurancesupport.online/about/" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Insurance Support | Expert Insurance Guides & Tips" href="/rss.xml" />
    <link rel="describedby" type="text/plain" href="/llms.txt" />
    <meta name="geo.region" content={pageMetaRegion} />
    <meta name="geo.placename" content={pageMetaPlace} />
    <meta name="geo.position" content={pageMetaPosition} />
    <meta name="ICBM" content={pageMetaPosition} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={pageOgImage} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={pageLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageCanonical} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={pageOgImage} />
    <meta name="google-site-verification" content="V1MQKb60VcWmP7f4u2x7yN1zR5aJ9bL0kD" />
    <meta name="msvalidate.01" content="551FF3A8CD7B8225D53FAB718B3051E2" />
    {combinedKeywords.length > 0 && <meta name="keywords" content={combinedKeywords} />}
    {pageLangCode !== 'en-IN' && <link rel="alternate" hreflang="en-IN" href={pageCanonical} />}
    {pageLangCode !== 'en-IN' && <link rel="alternate" hreflang="x-default" href={pageCanonical} />}
    {!pageSkipDefaultHreflang && <link rel="alternate" hreflang="en-IN" href={pageCanonical} />}
    {!pageSkipDefaultHreflang && <link rel="alternate" hreflang="x-default" href={pageCanonical} />}
    {INDIAN_LANGUAGES.map((lang: string) => (
      <link rel="alternate" hreflang={langRegion[lang as keyof typeof langRegion] || `${lang}-IN`} href={`https://insurancesupport.online/blog/${lang}/${pageCanonical.split('/').pop() || ''}`} />
    ))}
    {Astro.head}
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(locationSchema)} />
    {pageDateModified && <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "WebPage", "name": pageTitle, "description": pageDescription, "datePublished": pageDateModified, "dateModified": pageDateModified, "url": pageCanonical, "publisher": { "@type": "Organization", "name": siteName, "url": siteUrl } })} />}
  </head>
  <body class="bg-[#0a0a0a] text-white antialiased" data-page={Astro.props.pageType || ''}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:rounded focus:ring-2 focus:ring-offset-2">Skip to main content</a>
    <Header siteUrl={siteUrl} />
    <GeoBanner />
    <slot />
    <MobileStickyBar phoneNumber={phoneNumber} />
    <Footer siteUrl={siteUrl} />
    <FloatingCTA phoneNumber={phoneNumber} />
    <Chatbot />
    <script is:inline>
      // Set up Google Analytics (gtag)
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-XXXXXXX');
    </script>
    <script is:inline src="/scripts/analytics.js" defer></script>
    <script is:inline src="/scripts/reveal.js" defer></script>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  body {
    font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    background: #0a0a0a;
    color: #fff;
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-weight: 700;
    line-height: 1.2;
    color: #fff;
  }
  p {
    color: rgba(255,255,255,0.6);
  }
  a {
    color: #10b981;
    text-decoration: none;
  }
  a:hover {
    color: #0d9f6a;
  }
  code {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.875em;
    background: rgba(255,255,255,0.05);
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    color: rgba(255,255,255,0.8);
  }
  pre {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.875rem;
    background: #000;
    color: #e2e8f0;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    border: 1px solid rgba(255,255,255,0.1);
  }
  img {
    max-width: 100%;
    height: auto;
  }
  *:focus-visible {
    outline: 2px solid #10b981;
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
