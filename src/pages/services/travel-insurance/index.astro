---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TrustStrip from '../../../components/TrustStrip';
import InsuranceCalculator from '../../../components/InsuranceCalculator';
---

<BaseLayout
  title="Travel Insurance in Bangalore | Single/Multi-Trip, Schengen, COVID Cover | Insurance Support"
  description="Compare travel insurance in Bangalore. Single & multi-trip, Schengen-compliant, COVID-19 cover, adventure sports, pre-existing conditions. ICICI Lombard, Bajaj Allianz, HDFC ERGO, Tata AIG, Reliance, Star. IRDAI advisor Insurance Support"
  canonical="https://insurancesupport.online/services/travel-insurance/"
  ogImage="https://insurancesupport.online/images/og/travel-insurance.png"
  pageType="service-detail"
  keywords="travel insurance Bangalore, Schengen visa insurance, multi-trip travel insurance, COVID travel cover, international travel insurance India"
  dateModified="2026-10-22"
  geoPlaceName="Jalahalli, Bengaluru"
  geoPosition="13.0159;77.5522"
  lang="en-IN"
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Travel Insurance Advisory",
    "description": "International & domestic travel insurance. Single trip, multi-trip (annual), Schengen-compliant (€30k min), COVID-19 cover, adventure sports, pre-existing conditions. Cashless at global network. ICICI Lombard, Bajaj Allianz, HDFC ERGO, Tata AIG, Reliance, Star Health, Care Health.",
    "url": "https://insurancesupport.online/services/travel-insurance/",
    "provider": {
      "@type": "Person",
      "name": "Insurance Support",
      "jobTitle": "IRDAI Certified Insurance Advisor",
      "identifier": "0149161D",
      "worksFor": {
        "@type": "Organization",
        "name": "Insurance Support",
        "url": "https://insurancesupport.online"
      }
    },
    "areaServed": {
      "@type": "City",
      "name": "Bengaluru"
    },
    "offers": {
      "@type": "Offer",
      "name": "Travel Insurance Consultation",
      "description": "Free consultation to compare travel plans for your trip",
      "price": "0",
      "priceCurrency": "INR",
      "availability": "https://schema.org/InStock"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is travel insurance mandatory for Schengen visa?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Minimum €30,000 (approx ₹27L) medical cover, valid for all Schengen countries, entire stay duration. Must cover repatriation, emergency evacuation. We provide Schengen-compliant certificate instantly for visa application."
        }
      },
      {
        "@type": "Question",
        "name": "Does travel insurance cover COVID-19?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Most plans now include COVID-19: hospitalization, quarantine extension (hotel cost), trip cancellation if test positive pre-departure, emergency evacuation. Check: some exclude if travel against govt advisory. We confirm COVID coverage before you buy."
        }
      },
      {
        "@type": "Question",
        "name": "What is multi-trip (annual) travel insurance?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Covers unlimited trips in 1 year, each trip max 30/45/60 days (plan dependent). Ideal for frequent flyers (business, family visits). Cheaper than buying single-trip each time. Premium ~₹3,000–8,000/year for ₹50L–1Cr cover."
        }
      },
      {
        "@type": "Question",
        "name": "Are pre-existing conditions covered in travel insurance?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Generally excluded. Some plans offer PED cover (add-on or built-in) for life-threatening emergencies only, with sub-limit (₹1–5L). Requires declaration, may need medical report. We identify plans with best PED terms for your condition."
        }
      },
      {
        "@type": "Question",
        "name": "Can I buy travel insurance after booking tickets?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, anytime before departure. But trip cancellation cover only works if bought within 7–14 days of first booking (varies). For medical-only cover, can buy day of travel. We recommend buying early for maximum benefits."
        }
      }
    ]
  })} />

  <main id="main" class="min-h-screen bg-slate-900 text-white relative overflow-hidden pt-16 pb-24">
    <div class="absolute top-0 right-0 w-96 h-96 bg-emerald-500/10 rounded-full blur-[120px] pointer-events-none" />
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

      <nav class="text-sm text-slate-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-300">Home</a>
        <span class="mx-2">›</span>
        <a href="/services/" class="hover:text-amber-300">Services</a>
        <span class="mx-2">›</span>
        <span class="text-slate-200" aria-current="page">Travel Insurance</span>
      </nav>

      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-400/20 text-emerald-300 text-sm font-semibold mb-4 border border-emerald-400/30">
          Schengen Compliant · COVID Cover · Multi-Trip · Cashless Global
        </span>
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4" style="font-family: 'Plus Jakarta Sans', sans-serif;">
          Travel <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">Insurance</span>
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Travel worry-free with the right coverage. Single trip, annual multi-trip, Schengen visa compliant, COVID-19 included. Cashless hospitalization worldwide. Instant policy & visa letter.
        </p>
      </div>

      <TrustStrip client:visible />

      <section class="mb-12" aria-labelledby="comparison-heading">
        <h2 id="comparison-heading" class="text-2xl font-bold text-center mb-8">Plan Comparison (30-Year-Old, 15-Day Europe Trip, ₹50L Cover)</h2>
        <div class="overflow-x-auto rounded-2xl border border-white/10">
          <table class="w-full min-w-[700px] text-sm text-slate-200">
            <thead class="bg-white/5">
              <tr class="border-b border-white/10">
                <th class="text-left p-4 font-semibold">Insurer / Plan</th>
                <th class="text-left p-4 font-semibold">Premium</th>
                <th class="text-left p-4 font-semibold">Medical Cover</th>
                <th class="text-left p-4 font-semibold">Key Features</th>
                <th class="text-left p-4 font-semibold">Best For</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">ICICI Lombard - iTravel</td><td class="p-4">~₹1,800</td><td class="p-4">₹50L (€55k)</td><td class="p-4">COVID, adventure sports, PED emergency</td><td class="p-4">Comprehensive single trip</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Bajaj Allianz - Travel Companion</td><td class="p-4">~₹1,650</td><td class="p-4">₹50L</td><td class="p-4">Home burglary, missed connection, study interruption</td><td class="p-4">Students, families</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">HDFC ERGO - Travel Shield</td><td class="p-4">~₹1,900</td><td class="p-4">₹50L</td><td class="p-4">Cashless global, 0 deductible, COVID quarantine</td><td class="p-4">Cashless preference</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Tata AIG - Travel Guard</td><td class="p-4">~₹1,600</td><td class="p-4">₹50L</td><td class="p-4">Adventure sports, compassionate visit, bail bond</td><td class="p-4">Adventure travelers</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Reliance - Travel Care</td><td class="p-4">~₹1,450</td><td class="p-4">₹50L</td><td class="p-4">Budget option, basic COVID cover</td><td class="p-4">Cost-conscious</td></tr>
            </tbody>
          </table>
        </div>
        <p class="text-center text-sm text-slate-400 mt-3">Multi-trip annual: ~₹4,500–7,500 for ₹1Cr. <a href="/get-started/" class="text-emerald-300 hover:underline">Get quote for your dates →</a></p>
      </section>

      <section class="mb-16" aria-labelledby="features-heading">
        <h2 id="features-heading" class="text-3xl font-bold text-center mb-10">Coverage Essentials</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            { icon: '🏥', title: 'Medical Emergency', desc: 'Hospitalization, OPD, dental emergency, medical evacuation, repatriation of mortal remains. Cashless at network hospitals.' },
            { icon: '✈️', title: 'Trip Disruption', desc: 'Cancellation, curtailment, delay (>6hr), missed connection, denied boarding. Reimburses non-refundable costs.' },
            { icon: '🧳', title: 'Baggage & Documents', desc: 'Loss/delay of checked baggage, passport loss (replacement cost), laptop/gadget theft (add-on).' },
            { icon: '🛡️', title: 'Special Covers', desc: 'Adventure sports, study interruption, compassionate visit, bail bond, home burglary while away, pet care.' }
          ].map(item => (
            <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
              <div class="text-3xl mb-3">{item.icon}</div>
              <h3 class="text-lg font-bold text-white mb-2">{item.title}</h3>
              <p class="text-slate-300 text-sm">{item.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-16" aria-labelledby="types-heading">
        <h2 id="types-heading" class="text-3xl font-bold text-center mb-10">Types of Travel Insurance</h2>
        <div class="grid md:grid-cols-3 gap-6">
          {[
            { title: 'Single Trip', desc: 'One journey, specific dates. Ideal for vacation, business trip, family visit. Premium by days, destination, age, cover.', best: 'Occasional travelers' },
            { title: 'Multi-Trip (Annual)', desc: 'Unlimited trips in 1 year. Each trip capped (30/45/60 days). Best for frequent flyers. One policy, year-round cover.', best: 'Business travelers, NRIs' },
            { title: 'Student Travel', desc: 'Study abroad: tuition fee protection, sponsor protection, study interruption, compassionate visit. Long duration (1–2 yrs).', best: 'Students going abroad' },
            { title: 'Senior Citizen', desc: 'Age 60–80+. Higher premium, PED emergency cover, companion cover. No medical test up to 70 (some plans).', best: 'Parents visiting abroad' },
            { title: 'Domestic Travel', desc: 'Within India: flight delay, baggage, medical, personal accident. Low cost (~₹200–500). Often free with premium credit cards.', best: 'Frequent domestic flyers' },
            { title: 'Corporate/Group', desc: 'Employees on business travel. Master policy, centralized admin, consolidated billing. Custom limits per designation.', best: 'Companies with travel' }
          ].map(item => (
            <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
              <h3 class="text-lg font-bold text-white mb-2">{item.title}</h3>
              <p class="text-slate-300 text-sm mb-2">{item.desc}</p>
              <span class="text-xs text-emerald-300">Best: {item.best}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-16" aria-labelledby="process-heading">
        <h2 id="process-heading" class="text-3xl font-bold text-center mb-10">How We Help You Get Covered</h2>
        <div class="space-y-6">
          {[
            { step: 1, title: 'Trip Details & Risk Profile', desc: 'Destination(s), dates, activities (skiing, trekking, cruise), age, pre-existing conditions, visa requirements (Schengen, UAE, US, etc.).' },
            { step: 2, title: 'Plan Matching', desc: 'Compare 8+ insurers on: medical limit, COVID terms, PED coverage, adventure sports, cashless network, claim process, premium. Shortlist 3 best-fit.' },
            { step: 3, title: 'Instant Policy & Visa Letter', desc: 'Online payment, instant policy PDF + Schengen visa certificate (if needed). WhatsApp/email delivery. No medical test for most.' },
            { step: 4, title: 'Pre-Trip Briefing', desc: 'Cashless process, emergency numbers (global + India), claim documents checklist, app login, extension procedure if trip extends.' },
            { step: 5, title: 'Claim Support', desc: 'Cashless coordination abroad, reimbursement document check, follow-up with TPA/insurer. We handle timezone/language barriers.' }
          ].map(s => (
            <div class="flex gap-4 bg-white/5 rounded-2xl p-6 border border-white/10">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/20 flex items-center justify-center text-2xl font-bold text-emerald-300 flex-shrink-0">{s.step}</div>
              <div>
                <h3 class="text-lg font-bold text-white mb-1">{s.title}</h3>
                <p class="text-slate-300 text-sm">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-16" aria-labelledby="quote-heading">
        <h2 id="quote-heading" class="text-3xl font-bold text-center mb-10">Get Your Travel Insurance Quote</h2>
        <div class="bg-white/5 backdrop-blur-xl rounded-3xl border border-white/10 shadow-2xl p-6 md:p-8 max-w-xl mx-auto">
          <form id="travelQuoteForm" class="space-y-5">
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="t-trip-type" class="block text-sm font-semibold text-slate-300 mb-2">Trip Type <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <select id="t-trip-type" name="trip_type" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
                  <option value="">Select</option>
                  <option value="single">Single Trip</option>
                  <option value="multi">Multi-Trip (Annual)</option>
                  <option value="student">Student (Long Stay)</option>
                  <option value="senior">Senior Citizen (60+)</option>
                  <option value="domestic">Domestic (Within India)</option>
                </select>
              </div>
              <div>
                <label for="t-destination" class="block text-sm font-semibold text-slate-300 mb-2">Destination Region <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <select id="t-destination" name="destination" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
                  <option value="">Select</option>
                  <option value="schengen">Schengen Europe</option>
                  <option value="usa-canada">USA / Canada</option>
                  <option value="asia-sea">Asia (SE Asia, Japan, Korea)</option>
                  <option value="middle-east">Middle East (UAE, Saudi, Qatar)</option>
                  <option value="australia-nz">Australia / New Zealand</option>
                  <option value="worldwide">Worldwide</option>
                  <option value="india">Domestic India</option>
                </select>
              </div>
            </div>
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="t-days" class="block text-sm font-semibold text-slate-300 mb-2">Trip Duration (Days) <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <input type="number" id="t-days" name="days" min="1" max="365" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="15" />
              </div>
              <div>
                <label for="t-travelers" class="block text-sm font-semibold text-slate-300 mb-2">Travelers <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <select id="t-travelers" name="travelers" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
                  <option value="">Select</option>
                  <option value="1">Solo (1 Adult)</option>
                  <option value="2">Couple (2 Adults)</option>
                  <option value="family">Family (2A+1C/2C)</option>
                  <option value="group">Group (3+ Adults)</option>
                </select>
              </div>
            </div>
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="t-name" class="block text-sm font-semibold text-slate-300 mb-2">Your Name <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <input type="text" id="t-name" name="name" autocomplete="name" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="Full name" />
              </div>
              <div>
                <label for="t-phone" class="block text-sm font-semibold text-slate-300 mb-2">Mobile Number <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <input type="tel" id="t-phone" name="phone" autocomplete="tel" required pattern="[0-9+ -]{10,15}" class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="+91 XXXXX XXXXX" />
              </div>
            </div>
            <div class="flex items-start gap-3">
              <input type="checkbox" id="t-dpdp" name="dpdp_consent" required class="mt-1 w-4 h-4 accent-emerald-500 border-white/20 rounded bg-slate-800 focus:ring-2 focus:ring-emerald-400" />
              <label htmlFor="t-dpdp" class="text-sm text-slate-300">I consent to being contacted per the <a href="/privacy-policy/" class="underline hover:text-emerald-300">Privacy Policy</a> and DPDP Act 2023.</label>
            </div>
            <div class="text-center pt-2">
              <button type="submit" class="w-full md:w-auto px-10 py-4 bg-gradient-to-r from-emerald-400 to-teal-500 hover:from-emerald-500 hover:to-teal-600 text-white font-bold rounded-xl text-lg shadow-xl shadow-emerald-500/20 transition-all hover:scale-[1.02]">
                Get Instant Quote & Policy
              </button>
            </div>
            <div id="t-error" class="hidden rounded-xl border border-red-400/40 bg-red-500/10 p-4 text-center text-red-200" role="alert"></div>
          </form>
        </div>
      </section>

      <InsuranceCalculator client:load />
    </div>
  </main>
</BaseLayout>

<script is:inline>
  document.getElementById('travelQuoteForm')?.addEventListener('submit', async function (event) {
    event.preventDefault();
    const form = this;
    const button = form.querySelector('button[type="submit"]');
    const error = document.getElementById('t-error');
    const originalLabel = button.textContent;
    error.classList.add('hidden');
    button.disabled = true;
    button.textContent = 'Sending request...';

    try {
      const values = new FormData(form);
      const response = await fetch('/contact-submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: values.get('name'),
          phone: values.get('phone'),
          category: 'Travel Insurance',
          message: `Travel: ${values.get('trip_type')}, ${values.get('destination')}, ${values.get('days')} days, ${values.get('travelers')}`,
        }),
      });
      const result = await response.json();
      if (!response.ok || !result.success) {
        throw new Error(result.error || 'We could not send your request. Please try again or call us directly.');
      }
      alert('Thank you! We will send you travel insurance options within 4 hours.');
      form.reset();
    } catch (submissionError) {
      error.textContent = submissionError.message || 'We could not send your request. Please try again or call us directly.';
      error.classList.remove('hidden');
    } finally {
      button.disabled = false;
      button.textContent = originalLabel;
    }
  });
</script>