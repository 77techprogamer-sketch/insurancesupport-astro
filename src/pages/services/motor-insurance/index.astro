---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TrustStrip from '../../../components/TrustStrip';
import InsuranceCalculator from '../../../components/InsuranceCalculator';
---

<BaseLayout
  title="Motor Insurance in Bangalore | Car & Two-Wheeler | Zero Dep, Engine Protect | Insurance Support"
  description="Compare motor insurance in Bangalore. Car & two-wheeler. Zero Depreciation, Engine Protect, Return to Invoice, Consumables. Cashless at 5,000+ garages. ICICI Lombard, Bajaj Allianz, HDFC ERGO, Tata AIG. IRDAI advisor Insurance Support"
  canonical="https://insurancesupport.online/services/motor-insurance/"
  ogImage="https://insurancesupport.online/images/og/motor-insurance.png"
  pageType="service-detail"
  keywords="car insurance Bangalore, bike insurance, zero depreciation cover, engine protect add-on, return to invoice, cashless garage network"
  dateModified="2026-10-22"
  geoPlaceName="Jalahalli, Bengaluru"
  geoPosition="13.0159;77.5522"
  lang="en-IN"
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Motor Insurance Advisory",
    "description": "Car & two-wheeler insurance with essential add-ons. Zero Depreciation, Engine Protect, Return to Invoice, Consumables, Key Protect. Cashless at 5,000+ garages. ICICI Lombard, Bajaj Allianz, HDFC ERGO, Tata AIG, Reliance, Royal Sundaram.",
    "url": "https://insurancesupport.online/services/motor-insurance/",
    "provider": {
      "@type": "Person",
      "name": "Insurance Support",
      "jobTitle": "IRDAI Certified Insurance Advisor",
      "identifier": "0149161D",
      "worksFor": {
        "@type": "Organization",
        "name": "Insurance Support",
        "url": "https://insurancesupport.online"
      }
    },
    "areaServed": {
      "@type": "City",
      "name": "Bengaluru"
    },
    "offers": {
      "@type": "Offer",
      "name": "Motor Insurance Consultation",
      "description": "Free consultation to compare car/bike insurance with right add-ons",
      "price": "0",
      "priceCurrency": "INR",
      "availability": "https://schema.org/InStock"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is Zero Depreciation add-on worth it for a 5-year-old car?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Zero Dep is typically available up to 5 years (some insurers up to 7). For a 5-year-old car, it covers plastic/rubber parts at 100% (vs 50% without). Worth it if car value >₹5L and you drive in high-risk areas. Premium ~15–20% higher."
        }
      },
      {
        "@type": "Question",
        "name": "What does Engine Protect cover?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Covers engine damage due to water ingress (hydrostatic lock), oil leakage, gearbox damage — not covered in standard policy. Essential for flood-prone areas (Bangalore monsoon). Cost: ~₹1,000–2,500/year. Must buy with comprehensive policy."
        }
      },
      {
        "@type": "Question",
        "name": "What is Return to Invoice (RTI) add-on?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "On total loss/theft, pays original invoice price (including registration, road tax) instead of depreciated IDV. Available for new cars up to 3 years. Critical for new cars — IDV drops 10–15% yearly. Cost: ~₹500–1,500/year."
        }
      },
      {
        "@type": "Question",
        "name": "How does NCB (No Claim Bonus) work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Discount on own-damage premium for claim-free years: 20% (1yr), 25% (2yr), 35% (3yr), 45% (4yr), 50% (5yr). NCB transfers to new car/insurer. NCB Protect add-on retains NCB after 1 claim. Belongs to owner, not car."
        }
      },
      {
        "@type": "Question",
        "name": "Should I renew with same insurer or switch?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Compare premium, add-ons, cashless garage network, claim experience. NCB transfers. New insurer may offer lower premium for same cover. We compare 8+ insurers at renewal. Don't auto-renew — 20–30% savings possible."
        }
      }
    ]
  })} />

  <main id="main" class="min-h-screen bg-slate-900 text-white relative overflow-hidden pt-16 pb-24">
    <div class="absolute top-0 right-0 w-96 h-96 bg-emerald-500/10 rounded-full blur-[120px] pointer-events-none" />
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

      <nav class="text-sm text-slate-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-300">Home</a>
        <span class="mx-2">›</span>
        <a href="/services/" class="hover:text-amber-300">Services</a>
        <span class="mx-2">›</span>
        <span class="text-slate-200" aria-current="page">Motor Insurance</span>
      </nav>

      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-400/20 text-emerald-300 text-sm font-semibold mb-4 border border-emerald-400/30">
          5,000+ Cashless Garages · Zero Dep · Engine Protect · RTI
        </span>
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4" style="font-family: 'Plus Jakarta Sans', sans-serif;">
          Motor Insurance <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">Plans</span>
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Comprehensive car & two-wheeler coverage with the right add-ons. Zero Dep, Engine Protect, Return to Invoice — pay only for what you need. Cashless claims at 5,000+ network garages.
        </p>
      </div>

      <TrustStrip client:visible />

      <section class="mb-12" aria-labelledby="comparison-heading">
        <h2 id="comparison-heading" class="text-2xl font-bold text-center mb-8">Essential Add-ons — What You Actually Need</h2>
        <div class="overflow-x-auto rounded-2xl border border-white/10">
          <table class="w-full min-w-[700px] text-sm text-slate-200">
            <thead class="bg-white/5">
              <tr class="border-b border-white/10">
                <th class="text-left p-4 font-semibold">Add-on</th>
                <th class="text-left p-4 font-semibold">What It Covers</th>
                <th class="text-left p-4 font-semibold">Best For</th>
                <th class="text-left p-4 font-semibold">Approx. Cost</th>
                <th class="text-left p-4 font-semibold">Age Limit</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Zero Depreciation</td><td class="p-4">100% parts (plastic/rubber/glass) without depreciation deduction</td><td class="p-4">Cars <5 yrs, high-value</td><td class="p-4">15–20% of OD premium</td><td class="p-4">5–7 years</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Engine Protect</td><td class="p-4">Hydrostatic lock, oil leak, gearbox damage</td><td class="p-4">Flood-prone areas, monsoon</td><td class="p-4">₹1,000–2,500</td><td class="p-4">5 years</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Return to Invoice</td><td class="p-4">Invoice price (incl. tax/reg) on total loss/theft</td><td class="p-4">New cars <3 yrs</td><td class="p-4">₹500–1,500</td><td class="p-4">3 years</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Consumables</td><td class="p-4">Nuts, bolts, oil, coolant, filters, AC gas</td><td class="p-4">All comprehensive policies</td><td class="p-4">₹300–800</td><td class="p-4">5–7 years</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Key Protect</td><td class="p-4">Key replacement (smart key ~₹5k–15k)</td><td class="p-4">Cars with smart keys</td><td class="p-4">₹200–500</td><td class="p-4">3–5 years</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">NCB Protect</td><td class="p-4">Retain NCB after 1 claim</td><td class="p-4">High NCB (45–50%) owners</td><td class="p-4">₹300–800</td><td class="p-4">Any age</td></tr>
            </tbody>
          </table>
        </div>
        <p class="text-center text-sm text-slate-400 mt-3">Add-on availability varies by insurer. <a href="/get-started/" class="text-emerald-300 hover:underline">Get personalized recommendation →</a></p>
      </section>

      <section class="mb-16" aria-labelledby="insurer-heading">
        <h2 id="insurer-heading" class="text-3xl font-bold text-center mb-10">Top Insurers Comparison (₹10L IDV Sedan, 3yrs, Bangalore)</h2>
        <div class="overflow-x-auto rounded-2xl border border-white/10">
          <table class="w-full min-w-[700px] text-sm text-slate-200">
            <thead class="bg-white/5">
              <tr class="border-b border-white/10">
                <th class="text-left p-4 font-semibold">Insurer</th>
                <th class="text-left p-4 font-semibold">Base Premium</th>
                <th class="text-left p-4 font-semibold">With Zero Dep + Engine</th>
                <th class="text-left p-4 font-semibold">Cashless Garages (BLR)</th>
                <th class="text-left p-4 font-semibold">CSR (2023-24)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">ICICI Lombard</td><td class="p-4">~₹12,500</td><td class="p-4">~₹18,200</td><td class="p-4">450+</td><td class="p-4">93.5%</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Bajaj Allianz</td><td class="p-4">~₹11,800</td><td class="p-4">~₹17,500</td><td class="p-4">400+</td><td class="p-4">92.8%</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">HDFC ERGO</td><td class="p-4">~₹13,200</td><td class="p-4">~₹19,000</td><td class="p-4">380+</td><td class="p-4">91.2%</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Tata AIG</td><td class="p-4">~₹11,500</td><td class="p-4">~₹16,800</td><td class="p-4">350+</td><td class="p-4">90.5%</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Royal Sundaram</td><td class="p-4">~₹11,000</td><td class="p-4">~₹16,200</td><td class="p-4">300+</td><td class="p-4">89.7%</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="mb-16" aria-labelledby="process-heading">
        <h2 id="process-heading" class="text-3xl font-bold text-center mb-10">How We Help You Get the Right Motor Policy</h2>
        <div class="space-y-6">
          {[
            { step: 1, title: 'Vehicle & Usage Profile', desc: 'Car/bike details, age, variant, usage (personal/commercial), parking, flood risk, driver profile. Determines base IDV and must-have add-ons.' },
            { step: 2, title: 'Add-on Optimization', desc: 'Recommend only value-adding covers: Zero Dep (<5yr), Engine Protect (flood zones), RTI (new car), Consumables (all). Skip: PA cover (standalone cheaper), Roadside (often free).' },
            { step: 3, title: 'Insurer Shortlisting', desc: 'Compare 8+ insurers on premium, garage network near you, claim settlement ratio, digital claim process, NCB protection terms.' },
            { step: 4, title: 'Policy Issuance', desc: 'Instant policy via email/WhatsApp. Digital inspection (self-video) for renewals. RC copy, previous policy, KYC — we handle documentation.' },
            { step: 5, title: 'Claim Assistance', desc: 'Cashless coordination: surveyor follow-up, garage negotiation, document check. Reimbursement: estimate validation, bill scrutiny, faster settlement.' }
          ].map(s => (
            <div class="flex gap-4 bg-white/5 rounded-2xl p-6 border border-white/10">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/20 flex items-center justify-center text-2xl font-bold text-emerald-300 flex-shrink-0">{s.step}</div>
              <div>
                <h3 class="text-lg font-bold text-white mb-1">{s.title}</h3>
                <p class="text-slate-300 text-sm">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-16" aria-labelledby="quote-heading">
        <h2 id="quote-heading" class="text-3xl font-bold text-center mb-10">Get Your Motor Insurance Quote</h2>
        <div class="bg-white/5 backdrop-blur-xl rounded-3xl border border-white/10 shadow-2xl p-6 md:p-8 max-w-xl mx-auto">
          <form id="motorQuoteForm" class="space-y-5">
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="m-vehicle" class="block text-sm font-semibold text-slate-300 mb-2">Vehicle Type <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <select id="m-vehicle" name="vehicle_type" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
                  <option value="">Select</option>
                  <option value="car">Car (Private)</option>
                  <option value="bike">Two-Wheeler</option>
                  <option value="commercial">Commercial Vehicle</option>
                </select>
              </div>
              <div>
                <label for="m-age" class="block text-sm font-semibold text-slate-300 mb-2">Vehicle Age <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <select id="m-age" name="vehicle_age" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
                  <option value="">Select</option>
                  <option value="new">Brand New</option>
                  <option value="1-3">1–3 Years</option>
                  <option value="3-5">3–5 Years</option>
                  <option value="5-7">5–7 Years</option>
                  <option value="7+">7+ Years</option>
                </select>
              </div>
            </div>
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="m-make" class="block text-sm font-semibold text-slate-300 mb-2">Make & Model <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <input type="text" id="m-make" name="make_model" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="e.g., Honda City V, Hyundai Creta SX" />
              </div>
              <div>
                <label for="m-rto" class="block text-sm font-semibold text-slate-300 mb-2">RTO Location <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <select id="m-rto" name="rto" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
                  <option value="">Select</option>
                  <option value="KA-01">KA-01 (Koramangala)</option>
                  <option value="KA-02">KA-02 (Rajajinagar)</option>
                  <option value="KA-03">KA-03 (Indiranagar)</option>
                  <option value="KA-04">KA-04 (Yeshwanthpur)</option>
                  <option value="KA-05">KA-05 (Jayanagar)</option>
                  <option value="KA-53">KA-53 (Electronic City)</option>
                  <option value="other">Other Karnataka RTO</option>
                </select>
              </div>
            </div>
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="m-name" class="block text-sm font-semibold text-slate-300 mb-2">Your Name <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <input type="text" id="m-name" name="name" autocomplete="name" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="Full name" />
              </div>
              <div>
                <label for="m-phone" class="block text-sm font-semibold text-slate-300 mb-2">Mobile Number <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <input type="tel" id="m-phone" name="phone" autocomplete="tel" required pattern="[0-9+ -]{10,15}" class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="+91 XXXXX XXXXX" />
              </div>
            </div>
            <div class="flex items-start gap-3">
              <input type="checkbox" id="m-dpdp" name="dpdp_consent" required class="mt-1 w-4 h-4 accent-emerald-500 border-white/20 rounded bg-slate-800 focus:ring-2 focus:ring-emerald-400" />
              <label htmlFor="m-dpdp" class="text-sm text-slate-300">I consent to being contacted per the <a href="/privacy-policy/" class="underline hover:text-emerald-300">Privacy Policy</a> and DPDP Act 2023.</label>
            </div>
            <div class="text-center pt-2">
              <button type="submit" class="w-full md:w-auto px-10 py-4 bg-gradient-to-r from-emerald-400 to-teal-500 hover:from-emerald-500 hover:to-teal-600 text-white font-bold rounded-xl text-lg shadow-xl shadow-emerald-500/20 transition-all hover:scale-[1.02]">
                Get Free Quote & Comparison
              </button>
            </div>
            <div id="m-error" class="hidden rounded-xl border border-red-400/40 bg-red-500/10 p-4 text-center text-red-200" role="alert"></div>
          </form>
        </div>
      </section>

      <InsuranceCalculator client:load />
    </div>
  </main>
</BaseLayout>

<script is:inline>
  document.getElementById('motorQuoteForm')?.addEventListener('submit', async function (event) {
    event.preventDefault();
    const form = this;
    const button = form.querySelector('button[type="submit"]');
    const error = document.getElementById('m-error');
    const originalLabel = button.textContent;
    error.classList.add('hidden');
    button.disabled = true;
    button.textContent = 'Sending request...';

    try {
      const values = new FormData(form);
      const response = await fetch('/contact-submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: values.get('name'),
          phone: values.get('phone'),
          category: 'Motor Insurance',
          message: `Motor: ${values.get('vehicle_type')}, Age ${values.get('vehicle_age')}, ${values.get('make_model')}, RTO ${values.get('rto')}`,
        }),
      });
      const result = await response.json();
      if (!response.ok || !result.success) {
        throw new Error(result.error || 'We could not send your request. Please try again or call us directly.');
      }
      alert('Thank you! We will send you a personalized motor insurance comparison within 4 hours.');
      form.reset();
    } catch (submissionError) {
      error.textContent = submissionError.message || 'We could not send your request. Please try again or call us directly.';
      error.classList.remove('hidden');
    } finally {
      button.disabled = false;
      button.textContent = originalLabel;
    }
  });
</script>