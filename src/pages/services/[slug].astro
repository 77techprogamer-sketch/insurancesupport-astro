---
import BaseLayout from "../../layouts/BaseLayout.astro";
import services from "../../data/services.json";
import FAQPageJsonLd from "../../components/FAQPageJsonLd.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";


export async function getStaticPaths() {
  return services.map(s => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const service = services.find(s => s.slug === slug);
if (!service) {
  throw new Error('Service not found');
}

const serviceUrl = `https://insurancesupport.online/services/${slug}/`;
---

<BaseLayout title={`${service.title} in Bengaluru | Insurance Support`} description={service.desc}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    name: `${service.title} in Bengaluru`,
    serviceType: service.title, // Add serviceType
    description: service.desc,
    provider: {
      "@type": "LocalBusiness",
      name: "Insurance Support",
      url: "https://insurancesupport.online",
      telephone: "+91-9986634506", // Corrected phone number
      address: {
        "@type": "PostalAddress",
        addressLocality: "Bengaluru",
        addressRegion: "KA",
        addressCountry: "IN"
      }
    },
    areaServed: "Bengaluru, Karnataka, India",
    url: serviceUrl
  })} />
  
  <Breadcrumbs currentPage={service.title} />

  <main id="main" class="page-transition">
    <div class="max-w-4xl mx-auto px-4 py-16">
      <h1 class="text-4xl font-bold mb-4">{service.title} in Bengaluru</h1>
      <p class="text-lg text-slate-600 mb-12">{service.desc}</p>

      {service.content && (
        <div class="prose prose-lg max-w-none mb-12" set:html={service.content.replace(/\n/g, '<br/>')} />
      )}

      {service.benefits && service.benefits.length > 0 && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-slate-900 mb-6">Why Choose Our {service.title} Service</h2>
          <ul class="space-y-3">
            {service.benefits.map(benefit => (
              <li class="flex items-start gap-3 text-slate-600 leading-relaxed">
                <span class="text-emerald-500 mt-1">✓</span>
                <span>{benefit}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {service.faqs && service.faqs.length > 0 && (
        <>
          <FAQPageJsonLd questions={service.faqs} />
          <section class="mt-12">
            <h2 class="text-2xl font-bold text-slate-900 mb-6">Frequently Asked Questions</h2>
            <div class="space-y-3">
              {service.faqs.map(faq => (
                <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
                  <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors">
                    <span class="font-semibold text-slate-900 pr-4">{faq.question}</span>
                    <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </summary>
                  <div class="px-5 pb-5">
                    <p class="text-slate-600 leading-relaxed">{faq.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        </>
      )}

      <!-- CTA -->
      <section class="mt-16 bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 rounded-3xl p-8 md:p-12 text-center text-white relative overflow-hidden shadow-2xl">
        <div class="absolute -top-10 -right-10 w-48 h-48 bg-amber-400/10 rounded-full blur-2xl" />
        <div class="absolute -bottom-10 -left-10 w-48 h-48 bg-blue-500/20 rounded-full blur-2xl" />

        <div class="relative z-10 max-w-2xl mx-auto">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-400/20 text-amber-300 text-sm font-semibold mb-4 border border-amber-400/30">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            Instant Expert Help
          </span>
          <h2 class="text-3xl font-extrabold mb-4">Need Expert Guidance on {service.title}?</h2>
          <p class="text-blue-100/80 mb-8 leading-relaxed">
            Free consultation with Hari Kotian, IRDAI certified advisor (Reg No: 0149161D) with 25+ years experience. No pressure, just honest advice and proven claim recovery support.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4">
            <a href="https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20I%20need%20help%20with%20{encodeURIComponent(service.title)}." target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-600 hover:to-green-700 text-white font-bold rounded-full text-lg shadow-xl shadow-emerald-500/25 hover:scale-105 transition-all">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Chat on WhatsApp
            </a>
            <a href="tel:+919986634506" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-500 hover:to-amber-600 text-slate-900 font-bold rounded-full text-lg shadow-xl shadow-amber-500/25 hover:scale-105 transition-all">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              Call +91-99866 34506
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

</BaseLayout>