---
import BaseLayout from "../../layouts/BaseLayout.astro";
import services from "../../data/services.json";
import FAQPageJsonLd from "../../components/FAQPageJsonLd.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  return services.map(s => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const service = services.find(s => s.slug === slug);
if (!service) {
  throw new Error('Service not found');
}

const serviceUrl = `https://insurancesupport.online/services/${slug}`;
---

<BaseLayout title={`${service.title} in Bengaluru | Insurance Support`} description={service.desc}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    name: `${service.title} in Bengaluru`,
    serviceType: service.title, // Add serviceType
    description: service.desc,
    provider: {
      "@type": "LocalBusiness",
      name: "Insurance Support",
      url: "https://insurancesupport.online",
      telephone: "+91-9986634506", // Corrected phone number
      address: {
        "@type": "PostalAddress",
        addressLocality: "Bengaluru",
        addressRegion: "KA",
        addressCountry: "IN"
      }
    },
    areaServed: "Bengaluru, Karnataka, India",
    url: serviceUrl
  })} />
  
  <Breadcrumbs currentPage={service.title} />
  <Header />

  <main class="page-transition">
    <div class="max-w-4xl mx-auto px-4 py-16">
      <h1 class="text-4xl font-bold mb-4">{service.title} in Bengaluru</h1>
      <p class="text-lg text-slate-600 mb-12">{service.desc}</p>

      {service.faqs && service.faqs.length > 0 && (
        <>
          <FAQPageJsonLd questions={service.faqs} />
          <section class="mt-12">
            <h2 class="text-2xl font-bold text-slate-900 mb-6">Frequently Asked Questions</h2>
            <div class="space-y-3">
              {service.faqs.map(faq => (
                <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
                  <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors">
                    <span class="font-semibold text-slate-900 pr-4">{faq.question}</span>
                    <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </summary>
                  <div class="px-5 pb-5">
                    <p class="text-slate-600 leading-relaxed">{faq.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        </>
      )}

      <!-- CTA -->
      <section class="mt-16 bg-gradient-to-br from-slate-50 to-blue-50/50 rounded-2xl p-8 border border-slate-100 text-center">
        <h2 class="text-2xl font-extrabold text-slate-900 mb-3">Need help with {service.title}?</h2>
        <p class="text-slate-600 mb-6">Get a free consultation with Hari Kotian, IRDAI certified advisor with 25+ years of experience.</p>
        <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-900 font-bold rounded-full text-lg shadow-lg shadow-amber-500/25 hover:shadow-xl hover:scale-105 transition-all btn-glow">
          Book Free Consultation
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>