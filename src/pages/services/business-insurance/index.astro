---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TrustStrip from '../../../components/TrustStrip';
import InsuranceCalculator from '../../../components/InsuranceCalculator';
---

<BaseLayout
  title="Business Insurance in Bangalore | Fire, Marine, Liability, Cyber, Group Health | Up to ₹500Cr | Insurance Support"
  description="Business insurance in Bangalore. Fire & burglary, marine cargo, liability (public/product/professional), cyber, group health, keyman, workmen's compensation. SME to enterprise. ICICI Lombard, Bajaj Allianz, HDFC ERGO, Tata AIG, New India, National, Oriental, United India. IRDAI advisor Insurance Support"
  canonical="https://insurancesupport.online/services/business-insurance/"
  ogImage="https://insurancesupport.online/images/og/business-insurance.png"
  pageType="service-detail"
  keywords="business insurance Bangalore, fire insurance, marine cargo insurance, liability insurance, cyber insurance, group health insurance, keyman insurance India"
  dateModified="2026-10-22"
  geoPlaceName="Jalahalli, Bengaluru"
  geoPosition="13.0159;77.5522"
  lang="en-IN"
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Business Insurance Advisory",
    "description": "Commercial insurance for SMEs & enterprises. Fire & burglary (SFSP), marine cargo, liability (public, product, professional, D&O), cyber, group health, keyman, workmen's compensation, money insurance. Limit up to ₹500Cr. ICICI Lombard, Bajaj Allianz, HDFC ERGO, Tata AIG, New India, National, Oriental, United India.",
    "url": "https://insurancesupport.online/services/business-insurance/",
    "provider": {
      "@type": "Person",
      "name": "Insurance Support",
      "jobTitle": "IRDAI Certified Insurance Advisor",
      "identifier": "0149161D",
      "worksFor": {
        "@type": "Organization",
        "name": "Insurance Support",
        "url": "https://insurancesupport.online"
      }
    },
    "areaServed": {
      "@type": "City",
      "name": "Bengaluru"
    },
    "offers": {
      "@type": "Offer",
      "name": "Business Insurance Consultation",
      "description": "Free risk assessment and policy comparison for your business",
      "price": "0",
      "priceCurrency": "INR",
      "availability": "https://schema.org/InStock"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is SFSP policy in fire insurance?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Standard Fire & Special Perils Policy. Covers fire, lightning, explosion, aircraft damage, riot/strike, storm/cyclone/flood, impact, subsidence/landslide, bush fire. Add-ons: earthquake, terrorism, STFI (storm, tempest, flood, inundation), escalation clause, rent/alternative accommodation."
        }
      },
      {
        "@type": "Question",
        "name": "Is cyber insurance necessary for Indian businesses?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Increasingly yes. RBI mandates for NBFCs, payment operators. SEBI for listed companies. CERT-In reporting obligations. Average breach cost in India: ₹17Cr (IBM 2023). Cyber policy covers: data breach response, ransomware, business interruption, regulatory fines, third-party liability, cyber extortion."
        }
      },
      {
        "@type": "Question",
        "name": "What is keyman insurance and who needs it?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Life/health cover on key person whose loss would financially hurt the business. Company pays premium, is beneficiary. Used for: founders, top sales, specialized talent. Sum assured = 5–10x annual contribution or replacement cost. Tax-deductible premium (business expense). Proceeds tax-free for company."
        }
      },
      {
        "@type": "Question",
        "name": "Difference between public liability and professional indemnity?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Public Liability: bodily injury/property damage to third party from your premises/operations (slip-fall, product injury). Professional Indemnity: financial loss from professional error/omission (bad advice, design flaw, audit miss). Many businesses need BOTH. D&O covers directors' personal liability."
        }
      },
      {
        "@type": "Question",
        "name": "What is workmen's compensation mandatory limit?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Mandatory under Workmen's Compensation Act 1923 for employers. Covers death, permanent/temporary disablement, occupational diseases. No upper limit for death/permanent disablement (formula-based). Policy premium ~₹500–2000/employee/year. Separate from ESI (which is for <₹21k salary)."
        }
      }
    ]
  })} />

  <main id="main" class="min-h-screen bg-slate-900 text-white relative overflow-hidden pt-16 pb-24">
    <div class="absolute top-0 right-0 w-96 h-96 bg-emerald-500/10 rounded-full blur-[120px] pointer-events-none" />
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

      <nav class="text-sm text-slate-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-300">Home</a>
        <span class="mx-2">›</span>
        <a href="/services/" class="hover:text-amber-300">Services</a>
        <span class="mx-2">›</span>
        <span class="text-slate-200" aria-current="page">Business Insurance</span>
      </nav>

      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-400/20 text-emerald-300 text-sm font-semibold mb-4 border border-emerald-400/30">
          Fire · Marine · Liability · Cyber · Group Health · Keyman · WC
        </span>
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4" style="font-family: 'Plus Jakarta Sans', sans-serif;">
          Business <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">Insurance</span>
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Complete commercial risk protection for SMEs to enterprises. Fire, marine, liability, cyber, group health, keyman, workmen's compensation. Customized programs up to ₹500Cr. 8 insurers compared.
        </p>
      </div>

      <TrustStrip client:visible />

      <section class="mb-12" aria-labelledby="covers-heading">
        <h2 id="covers-heading" class="text-2xl font-bold text-center mb-8">Core Business Insurance Covers</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            { icon: '🔥', title: 'Fire & Burglary (SFSP)', desc: 'Building, plant, machinery, stock. Fire, flood, earthquake, terrorism, riot. Burglary add-on. Reinstatement value basis. Business interruption (loss of profit) optional.' },
            { icon: '🚢', title: 'Marine Cargo', desc: 'Transit by sea/air/road/rail. Institute Cargo Clauses A/B/C. Warehouse-to-warehouse. Open policy for regular shipments. War & SRCC extension.' },
            { icon: '⚖️', title: 'Liability Suite', desc: 'Public, Product, Professional, D&O, Employment Practices, Cyber. Defense costs inclusive. Retroactive date. Run-off for D&O. Limits ₹1–500Cr.' },
            { icon: '🔒', title: 'Cyber Insurance', desc: 'Data breach, ransomware, business interruption, regulatory fines, media liability, cyber extortion. Incident response team. RBI/SEBI compliance.' },
            { icon: '👥', title: 'Group Health', desc: 'Employees + dependents. Cashless network. Maternity, OPD, wellness. Top-up/super top-up. Portability. Claims support. Cost sharing options.' },
            { icon: '🔑', title: 'Keyman Insurance', desc: 'Life/health on critical talent. Company-owned, company-beneficiary. Tax-deductible premium. Succession funding. Loan security for banks.' },
            { icon: '💰', title: 'Money Insurance', desc: 'Cash in transit, in safe, in counter. Fidelity guarantee (employee dishonesty). ATM cash. Bank indemnity for lost instruments.' },
            { icon: '🏭', title: 'Workmen\'s Compensation', desc: 'Statutory liability for employee injury/death. Occupational diseases. No-fault. Separate from ESI. Contractor/subcontractor extension.' }
          ].map(item => (
            <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
              <div class="text-3xl mb-3">{item.icon}</div>
              <h3 class="text-lg font-bold text-white mb-2">{item.title}</h3>
              <p class="text-slate-300 text-sm">{item.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-16" aria-labelledby="industry-heading">
        <h2 id="industry-heading" class="text-3xl font-bold text-center mb-10">Industry-Specific Programs</h2>
        <div class="overflow-x-auto rounded-2xl border border-white/10">
          <table class="w-full min-w-[800px] text-sm text-slate-200">
            <thead class="bg-white/5">
              <tr class="border-b border-white/10">
                <th class="text-left p-4 font-semibold">Industry</th>
                <th class="text-left p-4 font-semibold">Critical Covers</th>
                <th class="text-left p-4 font-semibold">Special Considerations</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Manufacturing</td><td class="p-4">Fire, machinery breakdown, product liability, marine, WC</td><td class="p-4">Machinery breakdown, product recall, contamination, export credit</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">IT / Software / SaaS</td><td class="p-4">Cyber, professional indemnity, D&O, group health</td><td class="p-4">IP infringement, data privacy, global clients, contract limits</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Construction / Real Estate</td><td class="p-4">CAR/EAR, public liability, professional indemnity, WC</td><td class="p-4">Contractors all risk, erection all risk, delay in start-up</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Healthcare / Hospitals</td><td class="p-4">Professional indemnity, public liability, cyber, fire</td><td class="p-4">Medical malpractice, patient data, equipment breakdown</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Trading / Retail / E-commerce</td><td class="p-4">Fire, burglary, money, transit, cyber, product liability</td><td class="p-4">Stock fluctuation, seasonal increase, warehouse legal liability</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Financial Services</td><td class="p-4">D&O, professional indemnity, cyber, crime, fidelity</td><td class="p-4">RBI/SEBI mandate, regulatory defense, fines & penalties</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Hospitality / Hotels</td><td class="p-4">Fire, public liability, food contamination, cyber, money</td><td class="p-4">Guest property, liquor liability, business interruption</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Education Institutions</td><td class="p-4">Fire, public liability, professional indemnity, student safety</td><td class="p-4">Molestation cover, school bus, lab equipment, trip cover</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="mb-16" aria-labelledby="process-heading">
        <h2 id="process-heading" class="text-3xl font-bold text-center mb-10">How We Build Your Business Insurance Program</h2>
        <div class="space-y-6">
          {[
            { step: 1, title: 'Risk Survey & Gap Analysis', desc: 'Site visit (virtual/physical), asset register review, contract review, regulatory check, current policy audit, claims history, key person identification.' },
            { step: 2, title: 'Program Architecture', desc: 'Layered approach: primary (fire, marine, liability), excess/umbrella, specialty (cyber, D&O, crime). Optimize deductibles, coinsurance, sub-limits. Avoid overlaps/gaps.' },
            { step: 3, title: 'Market Placement', desc: 'Approach 8+ insurers. Leverage volume for pricing. Negotiate wordings: remove restrictive clauses, add extensions. Master policy for multi-location.' },
            { step: 4, title: 'Policy Administration', desc: 'Digital policy repository, endorsement management, premium allocation by unit, claims intimation SOP, vendor/TPA coordination, renewal calendar.' },
            { step: 5, title: 'Claims & Renewal Management', desc: 'Claim notification within 24hrs. Surveyor coordination. Document checklist. Settlement tracking. Renewal: exposure update, market check, restructuring.' }
          ].map(s => (
            <div class="flex gap-4 bg-white/5 rounded-2xl p-6 border border-white/10">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/20 flex items-center justify-center text-2xl font-bold text-emerald-300 flex-shrink-0">{s.step}</div>
              <div>
                <h3 class="text-lg font-bold text-white mb-1">{s.title}</h3>
                <p class="text-slate-300 text-sm">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-16" aria-labelledby="quote-heading">
        <h2 id="quote-heading" class="text-3xl font-bold text-center mb-10">Get Your Business Insurance Assessment</h2>
        <div class="bg-white/5 backdrop-blur-xl rounded-3xl border border-white/10 shadow-2xl p-6 md:p-8 max-w-xl mx-auto">
          <form id="bizQuoteForm" class="space-y-5">
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="biz-industry" class="block text-sm font-semibold text-slate-300 mb-2">Industry <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <select id="biz-industry" name="industry" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
                  <option value="">Select</option>
                  <option value="manufacturing">Manufacturing</option>
                  <option value="it-software">IT / Software / SaaS</option>
                  <option value="construction">Construction / Real Estate</option>
                  <option value="healthcare">Healthcare / Hospital</option>
                  <option value="trading-retail">Trading / Retail / E-commerce</option>
                  <option value="financial">Financial Services</option>
                  <option value="hospitality">Hospitality / Hotel</option>
                  <option value="education">Education Institution</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div>
                <label for="biz-size" class="block text-sm font-semibold text-slate-300 mb-2">Business Size <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <select id="biz-size" name="size" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
                  <option value="">Select</option>
                  <option value="startup">Startup (<10 employees)</option>
                  <option value="sme">SME (10–250 employees)</option>
                  <option value="mid-market">Mid-Market (250–1000)</option>
                  <option value="enterprise">Enterprise (1000+)</option>
                </select>
              </div>
            </div>
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="biz-covers" class="block text-sm font-semibold text-slate-300 mb-2">Covers Needed (Multi-select)</label>
                <div class="space-y-2 bg-slate-800/50 p-3 rounded-xl border border-white/10 max-h-48 overflow-y-auto">
                  {[
                    { val: 'fire', label: 'Fire & Burglary (SFSP)' },
                    { val: 'marine', label: 'Marine Cargo' },
                    { val: 'public-liab', label: 'Public Liability' },
                    { val: 'product-liab', label: 'Product Liability' },
                    { val: 'prof-indemnity', label: 'Professional Indemnity' },
                    { val: 'do', label: 'Directors & Officers (D&O)' },
                    { val: 'cyber', label: 'Cyber Insurance' },
                    { val: 'group-health', label: 'Group Health' },
                    { val: 'keyman', label: 'Keyman Insurance' },
                    { val: 'wc', label: 'Workmen\'s Compensation' },
                    { val: 'money', label: 'Money / Fidelity' },
                    { val: 'car-ear', label: 'CAR / EAR (Construction)' }
                  ].map(c => (
                    <label class="flex items-center gap-2 text-sm text-slate-200 cursor-pointer">
                      <input type="checkbox" name="covers" value={c.val} class="w-4 h-4 accent-emerald-500 border-white/20 rounded bg-slate-800 focus:ring-2 focus:ring-emerald-400" />
                      {c.label}
                    </label>
                  ))}
                </div>
              </div>
              <div>
                <label for="biz-name" class="block text-sm font-semibold text-slate-300 mb-2">Your Name <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <input type="text" id="biz-name" name="name" autocomplete="name" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="Full name" />
              </div>
            </div>
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="biz-company" class="block text-sm font-semibold text-slate-300 mb-2">Company Name <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <input type="text" id="biz-company" name="company" autocomplete="organization" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="Company name" />
              </div>
              <div>
                <label for="biz-phone" class="block text-sm font-semibold text-slate-300 mb-2">Mobile Number <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <input type="tel" id="biz-phone" name="phone" autocomplete="tel" required pattern="[0-9+ -]{10,15}" class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="+91 XXXXX XXXXX" />
              </div>
            </div>
            <div class="flex items-start gap-3">
              <input type="checkbox" id="biz-dpdp" name="dpdp_consent" required class="mt-1 w-4 h-4 accent-emerald-500 border-white/20 rounded bg-slate-800 focus:ring-2 focus:ring-emerald-400" />
              <label htmlFor="biz-dpdp" class="text-sm text-slate-300">I consent to being contacted per the <a href="/privacy-policy/" class="underline hover:text-emerald-300">Privacy Policy</a> and DPDP Act 2023.</label>
            </div>
            <div class="text-center pt-2">
              <button type="submit" class="w-full md:w-auto px-10 py-4 bg-gradient-to-r from-emerald-400 to-teal-500 hover:from-emerald-500 hover:to-teal-600 text-white font-bold rounded-xl text-lg shadow-xl shadow-emerald-500/20 transition-all hover:scale-[1.02]">
                Get Free Risk Assessment
              </button>
            </div>
            <div id="biz-error" class="hidden rounded-xl border border-red-400/40 bg-red-500/10 p-4 text-center text-red-200" role="alert"></div>
          </form>
        </div>
      </section>

      <InsuranceCalculator client:load />
    </div>
  </main>
</BaseLayout>

<script is:inline>
  document.getElementById('bizQuoteForm')?.addEventListener('submit', async function (event) {
    event.preventDefault();
    const form = this;
    const button = form.querySelector('button[type="submit"]');
    const error = document.getElementById('biz-error');
    const originalLabel = button.textContent;
    error.classList.add('hidden');
    button.disabled = true;
    button.textContent = 'Sending request...';

    try {
      const values = new FormData(form);
      const covers = values.getAll('covers').join(', ') || 'Not specified';
      const response = await fetch('/contact-submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: values.get('name'),
          phone: values.get('phone'),
          category: 'Business Insurance',
          message: `Business: ${values.get('industry')}, Size ${values.get('size')}, Covers: ${covers}, Company: ${values.get('company')}`,
        }),
      });
      const result = await response.json();
      if (!response.ok || !result.success) {
        throw new Error(result.error || 'We could not send your request. Please try again or call us directly.');
      }
      alert('Thank you! We will send you a business insurance assessment within 4 hours.');
      form.reset();
    } catch (submissionError) {
      error.textContent = submissionError.message || 'We could not send your request. Please try again or call us directly.';
      error.classList.remove('hidden');
    } finally {
      button.disabled = false;
      button.textContent = originalLabel;
    }
  });
</script>