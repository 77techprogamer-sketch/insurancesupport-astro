---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InsuranceCalculator from '../../components/InsuranceCalculator.tsx';
import LocalBusinessJsonLd from '../../components/LocalBusinessJsonLd.astro';
import FAQPageJsonLd from '../../components/FAQPageJsonLd.astro';

const locality = "Indiranagar";
const description = "IRDAI-certified insurance advisor in Indiranagar, Bengaluru for life, health, motor & term insurance, plus rejected-claim recovery. Free consultation for young families and IT professionals, 25+ years experience.";
const canonicalUrl = `https://insurancesupport.online/services/${locality.toLowerCase().replace(' ', '-')}`;
const pageTitle = `Insurance Advisor in ${locality}, Bengaluru | Life, Health & Motor Cover`;

const geoPlaceName = `${locality}, Bengaluru`;
const pageServices = 'life insurance, health insurance, motor insurance, term insurance, ULIP, pension plans, travel insurance, SME and business insurance';
const pageKeywords = `insurance advisor ${locality}, ${locality} insurance agent, health insurance ${locality}, term insurance ${locality}, life insurance ${locality}, motor insurance ${locality}, LIC agent ${locality}, IRDAI certified insurance advisor ${locality}, insurance claim recovery ${locality}`;
const successStory = `A young couple in ${locality} had their term life insurance claim delayed because nomination details were missing. We helped them correct the nomination and get the claim processed within 15 days.`;
const coordinates = {
  Indiranagar: { lat: 12.9784, lng: 77.6408 },
  Whitefield: { lat: 12.9698, lng: 77.7500 },
  Jayanagar: { lat: 12.9238, lng: 77.5937 },
  "BTM Layout": { lat: 12.8921, lng: 77.5956 },
  Malleshwaram: { lat: 13.0042, lng: 77.5678 }
}[locality];
---

<BaseLayout title={pageTitle} description={description} keywords={pageKeywords} canonical={canonicalUrl} geoPlaceName={geoPlaceName} geoRegion="IN-KA">
  <LocalBusinessJsonLd />
  <FAQPageJsonLd questions={[
    { question: `How do I find an insurance advisor near me in ${locality}?`, answer: `Hari Kotian is an IRDAI-certified insurance advisor with 25+ years experience serving ${locality.toLowerCase()} residents. You can reach him via WhatsApp at +91-99866 34506 or visit insurancesupport.online for a free consultation.` },
    { question: `What types of insurance are offered in ${locality}?`, answer: `We offer ${pageServices} for residents of ${locality.toLowerCase()} and surrounding areas.` },
    { question: `Can you help with rejected insurance claims in ${locality}?`, answer: `Yes. We specialize in recovering rejected claims. If your health or life insurance claim was rejected anywhere in Bangalore, including ${locality.toLowerCase()}, we can review your case and help you appeal.` },
    { question: `Do you help young families in ${locality} with insurance?`, answer: `Yes. Many Indiranagar residents are young families. We help with term insurance for new parents, health insurance for the whole family, and checking nominees for life policies.` },
    { question: `Which hospitals near ${locality} do you help with insurance claims?`, answer: `We help Indiranagar residents with claims at Apollo Hospitals Indiranagar, Manipal Hospital Indiranagar, Cloudnine Hospital, and St. Martha's Hospital — both cashless and reimbursement.` }
  ]} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": pageTitle,
    "description": description,
    "url": canonicalUrl,
    "isPartOf": {
      "@type": "WebPage",
      "@id": "https://insurancesupport.online/claim-recovery/",
      "name": "Insurance Claim Recovery Hub"
    },
    "about": {
      "@type": "Thing",
      "name": "IRDAI-certified insurance advisory and claim recovery in Bengaluru"
    },
    "author": {
      "@type": "Person",
      "name": "Hari Kotian",
      "jobTitle": "IRDAI Certified Insurance Advisor"
    }
  })} />

  <section class="py-16 bg-gradient-to-br from-slate-50 to-white">
    <div class="max-w-6xl mx-auto px-4">

      <div class="text-center mb-12">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-sm font-semibold mb-4">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          Now serving Indiranagar, Bengaluru
        </span>
        <h1 class="text-4xl md:text-5xl font-extrabold text-blue-900 mb-6">Insurance Advisor in Indiranagar, Bengaluru</h1>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed">
          Life, health, motor, and term insurance guidance for Indiranagar families, young professionals, and entrepreneurs — plus claim-recovery support if a health, life, or motor claim has been delayed or rejected.
        </p>
        <p class="text-sm text-slate-500 mt-3">Based near Jalahalli and serving Indiranagar residents with doorstep, phone, and WhatsApp consultations where convenient.</p>
      </div>

      <!-- Google Map -->
      <div class="rounded-2xl overflow-hidden shadow-lg mb-12 aspect-video">
        <iframe
          src={`https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3888.35!2d${coordinates.lng}!3d${coordinates.lat}!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bae159c9f48f7ef%3A0x2e6d5f6c795b9c5a!2s${locality.replace(' ', '%20')}%2C%20Bengaluru!5e0!3m2!1sen!2sin`}
          width="100%" height="100%" style="border:0;" allowfullscreen loading="lazy"
          title={`Insurance advisor in ${locality}, Bengaluru`}
        ></iframe>
      </div>

      <!-- Local Success Story -->
      <div class="bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200 rounded-2xl p-8 shadow-sm mb-12">
        <h2 class="text-2xl font-bold text-amber-900 mb-4">Local Claim Recovery — Indiranagar</h2>
        <p class="text-slate-700 leading-relaxed mb-4">
          A young couple in Indiranagar had their term life insurance claim delayed because nomination details were missing. We helped them correct the nomination and get the claim processed within 15 days.
        </p>
        <p class="text-sm text-slate-500 italic">— Verified Client, Indiranagar (name withheld for privacy)</p>
      </div>

      <!-- Local Area Insurance Insights -->
      <div class="grid md:grid-cols-2 gap-6 mb-12">
        <div class="bg-slate-50 rounded-xl p-6 border border-slate-200">
          <h3 class="text-lg font-bold text-slate-900 mb-3">Hospitals Near Indiranagar We Work With</h3>
          <ul class="space-y-2 text-sm text-slate-600">
            <li><a href="/services/health-insurance" class="text-blue-700 hover:underline">Apollo Hospitals, Indiranagar</a> — cashless health insurance claims</li>
            <li><a href="/services/health-insurance" class="text-blue-700 hover:underline">Manipal Hospital, Indiranagar</a> — pre-authorisation support</li>
            <li><a href="/services/health-insurance" class="text-blue-700 hover:underline">St. Martha's Hospital</a> — claim documentation help</li>
            <li><a href="/services/health-insurance" class="text-blue-700 hover:underline">Cloudnine Hospital</a> — maternity and newborn cover</li>
          </ul>
          <p class="text-xs text-slate-500 mt-3">We help Indiranagar residents with cashless and reimbursement claims at these and other hospitals.</p>
        </div>
        <div class="bg-slate-50 rounded-xl p-6 border border-slate-200">
          <h3 class="text-lg font-bold text-slate-900 mb-3">Common Insurance Issues We See in Indiranagar</h3>
          <ul class="space-y-2 text-sm text-slate-600">
            <li>Health insurance claim rejected for "non-medical" reasons — we help you appeal</li>
            <li>Term insurance nominees not updated after marriage — nomination corrections</li>
            <li>Group health insurance from IT companies in Indiranagar — portability when you leave</li>
            <li>Motor insurance claims with ICICI Lombard, HDFC ERGO, Bajaj Allianz — surveyor disputes</li>
          </ul>
          <p class="text-xs text-slate-500 mt-3">Every locality has different claim patterns. We know what Indiranagar residents face.</p>
        </div>
      </div>

      <!-- Local Insurance Tips -->
      <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 mb-12">
        <h3 class="text-lg font-bold text-slate-900 mb-3">Insurance Tips for Indiranagar Residents</h3>
        <div class="grid md:grid-cols-2 gap-4 text-sm">
          <div>
            <p class="font-semibold text-slate-800 mb-1">🍃 Monsoon motor claims</p>
            <p class="text-slate-600">Indiranagar floods can damage cars. Keep photos, get a surveyor report quickly, and know your IDV. We help with own-damage claims.</p>
          </div>
          <div>
            <p class="font-semibold text-slate-800 mb-1">🏥 Cashless hospital access</p>
            <p class="text-slate-600">Apollo and Manipal in Indiranagar are on many insurers' network lists. We help you check your policy's network before you need it.</p>
          </div>
          <div>
            <p class="font-semibold text-slate-800 mb-1">👨‍👩‍👧‍👦 Family floater vs individual</p>
            <p class="text-slate-600">Young families in Indiranagar often choose family floater plans. We review whether the sum insured is enough for a family of 4-5.</p>
          </div>
          <div>
            <p class="font-semibold text-slate-800 mb-1">🏢 IT professional group cover</p>
            <p class="text-slate-600">Many Indiranagar residents work in tech. Group health cover ends when you leave the job — we help plan personal cover alongside.</p>
          </div>
        </div>
      </div>

      <!-- Services for Indiranagar -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-slate-900 mb-6 text-center">Insurance Services in Indiranagar</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white border border-slate-200 rounded-xl p-6 hover:shadow-lg transition-shadow">
            <h3 class="font-bold text-lg text-slate-900 mb-2">Life & Term Insurance</h3>
            <p class="text-sm text-slate-600">Choose the right term cover and life plans tailored to your income and family needs.</p>
          </div>
          <div class="bg-white border border-slate-200 rounded-xl p-6 hover:shadow-lg transition-shadow">
            <h3 class="font-bold text-lg text-slate-900 mb-2">Health Insurance</h3>
            <p class="text-sm text-slate-600">Family floater, individual, and senior citizen plans with cashless hospital access in Indiranagar.</p>
          </div>
          <div class="bg-white border border-slate-200 rounded-xl p-6 hover:shadow-lg transition-shadow">
            <h3 class="font-bold text-lg text-slate-900 mb-2">Motor Insurance</h3>
            <p class="text-sm text-slate-600">Comprehensive and third-party car/bike insurance with quick claim support.</p>
          </div>
        </div>
      </div>

      <!-- Calculator -->
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Estimate Your Premium</h2>
        <p class="text-lg text-slate-600 mb-8">Use our quick calculator for an indicative premium estimate.</p>
        <InsuranceCalculator client:load />
      </div>

      <!-- Claim Recovery Hub cross-link -->
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8">
        <p class="text-sm text-slate-700 mb-3">
          Facing a claim problem in Indiranagar? Our <strong>Claim Recovery Hub</strong> walks you through health, LIC, motor, travel, group-policy, and nominee disputes — with the escalation steps that work most often for these cases.
        </p>
        <a href="/claim-recovery/" class="inline-flex items-center gap-2 text-sm font-semibold text-blue-700 hover:text-blue-900 underline decoration-blue-300/50">
          Visit the Claim Recovery Hub
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- CTA -->
      <div class="bg-gradient-to-r from-blue-600 to-indigo-600 rounded-2xl p-8 text-center text-white">
        <h2 class="text-2xl font-bold mb-3">Need Personalised Insurance Advice in Indiranagar?</h2>
        <p class="text-blue-100 mb-6">Free consultation with no obligation. Talk to a certified advisor with 25+ years of experience.</p>
        <p class="text-sm text-blue-200 mb-4">Most local clients prefer WhatsApp or a short phone call first; we can follow up with a home visit when that suits you better.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href={`https://wa.me/919986634506?text=Hi%20Hari,%20I%20need%20insurance%20help%20in%20${locality}`} target="_blank" rel="noopener noreferrer" class="bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-6 rounded-lg transition-colors">WhatsApp Hari Kotian</a>
          <a href="tel:+919986634506" class="bg-white hover:bg-blue-50 text-blue-900 font-bold py-3 px-6 rounded-lg transition-colors">Call +91-99866 34506</a>
        </div>
      </div>

      <!-- Local Nav -->
      <div class="mt-12 text-center">
        <p class="text-sm text-slate-500 mb-4">Also serving nearby areas:</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/services/koramangala" class="px-4 py-2 bg-white border border-slate-200 rounded-lg text-sm text-slate-700 hover:bg-blue-50 hover:border-blue-200 transition-colors">Koramangala</a>
          <a href="/services/indiranagar" class="px-4 py-2 bg-white border border-slate-200 rounded-lg text-sm text-slate-700 hover:bg-blue-50 hover:border-blue-200 transition-colors">Indiranagar</a>
          <a href="/services/whitefield" class="px-4 py-2 bg-white border border-slate-200 rounded-lg text-sm text-slate-700 hover:bg-blue-50 hover:border-blue-200 transition-colors">Whitefield</a>
          <a href="/services/jayanagar" class="px-4 py-2 bg-white border border-slate-200 rounded-lg text-sm text-slate-700 hover:bg-blue-50 hover:border-blue-200 transition-colors">Jayanagar</a>
          <a href="/services/btm-layout" class="px-4 py-2 bg-white border border-slate-200 rounded-lg text-sm text-slate-700 hover:bg-blue-50 hover:border-blue-200 transition-colors">BTM Layout</a>
          <a href="/services/malleshwaram" class="px-4 py-2 bg-white border border-slate-200 rounded-lg text-sm text-slate-700 hover:bg-blue-50 hover:border-blue-200 transition-colors">Malleshwaram</a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
