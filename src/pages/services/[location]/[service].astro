---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import services from "../../../data/services.json";
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const cities = await getCollection('cities');
  const bangaloreCities = cities.filter(c => c.data.slug.startsWith('bangalore-'));
  
  const paths = [];
  for (const city of bangaloreCities) {
    const locSlug = city.data.slug.replace('bangalore-', '');
    for (const service of services) {
      paths.push({
        params: { location: locSlug, service: service.slug },
        props: { cityData: city.data, serviceData: service }
      });
    }
  }
  return paths;
}

const { location, service } = Astro.params;
const { cityData, serviceData } = Astro.props;

const title = `${serviceData.title} in ${cityData.name} | Insurance Support`;
const description = `Get expert advisory for ${serviceData.title.toLowerCase()} in ${cityData.name}, Bangalore. IRDAI-certified advisor Hari Kotian with 25+ years experience. Free consultation & claim support.`;
const canonical = `https://insurancesupport.online/services/${location}/${service}/`;
---

<BaseLayout title={title} description={description} canonical={canonical} geoPlaceName={cityData.name} geoRegion="IN-KA">
  
  <main class="page-transition">
    <div class="max-w-4xl mx-auto px-4 py-16">
      
      <nav class="text-sm text-slate-500 mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-blue-600">Home</a></li>
          <li>/</li>
          <li><a href="/services" class="hover:text-blue-600">Services</a></li>
          <li>/</li>
          <li><a href={`/services/${location}`} class="hover:text-blue-600 capitalize">{location.replace('-', ' ')}</a></li>
          <li>/</li>
          <li class="text-slate-800 font-medium">{serviceData.title}</li>
        </ol>
      </nav>

      <div class="mb-12">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-blue-700 text-sm font-semibold mb-4">
          📍 {cityData.name}, Bangalore
        </span>
        <h1 class="text-4xl font-extrabold text-slate-900 mb-4">{serviceData.title} in {cityData.name}, Bangalore</h1>
        <p class="text-lg text-slate-600 leading-relaxed mb-6">{serviceData.desc}</p>
        <p class="text-slate-700 leading-relaxed bg-slate-50 border-l-4 border-blue-600 p-4 rounded-r-xl">
          {cityData.desc}
        </p>
      </div>

      {serviceData.content && (
        <div class="prose prose-lg max-w-none mb-12" set:html={serviceData.content.replace(/\n/g, '<br/>')} />
      )}

      {serviceData.benefits && serviceData.benefits.length > 0 && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-slate-900 mb-6">Why Choose Our {serviceData.title} in {cityData.name}</h2>
          <ul class="space-y-3">
            {serviceData.benefits.map((benefit: string) => (
              <li class="flex items-start gap-3 text-slate-600 leading-relaxed">
                <span class="text-emerald-500 mt-1">✓</span>
                <span>{benefit}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {cityData.it_focus && (
        <section class="mb-12 bg-indigo-50 border border-indigo-100 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-indigo-900 mb-3">Local Context & IT Professional Focus for {cityData.name}</h3>
          <p class="text-slate-700 leading-relaxed">{cityData.it_focus}</p>
        </section>
      )}

      {cityData.senior_focus && (
        <section class="mb-12 bg-amber-50 border border-amber-100 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-amber-900 mb-3">Senior Citizens & Family Advisory in {cityData.name}</h3>
          <p class="text-slate-700 leading-relaxed">{cityData.senior_focus}</p>
        </section>
      )}

      {serviceData.faqs && serviceData.faqs.length > 0 && (
        <section class="mt-12">
          <h2 class="text-2xl font-bold text-slate-900 mb-6">Frequently Asked Questions</h2>
          <div class="space-y-3">
            {serviceData.faqs.map((faq: any) => (
              <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
                <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors">
                  <span class="font-semibold text-slate-900 pr-4">{faq.question}</span>
                  <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="px-5 pb-5">
                  <p class="text-slate-600 leading-relaxed">{faq.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- CTA -->
      <section class="mt-16 bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 rounded-3xl p-8 md:p-12 text-center text-white relative overflow-hidden shadow-2xl">
        <div class="absolute -top-10 -right-10 w-48 h-48 bg-amber-400/10 rounded-full blur-2xl" />
        <div class="absolute -bottom-10 -left-10 w-48 h-48 bg-blue-500/20 rounded-full blur-2xl" />

        <div class="relative z-10 max-w-2xl mx-auto">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-400/20 text-amber-300 text-sm font-semibold mb-4 border border-amber-400/30">
            Instant Expert Help in {cityData.name}
          </span>
          <h2 class="text-3xl font-extrabold mb-4">Need Help with {serviceData.title} in {cityData.name}?</h2>
          <p class="text-blue-100/80 mb-8 leading-relaxed">
            Free consultation with Hari Kotian, IRDAI certified advisor (Reg No: 0149161D) with 25+ years experience. Doorstep service available across {cityData.name} and nearby areas.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4">
            <a href="https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20I%20need%20help%20with%20{encodeURIComponent(serviceData.title)}%20in%20{encodeURIComponent(cityData.name)}." target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-600 hover:to-green-700 text-white font-bold rounded-full text-lg shadow-xl shadow-emerald-500/25 hover:scale-105 transition-all">
              Chat on WhatsApp
            </a>
            <a href="tel:+919986634506" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-500 hover:to-amber-600 text-slate-900 font-bold rounded-full text-lg shadow-xl shadow-amber-500/25 hover:scale-105 transition-all">
              Call +91-99866 34506
            </a>
          </div>
        </div>
      </section>

    </div>
  </main>

</BaseLayout>
