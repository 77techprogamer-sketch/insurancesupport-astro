---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import services from "../../../data/services.json";
import FAQPageJsonLd from "../../../components/FAQPageJsonLd.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const cities = await getCollection('cities');
  const blrCities = cities.filter(c => c.data.slug.startsWith('bangalore-'));

  const locationMap = Object.fromEntries(
    blrCities.map(c => [c.data.slug.replace('bangalore-', ''), {
      name: c.data.slug.replace('bangalore-', '').replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) + ', Bangalore',
      lat: c.data.lat,
      lng: c.data.lng,
    }])
  );

  const paths = [];
  for (const [locSlug, locInfo] of Object.entries(locationMap)) {
    for (const service of services) {
      paths.push({
        params: { location: locSlug, service: service.slug },
        props: { cityData: locInfo, serviceData: service }
      });
    }
  }
  return paths;
}

const { location, service } = Astro.params;
const { cityData, serviceData } = Astro.props;

const title = `${serviceData.title} in ${cityData.name} | Insurance Support`;
const description = `Get expert advisory for ${serviceData.title.toLowerCase()} in ${cityData.name}. IRDAI-certified advisor Hari Kotian with 25+ years experience. ${serviceData.desc}`;
const serviceUrl = `https://insurancesupport.online/services/${location}/${service}/`;
---

<BaseLayout title={title} description={description} canonical={serviceUrl} geoPlaceName={cityData.name} geoRegion="IN-KA" geoPosition={`${cityData.lat};${cityData.lng}`}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    name: "Insurance Support - " + serviceData.title + " in " + cityData.name,
    description: serviceData.desc,
    url: serviceUrl,
    telephone: "+91-9986634506",
    address: {
      "@type": "PostalAddress",
      addressLocality: cityData.name.split(',')[0],
      addressRegion: "KA",
      addressCountry: "IN"
    },
    geo: { "@type": "GeoCoordinates", latitude: cityData.lat, longitude: cityData.lng },
    areaServed: cityData.name,
    serviceType: serviceData.title
  })} />

  <Breadcrumbs currentPage={serviceData.title} />

  <main id="main" class="page-transition">
    <div class="max-w-4xl mx-auto px-4 py-16">
      <div class="mb-8">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-blue-700 text-sm font-semibold">
          📍 {cityData.name}
        </span>
      </div>
      <h1 class="text-4xl font-bold mb-4">{serviceData.title} in {cityData.name}</h1>
      <p class="text-lg text-slate-600 mb-12">{serviceData.desc}</p>

      {serviceData.content && (
        <div class="prose prose-lg max-w-none mb-12" set:html={serviceData.content.replace(/\n/g, '<br/>')} />
      )}

      {serviceData.benefits && serviceData.benefits.length > 0 && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-slate-900 mb-6">Why Choose Our {serviceData.title} Service in {cityData.name.split(',')[0]}</h2>
          <ul class="space-y-3">
            {serviceData.benefits.map((benefit: string) => (
              <li class="flex items-start gap-3 text-slate-600 leading-relaxed">
                <span class="text-emerald-500 mt-1">✓</span>
                <span>{benefit}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="mb-12 bg-blue-50 rounded-2xl p-8">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Serving Residents in {cityData.name.split(',')[0]}</h2>
        <p class="text-slate-600 leading-relaxed mb-4">
          As a local IRDAI-certified advisor serving {cityData.name.split(',')[0]} and surrounding neighborhoods, I provide doorstep insurance advisory with same-day escalations for claim denials. Whether you're a tech professional in the IT corridor, a family in a residential area, or a senior citizen, I ensure you get the right coverage at the right price.
        </p>
        <p class="text-slate-600 leading-relaxed">
          <strong>Areas covered near {cityData.name.split(',')[0]}:</strong> {cityData.areas?.join(', ') || 'All nearby localities'}
        </p>
      </section>

      {serviceData.faqs && serviceData.faqs.length > 0 && (
        <>
          <FAQPageJsonLd questions={serviceData.faqs} />
          <section class="mt-12">
            <h2 class="text-2xl font-bold text-slate-900 mb-6">Frequently Asked Questions</h2>
            <div class="space-y-3">
              {serviceData.faqs.map((faq: any) => (
                <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
                  <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors">
                    <span class="font-semibold text-slate-900 pr-4">{faq.question}</span>
                    <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </summary>
                  <div class="px-5 pb-5">
                    <p class="text-slate-600 leading-relaxed">{faq.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        </>
      )}

      <!-- CTA -->
      <section class="mt-16 bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 rounded-3xl p-8 md:p-12 text-center text-white relative overflow-hidden shadow-2xl">
        <div class="absolute -top-10 -right-10 w-48 h-48 bg-amber-400/10 rounded-full blur-2xl" />
        <div class="absolute -bottom-10 -left-10 w-48 h-48 bg-blue-500/20 rounded-full blur-2xl" />

        <div class="relative z-10 max-w-2xl mx-auto">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-400/20 text-amber-300 text-sm font-semibold mb-4 border border-amber-400/30">
            Instant Expert Help in {cityData.name.split(',')[0]}
          </span>
          <h2 class="text-3xl font-extrabold mb-4">Need Expert Guidance on {serviceData.title}?</h2>
          <p class="text-blue-100/80 mb-8 leading-relaxed">
            Free consultation with Hari Kotian, IRDAI certified advisor (Reg No: 0149161D) with 25+ years experience. No pressure, just honest advice and proven claim recovery support in {cityData.name.split(',')[0]}.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4">
            <a href="https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20I%20need%20help%20with%20{encodeURIComponent(serviceData.title)}%20in%20{encodeURIComponent(cityData.name.split(',')[0])}." target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-600 hover:to-green-700 text-white font-bold rounded-full text-lg shadow-xl shadow-emerald-500/25">
              WhatsApp Hari Kotian
            </a>
            <a href="tel:+919986634506" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-500 hover:to-amber-600 text-slate-900 font-bold rounded-full text-lg shadow-xl shadow-amber-500/25">
              Call +91-99866 34506
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

</BaseLayout>
