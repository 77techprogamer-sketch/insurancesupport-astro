---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TrustStrip from '../../../components/TrustStrip';
import InsuranceCalculator from '../../../components/InsuranceCalculator';
---

<BaseLayout
  title="Claim Support in Bangalore | End-to-End Claim Help | Ombudsman, IRDAI Escalation | Insurance Support"
  description="Expert claim support in Bangalore. Motor, health, life, property claims. Documentation, surveyor coordination, TPA follow-up, ombudsman/IRDAI/consumer forum escalation. 94% claim success rate. IRDAI advisor Insurance Support"
  canonical="https://insurancesupport.online/services/claim-support/"
  ogImage="https://insurancesupport.online/images/og/claim-support.png"
  pageType="service-detail"
  keywords="claim support Bangalore, insurance claim help, claim rejection appeal, ombudsman complaint, IRDAI grievance, consumer forum insurance"
  dateModified="2026-10-22"
  geoPlaceName="Jalahalli, Bengaluru"
  geoPosition="13.0159;77.5522"
  lang="en-IN"
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Claim Support & Escalation",
    "description": "End-to-end claim assistance for motor, health, life, property. Documentation, surveyor/TPA coordination, cashless/reimbursement. Escalation: insurer grievance, ombudsman, IRDAI, consumer forum. 94% success rate on valid claims.",
    "url": "https://insurancesupport.online/services/claim-support/",
    "provider": {
      "@type": "Person",
      "name": "Insurance Support",
      "jobTitle": "IRDAI Certified Insurance Advisor",
      "identifier": "0149161D",
      "worksFor": {
        "@type": "Organization",
        "name": "Insurance Support",
        "url": "https://insurancesupport.online"
      }
    },
    "areaServed": {
      "@type": "City",
      "name": "Bengaluru"
    },
    "offers": {
      "@type": "Offer",
      "name": "Claim Support Consultation",
      "description": "Free initial assessment of your claim situation and next steps",
      "price": "0",
      "priceCurrency": "INR",
      "availability": "https://schema.org/InStock"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "My claim was rejected. Can you help?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. We analyze rejection reason, check policy terms vs rejection grounds, identify procedural gaps by insurer, and file appeal. 94% of valid claims we handle get settled — often at higher amount than initial offer."
        }
      },
      {
        "@type": "Question",
        "name": "What is the insurance ombudsman process?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Free, no lawyer needed. File complaint within 1 year of rejection. Ombudsman hears both sides, passes award (binding up to ₹30L). Takes 3–6 months. We prepare complaint, represent you at hearings, enforce award."
        }
      },
      {
        "@type": "Question",
        "name": "How long does claim settlement take?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "IRDAI mandates: 30 days for settlement after all docs submitted. Health cashless: pre-auth 1hr, discharge 3hr. Motor: survey 24–48hr. Delays usually from missing docs or insurer queries. We ensure complete file upfront."
        }
      },
      {
        "@type": "Question",
        "name": "Do you charge for claim support?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Initial assessment free. For active claim management: success fee (percentage of additional amount recovered) or fixed fee agreed upfront. No fee if no recovery. Transparent, no hidden charges."
        }
      },
      {
        "@type": "Question",
        "name": "Can you help with old/rejected claims?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, if within limitation period (3 years for consumer forum, 1 year for ombudsman from rejection). We review file, identify fresh grounds, file appropriate forum. Many 'closed' claims reopen with new evidence/legal precedent."
        }
      }
    ]
  })} />

  <main id="main" class="min-h-screen bg-slate-900 text-white relative overflow-hidden pt-16 pb-24">
    <div class="absolute top-0 right-0 w-96 h-96 bg-emerald-500/10 rounded-full blur-[120px] pointer-events-none" />
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

      <nav class="text-sm text-slate-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-300">Home</a>
        <span class="mx-2">›</span>
        <a href="/services/" class="hover:text-amerald-300">Services</a>
        <span class="mx-2">›</span>
        <span class="text-slate-200" aria-current="page">Claim Support</span>
      </nav>

      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-400/20 text-emerald-300 text-sm font-semibold mb-4 border border-emerald-400/30">
          94% Success Rate · Ombudsman & IRDAI Escalation · No Win No Fee
        </span>
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4" style="font-family: 'Plus Jakarta Sans', sans-serif;">
          Claim Support & <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">Escalation</span>
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Don't let a rejected or delayed claim drain you. End-to-end support: documentation, surveyor/TPA coordination, and full escalation through ombudsman, IRDAI, and consumer forum. 94% success on valid claims.
        </p>
      </div>

      <TrustStrip client:visible />

      <section class="mb-12" aria-labelledby="types-heading">
        <h2 id="types-heading" class="text-2xl font-bold text-center mb-8">Claims We Handle</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            { icon: '🚗', title: 'Motor Claims', desc: 'Accident, theft, total loss, third party, hit-and-run, natural calamity. Cashless garage coordination, depreciation negotiation.' },
            { icon: '🏥', title: 'Health Claims', desc: 'Cashless denial, pre-existing disease rejection, room rent capping, non-medical items, restoration benefit disputes.' },
            { icon: '👨‍👩‍👧', title: 'Life/Term Claims', desc: 'Death claim (early/non-early), suicide clause, non-disclosure, nominee dispute, assignment, delayed payout.' },
            { icon: '🏠', title: 'Property Claims', desc: 'Fire, burglary, flood, earthquake, business interruption. Stock valuation, underinsurance, reinstatement vs indemnity.' }
          ].map(item => (
            <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
              <div class="text-3xl mb-3">{item.icon}</div>
              <h3 class="text-lg font-bold text-white mb-2">{item.title}</h3>
              <p class="text-slate-300 text-sm">{item.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-16" aria-labelledby="escalation-heading">
        <h2 id="escalation-heading" class="text-3xl font-bold text-center mb-10">Escalation Ladder — We Take It All the Way</h2>
        <div class="space-y-4 max-w-3xl mx-auto">
          {[
            { level: 1, name: 'Insurer Grievance Cell', timeline: '15 days', binding: 'No', desc: 'First formal complaint. We draft, file, follow up. 40% resolved here.' },
            { level: 2, name: 'Insurance Ombudsman', timeline: '3–6 months', binding: 'Yes (up to ₹30L)', desc: 'Free, quasi-judicial. We prepare complaint, attend hearings. 70% success for valid claims.' },
            { level: 3, name: 'IRDAI Grievance (Bima Bharosa)', timeline: '30–60 days', binding: 'Advisory', desc: 'Regulator intervention. We escalate with evidence of unfair practice. Triggers insurer action.' },
            { level: 4, name: 'Consumer Forum (District/State/National)', timeline: '1–3 years', binding: 'Yes', desc: 'Legal forum. Compensation + interest + costs. We coordinate with empanelled advocates.' }
          ].map(item => (
            <div class="flex gap-4 bg-white/5 rounded-2xl p-6 border border-white/10">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/20 flex items-center justify-center text-2xl font-bold text-emerald-300 flex-shrink-0">{item.level}</div>
              <div class="flex-1">
                <div class="flex items-center gap-4 mb-2">
                  <h3 class="text-lg font-bold text-white">{item.name}</h3>
                  <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 text-xs">{item.timeline}</span>
                  <span class="px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 text-xs">{item.binding}</span>
                </div>
                <p class="text-slate-300 text-sm">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-16" aria-labelledby="process-heading">
        <h2 id="process-heading" class="text-3xl font-bold text-center mb-10">Our Claim Support Process</h2>
        <div class="space-y-6">
          {[
            { step: 1, title: 'File Review & Gap Analysis', desc: 'Collect policy, claim form, rejection letter, medical/survey reports, correspondence. Identify procedural errors, unfair terms, missing insurer obligations.' },
            { step: 2, title: 'Strategy & Forum Selection', desc: 'Based on claim amount, rejection grounds, limitation period — recommend ombudsman vs consumer forum vs IRDAI. Draft legal notice if needed.' },
            { step: 3, title: 'Representation & Filing', desc: 'Prepare complaint with evidence, legal precedents. File online/offline. Represent at hearings (ombudsman) or coordinate advocates (consumer forum).' },
            { step: 4, title: 'Negotiation & Settlement', desc: 'Many cases settle pre-hearing. We negotiate with insurer legal team for fair settlement. Document terms, ensure compliance.' },
            { step: 5, title: 'Award Enforcement', desc: 'Ombudsman award: insurer must comply in 30 days. Consumer forum order: execution petition if needed. We track till credit in account.' }
          ].map(s => (
            <div class="flex gap-4 bg-white/5 rounded-2xl p-6 border border-white/10">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/20 flex items-center justify-center text-2xl font-bold text-emerald-300 flex-shrink-0">{s.step}</div>
              <div>
                <h3 class="text-lg font-bold text-white mb-1">{s.title}</h3>
                <p class="text-slate-300 text-sm">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-16" aria-labelledby="quote-heading">
        <h2 id="quote-heading" class="text-3xl font-bold text-center mb-10">Get Free Claim Assessment</h2>
        <div class="bg-white/5 backdrop-blur-xl rounded-3xl border border-white/10 shadow-2xl p-6 md:p-8 max-w-xl mx-auto">
          <form id="claimQuoteForm" class="space-y-5">
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="c-type" class="block text-sm font-semibold text-slate-300 mb-2">Claim Type <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <select id="c-type" name="claim_type" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
                  <option value="">Select</option>
                  <option value="motor">Motor (Accident/Theft/Total Loss)</option>
                  <option value="health">Health (Cashless/Reimbursement)</option>
                  <option value="life">Life / Term Insurance</option>
                  <option value="property">Property (Fire/Burglary/Flood)</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div>
                <label for="c-status" class="block text-sm font-semibold text-slate-300 mb-2">Current Status <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <select id="c-status" name="status" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
                  <option value="">Select</option>
                  <option value="intimated">Just Intimated</option>
                  <option value="documents-submitted">Documents Submitted</option>
                  <option value="query-received">Insurer Query Received</option>
                  <option value="rejected">Rejected (have letter)</option>
                  <option value="partial">Partially Settled</option>
                  <option value="delayed">Delayed Beyond 30 Days</option>
                </select>
              </div>
            </div>
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="c-insurer" class="block text-sm font-semibold text-slate-300 mb-2">Insurer Name <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <input type="text" id="c-insurer" name="insurer" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="e.g., ICICI Lombard, LIC, Star Health" />
              </div>
              <div>
                <label for="c-amount" class="block text-sm font-semibold text-slate-300 mb-2">Claim Amount <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <select id="c-amount" name="amount" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
                  <option value="">Select</option>
                  <option value="<5L">Below ₹5 Lakh</option>
                  <option value="5L-10L">₹5–10 Lakh</option>
                  <option value="10L-30L">₹10–30 Lakh</option>
                  <option value="30L+">Above ₹30 Lakh</option>
                </select>
              </div>
            </div>
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="c-name" class="block text-sm font-semibold text-slate-300 mb-2">Your Name <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <input type="text" id="c-name" name="name" autocomplete="name" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="Full name" />
              </div>
              <div>
                <label for="c-phone" class="block text-sm font-semibold text-slate-300 mb-2">Mobile Number <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <input type="tel" id="c-phone" name="phone" autocomplete="tel" required pattern="[0-9+ -]{10,15}" class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="+91 XXXXX XXXXX" />
              </div>
            </div>
            <div class="flex items-start gap-3">
              <input type="checkbox" id="c-dpdp" name="dpdp_consent" required class="mt-1 w-4 h-4 accent-emerald-500 border-white/20 rounded bg-slate-800 focus:ring-2 focus:ring-emerald-400" />
              <label htmlFor="c-dpdp" class="text-sm text-slate-300">I consent to being contacted per the <a href="/privacy-policy/" class="underline hover:text-emerald-300">Privacy Policy</a> and DPDP Act 2023.</label>
            </div>
            <div class="text-center pt-2">
              <button type="submit" class="w-full md:w-auto px-10 py-4 bg-gradient-to-r from-emerald-400 to-teal-500 hover:from-emerald-500 hover:to-teal-600 text-white font-bold rounded-xl text-lg shadow-xl shadow-emerald-500/20 transition-all hover:scale-[1.02]">
                Get Free Claim Assessment
              </button>
            </div>
            <div id="c-error" class="hidden rounded-xl border border-red-400/40 bg-red-500/10 p-4 text-center text-red-200" role="alert"></div>
          </form>
        </div>
      </section>

      <InsuranceCalculator client:load />
    </div>
  </main>
</BaseLayout>

<script is:inline>
  document.getElementById('claimQuoteForm')?.addEventListener('submit', async function (event) {
    event.preventDefault();
    const form = this;
    const button = form.querySelector('button[type="submit"]');
    const error = document.getElementById('c-error');
    const originalLabel = button.textContent;
    error.classList.add('hidden');
    button.disabled = true;
    button.textContent = 'Sending request...';

    try {
      const values = new FormData(form);
      const response = await fetch('/contact-submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: values.get('name'),
          phone: values.get('phone'),
          category: 'Claim Support',
          message: `Claim: ${values.get('claim_type')}, Status ${values.get('status')}, Insurer ${values.get('insurer')}, Amount ${values.get('amount')}`,
        }),
      });
      const result = await response.json();
      if (!response.ok || !result.success) {
        throw new Error(result.error || 'We could not send your request. Please try again or call us directly.');
      }
      alert('Thank you! We will assess your claim and respond within 4 hours.');
      form.reset();
    } catch (submissionError) {
      error.textContent = submissionError.message || 'We could not send your request. Please try again or call us directly.';
      error.classList.remove('hidden');
    } finally {
      button.disabled = false;
      button.textContent = originalLabel;
    }
  });
</script>