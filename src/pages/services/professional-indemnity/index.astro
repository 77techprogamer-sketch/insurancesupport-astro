---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TrustStrip from '../../../components/TrustStrip';
import InsuranceCalculator from '../../../components/InsuranceCalculator';
---

<BaseLayout
  title="Professional Indemnity Insurance in Bangalore | Doctors, CAs, Architects, Engineers | Up to ₹10Cr | Insurance Support"
  description="Professional indemnity insurance in Bangalore. Doctors, CAs, architects, engineers, consultants, lawyers. Cover up to ₹10Cr. Retroactive date, run-off cover, defense costs inclusive. ICICI Lombard, Bajaj Allianz, HDFC ERGO, Tata AIG, New India. IRDAI advisor Suhas K."
  canonical="https://insurancesupport.online/services/professional-indemnity/"
  ogImage="https://insurancesupport.online/images/og/professional-indemnity.png"
  pageType="service-detail"
  keywords="professional indemnity insurance Bangalore, doctors indemnity insurance, CA professional indemnity, architect PI insurance, errors omissions insurance India"
  dateModified="2026-10-22"
  geoPlaceName="Jalahalli, Bengaluru"
  geoPosition="13.0159;77.5522"
  lang="en-IN"
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Professional Indemnity Insurance",
    "description": "Errors & omissions cover for professionals. Doctors, CAs, architects, engineers, consultants, lawyers, IT professionals. Limit up to ₹10Cr. Retroactive date, run-off cover, defense costs inclusive (in addition to limit). ICICI Lombard, Bajaj Allianz, HDFC ERGO, Tata AIG, New India Assurance, National Insurance.",
    "url": "https://insurancesupport.online/services/professional-indemnity/",
    "provider": {
      "@type": "Person",
      "name": "Suhas K.",
      "jobTitle": "IRDAI Certified Insurance Advisor",
      "identifier": "0149161D",
      "worksFor": {
        "@type": "Organization",
        "name": "Insurance Support",
        "url": "https://insurancesupport.online"
      }
    },
    "areaServed": {
      "@type": "City",
      "name": "Bengaluru"
    },
    "offers": {
      "@type": "Offer",
      "name": "Professional Indemnity Consultation",
      "description": "Free consultation to assess PI requirement and compare plans",
      "price": "0",
      "priceCurrency": "INR",
      "availability": "https://schema.org/InStock"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is professional indemnity insurance mandatory for doctors in India?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Not legally mandatory nationally, but: 1) Many hospitals mandate it for visiting consultants. 2) State medical councils (Karnataka, Maharashtra, Delhi) recommend/require. 3) Consumer courts increasingly expect doctors to have it. 4) Corporate clients require it. Minimum ₹50L–1Cr recommended for practitioners."
        }
      },
      {
        "@type": "Question",
        "name": "What is retroactive date in PI policy?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Covers claims arising from work done AFTER this date (even if policy bought later). Critical for professionals switching insurers — ensure new policy retroactive date matches first PI policy date. Gap in retroactive coverage = uncovered past work. We ensure continuity."
        }
      },
      {
        "@type": "Question",
        "name": "What does 'defense costs inclusive' mean?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Legal defense costs (lawyer, court, expert) paid IN ADDITION to sum insured. Without this, defense costs reduce your limit (e.g., ₹1Cr limit, ₹20L legal fees = only ₹80L for settlement). Always choose 'inclusive' — premium slightly higher but critical protection."
        }
      },
      {
        "@type": "Question",
        "name": "What is run-off cover?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Covers claims reported AFTER you retire/close practice, for work done while insured. Claims can arise years later (latent defects in architecture, delayed diagnosis in medicine). Run-off: 1–7 years (or unlimited). Essential for retirement planning."
        }
      },
      {
        "@type": "Question",
        "name": "How much PI cover do I need?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Doctors: ₹1–5Cr (surgeons higher). CAs: ₹50L–2Cr (audit clients). Architects/Engineers: ₹1–10Cr (project value). Consultants: ₹50L–2Cr. IT: ₹1–5Cr (contract requirement). Consider: max single claim exposure, client contract requirements, regulatory minimums."
        }
      }
    ]
  })} />

  <main id="main" class="min-h-screen bg-slate-900 text-white relative overflow-hidden pt-16 pb-24">
    <div class="absolute top-0 right-0 w-96 h-96 bg-emerald-500/10 rounded-full blur-[120px] pointer-events-none" />
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

      <nav class="text-sm text-slate-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-300">Home</a>
        <span class="mx-2">›</span>
        <a href="/services/" class="hover:text-amber-300">Services</a>
        <span class="mx-2">›</span>
        <span class="text-slate-200" aria-current="page">Professional Indemnity</span>
      </nav>

      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-400/20 text-emerald-300 text-sm font-semibold mb-4 border border-emerald-400/30">
          Up to ₹10Cr · Retroactive Date · Run-Off Cover · Defense Costs Inclusive
        </span>
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4" style="font-family: 'Plus Jakarta Sans', sans-serif;">
          Professional Indemnity <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">Insurance</span>
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Protect your practice from professional negligence claims. Doctors, CAs, architects, engineers, consultants, lawyers. Retroactive continuity, run-off cover for retirement, defense costs inclusive. Up to ₹10Cr limit.
        </p>
      </div>

      <TrustStrip client:visible />

      <section class="mb-12" aria-labelledby="profession-heading">
        <h2 id="profession-heading" class="text-2xl font-bold text-center mb-8">Recommended Limits by Profession</h2>
        <div class="overflow-x-auto rounded-2xl border border-white/10">
          <table class="w-full min-w-[700px] text-sm text-slate-200">
            <thead class="bg-white/5">
              <tr class="border-b border-white/10">
                <th class="text-left p-4 font-semibold">Profession</th>
                <th class="text-left p-4 font-semibold">Typical Limit</th>
                <th class="text-left p-4 font-semibold">Key Risk</th>
                <th class="text-left p-4 font-semibold">Special Features Needed</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Doctors (General Practice)</td><td class="p-4">₹1–2Cr</td><td class="p-4">Misdiagnosis, medication error</td><td class="p-4">Retroactive, run-off 5yr, defense inclusive</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Surgeons / Specialists</td><td class="p-4">₹3–5Cr</td><td class="p-4">Surgical complication, consent</td><td class="p-4">High limit, sampling cover, locum cover</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Chartered Accountants</td><td class="p-4">₹50L–2Cr</td><td class="p-4">Audit negligence, tax error</td><td class="p-4">Regulatory defense, partner cover</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Architects / Engineers</td><td class="p-4">₹1–10Cr</td><td class="p-4">Design defect, structural failure</td><td class="p-4">Joint venture, sub-consultant, run-off 10yr</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Lawyers / Advocates</td><td class="p-4">₹50L–2Cr</td><td class="p-4">Missed limitation, bad advice</td><td class="p-4">Bar council defense, libel/slander</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">IT / Software Consultants</td><td class="p-4">₹1–5Cr</td><td class="p-4">Data breach, system failure, IP</td><td class="p-4">Cyber add-on, client contract compliance</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Management Consultants</td><td class="p-4">₹50L–2Cr</td><td class="p-4">Faulty strategy, data leak</td><td class="p-4">Client contract limit, worldwide jurisdiction</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="mb-16" aria-labelledby="features-heading">
        <h2 id="features-heading" class="text-3xl font-bold text-center mb-10">Critical Policy Features — Don't Buy Without These</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
            <h3 class="text-xl font-bold text-emerald-300 mb-3 flex items-center gap-2">⏮️ Retroactive Date Continuity</h3>
            <p class="text-slate-300">Your first PI policy date = retroactive date. Never let it lapse. Switching insurers? New policy MUST match original retroactive date. We verify and enforce continuity.</p>
          </div>
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
            <h3 class="text-xl font-bold text-emerald-300 mb-3 flex items-center gap-2">⚖️ Defense Costs Inclusive</h3>
            <p class="text-slate-300">Legal fees paid OVER the limit, not from it. ₹1Cr limit + ₹30L legal = ₹1.3Cr protection. 'Costs exclusive' policies erode limit — avoid.</p>
          </div>
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
            <h3 class="text-xl font-bold text-emerald-300 mb-3 flex items-center gap-2">🏃 Run-Off Cover</h3>
            <p class="text-slate-300">Claims arise years after retirement (latent defects, delayed diagnosis). Run-off: 1–7 years or unlimited. Buy at retirement. We negotiate best terms.</p>
          </div>
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
            <h3 class="text-xl font-bold text-emerald-300 mb-3 flex items-center gap-2">🌍 Jurisdiction & Territory</h3>
            <p class="text-slate-300">India-only vs Worldwide (excl. USA/Canada). Global clients need worldwide. US/Canada exposure needs specific extension (high premium). Match to your client base.</p>
          </div>
        </div>
      </section>

      <section class="mb-16" aria-labelledby="insurers-heading">
        <h2 id="insurers-heading" class="text-3xl font-bold text-center mb-10">Top PI Insurers in India (2024)</h2>
        <div class="grid md:grid-cols-3 gap-6">
          {[
            { name: 'ICICI Lombard', strengths: 'Broad profession list, digital, competitive pricing', limit: 'Up to ₹10Cr' },
            { name: 'Bajaj Allianz', strengths: 'Strong medical PI, good claim service', limit: 'Up to ₹5Cr' },
            { name: 'HDFC ERGO', strengths: 'Architect/engineer specialist, cyber add-on', limit: 'Up to ₹10Cr' },
            { name: 'Tata AIG', strengths: 'Flexible wordings, international cover', limit: 'Up to ₹5Cr' },
            { name: 'New India Assurance', strengths: 'PSU trust, government panel, low cost', limit: 'Up to ₹5Cr' },
            { name: 'National Insurance', strengths: 'Established PI portfolio, retrofit options', limit: 'Up to ₹3Cr' }
          ].map(item => (
            <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
              <h3 class="text-lg font-bold text-white mb-2">{item.name}</h3>
              <p class="text-slate-300 text-sm mb-2">{item.strengths}</p>
              <span class="text-xs text-emerald-300">Limit: {item.limit}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-16" aria-labelledby="process-heading">
        <h2 id="process-heading" class="text-3xl font-bold text-center mb-10">How We Structure Your PI Cover</h2>
        <div class="space-y-6">
          {[
            { step: 1, title: 'Profession & Exposure Analysis', desc: 'Practice size, revenue, client profile, contract requirements, regulatory mandates, past claims, current retroactive date.' },
            { step: 2, title: 'Limit & Feature Recommendation', desc: 'Optimal limit (not max), retroactive continuity, defense inclusive, run-off period, territory, deductible optimization.' },
            { step: 3, title: 'Insurer Comparison', desc: 'Compare 6+ insurers on: wording breadth, exclusions, claim track record, premium, retroactive flexibility, run-off cost.' },
            { step: 4, title: 'Policy Issuance & Certificate', desc: 'Instant certificate for client/hospital/regulator. Digital policy. Retroactive date endorsement. Run-off quote for future.' },
            { step: 5, title: 'Annual Renewal & Management', desc: 'Revenue update, limit adequacy review, new regulation check, retroactive continuity, claim notification protocol, run-off trigger at retirement.' }
          ].map(s => (
            <div class="flex gap-4 bg-white/5 rounded-2xl p-6 border border-white/10">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/20 flex items-center justify-center text-2xl font-bold text-emerald-300 flex-shrink-0">{s.step}</div>
              <div>
                <h3 class="text-lg font-bold text-white mb-1">{s.title}</h3>
                <p class="text-slate-300 text-sm">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-16" aria-labelledby="quote-heading">
        <h2 id="quote-heading" class="text-3xl font-bold text-center mb-10">Get Your Professional Indemnity Quote</h2>
        <div class="bg-white/5 backdrop-blur-xl rounded-3xl border border-white/10 shadow-2xl p-6 md:p-8 max-w-xl mx-auto">
          <form id="piQuoteForm" class="space-y-5">
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="pi-profession" class="block text-sm font-semibold text-slate-300 mb-2">Profession <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <select id="pi-profession" name="profession" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
                  <option value="">Select</option>
                  <option value="doctor-gp">Doctor - General Practice</option>
                  <option value="doctor-surgeon">Doctor - Surgeon / Specialist</option>
                  <option value="ca">Chartered Accountant</option>
                  <option value="architect">Architect</option>
                  <option value="engineer">Engineer (Civil/Structural/MEP)</option>
                  <option value="lawyer">Lawyer / Advocate</option>
                  <option value="it-consultant">IT / Software Consultant</option>
                  <option value="mgmt-consultant">Management Consultant</option>
                  <option value="other">Other Professional</option>
                </select>
              </div>
              <div>
                <label for="pi-limit" class="block text-sm font-semibold text-slate-300 mb-2">Limit Required <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <select id="pi-limit" name="limit" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
                  <option value="">Select</option>
                  <option value="50L">₹50 Lakh</option>
                  <option value="1Cr">₹1 Crore</option>
                  <option value="2Cr">₹2 Crore</option>
                  <option value="3Cr">₹3 Crore</option>
                  <option value="5Cr">₹5 Crore</option>
                  <option value="10Cr">₹10 Crore</option>
                </select>
              </div>
            </div>
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="pi-retroactive" class="block text-sm font-semibold text-slate-300 mb-2">Retroactive Date Status <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <select id="pi-retroactive" name="retroactive" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
                  <option value="">Select</option>
                  <option value="new">First PI Policy (New)</option>
                  <option value="continuous">Continuous (Switching Insurer)</option>
                  <option value="gap">Gap in Coverage (Need Fix)</option>
                  <option value="runoff">Need Run-Off (Retiring)</option>
                </select>
              </div>
              <div>
                <label for="pi-territory" class="block text-sm font-semibold text-slate-300 mb-2">Territory <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <select id="pi-territory" name="territory" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
                  <option value="">Select</option>
                  <option value="india">India Only</option>
                  <option value="worldwide-excl">Worldwide (excl. USA/Canada)</option>
                  <option value="worldwide-incl">Worldwide (incl. USA/Canada)</option>
                </select>
              </div>
            </div>
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="pi-name" class="block text-sm font-semibold text-slate-300 mb-2">Your Name <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <input type="text" id="pi-name" name="name" autocomplete="name" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="Full name" />
              </div>
              <div>
                <label for="pi-phone" class="block text-sm font-semibold text-slate-300 mb-2">Mobile Number <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <input type="tel" id="pi-phone" name="phone" autocomplete="tel" required pattern="[0-9+ -]{10,15}" class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="+91 XXXXX XXXXX" />
              </div>
            </div>
            <div class="flex items-start gap-3">
              <input type="checkbox" id="pi-dpdp" name="dpdp_consent" required class="mt-1 w-4 h-4 accent-emerald-500 border-white/20 rounded bg-slate-800 focus:ring-2 focus:ring-emerald-400" />
              <label htmlFor="pi-dpdp" class="text-sm text-slate-300">I consent to being contacted per the <a href="/privacy-policy/" class="underline hover:text-emerald-300">Privacy Policy</a> and DPDP Act 2023.</label>
            </div>
            <div class="text-center pt-2">
              <button type="submit" class="w-full md:w-auto px-10 py-4 bg-gradient-to-r from-emerald-400 to-teal-500 hover:from-emerald-500 hover:to-teal-600 text-white font-bold rounded-xl text-lg shadow-xl shadow-emerald-500/20 transition-all hover:scale-[1.02]">
                Get Free PI Comparison
              </button>
            </div>
            <div id="pi-error" class="hidden rounded-xl border border-red-400/40 bg-red-500/10 p-4 text-center text-red-200" role="alert"></div>
          </form>
        </div>
      </section>

      <InsuranceCalculator client:load />
    </div>
  </main>
</BaseLayout>

<script is:inline>
  document.getElementById('piQuoteForm')?.addEventListener('submit', async function (event) {
    event.preventDefault();
    const form = this;
    const button = form.querySelector('button[type="submit"]');
    const error = document.getElementById('pi-error');
    const originalLabel = button.textContent;
    error.classList.add('hidden');
    button.disabled = true;
    button.textContent = 'Sending request...';

    try {
      const values = new FormData(form);
      const response = await fetch('/contact-submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: values.get('name'),
          phone: values.get('phone'),
          category: 'Professional Indemnity',
          message: `PI: ${values.get('profession')}, Limit ${values.get('limit')}, Retroactive ${values.get('retroactive')}, Territory ${values.get('territory')}`,
        }),
      });
      const result = await response.json();
      if (!response.ok || !result.success) {
        throw new Error(result.error || 'We could not send your request. Please try again or call us directly.');
      }
      alert('Thank you! We will send you a professional indemnity comparison within 4 hours.');
      form.reset();
    } catch (submissionError) {
      error.textContent = submissionError.message || 'We could not send your request. Please try again or call us directly.';
      error.classList.remove('hidden');
    } finally {
      button.disabled = false;
      button.textContent = originalLabel;
    }
  });
</script>