---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TrustStrip from '../../../components/TrustStrip';
import InsuranceCalculator from '../../../components/InsuranceCalculator';
---

<BaseLayout
  title="Term Insurance Plans in Bangalore | ₹1Cr Cover from ₹8,000/yr | Insurance Support"
  description="Compare term insurance plans in Bangalore. Pure protection ₹1Cr cover from ~₹8,000/year (age 30, non-smoker). ROP option, terminal illness benefit, tax-free death claim. IRDAI advisor Suhas K."
  canonical="https://insurancesupport.online/services/term-insurance/"
  ogImage="https://insurancesupport.online/images/og/term-insurance.png"
  pageType="service-detail"
  keywords="term insurance Bangalore, buy term plan online, ₹1 crore term insurance premium, return of premium term plan, best term insurance India 2024"
  dateModified="2026-10-22"
  geoPlaceName="Jalahalli, Bengaluru"
  geoPosition="13.0159;77.5522"
  lang="en-IN"
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Term Insurance Advisory",
    "description": "Pure protection term plans with high coverage at low premiums. ₹1Cr cover from ~₹8,000/year (age 30, non-smoker). Return of Premium option, terminal illness benefit, tax-free death claim under Section 10(10D).",
    "url": "https://insurancesupport.online/services/term-insurance/",
    "provider": {
      "@type": "Person",
      "name": "Suhas K.",
      "jobTitle": "IRDAI Certified Insurance Advisor",
      "identifier": "0149161D",
      "worksFor": {
        "@type": "Organization",
        "name": "Insurance Support",
        "url": "https://insurancesupport.online"
      }
    },
    "areaServed": {
      "@type": "City",
      "name": "Bengaluru"
    },
    "offers": {
      "@type": "Offer",
      "name": "Term Insurance Consultation",
      "description": "Free consultation to compare term plans from LIC, HDFC Life, Max Life, ICICI Prudential, TATA AIA, Bajaj Allianz, SBI Life",
      "price": "0",
      "priceCurrency": "INR",
      "availability": "https://schema.org/InStock"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the premium for ₹1 crore term insurance at age 30?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For a 30-year-old non-smoker male, ₹1 crore term cover costs approximately ₹8,000–12,000 per year. Females pay ~10–15% less. Premium varies by insurer, medical history, and riders. Return of Premium (ROP) variants cost 30–50% more."
        }
      },
      {
        "@type": "Question",
        "name": "Should I buy Return of Premium (ROP) term plan?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "ROP returns all premiums if you survive the term, but costs 30–50% more than pure term. Choose pure term if you want maximum cover at lowest cost and will invest the difference. Choose ROP if you prefer forced savings with guaranteed return."
        }
      },
      {
        "@type": "Question",
        "name": "Can I buy term insurance online without medical tests?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Up to ₹50–75 lakh cover, many insurers offer tele-medical or no-medical up to age 40–45. Above ₹1 crore or age 45+, medical tests (blood, urine, ECG) are usually required. We coordinate home-collection for convenience."
        }
      },
      {
        "@type": "Question",
        "name": "What riders should I add to my term plan?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Recommended: Critical Illness (lump sum on diagnosis), Accidental Death Benefit (extra payout), Waiver of Premium (premiums waived on disability). Avoid: Hospital Cash, Surgical Benefit — better covered by health insurance."
        }
      },
      {
        "@type": "Question",
        "name": "Is term insurance claim tax-free?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Death benefit is tax-free under Section 10(10D) for policies issued after 1 April 2003 (premium ≤10% of sum assured). Maturity benefit (ROP plans) is also tax-free if conditions met. No TDS on death claims."
        }
      }
    ]
  })} />

  <main id="main" class="min-h-screen bg-slate-900 text-white relative overflow-hidden pt-16 pb-24">
    <div class="absolute top-0 right-0 w-96 h-96 bg-emerald-500/10 rounded-full blur-[120px] pointer-events-none" />
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

      <nav class="text-sm text-slate-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-300">Home</a>
        <span class="mx-2">›</span>
        <a href="/services/" class="hover:text-amber-300">Services</a>
        <span class="mx-2">›</span>
        <span class="text-slate-200" aria-current="page">Term Insurance</span>
      </nav>

      <!-- ===== HERO ===== -->
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-400/20 text-emerald-300 text-sm font-semibold mb-4 border border-emerald-400/30">
          Pure Protection · ₹1Cr from ₹8,000/yr · Tax-Free Claim
        </span>
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4" style="font-family: 'Plus Jakarta Sans', sans-serif;">
          Term Insurance <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">Plans</span>
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Highest coverage at lowest cost. Pure protection for your family's financial future. No investment component — only what matters: a tax-free lump sum if you're not there.
        </p>
      </div>

      <TrustStrip client:visible />

      <!-- ===== QUICK COMPARISON ===== -->
      <section class="mb-12" aria-labelledby="comparison-heading">
        <h2 id="comparison-heading" class="text-2xl font-bold text-center mb-8">Top Term Plans Comparison (₹1Cr, Age 30, Non-Smoker Male)</h2>
        <div class="overflow-x-auto rounded-2xl border border-white/10">
          <table class="w-full min-w-[700px] text-sm text-slate-200">
            <thead class="bg-white/5">
              <tr class="border-b border-white/10">
                <th class="text-left p-4 font-semibold">Insurer</th>
                <th class="text-left p-4 font-semibold">Annual Premium</th>
                <th class="text-left p-4 font-semibold">Claim Settlement Ratio</th>
                <th class="text-left p-4 font-semibold">Key Feature</th>
                <th class="text-left p-4 font-semibold">Best For</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">HDFC Life Click 2 Protect</td><td class="p-4">~₹9,500</td><td class="p-4">99.4%</td><td class="p-4">Life stage cover increase</td><td class="p-4">Young families</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Max Life Smart Secure Plus</td><td class="p-4">~₹8,800</td><td class="p-4">99.5%</td><td class="p-4">Terminal illness + disability</td><td class="p-4">Comprehensive riders</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">ICICI Pru iProtect Smart</td><td class="p-4">~₹9,200</td><td class="p-4">97.9%</td><td class="p-4">Return of premium option</td><td class="p-4">ROP seekers</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">TATA AIA Sampoorna Raksha</td><td class="p-4">~₹8,500</td><td class="p-4">99.1%</td><td class="p-4">Whole life option (99 yrs)</td><td class="p-4">Lifelong cover</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">Bajaj Allianz Life Smart Protect</td><td class="p-4">~₹9,000</td><td class="p-4">98.5%</td><td class="p-4">Child education benefit</td><td class="p-4">Parents with kids</td></tr>
              <tr class="hover:bg-white/5"><td class="p-4 font-medium">LIC Tech Term</td><td class="p-4">~₹11,500</td><td class="p-4">98.3%</td><td class="p-4">Trusted brand, offline support</td><td class="p-4">Traditional buyers</td></tr>
            </tbody>
          </table>
        </div>
        <p class="text-center text-sm text-slate-400 mt-3">Premiums indicative (Oct 2024). Actual premium varies by health, lifestyle, and underwriting. <a href="/get-started/" class="text-emerald-300 hover:underline">Get personalized quote →</a></p>
      </section>

      <!-- ===== KEY FEATURES ===== -->
      <section class="mb-16" aria-labelledby="features-heading">
        <h2 id="features-heading" class="text-3xl font-bold text-center mb-10">Why Term Insurance is the Foundation of Financial Planning</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
            <h3 class="text-xl font-bold text-emerald-300 mb-3 flex items-center gap-2">💰 Lowest Cost per ₹Lakh Cover</h3>
            <p class="text-slate-300">₹1Cr pure term costs ~₹800–1,000/month. Same cover via endowment would cost ₹7,000–10,000/month. Invest the difference in mutual funds for better returns.</p>
          </div>
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
            <h3 class="text-xl font-bold text-emerald-300 mb-3 flex items-center gap-2">🎯 Pure Protection, No Confusion</h3>
            <p class="text-slate-300">No maturity value to track, no fund performance risk. One job: pay claim if you die during term. Simple, transparent, claim-friendly.</p>
          </div>
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
            <h3 class="text-xl font-bold text-emerald-300 mb-3 flex items-center gap-2">🏥 Terminal Illness Benefit</h3>
            <p class="text-slate-300">Most plans pay 50–100% of sum assured on diagnosis of terminal illness (life expectancy <12 months). Funds treatment or family needs while alive.</p>
          </div>
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
            <h3 class="text-xl font-bold text-emerald-300 mb-3 flex items-center gap-2">📊 Life Stage Cover Increase</h3>
            <p class="text-slate-300">Increase cover by 25–50% on marriage, childbirth, home loan — no medical re-underwriting. Keeps protection aligned with responsibilities.</p>
          </div>
        </div>
      </section>

      <!-- ===== RIDERS DEEP DIVE ===== -->
      <section class="mb-16" aria-labelledby="riders-heading">
        <h2 id="riders-heading" class="text-3xl font-bold text-center mb-10">Recommended Riders (Add-ons)</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
            <h3 class="text-lg font-bold text-white mb-3 flex items-center gap-2">🏥 Critical Illness</h3>
            <p class="text-slate-300 text-sm mb-2">Lump sum on diagnosis of cancer, heart attack, stroke, kidney failure (25–40 conditions). Use for treatment, income replacement, loan repayment.</p>
            <span class="text-xs text-emerald-300">Cost: ~₹800–1,500/yr for ₹25L</span>
          </div>
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
            <h3 class="text-lg font-bold text-white mb-3 flex items-center gap-2">🛡️ Accidental Death Benefit</h3>
            <p class="text-slate-300 text-sm mb-2">Extra 100% of base sum assured on accidental death. ₹1Cr base + ₹1Cr ADB = ₹2Cr to nominees. Covers road, rail, air, drowning accidents.</p>
            <span class="text-xs text-emerald-300">Cost: ~₹500–800/yr per ₹1Cr</span>
          </div>
          <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
            <h3 class="text-lg font-bold text-white mb-3 flex items-center gap-2">💸 Waiver of Premium</h3>
            <p class="text-slate-300 text-sm mb-2">All future premiums waived on total permanent disability or critical illness. Policy continues with full benefits. Essential for single-income households.</p>
            <span class="text-xs text-emerald-300">Cost: ~₹300–500/yr</span>
          </div>
        </div>
      </section>

      <!-- ===== BUYING PROCESS ===== -->
      <section class="mb-16" aria-labelledby="process-heading">
        <h2 id="process-heading" class="text-3xl font-bold text-center mb-10">How We Help You Buy the Right Term Plan</h2>
        <div class="space-y-6">
          {[
            { step: 1, title: 'Need Assessment', desc: 'Calculate human life value: 15–20x annual income + outstanding loans + future goals (education, marriage) - existing assets.' },
            { step: 2, title: 'Plan Shortlisting', desc: 'Compare 8–10 plans on premium, CSR, riders, claim process, brand trust. We shortlist 3 best-fit options with pros/cons.' },
            { step: 3, title: 'Application & Medical', desc: 'Fill proposal form, schedule home medical (blood, urine, ECG). We coordinate with insurer\'s empaneled diagnostic centers.' },
            { step: 4, title: 'Underwriting & Policy', desc: 'Insurer evaluates risk. May apply loading (higher premium) or counter-offer. We negotiate and explain terms before you accept.' },
            { step: 5, title: 'Ongoing Support', desc: 'Nominee registration, policy document storage, annual review reminder, claim assistance for family. We\'re there when it matters.' }
          ].map(s => (
            <div class="flex gap-4 bg-white/5 rounded-2xl p-6 border border-white/10">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/20 flex items-center justify-center text-2xl font-bold text-emerald-300 flex-shrink-0">{s.step}</div>
              <div>
                <h3 class="text-lg font-bold text-white mb-1">{s.title}</h3>
                <p class="text-slate-300 text-sm">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ===== LEAD FORM ===== -->
      <section class="mb-16" aria-labelledby="quote-heading">
        <h2 id="quote-heading" class="text-3xl font-bold text-center mb-10">Get Your Personalized Term Insurance Quote</h2>
        <div class="bg-white/5 backdrop-blur-xl rounded-3xl border border-white/10 shadow-2xl p-6 md:p-8 max-w-xl mx-auto">
          <form id="termQuoteForm" class="space-y-5">
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="age" class="block text-sm font-semibold text-slate-300 mb-2">Age <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <input type="number" id="age" name="age" min="18" max="65" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="30" />
              </div>
              <div>
                <label for="gender" class="block text-sm font-semibold text-slate-300 mb-2">Gender <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <select id="gender" name="gender" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
                  <option value="">Select</option>
                  <option value="Male">Male</option>
                  <option value="Female">Female</option>
                </select>
              </div>
            </div>
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="smoker" class="block text-sm font-semibold text-slate-300 mb-2">Tobacco Use <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <select id="smoker" name="smoker" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
                  <option value="">Select</option>
                  <option value="Non-smoker">Non-smoker</option>
                  <option value="Smoker">Smoker / Tobacco user</option>
                </select>
              </div>
              <div>
                <label for="cover" class="block text-sm font-semibold text-slate-300 mb-2">Cover Amount <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <select id="cover" name="cover" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
                  <option value="">Select</option>
                  <option value="50L">₹50 Lakh</option>
                  <option value="75L">₹75 Lakh</option>
                  <option value="1Cr">₹1 Crore</option>
                  <option value="1.5Cr">₹1.5 Crore</option>
                  <option value="2Cr">₹2 Crore</option>
                </select>
              </div>
            </div>
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="t-name" class="block text-sm font-semibold text-slate-300 mb-2">Your Name <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <input type="text" id="t-name" name="name" autocomplete="name" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="Full name" />
              </div>
              <div>
                <label for="t-phone" class="block text-sm font-semibold text-slate-300 mb-2">Mobile Number <span class="text-emerald-400" aria-hidden="true">*</span></label>
                <input type="tel" id="t-phone" name="phone" autocomplete="tel" required pattern="[0-9+ -]{10,15}" class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="+91 XXXXX XXXXX" />
              </div>
            </div>
            <div class="flex items-start gap-3">
              <input type="checkbox" id="t-dpdp" name="dpdp_consent" required class="mt-1 w-4 h-4 accent-emerald-500 border-white/20 rounded bg-slate-800 focus:ring-2 focus:ring-emerald-400" />
              <label htmlFor="t-dpdp" class="text-sm text-slate-300">I consent to being contacted per the <a href="/privacy-policy/" class="underline hover:text-emerald-300">Privacy Policy</a> and DPDP Act 2023.</label>
            </div>
            <div class="text-center pt-2">
              <button type="submit" class="w-full md:w-auto px-10 py-4 bg-gradient-to-r from-emerald-400 to-teal-500 hover:from-emerald-500 hover:to-teal-600 text-white font-bold rounded-xl text-lg shadow-xl shadow-emerald-500/20 transition-all hover:scale-[1.02]">
                Get Free Quote & Comparison
              </button>
            </div>
            <div id="t-error" class="hidden rounded-xl border border-red-400/40 bg-red-500/10 p-4 text-center text-red-200" role="alert"></div>
          </form>
        </div>
      </section>

      <InsuranceCalculator client:load />
    </div>
  </main>
</BaseLayout>

<script is:inline>
  document.getElementById('termQuoteForm')?.addEventListener('submit', async function (event) {
    event.preventDefault();
    const form = this;
    const button = form.querySelector('button[type="submit"]');
    const error = document.getElementById('t-error');
    const originalLabel = button.textContent;
    error.classList.add('hidden');
    button.disabled = true;
    button.textContent = 'Sending request...';

    try {
      const values = new FormData(form);
      const response = await fetch('/contact-submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: values.get('name'),
          phone: values.get('phone'),
          category: 'Term Insurance',
          message: `Term quote request: Age ${values.get('age')}, ${values.get('gender')}, ${values.get('smoker')}, Cover ${values.get('cover')}`,
        }),
      });
      const result = await response.json();
      if (!response.ok || !result.success) {
        throw new Error(result.error || 'We could not send your request. Please try again or call us directly.');
      }
      alert('Thank you! We will send you a personalized term insurance comparison within 4 hours.');
      form.reset();
    } catch (submissionError) {
      error.textContent = submissionError.message || 'We could not send your request. Please try again or call us directly.';
      error.classList.remove('hidden');
    } finally {
      button.disabled = false;
      button.textContent = originalLabel;
    }
  });
</script>