<script is:inline>
  // Radio group visual feedback for service form
  document.querySelectorAll('#service-category-options input[type="radio"]').forEach(radio => {
    radio.addEventListener('change', () => {
      document.querySelectorAll('#service-category-options label').forEach(l => l.classList.remove('ring-2', 'ring-emerald-400'));
      radio.closest('label')?.classList.add('ring-2', 'ring-emerald-400');
    });
  });

  document.getElementById('serviceQuoteForm')?.addEventListener('submit', async function (event) {
    event.preventDefault();
    const form = this;
    const button = form.querySelector('button[type="submit"]');
    const error = document.getElementById('svc-error');
    const originalLabel = button.textContent;
    error.classList.add('hidden');
    button.disabled = true;
    button.textContent = 'Sending request...';

    try {
      const values = new FormData(form);
      const response = await fetch('/contact-submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: values.get('name'),
          phone: values.get('phone'),
          category: values.get('service_category'),
          message: `Service inquiry: ${values.get('service_category')}`,
        }),
      });
      const result = await response.json();
      if (!response.ok || !result.success) {
        throw new Error(result.error || 'We could not send your request. Please try again or call us directly.');
      }
      alert('Thank you! We will contact you shortly about your ' + values.get('service_category') + ' inquiry.');
      form.reset();
    } catch (submissionError) {
      error.textContent = submissionError.message || 'We could not send your request. Please try again or call us directly.';
      error.classList.remove('hidden');
    } finally {
      button.disabled = false;
      button.textContent = originalLabel;
    }
  });
</script>
