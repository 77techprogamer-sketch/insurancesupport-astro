---
import GoogleRating from '../components/GoogleRating.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbJsonLd from '../components/BreadcrumbJsonLd.astro';
import FAQPageJsonLd from '../components/FAQPageJsonLd.astro';
import GoogleReviewCta from '../components/GoogleReviewCta.astro';

const pageUrl = 'https://insurancesupport.online/bangalore/';

// Areas with their own pages. The nine neighbourhoods that are indexed, plus
// the wider Bengaluru location pages.
const neighbourhoods = [
  { name: 'Koramangala', url: '/cities/koramangala/' },
  { name: 'Indiranagar', url: '/cities/indiranagar/' },
  { name: 'Whitefield', url: '/cities/whitefield/' },
  { name: 'HSR Layout', url: '/cities/hsr-layout/' },
  { name: 'Jayanagar', url: '/cities/jayanagar/' },
  { name: 'JP Nagar', url: '/cities/j-p-nagar/' },
  { name: 'Marathahalli', url: '/cities/marathahalli/' },
  { name: 'Bellandur', url: '/cities/bellandur/' },
  { name: 'Yelahanka', url: '/cities/yelahanka/' },
];

const widerAreas = [
  { name: 'Electronic City', url: '/cities/electronic-city/' },
  { name: 'Hebbal', url: '/cities/hebbal/' },
  { name: 'Malleshwaram', url: '/cities/malleshwaram/' },
  { name: 'Rajajinagar', url: '/cities/rajajinagar/' },
  { name: 'Padmanabha Nagar', url: '/cities/padmanabha-nagar/' },
  { name: 'Wilson Garden', url: '/cities/wilson-garden/' },
  { name: 'BTM Layout', url: '/cities/btm-layout/' },
  { name: 'Hoodi', url: '/cities/hoodi/' },
  { name: 'KR Puram', url: '/cities/kr-puram/' },
  { name: 'Domlur', url: '/cities/domlur/' },
  { name: 'Richmond Town', url: '/cities/richmond-town/' },
  { name: 'Yeshwanthpur', url: '/cities/yeshwantpur/' },
];

const localGuides = [
  {
    title: 'Insurance Ombudsman in Bangalore',
    url: '/blog/insurance-ombudsman-bangalore-guide-2026/',
    note: 'The Karnataka office, the one-year window and what happens at a hearing.',
  },
  {
    title: 'LIC claim rejected — the appeal route',
    url: '/blog/lic-claim-rejection-appeal-process-2026/',
    note: 'Section 45, the grievance officer and the LIC divisional office that holds the file.',
  },
  {
    title: 'Cashless authorisation refused at the hospital',
    url: '/blog/icici-lombard-cashless-denied-hospital-guide-2026/',
    note: 'What to ask the insurance desk for, and how reimbursement survives a cashless refusal.',
  },
  {
    title: 'Car insurance renewal in Bangalore',
    url: '/blog/car-insurance-renewal-online-bangalore/',
    note: 'No-claim bonus, inspection and the renewal gaps that void a motor claim.',
  },
  {
    title: 'Bima Bharosa: filing on IRDAI\'s portal',
    url: '/blog/irdai-bima-bharosa-complaint-filing-2026/',
    note: 'The complaint that makes an insurer answer, and when to move to the Ombudsman.',
  },
  {
    title: 'All guides by topic',
    url: '/guides/',
    note: 'Six clusters covering rejection, escalation, LIC, health, motor and NRI cover.',
  },
];

const faqs = [
  {
    question: 'Which Insurance Ombudsman office covers Bangalore?',
    answer:
      'Complaints from Karnataka go to the Bengaluru office of the Insurance Ombudsman, which also covers Goa. Jurisdiction follows your address and the insurer\'s office involved, so confirm the current zone on the Council for Insurance Ombudsmen site before filing. The office address and contact details are in the Bangalore Ombudsman guide on this site.',
  },
  {
    question: 'Do I have to visit in person, or can this be handled remotely?',
    answer:
      'Almost everything is handled remotely: documents are shared by email or WhatsApp, and the Ombudsman increasingly hears matters by video. If you prefer to meet in Bengaluru, say so when you write in and a time is fixed.',
  },
  {
    question: 'Which parts of Bangalore do you cover?',
    answer:
      'The whole city. Neighbourhood pages exist for Koramangala, Indiranagar, Whitefield, HSR Layout, Jayanagar, JP Nagar, Marathahalli, Bellandur and Yelahanka, and the wider area pages cover Electronic City, Hebbal, Malleshwaram, Rajajinagar and others. The work is the same wherever in the city you are.',
  },
  {
    question: 'Is the first consultation free?',
    answer:
      'Yes. Send the rejection letter and the policy schedule and you get a plain answer about whether the decision holds, which forum applies and what the next document is. No fee is charged for that first read, and any fee is agreed in writing before work starts.',
  },
  {
    question: 'Does the state I bought the policy in matter?',
    answer:
      'For a Bengaluru resident, the Karnataka Ombudsman zone normally applies even if the policy was sold elsewhere, because jurisdiction follows your address and the insurer\'s office handling the claim. A policy bought in another state does not send you to another state\'s forum.',
  },
];

const faqSchema = faqs.map((f) => ({ question: f.question, answer: f.answer }));

---

<BaseLayout
  title="Insurance Claim Help in Bengaluru | Insurance Support"
  description="Bengaluru-based help with rejected insurance claims: the Karnataka Ombudsman, LIC appeals, cashless refusals and policy disputes. First review free."
  pageType="city"
  keywords="insurance claim help Bangalore, insurance ombudsman Bangalore, LIC claim rejected Bangalore, cashless denied hospital Bengaluru, insurance advisor Bengaluru"
  canonical={pageUrl}
>
  <BreadcrumbJsonLd items={[
    { label: 'Home', url: 'https://insurancesupport.online/' },
    { label: 'Bengaluru', url: pageUrl },
  ]} />
  <FAQPageJsonLd questions={faqSchema} />

  <main id="main">
    <!-- Hero -->
    <section class="bg-gradient-to-br from-slate-900 via-slate-800 to-blue-900 text-white">
      <div class="max-w-5xl mx-auto px-4 py-16 lg:py-20">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-300 mb-4">Bengaluru · Priority city</p>
        <h1 class="text-3xl lg:text-5xl font-bold leading-tight mb-5">Insurance claim help in Bengaluru</h1>
        <p class="text-lg text-slate-200 max-w-3xl mb-4">
          <strong class="text-white">If an insurer has refused, reduced or delayed a claim in Bengaluru, the route is fixed and free for the first three steps:</strong>
          written reasons from the insurer, a complaint to its Grievance Redressal Officer (14 days), then IRDAI's Bima Bharosa, then the Insurance Ombudsman in Bengaluru — within one year, without a lawyer, for claims up to ₹50 lakh.
        </p>
        <p class="text-slate-300 max-w-3xl mb-8">
          This is the Bengaluru side of that work: the Karnataka Ombudsman office, the LIC divisional offices that hold claim files, the hospitals where cashless authorisation is refused, and the dealers and garages where motor claims stall.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/contact" class="inline-flex justify-center items-center gap-2 px-6 py-3 bg-amber-400 text-slate-900 font-bold rounded-lg hover:bg-amber-300 transition-colors">
            Send the rejection letter — first read free
          </a>
          <a href="tel:+919986634506" class="inline-flex justify-center items-center gap-2 px-6 py-3 bg-white/10 border border-white/25 text-white font-semibold rounded-lg hover:bg-white/20 transition-colors">
            Call +91 99866 34506
          </a>
        </div>
        <div class="mt-8 text-slate-200">
          <GoogleRating />
        </div>
      </div>
    </section>

    <!-- What is local -->
    <section class="max-w-5xl mx-auto px-4 py-14">
      <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 mb-6">What is specific to Bengaluru</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <article class="rounded-2xl border border-slate-200 p-6 bg-white">
          <h3 class="font-bold text-slate-900 mb-2">The Ombudsman office is here</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            The Insurance Ombudsman for Karnataka sits in Bengaluru, in JP Nagar 1st Phase. A complaint can be filed online, by post or in person, and the hearing may be by video. The award binds the insurer once you accept it, and payment is due within 30 days.
          </p>
          <a href="/blog/insurance-ombudsman-bangalore-guide-2026/" class="inline-block mt-3 text-sm font-semibold text-blue-700 hover:underline">The Bangalore Ombudsman guide →</a>
        </article>
        <article class="rounded-2xl border border-slate-200 p-6 bg-white">
          <h3 class="font-bold text-slate-900 mb-2">LIC files sit with divisional offices</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            A LIC death claim is handled by the divisional office that services the policy, not the branch that sold it. Knowing which office holds the file, and writing to its Grievance Redressal Officer rather than the branch, is the difference between a reply in two weeks and silence.
          </p>
          <a href="/blog/lic-claim-rejection-appeal-process-2026/" class="inline-block mt-3 text-sm font-semibold text-blue-700 hover:underline">The LIC appeal process →</a>
        </article>
        <article class="rounded-2xl border border-slate-200 p-6 bg-white">
          <h3 class="font-bold text-slate-900 mb-2">Cashless desks refuse on the spot</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            In Bengaluru's corporate hospitals the refusal usually happens at the insurance desk, in the hour before a planned procedure. A refusal is not a claim decision: ask for it in writing with the clause, then claim reimbursement if treatment cannot wait.
          </p>
          <a href="/blog/icici-lombard-cashless-denied-hospital-guide-2026/" class="inline-block mt-3 text-sm font-semibold text-blue-700 hover:underline">When cashless is refused →</a>
        </article>
        <article class="rounded-2xl border border-slate-200 p-6 bg-white">
          <h3 class="font-bold text-slate-900 mb-2">Motor claims turn on paperwork</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            A lapsed renewal, a surveyor's estimate below the repair cost, or a garage that will not release the vehicle without a settlement letter — each has a document that fixes it. The no-claim bonus and the inspection requirement cause most of the avoidable losses.
          </p>
          <a href="/blog/car-insurance-renewal-online-bangalore/" class="inline-block mt-3 text-sm font-semibold text-blue-700 hover:underline">Motor renewal in Bangalore →</a>
        </article>
      </div>
    </section>

    <!-- Areas -->
    <section class="bg-slate-50 border-y border-slate-200">
      <div class="max-w-5xl mx-auto px-4 py-14">
        <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 mb-2">Areas served in Bengaluru</h2>
        <p class="text-slate-600 mb-6 max-w-3xl">The work is remote-first, so the neighbourhood matters less than the documents. These pages exist because people search for their own area, and because local rules — which Ombudsman zone, which divisional office,which hospital network — are easier to explain in one place.</p>

        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-500 mb-3">Neighbourhood guides</h3>
        <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2 mb-8">
          {neighbourhoods.map((n) => (
            <li><a href={n.url} class="block px-3 py-2 rounded-lg bg-white border border-slate-200 text-sm font-medium text-slate-800 hover:border-blue-400 hover:text-blue-700 transition-colors">{n.name}</a></li>
          ))}
        </ul>

        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-500 mb-3">Wider Bengaluru</h3>
        <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2">
          {widerAreas.map((n) => (
            <li><a href={n.url} class="block px-3 py-2 rounded-lg bg-white border border-slate-200 text-sm text-slate-700 hover:border-blue-400 hover:text-blue-700 transition-colors">{n.name}</a></li>
          ))}
        </ul>
        <p class="mt-6 text-sm text-slate-500">
          Not listed? The <a href="/locations/" class="text-blue-700 underline">locations index</a> covers every city we serve, and Bengaluru work is not limited to these areas.
        </p>
      </div>
    </section>

    <!-- Local guides -->
    <section class="max-w-5xl mx-auto px-4 py-14">
      <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 mb-6">Start with the guide that matches your letter</h2>
      <ul class="grid md:grid-cols-2 gap-4">
        {localGuides.map((g) => (
          <li class="rounded-xl border border-slate-200 p-5 bg-white hover:border-blue-300 transition-colors">
            <a href={g.url} class="font-semibold text-slate-900 hover:text-blue-700">{g.title}</a>
            <p class="text-sm text-slate-600 mt-1">{g.note}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- How it works -->
    <section class="bg-white border-t border-slate-200">
      <div class="max-w-5xl mx-auto px-4 py-14">
        <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 mb-6">How a Bengaluru file usually runs</h2>
        <ol class="space-y-4 max-w-3xl">
          <li class="flex gap-4"><span class="shrink-0 w-9 h-9 rounded-full bg-blue-600 text-white grid place-items-center font-bold">1</span><div><strong class="text-slate-900">Send the documents.</strong> The rejection letter, the policy schedule and the claim file. The first read is free and the answer is a yes, a no, or "this needs one more document".</div></li>
          <li class="flex gap-4"><span class="shrink-0 w-9 h-9 rounded-full bg-blue-600 text-white grid place-items-center font-bold">2</span><div><strong class="text-slate-900">The written grievance goes out.</strong> To the Grievance Redressal Officer, with an indexed document list and the specific clause the insurer relied on. 14 days is the clock.</div></li>
          <li class="flex gap-4"><span class="shrink-0 w-9 h-9 rounded-full bg-blue-600 text-white grid place-items-center font-bold">3</span><div><strong class="text-slate-900">Escalation, if the reply is silence or a template.</strong> Bima Bharosa for the record, then the Ombudsman in Bengaluru within one year of the final reply.</div></li>
          <li class="flex gap-4"><span class="shrink-0 w-9 h-9 rounded-full bg-blue-600 text-white grid place-items-center font-bold">4</span><div><strong class="text-slate-900">The award, and the payment.</strong> Accepted in writing within 30 days, paid within 30 days of acceptance, and ₹5,000 a day if it is not.</div></li>
        </ol>
      </div>
    </section>

    <!-- FAQ -->
    <section class="max-w-5xl mx-auto px-4 py-14">
      <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 mb-6">Bengaluru questions</h2>
      <div class="space-y-3 max-w-3xl">
        {faqs.map((f) => (
          <details class="group rounded-xl border border-slate-200 bg-white p-5">
            <summary class="cursor-pointer font-semibold text-slate-900 list-none flex justify-between gap-4">
              {f.question}
              <span class="text-blue-600 group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-slate-600 text-sm leading-relaxed">{f.answer}</p>
          </details>
        ))}
      </div>

      <GoogleReviewCta
        heading="Helped in Bengaluru? Leave a Google review"
        body="Most people find this service by searching their own city. A short review is what lets the next Bengaluru family find it."
      />
    </section>

    <!-- Rest of India -->
    <section class="bg-slate-900 text-white">
      <div class="max-w-5xl mx-auto px-4 py-12">
        <h2 class="text-xl font-bold mb-3">Outside Bengaluru</h2>
        <p class="text-slate-300 text-sm max-w-3xl mb-4">
          Bengaluru is where the office is, and it gets the first attention. The rest of India is served the same way, remotely, with the Ombudsman zone that matches the policyholder's address. The rules are national; only the forum changes.
        </p>
        <div class="flex flex-wrap gap-3 text-sm">
          <a href="/locations/" class="px-4 py-2 rounded-lg bg-white/10 border border-white/20 hover:bg-white/20">All cities</a>
          <a href="/guides/" class="px-4 py-2 rounded-lg bg-white/10 border border-white/20 hover:bg-white/20">Guides by topic</a>
          <a href="/claim-recovery/" class="px-4 py-2 rounded-lg bg-white/10 border border-white/20 hover:bg-white/20">Claim recovery hub</a>
          <a href="/contact" class="px-4 py-2 rounded-lg bg-amber-400 text-slate-900 font-semibold hover:bg-amber-300">Contact</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
