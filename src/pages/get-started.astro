---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/sections/ContactSection.astro';
---

<BaseLayout 
  title="Request an Insurance Call Back | Insurance Support"
  description="Request a free insurance consultation from Hari Kotian, an IRDAI-registered advisor based in Bengaluru. Share your insurance need and preferred contact number."
>
  <main id="main" class="min-h-screen bg-slate-900 text-white relative overflow-hidden pt-16 pb-24">
    <div class="absolute top-0 right-0 w-96 h-96 bg-emerald-500/10 rounded-full blur-[120px] pointer-events-none" />
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

      <nav class="text-sm text-slate-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-300">Home</a>
        <span class="mx-2">›</span>
        <span class="text-slate-200" aria-current="page">Get Free Quote</span>
      </nav>

      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-400/20 text-emerald-300 text-sm font-semibold mb-4 border border-emerald-400/30">
          Free, No-Obligation Consultation
        </span>
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4">
          Request a <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">Call Back</span>
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Tell us what you need help with and the best number to reach you. Hari Kotian or an advisor will follow up about your request.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12" aria-label="Types of insurance support available">
        <div class="bg-white/5 rounded-2xl p-4 text-center border border-white/10"><div class="text-lg font-bold text-amber-300">Policy guidance</div><div class="text-xs text-slate-400 mt-1">Understand coverage and terms</div></div>
        <div class="bg-white/5 rounded-2xl p-4 text-center border border-white/10"><div class="text-lg font-bold text-amber-300">Claim support</div><div class="text-xs text-slate-400 mt-1">Organize documents and questions</div></div>
        <div class="bg-white/5 rounded-2xl p-4 text-center border border-white/10"><div class="text-lg font-bold text-amber-300">Insurer follow-up</div><div class="text-xs text-slate-400 mt-1">Understand available next steps</div></div>
        <div class="bg-white/5 rounded-2xl p-4 text-center border border-white/10"><div class="text-lg font-bold text-amber-300">Bengaluru</div><div class="text-xs text-slate-400 mt-1">Based in Jalahalli</div></div>
      </div>

      <!-- Quote form -->
      <div class="bg-white/5 backdrop-blur-xl rounded-3xl border border-white/10 shadow-2xl p-8 md:p-10 mb-14">
        <h2 class="text-2xl font-bold text-white mb-6 text-center">Request a Free Consultation</h2>
        <form id="quoteForm" class="grid md:grid-cols-2 gap-6">
          <div class="md:col-span-2">
            <label for="quote-type" class="block text-sm font-semibold text-slate-300 mb-2">Select Insurance Need</label>
            <select id="quote-type" name="category" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none">
              <option value="">Select your insurance need</option>
              <option>Term Insurance</option>
              <option>Health Insurance</option>
              <option>Life Insurance</option>
              <option>Motor Insurance</option>
              <option>Pension / Retirement Plans</option>
              <option>Child Education Plan</option>
              <option>SME / Business Insurance</option>
              <option>Claim Support / Rejected Claim</option>
              <option>Policy Review</option>
              <option>Other</option>
            </select>
          </div>
          <div>
            <label for="quote-name" class="block text-sm font-semibold text-slate-300 mb-2">Your Name</label>
            <input type="text" id="quote-name" name="name" autocomplete="name" required class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="Full name" />
          </div>
          <div>
            <label for="quote-phone" class="block text-sm font-semibold text-slate-300 mb-2">Mobile Number</label>
            <input type="tel" id="quote-phone" name="phone" autocomplete="tel" required pattern="[0-9+ -]{10,15}" class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-white/10 text-white focus:border-emerald-400 focus:outline-none" placeholder="+91 XXXXX XXXXX" />
          </div>
          <div class="md:col-span-2 text-center pt-2">
            <button type="submit" class="w-full md:w-auto px-10 py-4 bg-gradient-to-r from-emerald-400 to-teal-500 hover:from-emerald-500 hover:to-teal-600 text-white font-bold rounded-xl text-lg shadow-xl shadow-emerald-500/20 transition-all hover:scale-[1.02]">
              Request a Call Back
            </button>
            <p class="text-xs text-slate-400 mt-4">Your details will be used to respond to this request. See our <a class="underline hover:text-white" href="/privacy-policy/">Privacy Policy</a>.</p>
          </div>
          <div id="quote-error" class="hidden md:col-span-2 rounded-xl border border-red-400/40 bg-red-500/10 p-4 text-center text-red-200" role="alert"></div>
        </form>
        <div id="quote-success" class="hidden text-center py-10">
          <div class="text-5xl mb-4">✅</div>
          <h3 class="text-2xl font-bold text-white mb-3">Thank You!</h3>
          <p class="text-slate-300 mb-6">Your request has been received. Hari Kotian or an advisor will contact you about your insurance need.</p>
          <a href="tel:+919986634506" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-900 font-bold rounded-xl text-lg hover:scale-[1.02] transition-all">
            Or Call Now: +91-9986634506
          </a>
        </div>
      </div>

      <ContactSection />
    </div>
  </main>
</BaseLayout>

<script is:inline>
  document.getElementById('quoteForm')?.addEventListener('submit', async function (event) {
    event.preventDefault();
    const form = this;
    const button = form.querySelector('button[type="submit"]');
    const error = document.getElementById('quote-error');
    const originalLabel = button.textContent;
    error.classList.add('hidden');
    button.disabled = true;
    button.textContent = 'Sending request…';

    try {
      const values = new FormData(form);
      const response = await fetch('/contact-submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: values.get('name'),
          phone: values.get('phone'),
          category: values.get('category'),
          message: `Consultation request: ${values.get('category')}`,
        }),
      });
      const result = await response.json();
      if (!response.ok || !result.success) {
        throw new Error(result.error || 'We could not send your request. Please try again or call us directly.');
      }

      form.classList.add('hidden');
      document.getElementById('quote-success').classList.remove('hidden');
    } catch (submissionError) {
      error.textContent = submissionError.message || 'We could not send your request. Please try again or call us directly.';
      error.classList.remove('hidden');
    } finally {
      button.disabled = false;
      button.textContent = originalLabel;
    }
  });
</script>
