---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbJsonLd from '../components/BreadcrumbJsonLd.astro';
import FAQPageJsonLd from '../components/FAQPageJsonLd.astro';
import LocalBusinessJsonLd from '../components/LocalBusinessJsonLd.astro';
import Icon from '../components/icons/Icon.astro';

const pageTitle = 'Insurance Support | IRDAI-Registered Claim Advisory & Recovery Services India';
const pageDescription = 'Insurance Support by Hari Kotian (IRDAI Reg: 0149161D) provides expert claim assistance for health, life, motor, and term insurance. Free case review. Pan-India service from Bengaluru.';
const pageKeywords = 'insurance support, insurance claim help, IRDAI advisor, claim recovery India, insurance advisory services, claim rejection appeal';

const pageDateModified = new Date().toISOString().split('T')[0];

const pillars = [
  {
    title: 'Health & Mediclaim Claim Support',
    description: 'Cashless denial, room-rent capping, pre-existing disease exclusions, non-disclosure allegations — we handle every health claim dispute.',
    icon: 'heart-pulse',
    href: '/services/health-insurance',
    keywords: ['health insurance claim', 'cashless claim rejected', 'pre-existing disease', 'room rent limit', 'IRDAI health claim']
  },
  {
    title: 'Life & Term Insurance Claim Support',
    description: 'Death claim repudiation, contestability period disputes, nominee conflicts, mis-selling — 25+ years of LIC and private insurer experience.',
    icon: 'user-check',
    href: '/services/life-insurance',
    keywords: ['life insurance claim', 'term insurance claim', 'death claim rejected', 'LIC claim help', 'nominee dispute']
  },
  {
    title: 'Motor Insurance Claim Support',
    description: 'Total loss undervaluation, surveyor deductions, own-damage repudiation, third-party liability disputes — we challenge every low settlement.',
    icon: 'car',
    href: '/services/motor-insurance',
    keywords: ['motor insurance claim', 'car insurance claim', 'total loss claim', 'IDV dispute', 'surveyor deduction']
  },
  {
    title: 'Claim Rejection Appeals & Regulatory Escalation',
    description: 'IRDAI Bima Bharosa filing, Insurance Ombudsman representation, grievance redressal escalation — we take it to the highest authority.',
    icon: 'gavel',
    href: '/services/claim-support',
    keywords: ['claim rejection appeal', 'IRDAI Bima Bharosa', 'Insurance Ombudsman', 'grievance redressal', 'claim recovery']
  },
  {
    title: 'LIC Policy Services',
    description: 'Policy status check, loan against policy, surrender value, revival, maturity claims, Jeevan Anand/Shanti/Utsav — complete LIC support.',
    icon: 'shield-check',
    href: '/services/lic-services',
    keywords: ['LIC policy', 'LIC claim', 'LIC surrender', 'LIC revival', 'LIC loan', 'LIC maturity']
  },
  {
    title: 'Senior Citizen & Family Health Plans',
    description: 'Portability, top-up plans, critical illness riders, parents\' health insurance — tailored coverage for every life stage.',
    icon: 'users',
    href: '/services/senior-citizen-health-insurance',
    keywords: ['senior citizen health insurance', 'parents health insurance', 'critical illness insurance', 'portability', 'top-up plan']
  },
];

const insurers = [
  'LIC of India', 'ICICI Lombard', 'Star Health', 'HDFC ERGO', 'Niva Bupa',
  'Care Health', 'New India Assurance', 'Bajaj Allianz', 'SBI General',
  'Tata AIG', 'Oriental Insurance', 'Max Life', 'Aditya Birla Health',
  'ManipalCigna', 'Reliance General', 'Future Generali', 'Kotak Life'
];

const faqs = [
  {
    question: 'What is Insurance Support and how can you help me?',
    answer: 'Insurance Support is an IRDAI-registered advisory service (Reg No: 0149161D) led by Hari Kotian with 25+ years of experience. We help policyholders across India challenge rejected, delayed, or underpaid insurance claims — from health and life to motor and term insurance. Our free case review gives you an honest assessment within 24 hours.'
  },
  {
    question: 'Are you affiliated with any insurance company?',
    answer: 'No. Insurance Support is completely independent. We do not sell policies, earn commissions, or have partnerships with any insurer. Our only allegiance is to the policyholder. Insurer names on this site are listed only to describe matters we assist with — no endorsement or affiliation is implied.'
  },
  {
    question: 'What types of claims do you handle?',
    answer: 'We handle health/mediclaim claim denials, life/term insurance death claim repudiations, motor insurance total loss and own-damage disputes, and regulatory escalations via IRDAI Bima Bharosa and Insurance Ombudsman. We also assist with LIC policy services including revival, surrender, loans, and maturity claims.'
  },
  {
    question: 'Do I need to visit your Bengaluru office?',
    answer: 'No. We handle cases across India remotely via WhatsApp, email, and video calls. For Bengaluru clients, we offer doorstep document collection and in-person meetings. All regulatory filings (IRDAI, Ombudsman) are done online regardless of location.'
  },
  {
    question: 'How much does the initial review cost?',
    answer: 'The first case review is completely free — no obligation, no hidden fees. We only discuss fees if we take up your case, and the structure is transparent: typically a percentage of the recovered amount or a fixed fee agreed upfront in writing.'
  },
  {
    question: 'What documents do I need for the free review?',
    answer: 'Rejection letter from the insurer, your policy document, the claim form you submitted, medical records (for health/life claims), FIR or survey report (for motor claims), and any correspondence with the insurer. We will guide you on exactly what is needed for your specific case.'
  },
  {
    question: 'How long does the appeal process take?',
    answer: 'Insurer internal grievance (GRO): 15–30 days. IRDAI Bima Bharosa: 30–45 days. Insurance Ombudsman: 3–6 months typically. We manage the entire timeline, track every hearing, and keep you updated at every stage so you never wonder what is happening.'
  },
  {
    question: 'Can you help with a claim that was rejected years ago?',
    answer: 'Yes, within limitation periods. Insurance Ombudsman accepts complaints up to 3 years from the insurer\'s final decision. IRDAI Bima Bharosa has similar timelines. The sooner you act, the stronger your case — but we have successfully reopened older cases where documentation was preserved.'
  },
];

const trustSignals = [
  { label: 'IRDAI Registered', detail: 'Advisor Reg No: 0149161D' },
  { label: '25+ Years Experience', detail: 'Insurance advisory & claims' },
  { label: 'Pan-India Service', detail: 'Remote & doorstep in Bengaluru' },
  { label: 'No Fee First Review', detail: 'Honest assessment in 24 hrs' },
];

const processSteps = [
  { number: '01', title: 'Free Case Review', desc: 'Send your rejection letter & policy copy. We respond within 24 hours with an honest assessment.' },
  { number: '02', title: 'Policy & Ground Analysis', desc: 'Clause-by-clause review to identify where the insurer\'s reasoning fails.' },
  { number: '03', title: 'Documentation & Representation', desc: 'Medical records, doctor certificates, structured grievance to the insurer\'s GRO.' },
  { number: '04', title: 'Regulatory Escalation', desc: 'IRDAI Bima Bharosa complaint and Insurance Ombudsman filing on your behalf.' },
  { number: '05', title: 'Resolution & Follow-up', desc: 'We track every hearing and reminder until settlement lands in your account.' },
];

const testimonials = [
  { content: 'The insurer said my angioplasty was a pre-existing condition after four years of clean renewals. Insurance Support pulled my old records, drafted the representation, and the amount was credited before the Ombudsman hearing.', name: 'R. Sharma', role: 'Health Insurance Claim, Bangalore' },
  { content: 'After my husband\'s death the claim was repudiated for non-disclosure. I had given up. Hari Kotian\'s team handled the Ombudsman filing end to end and explained every step in simple language.', name: 'M. Patel', role: 'Term Insurance Claim, Mumbai' },
  { content: 'The surveyor\'s IDV was far below market. They challenged the deductions with valuation evidence and the insurer revised the settlement in six weeks.', name: 'A. Reddy', role: 'Motor Insurance Claim, Hyderabad' },
];

---

<BaseLayout title={pageTitle} description={pageDescription} keywords={pageKeywords} pageType="service" dateModified={pageDateModified}>
  <BreadcrumbJsonLd items={[
    { label: 'Home', url: 'https://insurancesupport.online' },
    { label: 'Insurance Support', url: 'https://insurancesupport.online/insurance-support/' }
  ]} />

  <main id="main" role="main">
    <!-- Hero Section -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-content">
        <div class="hero-badge animate-fade-in" style="font-family: var(--font-sans);">
          <Icon name="shield-check" size="sm" />
          <span>IRDAI Registered Advisor · Reg No: 0149161D</span>
        </div>

        <h1 id="hero-title" class="hero-title animate-slide-up stagger-1" style="font-family: var(--font-display);">
          Your claim was rejected.<br /><span style="color: var(--color-primary);">That is not the final word.</span>
        </h1>

        <p class="hero-desc animate-slide-up stagger-2" style="font-family: var(--font-sans);">
          Insurance Support helps Indian policyholders challenge rejected, delayed, and underpaid claims — with clause-level policy analysis, airtight documentation, and escalation up to the Insurance Ombudsman.
        </p>

        <div class="hero-actions animate-slide-up stagger-3">
          <a href="https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20my%20claim%20was%20rejected.%20I%20need%20help." target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg" style="font-family: var(--font-sans);" aria-label="Start free case review on WhatsApp">
            <Icon name="whatsapp" size="sm" />
            Free Case Review on WhatsApp
          </a>
          <a href="tel:+919****4506" class="btn btn-outline btn-lg" style="font-family: var(--font-sans);" aria-label="Call +91 99866 34506">
            <Icon name="phone" size="sm" />
            Call +91 99866 34506
          </a>
        </div>

        <!-- Trust Bar -->
        <div class="hero-trust animate-slide-up stagger-4" role="list" aria-label="Trust indicators">
          {trustSignals.map((signal, i) => (
            <div class="hero-trust-item" role="listitem" style="font-family: var(--font-sans);">
              <Icon name="check" size="sm" />
              <span><strong>{signal.label}</strong> — {signal.detail}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- What We Handle - Pillar Navigation -->
    <section class="section" aria-labelledby="services-title">
      <div class="container">
        <header class="section-header">
          <span class="section-label" style="font-family: var(--font-sans);">Our Core Services</span>
          <h2 id="services-title" class="section-title" style="font-family: var(--font-display);">Every kind of claim dispute Indian policyholders run into</h2>
          <p class="section-desc" style="font-family: var(--font-sans);">From health claim denials to life insurance repudiations — we know the clauses, the process, and how to win. Click any service to learn more.</p>
        </header>

        <div class="grid-auto">
          {pillars.map((pillar, i) => (
            <article class="card animate-slide-up" style={`animation-delay: ${(i + 1) * 100}ms`}>
              <div class="icon icon-primary mb-4" aria-hidden="true">
                <Icon name={pillar.icon} size="md" />
              </div>
              <h3 style="font-family: var(--font-display); font-size: 1.25rem; margin-bottom: var(--space-3);">{pillar.title}</h3>
              <p style="font-family: var(--font-sans); color: var(--color-text-secondary); margin-bottom: var(--space-4);">{pillar.description}</p>
              <a href={pillar.href} class="link-aurora" style="font-family: var(--font-sans);">Learn more →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="section" style="background: var(--color-bg-alt);" aria-labelledby="process-title">
      <div class="container">
        <header class="section-header">
          <span class="section-label" style="font-family: var(--font-sans);">How It Works</span>
          <h2 id="process-title" class="section-title" style="font-family: var(--font-display);">From rejection letter to resolution, in five steps</h2>
          <p class="section-desc" style="font-family: var(--font-sans);">A clear, structured process — no surprises, no jargon.</p>
        </header>

        <div class="steps">
          {processSteps.map((step, i) => (
            <article class="card animate-slide-up" style={`animation-delay: ${(i + 1) * 100}ms`}>
              <div class="step-number" aria-label={`Step ${step.number}`}>{step.number}</div>
              <h3 class="step-title" style="font-family: var(--font-display);">{step.title}</h3>
              <p class="step-desc" style="font-family: var(--font-sans);">{step.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Insurers We Deal With -->
    <section class="section" aria-labelledby="insurers-title">
      <div class="container">
        <header class="section-header">
          <span class="section-label" style="font-family: var(--font-sans);">Insurers & Regulators</span>
          <h2 id="insurers-title" class="section-title" style="font-family: var(--font-display);">We know how each insurer's grievance desk works</h2>
          <p class="section-desc" style="font-family: var(--font-sans);">Our team has taken up matters against most major Indian insurers and TPAs. We use the official route every time.</p>
        </header>

        <div class="trust-bar" role="list" aria-label="Insurers we handle">
          {insurers.map(insurer => (
            <span role="listitem" class="badge badge-primary" style="font-family: var(--font-sans);">{insurer}</span>
          ))}
        </div>

        <p style="text-align: center; margin-top: var(--space-6); font-size: 0.875rem; color: var(--color-text-muted); font-family: var(--font-sans);">
          Insurer names listed only to describe matters we assist with. No affiliation, partnership, or endorsement implied.
        </p>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="section" style="background: var(--color-bg-alt);" aria-labelledby="testimonials-title">
      <div class="container">
        <header class="section-header">
          <span class="section-label" style="font-family: var(--font-sans);">Case Outcomes</span>
          <h2 id="testimonials-title" class="section-title" style="font-family: var(--font-display);">Policyholders who were told no — and did not stop there</h2>
          <p class="section-desc" style="font-family: var(--font-sans);">Names changed on request. Past outcomes do not predict the result of your claim.</p>
        </header>

        <div class="grid-3">
          {testimonials.map((testimonial, i) => (
            <article class="testimonial animate-slide-up" style={`animation-delay: ${(i + 1) * 100}ms`}>
              <p class="testimonial-content" style="font-family: var(--font-sans);">"{testimonial.content}"</p>
              <div class="testimonial-author" style="font-family: var(--font-sans);">
                <div class="testimonial-avatar" aria-hidden="true">{testimonial.name.charAt(0)}</div>
                <div>
                  <div class="testimonial-name">{testimonial.name}</div>
                  <div class="testimonial-role">{testimonial.role}</div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- LocalBusiness Schema for this specific page -->
    <LocalBusinessJsonLd 
      name="Insurance Support"
      description="Insurance guidance and claim assistance provided by Hari Kotian from Bengaluru."
      url="https://insurancesupport.online/insurance-support/"
      telephone="+91-9986634506"
      email="hari@insurancesupport.online"
      address={{
        streetAddress: "Bahubali Nagar, Jalahalli",
        addressLocality: "Bengaluru",
        addressRegion: "Karnataka",
        postalCode: "560013",
        addressCountry: "IN"
      }}
      geo={{
        latitude: 13.0159,
        longitude: 77.5522
      }}
      openingHours={[
        { dayOfWeek: ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], opens: "09:00", closes: "18:00" }
      ]}
      priceRange="₹1000 - ₹50000"
      areaServed="India"
    />

    <!-- FAQ -->
    <section class="section" aria-labelledby="faq-title">
      <div class="container">
        <header class="section-header">
          <span class="section-label" style="font-family: var(--font-sans);">Common Questions</span>
          <h2 id="faq-title" class="section-title" style="font-family: var(--font-display);">Straight answers, no fine print</h2>
        </header>

        <div class="grid-2" style="max-width: 900px; margin: 0 auto;">
          <FAQPageJsonLd questions={faqs} />
          {faqs.map((faq, i) => (
            <details class="faq-item animate-slide-up" style={`animation-delay: ${(i + 1) * 100}ms`}>
              <summary class="faq-question" style="font-family: var(--font-sans);">
                {faq.question}
                <Icon name="arrow-right" size="sm" class="faq-icon" />
              </summary>
              <div class="faq-answer" style="font-family: var(--font-sans);">{faq.answer}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="section" style="background: var(--gradient-hero);" aria-labelledby="cta-title">
      <div class="container">
        <div style="max-width: 720px; margin: 0 auto; text-align: center;">
          <h2 id="cta-title" class="section-title" style="color: var(--color-text-inverse); font-family: var(--font-display);">Ready to challenge the rejection?</h2>
          <p class="section-desc" style="color: rgba(255,255,255,0.9); font-family: var(--font-sans);">Get your free case review within 24 hours. No obligation, no pressure — just an honest assessment.</p>
          <div class="hero-actions" style="margin-top: var(--space-8);">
            <a href="https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20my%20claim%20was%20rejected.%20I%20need%20help." target="_blank" rel="noopener noreferrer" class="btn btn-accent btn-lg" style="font-family: var(--font-sans);">
              <Icon name="whatsapp" size="sm" />
              Start Free Review on WhatsApp
            </a>
            <a href="tel:+919****4506" class="btn btn-outline btn-lg" style="font-family: var(--font-sans); border-color: var(--color-text-inverse); color: var(--color-text-inverse);">
              <Icon name="phone" size="sm" />
              Call +91 99866 34506
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>