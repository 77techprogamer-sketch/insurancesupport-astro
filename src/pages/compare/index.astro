---
// src/pages/compare/index.astro
// Hub for every side-by-side comparison on the site. Collects the model-level
// comparisons (aggregator vs advisor) and the product-level ones.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CallbackForm from '../../components/CallbackForm.astro';
import comparisons from '../../data/comparisons.json';
import SectionLinks from '../../components/SectionLinks.astro';

const modelSlugs = new Set(['aggregator-vs-advisor', 'lic-online-vs-agent', 'claim-lawyer-vs-advisor']);
const modelComparisons = comparisons.filter((c) => modelSlugs.has(c.slug));
const productComparisons = comparisons.filter((c) => !modelSlugs.has(c.slug));

const pageUrl = 'https://insurancesupport.online/compare/';
---

<BaseLayout
  title="Insurance Comparisons: Plans, Channels and Claim Routes"
  description="Side-by-side comparisons for Indian policyholders: term, health and motor plans, aggregator versus advisor, LIC online versus agent, and when a rejected claim needs a lawyer."
  canonical={pageUrl}
  pageType="compare"
  keywords="insurance comparison India, aggregator vs advisor, LIC online vs agent, best health insurance comparison, term insurance comparison"
>
  <Breadcrumbs currentPage="Comparisons" />

  <main id="main" class="page-transition">
    <section class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 text-white py-16 lg:py-20">
      <div class="max-w-4xl mx-auto px-4">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/10 text-amber-300 text-sm font-semibold mb-6">
          Comparisons
        </span>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold leading-tight mb-4">
          Compare insurance plans, channels and claim routes
        </h1>
        <p class="text-lg text-blue-100/80 leading-relaxed max-w-2xl">
          Two kinds of decisions decide what happens when you claim: which product you buy, and
          which channel you buy it through. Both are compared here, without sales language.
        </p>
      </div>
    </section>

    <section class="py-14 bg-white">
      <div class="max-w-5xl mx-auto px-4">
        <h2 class="text-2xl font-extrabold text-slate-900 mb-2">Channel and route comparisons</h2>
        <p class="text-slate-600 mb-8 max-w-2xl">Where the money and the responsibility actually sit.</p>
        <div class="grid md:grid-cols-2 gap-4">
          {modelComparisons.map((c) => (
            <a href={`/compare/${c.slug}/`} class="group p-6 bg-slate-50 border border-slate-200 rounded-2xl hover:border-blue-300 hover:shadow-lg transition-all">
              <h3 class="font-bold text-blue-900 group-hover:text-blue-600 mb-2 leading-snug">{c.title}</h3>
              <p class="text-sm text-slate-600 line-clamp-3">{c.description}</p>
              <span class="mt-3 inline-block text-sm font-semibold text-blue-700">Read the comparison →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {productComparisons.length > 0 && (
      <section class="py-14 bg-slate-50">
        <div class="max-w-5xl mx-auto px-4">
          <h2 class="text-2xl font-extrabold text-slate-900 mb-2">Product comparisons</h2>
          <p class="text-slate-600 mb-8 max-w-2xl">Plan-level differences: coverage, waiting periods, claim experience.</p>
          <div class="grid md:grid-cols-2 gap-4">
            {productComparisons.map((c) => (
              <a href={`/compare/${c.slug}/`} class="group p-6 bg-white border border-slate-200 rounded-2xl hover:border-blue-300 hover:shadow-lg transition-all">
                <h3 class="font-bold text-blue-900 group-hover:text-blue-600 mb-2 leading-snug">{c.title}</h3>
                <p class="text-sm text-slate-600 line-clamp-3">{c.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="py-16 bg-white">
      <div class="max-w-3xl mx-auto px-4">
        <CallbackForm
          source="compare-index"
          heading="Stuck between two options?"
          subheading="Tell us what you are comparing and we will point out what the brochures leave out. One call, no obligation."
        />
      </div>
    </section>
    <SectionLinks current="/compare/" />
  </main>
</BaseLayout>
