---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbJsonLd from '../../components/BreadcrumbJsonLd.astro';
import cityClaimData from '../../data/city-claim-data.json';
import LanguageSidebar from '../../components/LanguageSidebar.astro';

const title = 'Insurance Claim Help by City — Network Hospitals, TPAs & Ombudsman Offices';
const description = 'Find insurance claim help for your city: network hospitals, TPA contacts, Ombudsman jurisdiction, cashless process, and expert assistance. 50+ Indian cities covered. Free consultation by Hari Kotian (IRDAI 0149161D).';
const canonical = 'https://insurancesupport.online/claim-help/';
const ogImageUrl = 'https://insurancesupport.online/images/og/claim-help-cities.png';

const cities = Object.values(cityClaimData).sort((a, b) => a.name.localeCompare(b.name));

const breadcrumbItems = [
  { label: 'Home', url: 'https://insurancesupport.online/' },
  { label: 'Claim Help by City', url: canonical }
];
---

<BaseLayout title={title} description={description} ogImage={ogImageUrl} keywords="insurance claim help by city, network hospitals city, insurance ombudsman city, cashless claim city, claim rejection appeal city" canonical={canonical} skipDefaultHreflang={true} pageType="service-page" pageLang="en-IN" ogLocale="en_IN">
  <BreadcrumbJsonLd items={breadcrumbItems} />

  <main class="page-transition">
    <!-- Hero -->
    <section class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 text-white py-16 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px]" />
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-amber-500/5 rounded-full blur-[100px]" />

      <div class="max-w-4xl mx-auto px-4 relative">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-white/10 border border-white/10 text-amber-300 text-xs font-semibold rounded-full backdrop-blur-sm mb-4">
          50+ Cities • 5,000+ Network Hospitals
        </div>

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold leading-tight mb-6">
          Insurance Claim Help by City
        </h1>

        <p class="text-lg text-blue-100/80 mb-6 max-w-3xl leading-relaxed">
          Find network hospitals, TPA contacts, Ombudsman offices, and cashless claim guidance for your city. Expert help by Hari Kotian — IRDAI Reg. 0149161D.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-900 font-bold rounded-full text-lg shadow-lg shadow-amber-500/25 hover:shadow-xl hover:scale-105 transition-all">
            Book Free Consultation
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="tel:+919986634506" class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 border border-white/20 text-white font-semibold rounded-full text-lg hover:bg-white/20 transition-all backdrop-blur-sm">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call: +91-9986634506
          </a>
        </div>
      </div>
    </section>

    <!-- Search/Filter Bar -->
    <section class="py-8 bg-white border-y border-slate-200">
      <div class="max-w-6xl mx-auto px-4">
        <div class="relative max-w-xl mx-auto">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="search"
            id="city-search"
            placeholder="Search your city... (e.g., Bangalore, Mumbai, Delhi)"
            class="w-full pl-12 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
            aria-label="Search cities"
          />
        </div>
        <p class="text-center text-sm text-slate-500 mt-3">We cover {cities.length} cities across India. Don't see yours? <a href="/contact" class="text-blue-600 hover:underline font-medium">Contact us</a> — we can still help.</p>
      </div>
    </section>

    <!-- City Cards Grid -->
    <section class="py-16 bg-slate-50">
      <div class="max-w-6xl mx-auto px-4">
        <div class="mb-8">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-2">All Cities</h2>
          <p class="text-slate-600">Click any city for detailed network hospital lists, TPA contacts, Ombudsman info, and step-by-step claim guides.</p>
        </div>

        <div id="city-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          {cities.map(city => (
            <a href={`/claim-help/${city.slug}/`} class="group block bg-white rounded-xl border border-slate-200 p-5 hover:shadow-lg hover:border-blue-200 hover:-translate-y-1 transition-all duration-200">
              <div class="flex items-start justify-between mb-3">
                <h3 class="font-bold text-slate-900 group-hover:text-blue-700 transition-colors">{city.name}</h3>
                <span class="px-2 py-0.5 bg-blue-50 text-blue-600 text-[10px] font-bold rounded uppercase tracking-wide shrink-0">{city.state}</span>
              </div>
              <div class="flex flex-wrap gap-1.5 mb-4">
                <span class="px-2 py-0.5 bg-green-50 text-green-700 text-xs font-medium rounded">{city.stats.networkHospitals}+ Hospitals</span>
                <span class="px-2 py-0.5 bg-blue-50 text-blue-700 text-xs font-medium rounded">{city.stats.tpas} TPAs</span>
                <span class="px-2 py-0.5 bg-amber-50 text-amber-700 text-xs font-medium rounded">{city.stats.avgCashlessHours}h Avg Approval</span>
              </div>
              <div class="text-xs text-slate-500 flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
                View details →
              </div>
            </a>
          ))}
        </div>

        <div id="no-results" class="hidden text-center py-12">
          <p class="text-slate-500">No cities match your search. Try a different spelling.</p>
        </div>
      </div>
    </section>

    <!-- Featured Cities Quick Links -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-2xl font-bold text-slate-900 mb-8 text-center">Major Metros — Quick Access</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
          {cities.filter(c => ['bangalore', 'mumbai', 'delhi', 'hyderabad', 'chennai', 'pune', 'kolkata', 'ahmedabad', 'gurgaon', 'noida'].includes(c.slug)).map(city => (
            <a href={`/claim-help/${city.slug}/`} class="group bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-5 border border-blue-100 text-center hover:shadow-lg hover:border-blue-200 transition-all">
              <h3 class="font-bold text-slate-900 mb-1 group-hover:text-blue-700 transition-colors">{city.name}</h3>
              <p class="text-xs text-slate-500">{city.state}</p>
              <p class="text-sm font-semibold text-blue-600 mt-2">{city.stats.networkHospitals}+ Hospitals</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- How We Help Section -->
    <section class="py-16 bg-slate-50">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-2xl font-bold text-slate-900 mb-8 text-center">How We Help with Claims in Your City</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl border border-slate-200 p-6">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-2">Cashless Pre-Authorization</h3>
            <p class="text-slate-600 text-sm">We coordinate with your TPA and hospital for quick pre-auth approval. Know exactly which documents are needed and track status in real-time.</p>
          </div>
          <div class="bg-white rounded-xl border border-slate-200 p-6">
            <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-2">Claim Rejection Appeals</h3>
            <p class="text-slate-600 text-sm">Denied claim? We draft appeal letters, file with insurer grievance cell, IRDAI IGMS, and Insurance Ombudsman. 85%+ success rate on valid appeals.</p>
          </div>
          <div class="bg-white rounded-xl border border-slate-200 p-6">
            <div class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-2">Ombudsman Complaint Filing</h3>
            <p class="text-slate-600 text-sm">We prepare and file Ombudsman complaints for claims up to ₹30 lakh. No lawyer needed, binding award, 30-day hearing timeline.</p>
          </div>
          <div class="bg-white rounded-xl border border-slate-200 p-6">
            <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-2">Local Hospital & TPA Knowledge</h3>
            <p class="text-slate-600 text-sm">We know which hospitals in your city honor cashless easily, which TPAs are slow, and which doctors document well for claims.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 text-white">
      <div class="max-w-3xl mx-auto px-4 text-center">
        <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/10 rounded-full blur-[100px]" />
        <h3 class="text-2xl md:text-3xl font-extrabold mb-3 relative">Need Help with a Claim?</h3>
        <p class="text-blue-200/80 mb-6 max-w-2xl mx-auto relative">Free consultation with Hari Kotian. We handle the paperwork, follow-ups, and escalations — you focus on recovery. 12+ years experience, 2,800+ families served.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-900 font-bold rounded-full text-lg shadow-lg shadow-amber-500/25 hover:shadow-xl hover:scale-105 transition-all">
            Book Free Consultation
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="tel:+919986634506" class="inline-flex items-center gap-2 px-8 py-4 bg-white/10 border border-white/20 text-white font-bold rounded-full text-lg hover:bg-white/20 transition-all backdrop-blur-sm">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call: +91-9986634506
          </a>
        </div>
      </div>
    </section>

    <LanguageSidebar lang="en" />
  </main>
</BaseLayout>

<script is:inline>
  const searchInput = document.getElementById('city-search');
  const cityGrid = document.getElementById('city-grid');
  const noResults = document.getElementById('no-results');
  const cityCards = cityGrid.querySelectorAll('a');

  searchInput?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase().trim();
    let visibleCount = 0;

    cityCards.forEach(card => {
      const cityName = card.querySelector('h3')?.textContent.toLowerCase() || '';
      const stateName = card.querySelector('span[class*="uppercase"]')?.textContent.toLowerCase() || '';
      const matches = query === '' || cityName.includes(query) || stateName.includes(query);

      card.style.display = matches ? 'block' : 'none';
      if (matches) visibleCount++;
    });

    noResults.classList.toggle('hidden', visibleCount > 0 || query === '');
  });
</script>