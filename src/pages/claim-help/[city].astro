---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleJsonLd from '../../components/ArticleJsonLd.astro';
import FAQPageJsonLd from '../../components/FAQPageJsonLd.astro';
import BreadcrumbJsonLd from '../../components/BreadcrumbJsonLd.astro';
import LanguageSidebar from '../../components/LanguageSidebar.astro';
import cityClaimData from '../../data/city-claim-data.json';

const { city } = Astro.params;
const cityKey = city.toLowerCase();
const cityData = cityClaimData[cityKey];

if (!cityData) {
  return Astro.redirect('/claim-help/');
}

const title = `Insurance Claim Help in ${cityData.name} — Cashless, Reimbursement & Ombudsman Guide`;
const description = `Complete guide to filing insurance claims in ${cityData.name}: network hospitals, TPA contacts, Ombudsman jurisdiction, cashless process, and appeal steps. Expert help by Hari Kotian (IRDAI 0149161D).`;
const canonical = `https://insurancesupport.online/claim-help/${cityKey}/`;
const ogImageUrl = `https://insurancesupport.online/images/og/claim-help-${cityKey}.png`;

const faqs = [
  {
    question: `Which are the best network hospitals for cashless claims in ${cityData.name}?`,
    answer: cityData.topHospitals.slice(0, 10).map(h => `${h.name} (${h.area}) — TPAs: ${h.tpas.join(', ')} | Specialties: ${h.specialties.join(', ')}`).join('\n\n')
  },
  {
    question: `Where is the Insurance Ombudsman office for ${cityData.name}?`,
    answer: `The Insurance Ombudsman for ${cityData.name} is located at ${cityData.ombudsman.address}. Jurisdiction: ${cityData.ombudsman.jurisdiction}. Phone: ${cityData.ombudsman.phone}. Email: ${cityData.ombudsman.email}. File online at cioins.co.in or visit in person.`
  },
  {
    question: `How long does cashless pre-authorization take in ${cityData.name} hospitals?`,
    answer: `Most ${cityData.name} network hospitals get pre-auth approval within ${cityData.stats.avgCashlessHours} hours on average. Emergency cases: 30 minutes. Keep your TPA ID card, policy copy, and doctor's admission note ready.`
  },
  {
    question: `What if my cashless claim is denied at a ${cityData.name} hospital?`,
    answer: `Ask for written denial reason from the hospital/TPA. File grievance with insurer (15 days), then IRDAI IGMS/Bima Bharosa portal, then Insurance Ombudsman (${cityData.ombudsman.office}). Time limit: Ombudsman within 1 year of rejection. We can help — book a free consultation.`
  },
  {
    question: `Which TPAs are most active in ${cityData.name}?`,
    answer: `Top TPAs in ${cityData.name}: ${getTopTPAs(cityData.topHospitals).join(', ')}. These ${getTopTPAs(cityData.topHospitals).length} TPAs cover ${cityData.stats.networkHospitals}+ network hospitals in the city.`
  },
  {
    question: `Can I get cashless treatment at any hospital in ${cityData.name}?`,
    answer: `Only at network hospitals empanelled with your insurer/TPA. Check your policy's hospital list or call your TPA before admission. We maintain updated lists — contact us for your insurer's ${cityData.name} network.`
  }
];

function getTopTPAs(hospitals) {
  const tpaCount = {};
  hospitals.forEach(h => h.tpas.forEach(tpa => tpaCount[tpa] = (tpaCount[tpa] || 0) + 1));
  return Object.entries(tpaCount).sort((a, b) => b[1] - a[1]).slice(0, 5).map(([tpa]) => tpa);
}

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `Insurance Claim Assistance in ${cityData.name}`,
  "description": description,
  "url": canonical,
  "provider": {
    "@type": "Organization",
    "name": "Insurance Support",
    "url": "https://insurancesupport.online/",
    "logo": "https://insurancesupport.online/images/logo.png",
    "telephone": "+91-9986634506",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Bengaluru",
      "addressRegion": "Karnataka",
      "addressCountry": "IN"
    }
  },
  "areaServed": {
    "@type": "City",
    "name": cityData.name,
    "containedInPlace": {
      "@type": "State",
      "name": cityData.state
    }
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Claim Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cashless Claim Filing", "description": "End-to-end cashless pre-authorization and claim filing at network hospitals" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Claim Rejection Appeal", "description": "Appeal rejected/denied claims through insurer grievance, IRDAI, Ombudsman" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ombudsman Complaint Filing", "description": "Draft and file Insurance Ombudsman complaints for claims up to ₹30 lakh" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Document Preparation", "description": "Prepare claim documents, medical summaries, and appeal letters" } }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "127",
    "bestRating": "5",
    "worstRating": "1"
  }
};

const breadcrumbItems = [
  { label: 'Home', url: 'https://insurancesupport.online/' },
  { label: 'Claim Help by City', url: 'https://insurancesupport.online/claim-help/' },
  { label: cityData.name, url: canonical }
];
---

<BaseLayout title={title} description={description} ogImage={ogImageUrl} keywords={`${cityData.name} insurance claim, ${cityData.name} cashless hospital, ${cityData.name} insurance ombudsman, ${cityData.name} claim rejection appeal, ${cityData.name} TPA list`} canonical={canonical} skipDefaultHreflang={true} pageType="service-page" pageLang="en-IN" ogLocale="en_IN" structuredData={serviceSchema}>
  <ArticleJsonLd title={title} description={description} url={canonical} date={new Date().toISOString().split('T')[0]} modifiedDate={new Date().toISOString().split('T')[0]} authorName="Hari Kotian" inLanguage="en-IN" />
  <FAQPageJsonLd questions={faqs} />
  <BreadcrumbJsonLd items={breadcrumbItems} />

  <main class="page-transition">
    <!-- Hero Banner -->
    <section class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 text-white py-16 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px]" />
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-amber-500/5 rounded-full blur-[100px]" />

      <div class="max-w-4xl mx-auto px-4 relative">
        <a href="/claim-help/" class="inline-flex items-center gap-2 text-sm text-blue-200/70 hover:text-white mb-6 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          All Cities
        </a>

        <div class="flex flex-wrap gap-2 mb-4">
          <span class="px-3 py-1 bg-white/10 border border-white/10 text-amber-300 text-xs font-semibold rounded-full backdrop-blur-sm">
            {cityData.name}, {cityData.state}
          </span>
          <span class="px-3 py-1 bg-white/10 border border-white/10 text-green-300 text-xs font-semibold rounded-full backdrop-blur-sm">
            {cityData.stats.networkHospitals}+ Network Hospitals
          </span>
          <span class="px-3 py-1 bg-white/10 border border-white/10 text-blue-300 text-xs font-semibold rounded-full backdrop-blur-sm">
            {cityData.stats.tpas} Active TPAs
          </span>
        </div>

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold leading-tight mb-6">
          Insurance Claim Help in {cityData.name}
        </h1>

        <p class="text-lg text-blue-100/80 mb-6 max-w-3xl leading-relaxed">
          {cityData.name}-specific guidance for cashless claims, reimbursement, Ombudsman complaints, and claim denial appeals. Served by Hari Kotian — IRDAI Reg. 0149161D.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-900 font-bold rounded-full text-lg shadow-lg shadow-amber-500/25 hover:shadow-xl hover:scale-105 transition-all">
            Book Free Consultation
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="tel:+919986634506" class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 border border-white/20 text-white font-semibold rounded-full text-lg hover:bg-white/20 transition-all backdrop-blur-sm">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call: +91-9986634506
          </a>
        </div>
      </div>
    </section>

    <!-- Key Stats Bar -->
    <section class="py-10 bg-white border-y border-slate-200">
      <div class="max-w-6xl mx-auto px-4 grid grid-cols-2 md:grid-cols-4 gap-6">
        <div class="text-center p-6 bg-blue-50 rounded-xl border border-blue-100">
          <p class="text-3xl md:text-4xl font-extrabold text-blue-700">{cityData.stats.networkHospitals}+</p>
          <p class="text-sm text-slate-600 mt-1">Network Hospitals</p>
        </div>
        <div class="text-center p-6 bg-green-50 rounded-xl border border-green-100">
          <p class="text-3xl md:text-4xl font-extrabold text-green-700">{cityData.stats.tpas}</p>
          <p class="text-sm text-slate-600 mt-1">Active TPAs</p>
        </div>
        <div class="text-center p-6 bg-amber-50 rounded-xl border border-amber-100">
          <p class="text-3xl md:text-4xl font-extrabold text-amber-700">{cityData.stats.avgCashlessHours}h</p>
          <p class="text-sm text-slate-600 mt-1">Avg Cashless Approval</p>
        </div>
        <div class="text-center p-6 bg-purple-50 rounded-xl border border-purple-100">
          <p class="text-3xl md:text-4xl font-extrabold text-purple-700">{cityData.stats.ombudsmanCases}+</p>
          <p class="text-sm text-slate-600 mt-1">Ombudsman Cases (2024)</p>
        </div>
      </div>
    </section>

    <!-- Top Network Hospitals Table -->
    <section class="py-16 bg-slate-50">
      <div class="max-w-6xl mx-auto px-4">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-8">
          <div>
            <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-2">Top Network Hospitals for Cashless Claims in {cityData.name}</h2>
            <p class="text-slate-600">Showing top 20 of {cityData.topHospitals.length} empanelled hospitals. Data sourced from TPA networks (MediAssist, HealthIndia, Paramount, Vidal, Raksha, Family Health).</p>
          </div>
          <a href="/contact" class="mt-4 md:mt-0 inline-flex items-center gap-2 px-5 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-colors">
            Need help with a specific hospital?
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
          <table class="min-w-full">
            <thead class="bg-slate-50 border-b border-slate-200 sticky top-0 z-10">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-bold text-slate-600 uppercase tracking-wider">Hospital</th>
                <th class="px-4 py-3 text-left text-xs font-bold text-slate-600 uppercase tracking-wider">Area</th>
                <th class="px-4 py-3 text-left text-xs font-bold text-slate-600 uppercase tracking-wider">Key TPAs</th>
                <th class="px-4 py-3 text-left text-xs font-bold text-slate-600 uppercase tracking-wider">Specialties</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {cityData.topHospitals.slice(0, 20).map(hospital => (
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="px-4 py-3 font-medium text-slate-900">{hospital.name}</td>
                  <td class="px-4 py-3 text-slate-600">{hospital.area}</td>
                  <td class="px-4 py-3 text-slate-600">
                    <div class="flex flex-wrap gap-1">
                      {hospital.tpas.map(tpa => (
                        <span class="px-2 py-0.5 bg-blue-50 text-blue-700 text-[10px] font-medium rounded">{tpa}</span>
                      ))}
                    </div>
                  </td>
                  <td class="px-4 py-3 text-slate-600">
                    <div class="flex flex-wrap gap-1">
                      {hospital.specialties.slice(0, 3).map(spec => (
                        <span class="px-2 py-0.5 bg-green-50 text-green-700 text-[10px] font-medium rounded">{spec}</span>
                      ))}
                      {hospital.specialties.length > 3 && (
                        <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-[10px] font-medium rounded">+{hospital.specialties.length - 3} more</span>
                      )}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- TPA Summary -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-2xl font-bold text-slate-900 mb-8">Active TPAs in {cityData.name}</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {getTopTPAs(cityData.topHospitals).map(tpa => {
            const count = cityData.topHospitals.filter(h => h.tpas.includes(tpa)).length;
            return (
              <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-5 border border-blue-100 text-center group hover:shadow-lg transition-shadow">
                <p class="text-2xl font-extrabold text-blue-700">{count}+</p>
                <p class="text-sm text-slate-600 mt-1">Hospitals</p>
                <p class="text-lg font-bold text-slate-900 mt-2">{tpa}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Insurance Ombudsman Info -->
    <section class="py-16 bg-slate-50">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">Insurance Ombudsman — {cityData.name} Jurisdiction</h2>

        <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 mb-8">
          <h3 class="font-bold text-slate-900 mb-2">{cityData.ombudsman.office}</h3>
          <div class="space-y-2 text-slate-700">
            <p><strong>Address:</strong> {cityData.ombudsman.address}</p>
            <p><strong>Jurisdiction:</strong> {cityData.ombudsman.jurisdiction}</p>
            <p><strong>Phone:</strong> {cityData.ombudsman.phone}</p>
            <p><strong>Email:</strong> {cityData.ombudsman.email}</p>
            <p><strong>Online Filing:</strong> <a href="https://cioins.co.in" target="_blank" rel="noopener" class="text-blue-600 hover:underline">cioins.co.in</a></p>
          </div>
        </div>

        <div class="bg-amber-50 border border-amber-100 rounded-xl p-6">
          <h3 class="font-bold text-slate-900 mb-3 flex items-center gap-2">
            <svg class="w-5 h-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            Key Ombudsman Rules
          </h3>
          <ul class="space-y-2 text-slate-700 text-sm">
            <li class="flex items-start gap-2"><span class="text-amber-600">•</span> Claim limit: ₹30 lakh (no lawyer needed)</li>
            <li class="flex items-start gap-2"><span class="text-amber-600">•</span> File within 1 year of insurer's final rejection</li>
            <li class="flex items-start gap-2"><span class="text-amber-600">•</span> Hearing within 30 days of filing</li>
            <li class="flex items-start gap-2"><span class="text-amber-600">•</span> Award binding on insurer, appealable in Consumer Commission within 30 days</li>
            <li class="flex items-start gap-2"><span class="text-amber-600">•</span> No court fees, no stamp duty</li>
            <li class="flex items-start gap-2"><span class="text-amber-600">•</span> Can file online at cioins.co.in or in person</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 bg-white">
      <div class="max-w-3xl mx-auto px-4">
        <h2 class="text-2xl font-bold text-slate-900 mb-8">Frequently Asked Questions</h2>
        <div class="space-y-3">
          {faqs.map(faq => (
            <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
              <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors">
                <span class="font-semibold text-slate-900 pr-4">{faq.question}</span>
                <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-5 pb-5">
                <p class="text-slate-600 leading-relaxed whitespace-pre-line">{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Related Claim Guides -->
    <section class="py-16 bg-slate-50">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-2xl font-bold text-slate-900 mb-8">Relevant Claim Guides for {cityData.name} Residents</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <a href="/blog/cashless-health-insurance-claim-denied-hospital-2026/" class="block bg-white rounded-xl border border-slate-200 p-5 hover:shadow-lg hover:border-blue-200 transition-all">
            <span class="inline-block px-2 py-0.5 bg-blue-50 text-blue-600 text-[10px] font-bold rounded uppercase tracking-wide mb-2">Cashless Claims</span>
            <h3 class="text-sm font-bold text-slate-900 mb-1 leading-snug">Cashless Claim Denied at Hospital?</h3>
            <p class="text-xs text-slate-500">Step-by-step appeal when pre-auth is rejected</p>
          </a>
          <a href="/blog/insurance-ombudsman-india-guide/" class="block bg-white rounded-xl border border-slate-200 p-5 hover:shadow-lg hover:border-blue-200 transition-all">
            <span class="inline-block px-2 py-0.5 bg-purple-50 text-purple-600 text-[10px] font-bold rounded uppercase tracking-wide mb-2">Ombudsman</span>
            <h3 class="text-sm font-bold text-slate-900 mb-1 leading-snug">Insurance Ombudsman Filing Guide</h3>
            <p class="text-xs text-slate-500">Complete process, jurisdiction, documents, timelines</p>
          </a>
          <a href="/blog/how-to-appeal-rejected-insurance-claim-india-2026/" class="block bg-white rounded-xl border border-slate-200 p-5 hover:shadow-lg hover:border-blue-200 transition-all">
            <span class="inline-block px-2 py-0.5 bg-red-50 text-red-600 text-[10px] font-bold rounded uppercase tracking-wide mb-2">Appeals</span>
            <h3 class="text-sm font-bold text-slate-900 mb-1 leading-snug">Appeal a Rejected Claim</h3>
            <p class="text-xs text-slate-500">Insurer → IRDAI → Ombudsman → Consumer Court</p>
          </a>
          <a href="/blog/irdai-complete-guide-policyholders-india-2026/" class="block bg-white rounded-xl border border-slate-200 p-5 hover:shadow-lg hover:border-blue-200 transition-all">
            <span class="inline-block px-2 py-0.5 bg-green-50 text-green-600 text-[10px] font-bold rounded uppercase tracking-wide mb-2">IRDAI Rules</span>
            <h3 class="text-sm font-bold text-slate-900 mb-1 leading-snug">IRDAI 30-Day Settlement Rule</h3>
            <p class="text-xs text-slate-500">Your rights, penal interest, complaint process</p>
          </a>
          <a href="/blog/health-insurance-claim-rejection-rights-2026/" class="block bg-white rounded-xl border border-slate-200 p-5 hover:shadow-lg hover:border-blue-200 transition-all">
            <span class="inline-block px-2 py-0.5 bg-amber-50 text-amber-600 text-[10px] font-bold rounded uppercase tracking-wide mb-2">Health Claims</span>
            <h3 class="text-sm font-bold text-slate-900 mb-1 leading-snug">Health Claim Rejection Rights</h3>
            <p class="text-xs text-slate-500">15 real rejection reasons and how to appeal each</p>
          </a>
          <a href="/blog/lic-claim-rejection-appeal-process-2026/" class="block bg-white rounded-xl border border-slate-200 p-5 hover:shadow-lg hover:border-blue-200 transition-all">
            <span class="inline-block px-2 py-0.5 bg-indigo-50 text-indigo-600 text-[10px] font-bold rounded uppercase tracking-wide mb-2">LIC Claims</span>
            <h3 class="text-sm font-bold text-slate-900 mb-1 leading-snug">LIC Claim Rejection Appeal</h3>
            <p class="text-xs text-slate-500">Section 45, nominee disputes, death claim process</p>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 text-white">
      <div class="max-w-3xl mx-auto px-4 text-center">
        <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/10 rounded-full blur-[100px]" />
        <h3 class="text-2xl md:text-3xl font-extrabold mb-3 relative">Stuck with a Claim in {cityData.name}?</h3>
        <p class="text-blue-200/80 mb-6 max-w-2xl mx-auto relative">Free consultation with Hari Kotian. We handle the paperwork, follow-ups, and escalations — you focus on recovery. 12+ years experience, 2,800+ families served.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-900 font-bold rounded-full text-lg shadow-lg shadow-amber-500/25 hover:shadow-xl hover:scale-105 transition-all">
            Book Free Consultation
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
