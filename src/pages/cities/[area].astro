  return SLUGS.map(slug => ({ params: { area: slug } }));
}

const PLAN_MAP = [
  'LIC Jeevan Labh',
  'LIC Tech Term',
  'LIC New Jeevan Anand',
  'LIC Saral Jeevan Bima',
