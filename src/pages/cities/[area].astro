---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AREAS } from '../../data/areas';
import BreadcrumbJsonLd from '../../components/BreadcrumbJsonLd.astro';

const PLAN_MAP = [
  'LIC Jeevan Labh',
  'LIC Tech Term',
  'LIC New Jeevan Anand',
  'LIC Saral Jeevan Bima',
  'LIC Jeevan Arogya',
  'LIC Jeevan Anand',
  'LIC Jeevan Umang',
  'LIC Jeevan Shanti',
  'LIC Dhan Rekha',
];

export async function getStaticPaths() {
  return AREAS.map(a => ({ params: { area: a.slug } }))
}

const area = AREAS.find(a => a.slug === Astro.params.area);
if (!area) return Astro.redirect('/404');

const featuredPlans = PLAN_MAP.sort(() => Math.random() - 0.5).slice(0, 2);
const citySlug = area.slug;
const pageUrl = `https://insurancesupport.online/cities/${citySlug}`;

const LOCAL_LANDMARKS = {
