---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AREAS } from '../../data/areas';



export async function getStaticPaths() {
  return AREAS.map(a => ({ params: { area: a.slug } }))
}

const PLAN_MAP = [
  'LIC Jeevan Labh',
  'LIC Tech Term',
  'LIC New Jeevan Anand',
  'LIC Saral Jeevan Bima',
  'LIC Jeevan Arogya',
  'LIC Jeevan Anand',
  'LIC Jeevan Umang',
  'LIC Jeevan Shanti',
  'LIC Dhan Rekha',
];

const area = AREAS.find(a => a.slug === Astro.params.area);
if (!area) return Astro.redirect('/404');

const featuredPlans = PLAN_MAP.sort(() => Math.random() - 0.5).slice(0, 2);
const citySlug = area.slug;
---

<BaseLayout
  title={`LIC Agent in ${area.name}, Bangalore — Expert Policy Advice | Insurance Support`}
  description={`Trusted LIC agent in ${area.name}, Bangalore. Hari Kotian offers 25+ years of experience. IRDAI Reg No: 0149161D. Life, health, and term insurance services.`}
>
  <main class="max-w-4xl mx-auto px-4 py-16">
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/cities" class="hover:text-blue-600">Locations</a>
      <span class="mx-2">/</span>
      <span class="text-slate-700">{area.name}</span>
    </nav>

    <h1 class="text-4xl font-extrabold text-blue-900 mb-6">
      LIC Agent in {area.name}, Bangalore
    </h1>

    <p class="text-lg text-slate-700 mb-8">
      {area.name} is a key locality in {area.highlight} Bangalore. As your local
      IRDAI-certified LIC advisor, I provide expert guidance on life insurance, health cover,
      term plans, and claim recovery — right here in {area.name}. With 25+ years of
      experience and INR 50Cr+ claims recovered, families across Bangalore trust me
      for honest, professional insurance advisory.
    </p>

    <h2 class="text-2xl font-bold text-slate-900 mb-4">
      Why {area.name} Residents Choose Me
    </h2>
    <ul class="list-disc list-inside space-y-2 text-slate-700 mb-8">
      <li><strong>IRDAI Registered:</strong> Reg No: 0149161D — verified and accountable.</li>
      <li><strong>25+ Years of Trust:</strong> Serving families across Bangalore since 1999.</li>
      <li><strong>INR 50Cr+ Recovered:</strong> Claim recovery expertise you can rely on.</li>
      <li><strong>Door-Step Service:</strong> I visit {area.name} and surrounding areas.</li>
      <li><strong>Free Portfolio Review:</strong> No obligation consultation at your convenience.</li>
    </ul>

    <h2 class="text-2xl font-bold text-slate-900 mb-4">
      Recommended Plans for {area.name}
    </h2>
    <div class="grid md:grid-cols-2 gap-4 mb-8">
      {featuredPlans.map((plan) => (
        <div class="p-4 border rounded-xl shadow-sm">
          <h3 class="font-bold text-blue-800">{plan}</h3>
          <p class="text-sm text-slate-600">Tailored recommendation — get your personalized breakdown on a free call.</p>
        </div>
      ))}
    </div>

    <h2 class="text-2xl font-bold text-slate-900 mb-4">
      Insurance Services in {area.name}
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-8">
      {['Life Insurance', 'Health Insurance', 'Term Plans', 'Pension Plans', 'Claim Support', 'Policy Review'].map(service => (
        <div class="text-sm bg-slate-50 border rounded-lg px-3 py-2 text-slate-700 font-medium">
          {service}
        </div>
      ))}
    </div>

    <div class="bg-gradient-to-r from-blue-600 to-indigo-600 p-6 rounded-2xl text-white mb-8">
      <h2 class="text-2xl font-bold mb-2">Ready to Secure Your Family's Future?</h2>
      <p class="text-blue-100 mb-4">Get a free 15-minute expert policy review. No obligation, no pressure — just honest advice.</p>
      <div class="flex flex-wrap gap-3">
        <a href="https://wa.me/919986634506" class="inline-flex items-center gap-2 bg-green-500 text-white font-bold py-3 px-6 rounded-lg hover:bg-green-600 transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp Now
        </a>
        <a href="tel:+919986634506" class="inline-flex items-center gap-2 bg-white text-blue-900 font-bold py-3 px-6 rounded-lg hover:bg-blue-50 transition-colors">
          Call: +91 99866 34506
        </a>
        <a href="/contact" class="inline-flex items-center gap-2 bg-amber-400 text-slate-900 font-bold py-3 px-6 rounded-lg hover:bg-amber-300 transition-colors">
          Book Free Consultation
        </a>
      </div>
    </div>

    <div class="text-center text-sm text-slate-500">
      <p>IRDAI Reg No: 0149161D | 25+ Years | 1000+ Families Served | INR 50Cr+ Claims Recovered</p>
    </div>
  </main>
</BaseLayout>