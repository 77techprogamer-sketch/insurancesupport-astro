<BaseLayout
  title={`LIC Agent in ${area.name}, Bangalore — Expert Policy Advice | Insurance Support`}
  description={`Trusted LIC agent in ${area.name}, Bangalore. Hari Kotian offers 25+ years of experience. IRDAI Reg No: 0149161D. Life, health, and term insurance services.`}
>
  <main class="max-w-4xl mx-auto px-4 py-16">
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/cities" class="hover:text-blue-600">Locations</a>
      <span class="mx-2">/</span>
      <span class="text-slate-700">{area.name}</span>
    </nav>

    <h1 class="text-4xl font-extrabold text-blue-900 mb-6">
      LIC Agent in {area.name}, Bangalore
    </h1>

    <p class="text-lg text-slate-700 mb-8">
      {area.name} is a key locality in {area.highlight} Bangalore. As your local
      IRDAI-certified LIC advisor, I provide expert guidance on life insurance, health cover,
      term plans, and claim recovery — right here in {area.name}. With 25+ years of
      experience and INR 50Cr+ claims recovered, families across Bangalore trust me
      for honest, professional insurance advisory.
    </p>

    <h2 class="text-2xl font-bold text-slate-900 mb-4">
      Why {area.name} Residents Choose Me
    </h2>
    <ul class="list-disc list-inside space-y-2 text-slate-700 mb-8">
      <li><strong>IRDAI Registered:</strong> Reg No: 0149161D — verified and accountable.</li>
      <li><strong>25+ Years of Trust:</strong> Serving families across Bangalore since 1999.</li>
      <li><strong>INR 50Cr+ Recovered:</strong> Claim recovery expertise you can rely on.</li>
      <li><strong>Door-Step Service:</strong> I visit {area.name} and surrounding areas.</li>
      <li><strong>Free Portfolio Review:</strong> No obligation consultation at your convenience.</li>
    </ul>

    <h2 class="text-2xl font-bold text-slate-900 mb-4">
      Recommended Plans for {area.name}
    </h2>
    <div class="grid md:grid-cols-2 gap-4 mb-8">
      {featuredPlans.map((plan) => (
        <div class="p-4 border rounded-xl shadow-sm">
          <h3 class="font-bold text-blue-800">{plan}</h3>
          <p class="text-sm text-slate-600">Tailored recommendation — get your personalized breakdown on a free call.</p>
        </div>
      ))}
    </div>

    <h2 class="text-2xl font-bold text-slate-900 mb-4">
      Insurance Services in {area.name}
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-8">
      {['Life Insurance', 'Health Insurance', 'Term Plans', 'Pension Plans', 'Claim Support', 'Policy Review'].map(service => (
        <div class="text-sm bg-slate-50 border rounded-lg px-3 py-2 text-slate-700 font-medium">
          {service}
        </div>
      ))}
    </div>

    <div class="bg-gradient-to-r from-blue-600 to-indigo-600 p-6 rounded-2xl text-white mb-8">
      <h2 class="text-2xl font-bold mb-2">Ready to Secure Your Family's Future?</h2>
      <p class="text-blue-100 mb-4">Get a free 15-minute expert policy review. No obligation, no pressure — just honest advice.</p>
