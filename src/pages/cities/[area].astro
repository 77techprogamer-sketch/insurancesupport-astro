const LOCAL_TRENDS = {
  koramangala: 'Koramangala is known for its vibrant nightlife, tech parks, and luxury housing. Many residents are IT professionals and startups.',
  indiranagar: 'Indiranagar is a cultural hub with a mix of residential, commercial, and educational spaces. It has a strong arts and crafts community.',
  jayanagar: 'Jayanagar is a residential area with a mix of middle-class and upper-middle-class families. It has a strong educational and healthcare presence.',
  whitefield: 'Whitefield is a major IT hub with a mix of residential and commercial spaces. It is known for its luxury housing and high-end amenities.',
  hsrlayout: 'HSR Layout is a major IT hub with a mix of residential and commercial spaces. It is known for its luxury housing and high-end amenities.',
  marathahalli: 'Marathahalli is a major IT hub with a mix of residential and commercial spaces. It is known for its luxury housing and high-end amenities.',
  jpnagar: 'JP Nagar is a residential area with a mix of middle-class and upper-middle-class families. It has a strong educational and healthcare presence.',
  bellandur: 'Bellandur is a major IT hub with a mix of residential and commercial spaces. It is known for its luxury housing and high-end amenities.',
  sarjapur: 'Sarjapur is a major IT hub with a mix of residential and commercial spaces. It is known for its luxury housing and high-end amenities.',
  yelahanka: 'Yelahanka is a residential area with a mix of middle-class and upper-middle-class families. It has a strong educational and healthcare presence.'
};

const LOCAL_INSURANCE_TRENDS = {
  koramangala: 'Many residents in Koramangala are concerned about health insurance due to the high cost of medical treatments. They are looking for affordable health insurance plans.',
  indiranagar: 'Residents in Indiranagar are concerned about life insurance due to the high cost of education and healthcare. They are looking for affordable life insurance plans.',
  jayanagar: 'Residents in Jayanagar are concerned about health insurance due to the high cost of medical treatments. They are looking for affordable health insurance plans.',
  whitefield: 'Residents in Whitefield are concerned about life insurance due to the high cost of education and healthcare. They are looking for affordable life insurance plans.',
  hsrlayout: 'Residents in HSR Layout are concerned about health insurance due to the high cost of medical treatments. They are looking for affordable health insurance plans.',
  marathahalli: 'Residents in Marathahalli are concerned about life insurance due to the high cost of education and healthcare. They are looking for affordable life insurance plans.',
  jpnagar: 'Residents in JP Nagar are concerned about health insurance due to the high cost of medical treatments. They are looking for affordable health insurance plans.',
  bellandur: 'Residents in Bellandur are concerned about life insurance due to the high cost of education and healthcare. They are looking for affordable life insurance plans.',
  sarjapur: 'Residents in Sarjapur are concerned about health insurance due to the high cost of medical treatments. They are looking for affordable health insurance plans.',
  yelahanka: 'Residents in Yelahanka are concerned about life insurance due to the high cost of education and healthcare. They are looking for affordable life insurance plans.'
};

const LOCAL_LANDMARKS_LIST = LOCAL_LANDMARKS[citySlug] || [];
const LOCAL_TREND = LOCAL_TRENDS[citySlug] || '';
const LOCAL_INSURANCE_TREND = LOCAL_INSURANCE_TRENDS[citySlug] || '';
---

<BaseLayout
  title={`LIC Agent in ${area.name}, Bangalore — Expert Policy Advice | Insurance Support`}
  description={`Trusted LIC agent in ${area.name}, Bangalore. Hari Kotian offers 25+ years of experience. IRDAI Reg No: 0149161D. Life, health, and term insurance services.`}
>
  <BreadcrumbJsonLd items={[
    { label: 'Home', url: 'https://insurancesupport.online' },
    { label: 'Cities', url: 'https://insurancesupport.online/cities' },
    { label: `${area.name}, Bangalore`, url: pageUrl }
  ]} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": `LIC Agent & Insurance Advisor in ${area.name} - Hari Kotian`,
    "description": `IRDAI certified insurance advisor serving ${area.name}, Bangalore. Life, health, motor, term plans and claim recovery assistance.`,
    "url": pageUrl,
    "telephone": "+91-9986634506",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": area.name,
      "addressRegion": "Bengaluru, KA",
      "postalCode": "560013",
      "addressCountry": "IN"
    },
    "priceRange": "₹₹",
    "parentOrganization": {
      "@type": "Organization",
      "name": "Insurance Support - Hari Kotian",
      "url": "https://insurancesupport.online"
    }
  })} />

  <main id="main" class="max-w-4xl mx-auto px-4 py-16">
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/cities" class="hover:text-blue-600">Locations</a>
      <span class="mx-2">/</span>
      <span class="text-slate-700">{area.name}</span>
    </nav>

    <h1 class="text-4xl font-extrabold text-blue-900 mb-6">
      LIC Agent in {area.name}, Bangalore
    </h1>

    <p class="text-lg text-slate-700 mb-8">
      {area.name} is a key locality in {area.highlight} Bangalore. As your local
      IRDAI-certified LIC advisor, I provide expert guidance on life insurance, health cover,
      term plans, and claim recovery — right here in {area.name}. With 25+ years of
      experience and INR 50Cr+ claims recovered, families across Bangalore trust me
      for honest, professional insurance advisory.
    </p>

    <h2 class="text-2xl font-bold text-slate-900 mb-4">
      Why {area.name} Residents Choose Me
    </h2>
    <ul class="list-disc list-inside space-y-2 text-slate-700 mb-8">
      <li><strong>IRDAI Registered:</strong> Reg No: 0149161D — verified and accountable.</li>
      <li><strong>25+ Years of Trust:</strong> Serving families across Bangalore since 1999.</li>
      <li><strong>INR 50Cr+ Recovered:</strong> Claim recovery expertise you can rely on.</li>
      <li><strong>Door-Step Service:</strong> I visit {area.name} and surrounding areas.</li>
      <li><strong>Free Portfolio Review:</strong> No obligation consultation at your convenience.</li>
    </ul>

    <h2 class="text-2xl font-bold text-slate-900 mb-4">
      Local Landmarks in {area.name}
    </h2>
    <ul class="list-disc list-inside space-y-2 text-slate-700 mb-8">
      {LOCAL_LANDMARKS_LIST.map((landmark) => (
        <li>{landmark}</li>
      ))}
    </ul>

    <h2 class="text-2xl font-bold text-slate-900 mb-4">
      Local Trends in {area.name}
    </h2>
    <p class="text-lg text-slate-700 mb-8">
      {LOCAL_TREND}
    </p>

    <h2 class="text-2xl font-bold text-slate-900 mb-4">
      Insurance Trends in {area.name}
    </h2>
    <p class="text-lg text-slate-700 mb-8">
      {LOCAL_INSURANCE_TREND}
    </p>

    <h2 class="text-2xl font-bold text-slate-900 mb-4">
      Recommended Plans for {area.name}
    </h2>
    <div class="grid md:grid-cols-2 gap-4 mb-8">
      {featuredPlans.map((plan) => (
        <div class="p-4 border rounded-xl shadow-sm">
          <h3 class="text-xl font-bold text-slate-900 mb-2">{plan}</h3>
          <p class="text-slate-700">
            A tailored {plan} plan designed for residents in {area.name}.
          </p>
        </div>
      ))}
    </div>

    <div class="mt-12 bg-gradient-to-r from-blue-600 to-indigo-600 p-8 rounded-2xl text-white text-center">
      <h2 class="text-2xl font-bold mb-3">Need Insurance Help in {area.name}?</h2>
      <p class="text-blue-100 mb-6">Get expert advice from your local LIC agent in {area.name}.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20I%20need%20insurance%20help%20in%20${area.name}." target="_blank" rel="noopener noreferrer" class="bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-6 rounded-lg transition-colors">
          WhatsApp for Insurance Advice
        </a>
        <a href="tel:+919986634506" class="bg-white hover:bg-blue-50 text-blue-900 font-bold py-3 px-6 rounded-lg transition-colors">
          Call +91-99866 34506
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
