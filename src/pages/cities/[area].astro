    'Bellandur 1st Block',
    'Bellandur 2nd Block',
    'Bellandur 3rd Block',
    'Bellandur 4th Block'
  ],
  sarjapur: [
    'Sarjapur Road',
    'Sarjapur 1st Block',
    'Sarjapur 2nd Block',
    'Sarjapur 3rd Block',
    'Sarjapur 4th Block'
  ],
  yelahanka: [
    'Yelahanka New Town',
    'Yelahanka 1st Block',
    'Yelahanka 2nd Block',
    'Yelahanka 3rd Block',
    'Yelahanka 4th Block'
  ]
