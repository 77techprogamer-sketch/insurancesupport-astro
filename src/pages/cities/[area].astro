  indiranagar: [
    'Indiranagar 100ft Road',
    'Indiranagar 2nd Stage',
    'Indiranagar 3rd Stage',
    'Indiranagar 4th Stage',
    'Indiranagar 5th Stage'
  ],
  jayanagar: [
    'Jayanagar 4th Block',
    'Jayanagar 9th Block',
    'Jayanagar 10th Block',
    'Jayanagar 11th Block',
    'Jayanagar 1st Block'
  ],
  whitefield: [
    'Whitefield Main Road',
    'Whitefield 2nd Stage',
    'Whitefield 3rd Stage',
    'Whitefield 4th Stage',
    'Whitefield 5th Stage'
  ],
  hsrlayout: [
    'HSR Layout 1st Sector',
    'HSR Layout 2nd Sector',
