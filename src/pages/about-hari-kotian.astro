>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "About Hari Kotian — Insurance Support",
    "description": "Hari Kotian leads Insurance Support, a Bengaluru-based insurance guidance and claim assistance service.",
