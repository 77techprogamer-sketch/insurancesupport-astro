---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalBusinessJsonLd from '../components/LocalBusinessJsonLd.astro';
import TrustBadges from '../components/TrustBadges.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import SupportScopeSection from '../components/sections/SupportScopeSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';

const pageTitle = "IRDAI Certified Insurance Advisor in Bengaluru | Hari Kotian";
const pageDescription = "25+ years experience IRDAI certified insurance advisor in Bengaluru. Free consultation for life, health, motor, term & all insurance types. Claim recovery expert. Call +91-99866 34506.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <LocalBusinessJsonLd />

  <a href="#main-content" class="sr-only focus:not-sr-only">Skip to main content</a>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Insurance Support - Home",
    "description": pageDescription,
    "url": "https://insurancesupport.online",
    "inLanguage": "en"
  })} />

  <TrustBadges />

  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative bg-white pt-20 pb-32 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row items-center">
          <div class="w-full lg:w-1/2 text-center lg:text-left mb-12 lg:mb-0">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-slate-900 leading-tight mb-6">
              Your Trusted Insurance Advisor
              <span class="text-blue-600">with 25+ Years</span> of Experience
            </h1>
            <p class="text-lg sm:text-xl text-slate-600 mb-8 leading-relaxed">
              IRDAI-certified independent insurance advisor providing comprehensive insurance advisory across Bengaluru and India. Free, no-obligation consultation.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
              <div class="text-center lg:text-left">
                <div class="text-2xl font-bold text-blue-600">25+ Years</div>
                <div class="text-sm text-slate-500">Experience</div>
              </div>
              <div class="text-center lg:text-left">
                <div class="text-2xl font-bold text-green-600">1000+ Families</div>
                <div class="text-sm text-slate-500">Happy Clients</div>
              </div>
              <div class="text-center lg:text-left">
                <div class="text-2xl font-bold text-amber-600">4.2&#9733; Rating</div>
                <div class="text-sm text-slate-500">Google Reviews</div>
              </div>
            </div>
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3.5 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-xl hover:from-blue-700 hover:to-indigo-700 transition-all shadow-lg shadow-blue-500/20">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                Book Free Consultation
              </a>
              <a href="#services" class="inline-flex items-center gap-2 px-6 py-3.5 border border-slate-300 text-slate-700 font-semibold rounded-xl hover:bg-slate-50 transition-colors">
                View Services
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </a>
            </div>
          </div>
          <div class="w-full lg:w-1/2">
            <div class="relative">
              <div class="aspect-[4/3] rounded-2xl bg-gradient-to-br from-blue-50 to-indigo-50 p-8">
                <div class="h-full w-full bg-white rounded-xl shadow-xl flex items-center justify-center">
                  <div class="text-center p-8">
                    <div class="w-24 h-24 mx-auto mb-4 rounded-full bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center text-white font-bold text-xl">HK</div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Hari Kotian</h3>
                    <p class="text-sm text-slate-600 mb-4">IRDAI Certified Advisor</p>
                    <p class="text-sm font-medium">IRDAI Reg: 0149161D</p>
                  </div>
                </div>
              </div>
              <div class="absolute -bottom-6 -right-6 bg-white rounded-xl shadow-xl p-4 border border-slate-100 hidden lg:block">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-lg bg-green-50 flex items-center justify-center">
                    <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  </div>
                  <div>
                    <div class="text-sm font-bold text-slate-900">Claim Recovery</div>
                    <div class="text-xs text-slate-500">95% Success Rate</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services -->
    <ServicesSection />

    <!-- FAQ Section -->
    <section class="py-20 lg:py-28 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Frequently Asked Questions</h2>
          <p class="text-lg text-slate-600">Get answers to the most common questions about insurance planning and our services.</p>
        </div>
        <div class="space-y-4">
          <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <details class="group">
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none hover:bg-slate-50 transition-colors">
                <h3 class="text-lg font-semibold text-slate-900">How much does insurance cost and what affects the premium?</h3>
              </summary>
              <div class="px-6 pb-6">
                <p class="text-slate-600 leading-relaxed">Premiums vary based on coverage type, sum assured, age, health condition, occupation, and location. GST of 18% is applicable on most insurance premiums. The key factors affecting premiums are sum assured requirements, age, health, and coverage duration.</p>
              </div>
            </details>
          </div>
          <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <details class="group">
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none hover:bg-slate-50 transition-colors">
                <h3 class="text-lg font-semibold text-slate-900">How do I know which insurance is best for my family?</h3>
              </summary>
              <div class="px-6 pb-6">
                <p class="text-slate-600 leading-relaxed">The best insurance depends on your family size, age, income, existing assets, health conditions, and goals. I provide personalized advisory based on your unique situation, comparing multiple insurer options to find the most suitable coverage.</p>
              </div>
            </details>
          </div>
          <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <details class="group">
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none hover:bg-slate-50 transition-colors">
                <h3 class="text-lg font-semibold text-slate-900">What documents are needed for insurance claims?</h3>
              </summary>
              <div class="px-6 pb-6">
                <p class="text-slate-600 leading-relaxed">Required documents typically include: completed claim form, original policy document, medical reports/invoices, FIR and police report, death certificate, and proof of identity. I assist with claim filing, document preparation, and follow-up.</p>
              </div>
            </details>
          </div>
          <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <details class="group">
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none hover:bg-slate-50 transition-colors">
                <h3 class="text-lg font-semibold text-slate-900">Can you help with policy review and switching?</h3>
              </summary>
              <div class="px-6 pb-6">
                <p class="text-slate-600 leading-relaxed">Yes, policy review and switching is one of our specialties. We compare multiple insurers using our expertise in policy comparison, ensuring you don't lose continuity of coverage. We handle all the paperwork and coordination.</p>
              </div>
            </details>
          </div>
        </div>
        <div class="text-center mt-12">
          <a href="/faq" class="inline-flex items-center gap-2 px-6 py-3 bg-slate-50 text-slate-700 font-medium rounded-lg hover:bg-slate-100 transition-colors">
            View All FAQs
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Process Timeline -->
    <section class="py-20 lg:py-28 bg-gradient-to-br from-slate-50 to-blue-50/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mb-4">Simple 4-Step Process</h2>
          <p class="text-lg text-slate-600 max-w-2xl mx-auto">We believe insurance advisory should be transparent, straightforward, and stress-free.</p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
          <div class="text-center">
            <div class="w-16 h-16 mx-auto mb-6 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-full flex items-center justify-center text-white font-bold text-xl shadow-lg">1</div>
            <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
              <h3 class="text-lg font-bold text-slate-900 mb-3">Free Consultation</h3>
              <p class="text-sm text-slate-600">Schedule a no-obligation consultation to discuss your needs.</p>
            </div>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 mx-auto mb-6 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-full flex items-center justify-center text-white font-bold text-xl shadow-lg">2</div>
            <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
              <h3 class="text-lg font-bold text-slate-900 mb-3">Policy Analysis</h3>
              <p class="text-sm text-slate-600">We compare multiple insurer options to find the best coverage.</p>
            </div>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 mx-auto mb-6 bg-gradient-to-br from-purple-500 to-pink-600 rounded-full flex items-center justify-center text-white font-bold text-xl shadow-lg">3</div>
            <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
              <h3 class="text-lg font-bold text-slate-900 mb-3">Implementation</h3>
              <p class="text-sm text-slate-600">We handle all paperwork and coordinate with insurers.</p>
            </div>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 mx-auto mb-6 bg-gradient-to-br from-pink-500 to-rose-600 rounded-full flex items-center justify-center text-white font-bold text-xl shadow-lg">4</div>
            <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
              <h3 class="text-lg font-bold text-slate-900 mb-3">Lifetime Support</h3>
              <p class="text-sm text-slate-600">Ongoing policy reviews and claim assistance for life.</p>
            </div>
          </div>
        </div>
        <div class="text-center mt-16">
          <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-xl hover:from-blue-700 hover:to-indigo-700 transition-all shadow-lg shadow-blue-500/20">
            Start Your Journey Today
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Support Scope -->
    <SupportScopeSection />

    <!-- Service Areas -->
    <section class="py-20 lg:py-28 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Serving Across Bengaluru & Nationwide</h2>
          <p class="text-lg text-slate-600 max-w-2xl mx-auto">Primary service area in Bengaluru with pan-India coverage for online consultations.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-6 border border-blue-100">
            <div class="w-12 h-12 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-lg mb-4">BL</div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Bengaluru</h3>
            <p class="text-sm text-slate-600">Primary service area covering all neighborhoods</p>
          </div>
          <div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-xl p-6 border border-emerald-100">
            <div class="w-12 h-12 rounded-lg bg-emerald-600 flex items-center justify-center text-white font-bold text-lg mb-4">IN</div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Nationwide</h3>
            <p class="text-sm text-slate-600">Pan-India policy coverage and consultations</p>
          </div>
          <div class="bg-gradient-to-br from-purple-50 to-violet-50 rounded-xl p-6 border border-purple-100">
            <div class="w-12 h-12 rounded-lg bg-purple-600 flex items-center justify-center text-white font-bold text-lg mb-4">IT</div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">IT Sector</h3>
            <p class="text-sm text-slate-600">Corporate and employee insurance solutions</p>
          </div>
          <div class="bg-gradient-to-br from-orange-50 to-amber-50 rounded-xl p-6 border border-orange-100">
            <div class="w-12 h-12 rounded-lg bg-orange-600 flex items-center justify-center text-white font-bold text-lg mb-4">EDU</div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Educational</h3>
            <p class="text-sm text-slate-600">School and college insurance solutions</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="py-20 lg:py-28 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">What Our Clients Say</h2>
          <p class="text-lg text-slate-600 max-w-2xl mx-auto">Real experiences from families who trust us with their insurance needs.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-8 hover:shadow-lg transition-shadow">
            <p class="text-slate-600 mb-6 leading-relaxed">"Hari Kotian's guidance helped me save annually on my family's health insurance while getting better coverage. The claim settlement was seamless. Truly professional service!"</p>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-slate-200 flex items-center justify-center"><span class="text-sm font-semibold text-slate-600">R.K.</span></div>
              <div><div class="text-sm font-semibold text-slate-900">Rajesh Kumar</div><div class="text-xs text-slate-500">Bengaluru</div></div>
            </div>
          </div>
          <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-8 hover:shadow-lg transition-shadow">
            <p class="text-slate-600 mb-6 leading-relaxed">"Excellent service for our two-wheeler insurance. The claim process was quick and hassle-free. Hari understands the policies thoroughly. Highly recommended!"</p>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-slate-200 flex items-center justify-center"><span class="text-sm font-semibold text-slate-600">S.M.</span></div>
              <div><div class="text-sm font-semibold text-slate-900">Sumantha Malu</div><div class="text-xs text-slate-500">Whitefield, Bengaluru</div></div>
            </div>
          </div>
          <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-8 hover:shadow-lg transition-shadow">
            <p class="text-slate-600 mb-6 leading-relaxed">"The term insurance plan I got is perfect for my goals. The premium is affordable and the coverage is comprehensive. Very professional!"</p>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-slate-200 flex items-center justify-center"><span class="text-sm font-semibold text-slate-600">P.A.</span></div>
              <div><div class="text-sm font-semibold text-slate-900">Priya Agarwal</div><div class="text-xs text-slate-500">Electronic City, Bengaluru</div></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <ContactSection />

    <!-- CTA Banner -->
    <div class="py-8 bg-gradient-to-r from-blue-600 to-indigo-600">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center justify-center gap-8 text-white">
          <div class="flex items-center gap-2"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg><span class="text-sm font-medium">IRDAI Certified: 0149161D</span></div>
          <div class="flex items-center gap-2"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg><span class="text-sm font-medium">Call: +91-99866 34506</span></div>
          <div class="flex items-center gap-2"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg><span class="text-sm font-medium">Email: contact@insurancesupport.online</span></div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
