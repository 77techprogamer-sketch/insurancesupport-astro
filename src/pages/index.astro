---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbJsonLd from '../components/BreadcrumbJsonLd.astro';
import FAQPageJsonLd from '../components/FAQPageJsonLd.astro';
import ClaimRejectionQuiz from '../components/ClaimRejectionQuiz.astro';
import Icon from '../components/icons/Icon.astro';

const pageTitle = 'Insurance Support | Insurance Claim Help & Advisory India | Free Review by IRDAI Advisor';
const pageDescription = 'Insurance claim rejected, delayed or underpaid? Get free case review from Hari Kotian, IRDAI-certified advisor (Reg No: 0149161D). We handle health, life, motor, term claim disputes across India. No fee for first review.';
const pageKeywords = 'insurance claim help India, claim rejection appeal, IRDAI advisor, insurance claim recovery, health claim rejected, life insurance claim dispute, motor claim settlement, term insurance claim help';

const services = [
  {
    title: 'Health & Mediclaim Claims',
    desc: 'Pre-existing disease exclusions, room-rent capping, cashless denials, non-disclosure allegations.',
    icon: 'heart-pulse',
    href: '/services/health-insurance',
  },
  {
    title: 'Life & Term Insurance Claims',
    desc: 'Death claim repudiation, contestability period disputes, nominee disputes, mis-selling cases.',
    icon: 'user-check',
    href: '/services/life-insurance',
  },
  {
    title: 'Motor Insurance Claims',
    desc: 'Total loss undervaluation, surveyor deductions, own-damage repudiation, third-party disputes.',
    icon: 'car',
    href: '/services/motor-insurance',
  },
  {
      title: 'Claim Rejection Appeals',
      desc: "IRDAI Bima Bharosa filing, Insurance Ombudsman representation, grievance redressal escalation.",
      icon: 'gavel',
      href: '/services/claim-support',
    },
  {
      title: 'All Services — Insurance Support Hub',
      desc: 'Complete overview of every claim type we handle, insurers we deal with, and how we work.',
      icon: 'shield-check',
      href: '/insurance-support/',
    },
];

const trustSignals = [
  { label: 'IRDAI Registered', detail: 'Advisor Reg No: 0149161D' },
  { label: '25+ Years Experience', detail: 'Insurance advisory & claims' },
  { label: 'Pan-India Service', detail: 'Remote & doorstep in Bengaluru' },
  { label: 'No Fee First Review', detail: 'Honest assessment in 24 hrs' },
];

const processSteps = [
  {
    number: '01',
    title: 'Free Case Review',
    desc: 'Send your rejection letter & policy copy. We respond within 24 hours with an honest assessment.',
  },
  {
    number: '02',
    title: 'Policy & Ground Analysis',
    desc: 'Clause-by-clause review to identify where the insurer\'s reasoning fails.',
  },
  {
    number: '03',
    title: 'Documentation & Representation',
    desc: 'Medical records, doctor certificates, structured grievance to the insurer\'s GRO.',
  },
  {
    number: '04',
    title: 'Regulatory Escalation',
    desc: 'IRDAI Bima Bharosa complaint and Insurance Ombudsman filing on your behalf.',
  },
  {
    number: '05',
    title: 'Resolution & Follow-up',
    desc: 'We track every hearing and reminder until settlement lands in your account.',
  },
];

const testimonials = [
  {
    content: 'The insurer said my angioplasty was a pre-existing condition after four years of clean renewals. Insurance Support pulled my old records, drafted the representation, and the amount was credited before the Ombudsman hearing.',
    name: 'R. Sharma',
    role: 'Health Insurance Claim, Bangalore',
  },
  {
    content: 'After my husband\'s death the claim was repudiated for non-disclosure. I had given up. Hari Kotian\'s team handled the Ombudsman filing end to end and explained every step in simple language.',
    name: 'M. Patel',
    role: 'Term Insurance Claim, Mumbai',
  },
  {
    content: 'The surveyor\'s IDV was far below market. They challenged the deductions with valuation evidence and the insurer revised the settlement in six weeks.',
    name: 'A. Reddy',
    role: 'Motor Insurance Claim, Hyderabad',
  },
];

const faqs = [
  {
    question: 'My claim was rejected. Is it worth fighting?',
    answer: 'Yes. A significant percentage of rejected claims are overturned on appeal, especially when the rejection is based on vague grounds like "non-disclosure" or "pre-existing condition" without specific evidence. Our free review tells you honestly if you have a case.',
  },
  {
    question: 'How long does the appeal process take?',
    answer: 'Insurer GRO: 15-30 days. IRDAI Bima Bharosa: 30-45 days. Insurance Ombudsman: 3-6 months typically. We manage the entire timeline and keep you updated at every stage.',
  },
  {
    question: 'What documents do I need to start?',
    answer: 'Rejection letter, policy document, claim form submitted, medical records (for health/life), FIR/survey report (for motor), and any correspondence with the insurer. We guide you on exactly what\'s needed.',
  },
  {
    question: 'Do you charge for the initial review?',
    answer: 'No. The first case review is completely free. We only discuss fees if we take up your case, and the structure is transparent — typically a percentage of recovered amount or a fixed fee agreed upfront.',
  },
  {
    question: 'Can you help with claims outside Bengaluru?',
        answer: 'Yes. We handle claims across India remotely. For Bengaluru clients, we offer doorstep document collection and in-person meetings. All regulatory filings (IRDAI, Ombudsman) are done online.',
      },
    ];
    ---

<BaseLayout title={pageTitle} description={pageDescription} keywords={pageKeywords} skipGlobalOrgSchema={true} skipGlobalLocationSchema={true}>
  <BreadcrumbJsonLd items={[
    { label: 'Home', url: 'https://insurancesupport.online' }
  ]} />

  <main id="main" role="main">
    <!-- Hero Section -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-content">
        <div class="hero-badge animate-fade-in" style="font-family: var(--font-sans);">
                  <Icon name="shield-check" size="sm" />
                  <span>IRDAI Registered Advisor · Reg No: 0149161D</span>
                </div>

                <h1 id="hero-title" class="hero-title animate-slide-up stagger-1" style="font-family: var(--font-display);">
                  Your claim was rejected.<br /><span style="color: var(--color-primary);">That is not the final word.</span>
                </h1>

                <p class="hero-desc animate-slide-up stagger-2" style="font-family: var(--font-sans);">
                  Insurance Support helps Indian policyholders challenge rejected, delayed, and underpaid claims — with clause-level policy analysis, airtight documentation, and escalation up to the Insurance Ombudsman.
                </p>

                <div class="hero-actions animate-slide-up stagger-3">
                          <a href="https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20my%20claim%20was%20rejected.%20I%20need%20help." target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg" style="font-family: var(--font-sans);" aria-label="Start free case review on WhatsApp">
                            <Icon name="whatsapp" size="sm" />
                            Free Case Review on WhatsApp
                          </a>
                          <a href="tel:+919986634506" class="btn btn-outline btn-lg" style="font-family: var(--font-sans);" aria-label="Call +91 99866 34506">
                            <Icon name="phone" size="sm" />
                            Call +91 99866 34506
                          </a>
                        </div>

                <!-- Trust Bar -->
                <div class="hero-trust animate-slide-up stagger-4" role="list" aria-label="Trust indicators">
                  {trustSignals.map((signal, i) => (
                    <div class="hero-trust-item" role="listitem" style="font-family: var(--font-sans);">
                      <Icon name="check" size="sm" />
                      <span><strong>{signal.label}</strong> — {signal.detail}</span>
                    </div>
                  ))}
                </div>
      </div>
    </section>

    <!-- Track record -->
    <section class="py-10 sm:py-14 bg-white border-b border-slate-200" aria-labelledby="proof-title">
      <div class="max-w-7xl mx-auto px-4">
        <h2 id="proof-title" class="sr-only">Our track record</h2>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          <div class="text-center p-4 sm:p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="text-3xl sm:text-4xl font-extrabold text-slate-900" style="font-family: var(--font-display);">500+</div>
            <div class="mt-1 text-sm font-semibold text-slate-700">Policyholders guided</div>
            <div class="mt-1 text-xs text-slate-500">Across life, health &amp; motor</div>
          </div>
          <div class="text-center p-4 sm:p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="text-3xl sm:text-4xl font-extrabold text-slate-900" style="font-family: var(--font-display);">78%</div>
            <div class="mt-1 text-sm font-semibold text-slate-700">Success rate</div>
            <div class="mt-1 text-xs text-slate-500">On claims we take up</div>
          </div>
          <div class="text-center p-4 sm:p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="text-3xl sm:text-4xl font-extrabold text-slate-900" style="font-family: var(--font-display);">200+</div>
            <div class="mt-1 text-sm font-semibold text-slate-700">LIC claims resolved</div>
            <div class="mt-1 text-xs text-slate-500">Revival, maturity &amp; death claims</div>
          </div>
          <div class="text-center p-4 sm:p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="text-3xl sm:text-4xl font-extrabold text-slate-900" style="font-family: var(--font-display);">150+</div>
            <div class="mt-1 text-sm font-semibold text-slate-700">Ombudsman cases</div>
            <div class="mt-1 text-xs text-slate-500">Filed &amp; argued</div>
          </div>
        </div>

        <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-6">
          <div class="flex items-center gap-2">
            <span class="text-amber-500 text-lg" aria-hidden="true">★★★★★</span>
            <span class="text-sm font-semibold text-slate-800">4.2 out of 5 on Google</span>
            <span class="text-sm text-slate-500">(23 reviews)</span>
          </div>
          <span class="hidden sm:inline text-slate-300" aria-hidden="true">|</span>
          <span class="text-sm text-slate-600">
            <strong class="text-slate-800">25+ years</strong> advising policyholders from Bengaluru
          </span>
        </div>

        <p class="mt-4 text-center text-xs text-slate-500 max-w-2xl mx-auto">
          Figures reflect work handled by Hari Kotian to date. Every claim is decided by the insurer or
          the Ombudsman on its own facts — past outcomes do not predict the result of your claim.
        </p>
      </div>
    </section>

    <!-- What We Handle -->
    <section class="section" aria-labelledby="services-title">
      <div class="container">
        <header class="section-header">
          <span class="section-label" style="font-family: var(--font-sans);">What We Handle</span>
          <h2 id="services-title" class="section-title" style="font-family: var(--font-display);">Every kind of claim dispute Indian policyholders run into</h2>
          <p class="section-desc" style="font-family: var(--font-sans);">From health claim denials to life insurance repudiations — we know the clauses, the process, and how to win.</p>
        </header>

        <div class="grid-auto">
                  {services.map((service, i) => (
                    <article class="card animate-slide-up" style={`animation-delay: ${(i + 1) * 100}ms`}>
                      <div class="icon icon-primary mb-4" aria-hidden="true">
                        <Icon name={service.icon} size="md" />
                      </div>
                      <h3 style="font-family: var(--font-display); font-size: 1.25rem; margin-bottom: var(--space-3);">{service.title}</h3>
                      <p style="font-family: var(--font-sans); color: var(--color-text-secondary); margin-bottom: var(--space-4);">{service.desc}</p>
                      <a href={service.href} class="link-aurora" style="font-family: var(--font-sans);">Learn more →</a>
                    </article>
                  ))}
                </div>
      </div>
    </section>

    <!-- Claim Rejection Quiz -->
    <section class="section" style="background: var(--color-bg-alt);" aria-labelledby="quiz-title">
      <div class="container">
        <header class="section-header">
          <span class="section-label" style="font-family: var(--font-sans);">Free Assessment</span>
          <h2 id="quiz-title" class="section-title" style="font-family: var(--font-display);">Quick quiz: How strong is your claim appeal?</h2>
          <p class="section-desc" style="font-family: var(--font-sans);">Answer 5 questions. Get an honest potential score in 60 seconds.</p>
        </header>
        <div style="max-width: 560px; margin: 0 auto;">
          <ClaimRejectionQuiz />
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="section" style="background: var(--color-bg-alt);" aria-labelledby="process-title">
      <div class="container">
        <header class="section-header">
          <span class="section-label" style="font-family: var(--font-sans);">How It Works</span>
          <h2 id="process-title" class="section-title" style="font-family: var(--font-display);">From rejection letter to resolution, in five steps</h2>
          <p class="section-desc" style="font-family: var(--font-sans);">A clear, structured process — no surprises, no jargon.</p>
        </header>

        <div class="steps">
          {processSteps.map((step, i) => (
            <article class="card animate-slide-up" style={`animation-delay: ${(i + 1) * 100}ms`}>
              <div class="step-number" aria-label="Step {step.number}">{step.number}</div>
              <h3 class="step-title" style="font-family: var(--font-display);">{step.title}</h3>
              <p class="step-desc" style="font-family: var(--font-sans);">{step.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Insurers We Deal With -->
    <section class="section" aria-labelledby="insurers-title">
      <div class="container">
        <header class="section-header">
          <span class="section-label" style="font-family: var(--font-sans);">Insurers & Regulators</span>
          <h2 id="insurers-title" class="section-title" style="font-family: var(--font-display);">We know how each insurer's grievance desk works</h2>
          <p class="section-desc" style="font-family: var(--font-sans);">Our team has taken up matters against most major Indian insurers and TPAs. We use the official route every time.</p>
        </header>

        <div class="trust-bar" role="list" aria-label="Insurers we handle">
          {[
            'Star Health', 'HDFC ERGO', 'LIC of India', 'ICICI Lombard',
            'Niva Bupa', 'New India Assurance', 'Bajaj Allianz', 'Care Health',
            'SBI General', 'Tata AIG', 'Oriental Insurance', 'Max Life'
          ].map(insurer => (
            <span role="listitem" class="badge badge-primary" style="font-family: var(--font-sans);">{insurer}</span>
          ))}
        </div>

        <p style="text-align: center; margin-top: var(--space-6); font-size: 0.875rem; color: var(--color-text-muted); font-family: var(--font-sans);">
          Insurer names listed only to describe matters we assist with. No affiliation, partnership, or endorsement implied.
        </p>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="section" style="background: var(--color-bg-alt);" aria-labelledby="testimonials-title">
      <div class="container">
        <header class="section-header">
          <span class="section-label" style="font-family: var(--font-sans);">Case Outcomes</span>
          <h2 id="testimonials-title" class="section-title" style="font-family: var(--font-display);">Policyholders who were told no — and did not stop there</h2>
          <p class="section-desc" style="font-family: var(--font-sans);">Names changed on request. Past outcomes do not predict the result of your claim.</p>
        </header>

        <div class="grid-3">
          {testimonials.map((testimonial, i) => (
            <article class="testimonial animate-slide-up" style={`animation-delay: ${(i + 1) * 100}ms`}>
              <p class="testimonial-content" style="font-family: var(--font-sans);">"{testimonial.content}"</p>
              <div class="testimonial-author" style="font-family: var(--font-sans);">
                <div class="testimonial-avatar" aria-hidden="true">{testimonial.name.charAt(0)}</div>
                <div>
                  <div class="testimonial-name">{testimonial.name}</div>
                  <div class="testimonial-role">{testimonial.role}</div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" aria-labelledby="faq-title">
      <div class="container">
        <header class="section-header">
          <span class="section-label" style="font-family: var(--font-sans);">Common Questions</span>
          <h2 id="faq-title" class="section-title" style="font-family: var(--font-display);">Straight answers, no fine print</h2>
        </header>

        <div class="grid-2" style="max-width: 900px; margin: 0 auto;">
          <FAQPageJsonLd questions={faqs} />
          {faqs.map((faq, i) => (
                      <details class="faq-item animate-slide-up" style={`animation-delay: ${(i + 1) * 100}ms`}>
                        <summary class="faq-question" style="font-family: var(--font-sans);">
                          {faq.question}
                          <Icon name="arrow-right" size="sm" class="faq-icon" />
                        </summary>
                        <div class="faq-answer" style="font-family: var(--font-sans);">{faq.answer}</div>
                      </details>
                    ))}
        </div>
      </div>
    </section>

    <!-- Named advisor + callback form -->
    <section class="py-14 sm:py-20 bg-white border-t border-slate-200" aria-labelledby="advisor-title">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-start">

          <!-- Who you will actually speak to -->
          <div>
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold mb-4">
              <Icon name="shield-check" size="sm" />
              IRDAI Registered · 0149161D
            </span>
            <h2 id="advisor-title" class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-3" style="font-family: var(--font-display);">
              You deal with Hari Kotian, not a call centre
            </h2>
            <p class="text-slate-600 mb-6 leading-relaxed">
              Every enquiry is reviewed personally by Hari Kotian — an IRDAI-registered insurance advisor
              (Reg. No. 0149161D) with 25+ years of claims and policy work from Bengaluru. No bots,
              no scripted agents, no passing your file between departments.
            </p>

            <h3 class="text-sm font-bold uppercase tracking-wide text-slate-500 mb-3">What happens after you enquire</h3>
            <ol class="space-y-3 mb-6">
              <li class="flex gap-3">
                <span class="shrink-0 w-7 h-7 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-sm font-bold">1</span>
                <span class="text-slate-700 text-sm pt-1">You send the insurer's rejection or delay letter — or just describe what happened.</span>
              </li>
              <li class="flex gap-3">
                <span class="shrink-0 w-7 h-7 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-sm font-bold">2</span>
                <span class="text-slate-700 text-sm pt-1">You get an honest read on whether it is appealable — <strong class="text-slate-900">free, within 24 hours</strong>.</span>
              </li>
              <li class="flex gap-3">
                <span class="shrink-0 w-7 h-7 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-sm font-bold">3</span>
                <span class="text-slate-700 text-sm pt-1">If it is worth pursuing, we map the escalation: insurer GRO, IRDAI, then the Ombudsman.</span>
              </li>
            </ol>

            <div class="flex flex-wrap gap-3">
              <a href="https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20my%20claim%20was%20rejected.%20I%20need%20help." target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm transition-colors">
                <Icon name="whatsapp" size="sm" />
                WhatsApp your case
              </a>
              <a href="tel:+919986634506" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl border border-slate-300 hover:border-slate-400 text-slate-800 font-semibold text-sm transition-colors">
                <Icon name="phone" size="sm" />
                +91 99866 34506
              </a>
            </div>
          </div>

          <!-- Callback form -->
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 sm:p-8">
            <h3 class="text-xl font-bold text-slate-900 mb-1">Request a free case review</h3>
            <p class="text-sm text-slate-600 mb-5">Two fields. We reply within 24 hours, and only about your claim.</p>

            <form id="homeCallbackForm" class="space-y-4" novalidate>
              <div>
                <label for="cb-name" class="block text-sm font-semibold text-slate-800 mb-1.5">Your name</label>
                <input type="text" id="cb-name" name="name" required autocomplete="name"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-white text-slate-900 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition"
                  placeholder="e.g. Ramesh Kumar" />
              </div>

              <div>
                <label for="cb-phone" class="block text-sm font-semibold text-slate-800 mb-1.5">Phone / WhatsApp</label>
                <input type="tel" id="cb-phone" name="phone" required inputmode="numeric" autocomplete="tel"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-white text-slate-900 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition"
                  placeholder="10-digit mobile number" />
              </div>

              <div>
                <label for="cb-category" class="block text-sm font-semibold text-slate-800 mb-1.5">What is it about?</label>
                <select id="cb-category" name="category"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-white text-slate-900 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition">
                  <option value="Health Insurance Claim">Health insurance claim</option>
                  <option value="LIC / Life Insurance Claim">LIC or life insurance claim</option>
                  <option value="Motor Insurance Claim">Motor insurance claim</option>
                  <option value="Term Insurance Claim">Term insurance claim</option>
                  <option value="Policy Review">Policy review</option>
                  <option value="Other">Something else</option>
                </select>
              </div>

              <div id="cb-error" class="hidden text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-3 py-2" role="alert"></div>

              <button type="submit" id="cb-submit"
                class="w-full px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold transition-colors shadow-lg shadow-emerald-600/20">
                Get my free case review
              </button>

              <p class="text-xs text-slate-500 leading-relaxed">
                Your details are used only to review your case and contact you about it. See our
                <a href="/privacy-policy" class="text-emerald-700 underline">Privacy Policy</a>.
                No obligation, no fee for the first review.
              </p>
            </form>

            <div id="cb-success" class="hidden text-center py-6">
              <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-2xl" aria-hidden="true">✓</div>
              <h4 class="text-lg font-bold text-slate-900 mb-2">Request received</h4>
              <p class="text-slate-600 text-sm">
                Hari Kotian will review it and get back to you within 24 hours.
                Need it faster? WhatsApp is usually quickest.
              </p>
              <a href="https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20I%20just%20submitted%20an%20enquiry." target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 mt-4 px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm transition-colors">
                <Icon name="whatsapp" size="sm" />
                Message on WhatsApp
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

<script is:inline>
  // Homepage callback form -> /contact-submit (same endpoint as /get-started/)
  document.getElementById('homeCallbackForm')?.addEventListener('submit', async function (event) {
    event.preventDefault();
    const form = this;
    const button = document.getElementById('cb-submit');
    const errorBox = document.getElementById('cb-error');
    const originalLabel = button ? button.textContent : '';

    errorBox.classList.add('hidden');

    const name = (form.elements.namedItem('name') || {}).value || '';
    const phone = (form.elements.namedItem('phone') || {}).value || '';
    const category = (form.elements.namedItem('category') || {}).value || '';

    const digits = String(phone).replace(/\D/g, '');
    if (!name.trim()) { errorBox.textContent = 'Please enter your name.'; errorBox.classList.remove('hidden'); return; }
    if (digits.length < 10) { errorBox.textContent = 'Please enter a valid 10-digit mobile number.'; errorBox.classList.remove('hidden'); return; }

    if (button) { button.disabled = true; button.textContent = 'Sending…'; }

    try {
      const response = await fetch('/contact-submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: name.trim(),
          phone: phone.trim(),
          category: category,
          message: 'Homepage callback request: ' + category,
        }),
      });
      const result = await response.json();
      if (!response.ok || !result.success) {
        throw new Error(result.error || 'We could not send your request. Please try again or call us directly.');
      }
      form.classList.add('hidden');
      document.getElementById('cb-success').classList.remove('hidden');
    } catch (err) {
      errorBox.textContent = err.message || 'We could not send your request. Please try again or call us directly.';
      errorBox.classList.remove('hidden');
    } finally {
      if (button) { button.disabled = false; button.textContent = originalLabel; }
    }
  });
</script>

