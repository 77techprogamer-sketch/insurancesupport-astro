---
import BaseLayout from '../layouts/BaseLayout.astro';
import InsuranceLanding from '../components/InsuranceLanding';
import LocalBusinessJsonLd from '../components/LocalBusinessJsonLd.astro';
import PersonJsonLd from '../components/PersonJsonLd.astro';
import FAQPageJsonLd from '../components/FAQPageJsonLd.astro';

const homepageFaqs = [
  {
    question: "How much does insurance cost and what affects the premium?",
    answer: "Premiums vary by coverage, sum assured, age, health, occupation, and location. Since 22 September 2025, GST has been exempt on individual life insurance and individual health insurance policies, including family floaters and senior-citizen policies. Group policies and other insurance products may be treated differently, so check the insurer's current quote."
  },
  {
    question: "How do I know which insurance is best for my family and needs?",
    answer: "The best insurance depends on your family size, age, income, existing assets, health conditions, and goals. For health coverage, choose between individual and family floater plans based on budget. Motor insurance should include third-party liability and suitable own-damage coverage. We provide personalized guidance based on your situation."
  },
  {
    question: "What documents are needed for insurance claims and the process?",
    answer: "Common documents include the claim form, policy document, medical records and bills for health claims, FIR and survey report for some motor claims, and a death certificate for life claims. Requirements vary by policy and claim. We can help organize documents and follow up; the insurer makes the claim decision under the policy terms."
  },
  {
    question: "Can you help with existing policy review and switching insurers?",
    answer: "Yes. We can review your policy terms, coverage gaps, and potential alternatives. Switching may affect waiting-period credits, exclusions, or other benefits, so compare the terms carefully before replacing existing cover."
  },
  {
    question: "What is the difference between term insurance and whole life insurance?",
    answer: "Term insurance provides coverage for a specified period, usually at a lower premium. Whole-life insurance can provide lifelong coverage and may include a cash value element, depending on the product. Compare policy terms and suitability before deciding."
  },
  {
    question: "What is the Insurance Ombudsman?",
    answer: "The Insurance Ombudsman is a free grievance forum. First write to your insurer; you may approach the Ombudsman if the insurer rejects your complaint, you are dissatisfied with its reply, or you receive no reply within one month. The amended Rules provide for awards up to ₹50 lakh, including relevant expenses. Check current eligibility before filing."
  }
];
---

<BaseLayout
  title="Insurance Advisor in Bengaluru | Claim Support | Hari Kotian"
  description="Speak with Hari Kotian, an IRDAI-registered insurance advisor in Bengaluru with 25+ years of experience. Get clear policy guidance and help navigating difficult claims."
  keywords="insurance advisor Bangalore, insurance claim support, claim recovery expert, IRDAI registered insurance advisor, health insurance advisor, term insurance advisor"
  canonical="https://insurancesupport.online/"
  landingPage={true}
>
  <LocalBusinessJsonLd />
  <PersonJsonLd />
  <main id="main">
    <InsuranceLanding faqs={homepageFaqs} client:load />
    <FAQPageJsonLd questions={homepageFaqs} />
  </main>
</BaseLayout>
