---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedHero from '../components/AnimatedHero';
import TrustCounterBar from '../components/TrustCounterBar';
import ServicesGrid from '../components/ServicesGrid';
import FeaturesSection from '../components/sections/FeaturesSection.astro';
import TestimonialsCarousel from '../components/TestimonialsCarousel';
import BlogSection from '../components/BlogSection';
import NewsletterSection from '../components/NewsletterSection';
import FloatingCTA from '../components/FloatingCTA';
import LocalBusinessJsonLd from '../components/LocalBusinessJsonLd.astro';
---

<BaseLayout title="IRDAI Certified Insurance Advisor in Bengaluru | Hari Kotian" description="25+ years experience IRDAI certified insurance advisor. Free consultation for life, health, motor, term & all insurance types. Claim recovery expert.">
  <LocalBusinessJsonLd />

  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:rounded-lg">Skip to main content</a>

  <!-- ===== TOP NOTIFICATION BAR ===== -->
  <div class="bg-gradient-to-r from-blue-900 via-blue-800 to-indigo-900 text-white text-xs py-1.5 overflow-hidden">
    <div class="marquee-container">
      <div class="marquee-content inline-block">
        <span class="inline-block px-8">
          📢 Important: GST rates on insurance premiums — Health Insurance: 18% GST | Motor Insurance: 18% GST | Term Insurance: 18% GST | Claim Settlement: 100% support provided | Updated as per Government of India notifications
          &nbsp;&nbsp;|&nbsp;&nbsp;
          📢 Important: GST rates on insurance premiums — Health Insurance: 18% GST | Motor Insurance: 18% GST | Term Insurance: 18% GST | Claim Settlement: 100% support provided | Updated as per Government of India notifications
          &nbsp;&nbsp;|&nbsp;&nbsp;
          📢 Important: GST rates on insurance premiums — Health Insurance: 18% GST | Motor Insurance: 18% GST | Term Insurance: 18% GST | Claim Settlement: 100% support provided | Updated as per Government of India notifications
        </span>
      </div>
    </div>
  </div>

  <!-- ===== HEADER ===== -->
  <header class="fixed top-7 left-0 right-0 z-40 bg-white/80 backdrop-blur-xl border-b border-slate-100/80 shadow-sm transition-all duration-300" id="site-header">
    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center text-white font-bold text-sm shadow-lg shadow-blue-500/25 group-hover:shadow-blue-500/40 transition-shadow">IS</div>
        <div class="font-bold text-slate-900 leading-tight">
          Insurance<span class="text-blue-600">Support</span>
          <div class="text-[10px] text-slate-400 font-medium tracking-wide">IRDAI Certified • Est. 1998</div>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-slate-600">
        <a href="/" class="px-3 py-2 rounded-lg hover:text-blue-600 hover:bg-blue-50/60 transition-all">Home</a>
        <a href="/services" class="px-3 py-2 rounded-lg hover:text-blue-600 hover:bg-blue-50/60 transition-all">Services</a>
        <a href="/locations" class="px-3 py-2 rounded-lg hover:text-blue-600 hover:bg-blue-50/60 transition-all">Locations</a>
        <a href="/blog" class="px-3 py-2 rounded-lg hover:text-blue-600 hover:bg-blue-50/60 transition-all">Blog</a>
        <a href="/faq" class="px-3 py-2 rounded-lg hover:text-blue-600 hover:bg-blue-50/60 transition-all">FAQ</a>
        <a href="/contact" class="ml-2 px-5 py-2.5 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-900 rounded-xl font-bold hover:shadow-lg hover:shadow-amber-500/25 hover:scale-105 active:scale-95 transition-all btn-glow flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          Get Help
        </a>
      </nav>

      <!-- Mobile Menu Toggle -->
      <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100 transition-colors" aria-label="Toggle menu">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="md:hidden hidden border-t border-slate-100 bg-white/95 backdrop-blur-xl">
      <div class="max-w-7xl mx-auto px-4 py-4 space-y-1">
        <a href="/" class="block px-4 py-3 text-sm font-medium text-slate-700 hover:bg-blue-50/60 rounded-lg">Home</a>
        <a href="/services" class="block px-4 py-3 text-sm font-medium text-slate-700 hover:bg-blue-50/60 rounded-lg">Services</a>
        <a href="/locations" class="block px-4 py-3 text-sm font-medium text-slate-700 hover:bg-blue-50/60 rounded-lg">Locations</a>
        <a href="/blog" class="block px-4 py-3 text-sm font-medium text-slate-700 hover:bg-blue-50/60 rounded-lg">Blog</a>
        <a href="/faq" class="block px-4 py-3 text-sm font-medium text-slate-700 hover:bg-blue-50/60 rounded-lg">FAQ</a>
        <a href="/contact" class="block px-4 py-3 text-sm font-bold text-blue-600 bg-blue-50/60 rounded-lg text-center mt-2">📞 Get Free Consultation</a>
      </div>
    </div>
  </header>

  <script is:inline>
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
        const isOpen = !mobileMenu.classList.contains('hidden');
        menuBtn.innerHTML = isOpen
          ? '<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>'
          : '<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>';
      });
    }

    // Header shrink on scroll
    const header = document.getElementById('site-header');
    let lastScroll = 0;
    window.addEventListener('scroll', () => {
      const currentScroll = window.scrollY;
      if (currentScroll > 100) {
        header.classList.add('shadow-md');
        header.classList.remove('shadow-sm');
      } else {
        header.classList.remove('shadow-md');
        header.classList.add('shadow-sm');
      }
      lastScroll = currentScroll;
    }, { passive: true });
  </script>

  <main id="main-content" class="page-transition">

    <!-- ===== HERO ===== -->
    <AnimatedHero client:load />

    <!-- ===== TRUST COUNTER BAR ===== -->
    <TrustCounterBar client:load />

    <!-- ===== BRAND TRUST LOGOS ===== -->
    <section class="py-10 bg-white border-b border-slate-100 noise-overlay">
      <div class="max-w-6xl mx-auto px-4 text-center">
        <p class="text-sm text-slate-400 font-medium mb-8 uppercase tracking-wider reveal">Trusted by leading insurers across India</p>
        <div class="flex flex-wrap items-center justify-center gap-8 md:gap-16 stagger-children">
          <div class="reveal opacity-40 hover:opacity-100 transition-opacity duration-300 grayscale hover:grayscale-0">
            <div class="text-xl font-bold text-slate-700 flex items-center gap-2">
              <span class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center text-blue-600 font-bold text-sm">L</span>
              LIC
            </div>
          </div>
          <div class="reveal opacity-40 hover:opacity-100 transition-opacity duration-300 grayscale hover:grayscale-0">
            <div class="text-xl font-bold text-slate-700 flex items-center gap-2">
              <span class="w-8 h-8 rounded-lg bg-red-100 flex items-center justify-center text-red-600 font-bold text-sm">IC</span>
              ICICI Lombard
            </div>
          </div>
          <div class="reveal opacity-40 hover:opacity-100 transition-opacity duration-300 grayscale hover:grayscale-0">
            <div class="text-xl font-bold text-slate-700 flex items-center gap-2">
              <span class="w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-600 font-bold text-sm">H</span>
              HDFC ERGO
            </div>
          </div>
          <div class="reveal opacity-40 hover:opacity-100 transition-opacity duration-300 grayscale hover:grayscale-0">
            <div class="text-xl font-bold text-slate-700 flex items-center gap-2">
              <span class="w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center text-amber-600 font-bold text-sm">B</span>
              Bajaj Allianz
            </div>
          </div>
          <div class="reveal opacity-40 hover:opacity-100 transition-opacity duration-300 grayscale hover:grayscale-0">
            <div class="text-xl font-bold text-slate-700 flex items-center gap-2">
              <span class="w-8 h-8 rounded-lg bg-violet-100 flex items-center justify-center text-violet-600 font-bold text-sm">S</span>
              Star Health
            </div>
          </div>
          <div class="reveal opacity-40 hover:opacity-100 transition-opacity duration-300 grayscale hover:grayscale-0">
            <div class="text-xl font-bold text-slate-700 flex items-center gap-2">
              <span class="w-8 h-8 rounded-lg bg-indigo-100 flex items-center justify-center text-indigo-600 font-bold text-sm">N</span>
              Niva Bupa
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== SERVICES ===== -->
    <ServicesGrid client:load />

    <!-- ===== FEATURES ===== -->
    <FeaturesSection />

    <!-- ===== TESTIMONIALS ===== -->
    <section class="py-20 lg:py-28 bg-white noise-overlay">
      <!-- Background decoration -->
      <div class="absolute top-0 right-0 w-96 h-96 bg-blue-100/40 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2" />
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-amber-100/30 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2" />

      <div class="max-w-7xl mx-auto px-4 relative">
        <div class="text-center mb-16 reveal">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-600/10 text-blue-700 text-sm font-semibold mb-4">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            Why Choose Us
          </span>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-slate-900 mb-4">25+ Years of Trusted Service</h2>
          <p class="text-lg text-slate-600 max-w-2xl mx-auto">A proven track record of protecting families and recovering claims across Bengaluru and India.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 stagger-children">
          <!-- Card 1: IRDAI Certified -->
          <div class="text-center p-8 bg-white rounded-2xl shadow-sm border border-slate-100 reveal card-hover card-shine group">
            <div class="w-16 h-16 mx-auto mb-5 bg-gradient-to-br from-blue-100 to-blue-50 rounded-2xl flex items-center justify-center group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
              <svg class="w-8 h-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">IRDAI Certified</h3>
            <p class="text-slate-600 leading-relaxed">Reg No: 0149161D — Licensed by IRDAI with 25+ years of adherence to regulatory standards.</p>
            <div class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-blue-600 opacity-0 group-hover:opacity-100 transition-opacity">
              Learn more <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </div>
          </div>

          <!-- Card 2: 95% Claim Success -->
          <div class="text-center p-8 bg-white rounded-2xl shadow-sm border border-slate-100 reveal card-hover card-shine group" style="transition-delay:0.1s">
            <div class="w-16 h-16 mx-auto mb-5 bg-gradient-to-br from-emerald-100 to-emerald-50 rounded-2xl flex items-center justify-center group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
              <svg class="w-8 h-8 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">95% Claim Success</h3>
            <p class="text-slate-600 leading-relaxed">Proven track record of overturning rejected claims. ₹50+ Crore recovered for families.</p>
            <div class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-emerald-600 opacity-0 group-hover:opacity-100 transition-opacity">
              Learn more <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </div>
          </div>

          <!-- Card 3: Doorstep Service -->
          <div class="text-center p-8 bg-white rounded-2xl shadow-sm border border-slate-100 reveal card-hover card-shine group" style="transition-delay:0.2s">
            <div class="w-16 h-16 mx-auto mb-5 bg-gradient-to-br from-amber-100 to-amber-50 rounded-2xl flex items-center justify-center group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
              <svg class="w-8 h-8 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Doorstep Service</h3>
            <p class="text-slate-600 leading-relaxed">We come to your home or office in Bengaluru & pan-India via online consultation.</p>
            <div class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-amber-600 opacity-0 group-hover:opacity-100 transition-opacity">
              Learn more <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== TESTIMONIALS ===== -->
    <section class="py-20 lg:py-28 bg-white noise-overlay">
      <div class="max-w-5xl mx-auto px-4">
        <div class="text-center mb-12 reveal">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-purple-50 text-purple-700 text-sm font-semibold mb-4">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
            Testimonials
          </span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">What Our Clients Say</h2>
          <p class="text-lg text-slate-600">Real stories from families we've helped protect and recover.</p>
        </div>
        <TestimonialsCarousel client:load />
      </div>
    </section>

    <!-- ===== HOW IT WORKS (Timeline) ===== -->
    <section class="py-20 lg:py-28 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white relative overflow-hidden noise-overlay">
      <!-- Background orbs -->
      <div class="absolute top-20 left-10 w-64 h-64 bg-blue-500/10 rounded-full blur-3xl" />
      <div class="absolute bottom-20 right-10 w-80 h-80 bg-amber-500/5 rounded-full blur-3xl" />

      <div class="max-w-7xl mx-auto px-4 relative">
        <div class="text-center mb-16 reveal">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/10 text-amber-300 text-sm font-semibold mb-4">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            Simple Process
          </span>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold mb-4">How It Works</h2>
          <p class="text-lg text-slate-300 max-w-2xl mx-auto">Getting expert insurance support is simple and stress-free.</p>
        </div>

        <!-- Timeline Steps -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 stagger-children relative">
          <!-- Connector line (desktop only) -->
          <div class="hidden md:block absolute top-8 left-[12.5%] right-[12.5%] h-0.5 bg-gradient-to-r from-amber-400/0 via-amber-400/50 to-amber-400/0" />

          <div class="text-center reveal relative">
            <div class="w-16 h-16 mx-auto mb-5 bg-gradient-to-br from-amber-400 to-amber-500 rounded-full flex items-center justify-center text-slate-900 font-bold text-2xl shadow-lg shadow-amber-500/30 glow-pulse relative z-10 hover:scale-110 transition-transform">1</div>
            <h3 class="text-lg font-bold mb-2">Free Consultation</h3>
            <p class="text-sm text-slate-400 leading-relaxed">Call or book online for a no-obligation discussion of your needs.</p>
          </div>

          <div class="text-center reveal relative" style="transition-delay:0.1s">
            <div class="w-16 h-16 mx-auto mb-5 bg-gradient-to-br from-amber-400 to-amber-500 rounded-full flex items-center justify-center text-slate-900 font-bold text-2xl shadow-lg shadow-amber-500/30 glow-pulse relative z-10 hover:scale-110 transition-transform">2</div>
            <h3 class="text-lg font-bold mb-2">Expert Analysis</h3>
            <p class="text-sm text-slate-400 leading-relaxed">We analyze your situation and find the best solution.</p>
          </div>

          <div class="text-center reveal relative" style="transition-delay:0.2s">
            <div class="w-16 h-16 mx-auto mb-5 bg-gradient-to-br from-amber-400 to-amber-500 rounded-full flex items-center justify-center text-slate-900 font-bold text-2xl shadow-lg shadow-amber-500/30 glow-pulse relative z-10 hover:scale-110 transition-transform">3</div>
            <h3 class="text-lg font-bold mb-2">Take Action</h3>
            <p class="text-sm text-slate-400 leading-relaxed">We handle paperwork, coordination, and follow-ups.</p>
          </div>

          <div class="text-center reveal relative" style="transition-delay:0.3s">
            <div class="w-16 h-16 mx-auto mb-5 bg-gradient-to-br from-amber-400 to-amber-500 rounded-full flex items-center justify-center text-slate-900 font-bold text-2xl shadow-lg shadow-amber-500/30 glow-pulse relative z-10 hover:scale-110 transition-transform">4</div>
            <h3 class="text-lg font-bold mb-2">Lifetime Support</h3>
            <p class="text-sm text-slate-400 leading-relaxed">Ongoing reviews, claim assistance, and advice.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== BLOG SECTION ===== -->
    <BlogSection client:load />

    <!-- ===== SOCIAL PROOF BANNER ===== -->
    <section class="py-16 bg-gradient-to-r from-blue-600 to-indigo-600 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 left-1/4 w-40 h-40 bg-white rounded-full blur-3xl" />
        <div class="absolute bottom-0 right-1/4 w-60 h-60 bg-amber-300 rounded-full blur-3xl" />
      </div>
      <div class="max-w-5xl mx-auto px-4 text-center text-white relative">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 stagger-children">
          <div class="reveal">
            <div class="text-3xl md:text-4xl font-extrabold">25+</div>
            <div class="text-blue-200 text-sm font-medium mt-1">Years Experience</div>
          </div>
          <div class="reveal" style="transition-delay:0.1s">
            <div class="text-3xl md:text-4xl font-extrabold">1000+</div>
            <div class="text-blue-200 text-sm font-medium mt-1">Families Served</div>
          </div>
          <div class="reveal" style="transition-delay:0.2s">
            <div class="text-3xl md:text-4xl font-extrabold">₹50Cr+</div>
            <div class="text-blue-200 text-sm font-medium mt-1">Claims Recovered</div>
          </div>
          <div class="reveal" style="transition-delay:0.3s">
            <div class="text-3xl md:text-4xl font-extrabold">95%</div>
            <div class="text-blue-200 text-sm font-medium mt-1">Success Rate</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== NEWSLETTER ===== -->
    <NewsletterSection client:load />

    <!-- ===== CTA ===== -->
    <section class="py-20 lg:py-24 bg-gradient-to-br from-slate-50 to-blue-50/50 relative overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-blue-100/30 rounded-full blur-3xl" />
      <div class="max-w-4xl mx-auto px-4 text-center relative">
        <div class="reveal">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-100 text-amber-700 text-sm font-semibold mb-6">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            Limited Time Offer
          </span>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-slate-900 mb-4">Ready to Secure Your Family's Future?</h2>
          <p class="text-lg text-slate-600 mb-8 max-w-xl mx-auto leading-relaxed">Get personalized insurance guidance from an IRDAI-certified advisor with 25+ years of experience. Free consultation, no obligation.</p>
          <div class="flex flex-wrap justify-center gap-4">
