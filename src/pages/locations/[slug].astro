        </div>
      </div>
    </section>

    <!-- GOOGLE MAPS EMBED -->
    <section class="py-0 bg-slate-50">
      <div class="max-w-5xl mx-auto px-4">
        <div class="relative aspect-video w-full rounded-2xl overflow-hidden shadow-xl border border-slate-200">
          <iframe
            width="100%"
            height="100%"
            frameborder="0"
            style="border:0; position: absolute; top: 0; left: 0; width: 100%; height: 100%;"
            referrerpolicy="no-referrer-when-downgrade"
            src={`https://www.google.com/maps/embed/v1/place?key=AIzaSyB41DRUbKWJHPxaFjMAwdrzWzbVKopNGg0&q=${encodeURIComponent(`${cityName}, ${stateName}, India`)}`}
