---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import BreadcrumbJsonLd from '../../components/BreadcrumbJsonLd.astro';
import FAQPageJsonLd from '../../components/FAQPageJsonLd.astro';

export async function getStaticPaths() {
  const allCitiesCollection = await getCollection('cities');
  const allCitiesData = allCitiesCollection[0].data; // Access the array from the 'default' key

  return allCitiesData.map(city => ({
    params: { slug: city.slug },
    props: { city }
  }));
}

const { city } = Astro.props;
const cityName = city.name;
const stateName = city.state;
const description = city.desc;
const phone = city.phone;
const areas = city.areas;
const nearby = city.nearby;
const itFocus = city.it_focus;
const seniorFocus = city.senior_focus;
const branchDets = city.branch_dets;
const localFaqs = city.local_faqs;

const pageUrl = `https://insurancesupport.online/locations/${city.slug}`;
---

<BaseLayout title={`Insurance Support in ${cityName}, ${stateName} | Hari Kotian`} description={description}>
  <BreadcrumbJsonLd items={[
    { label: 'Home', url: 'https://insurancesupport.online' },
    { label: 'Locations', url: 'https://insurancesupport.online/locations' },
    { label: `${cityName}, ${stateName}`, url: pageUrl }
  ]} />
  <!-- LocalBusiness schema for this location -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": `Insurance Support - Hari Kotian in ${cityName}`,
    "description": description,
    "url": pageUrl,
    "telephone": phone,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": cityName,
      "addressRegion": stateName,
      "addressCountry": "IN"
    },
    "priceRange": "₹₹",
    "parentOrganization": {
      "@type": "Organization",
      "name": "Insurance Support - Hari Kotian",
      "url": "https://insurancesupport.online"
    }
  })} />
  {localFaqs.length > 0 && <FAQPageJsonLd questions={localFaqs} />}
</BaseLayout>

<!-- FAQ Section -->
{localFaqs.length > 0 && (
  <div class="max-w-4xl mx-auto px-4 mt-12 mb-16">
    <h3 class="text-2xl font-bold text-slate-900 mb-6 text-center">Insurance FAQs for {cityName}, {stateName}</h3>
    <div class="space-y-3">
      {localFaqs.map(faq => (
        <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
          <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors">
            <span class="font-semibold text-slate-900 pr-4">{faq.question}</span>
            <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-5 pb-5">
            <p class="text-slate-600 leading-relaxed">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
)}