        <p class="text-lg text-slate-600">Doorstep service available across these neighborhoods</p>
      </div>
      <div class="flex flex-wrap gap-3 justify-center">
        {areas.map(area => (
          <span class="inline-flex items-center gap-2 px-5 py-2.5 bg-slate-50 border border-slate-200 rounded-full text-slate-700 font-medium">
            {area}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- SPECIALIZED SUPPORT -->

  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-slate-900 mb-4">Local Insurance Tips for {cityName}</h2>
      <ul class="list-disc list-inside space-y-2 text-slate-700">
        <li>Check the claim settlement ratios of major insurers in {cityName} – higher ratios mean faster payouts.</li>
        <li>Maintain a digital copy of all policy documents; many insurers in {stateName} accept electronic submissions.</li>
        <li>For senior citizens in {cityName}, review the free health check‑up benefits included in most senior plans.</li>
        <li>Ensure your address proof matches the one on your policy to avoid claim rejections in {cityName}.</li>
