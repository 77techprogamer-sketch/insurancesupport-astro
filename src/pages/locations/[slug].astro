                                              "@type": "Rating",
                                              "ratingValue": "5",
                                              "bestRating": "5"
                                            },
                                            "publisher": {
                                              "@type": "Organization",
                                              "name": "Google Reviews"
                                            }
                                          })} />
                                    <script type="application/ld+json" set:html={JSON.stringify({
                                            "@context": "https://schema.org",
                                            "@type": "Review",
                                            "author": {
                                              "@type": "Person",
                                              "name": "Priya Sharma"
                                            },
                                            "datePublished": "2025-11-28",
                                            "reviewBody": `Got my ICICI Lombard cashless claim approved after hospital denial in ${cityName}. The team knew exactly which documents to submit and escalated properly. Professional and responsive.`,
                                            "reviewRating": {
                                              "@type": "Rating",
                                              "ratingValue": "5",
                                              "bestRating": "5"
                                            },
                                            "publisher": {
                                              "@type": "Organization",
                                              "name": "Google Reviews"
                                            }
                                          })} />
                                    <script type="application/ld+json" set:html={JSON.stringify({
                                            "@context": "https://schema.org",
                                            "@type": "Review",
                                            "author": {
                                              "@type": "Person",
                                              "name": "Amit Patel"
                                            },
                                            "datePublished": "2025-10-10",
                                            "reviewBody": `Best insurance advisor in ${cityName} for senior citizen policies. Helped my parents with Care Health claim and doorstep service was a blessing. Transparent advice, no hidden fees.`,
                                            "reviewRating": {
                                              "@type": "Rating",
                                              "ratingValue": "5",
                                              "bestRating": "5"
                                            },
                                            "publisher": {
                                              "@type": "Organization",
                                              "name": "Google Reviews"
                                            }
                                          })} />
              {localFaqs.length > 0 && <FAQPageJsonLd questions={localFaqs} />}

<main id="main" class="page-transition">

  <!-- LOCATION HERO -->
    <section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-900 text-white py-16 lg:py-24">
      <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-amber-500/5 rounded-full blur-[100px]"></div>

