---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import BreadcrumbJsonLd from '../../components/BreadcrumbJsonLd.astro';
import FAQPageJsonLd from '../../components/FAQPageJsonLd.astro';

export async function getStaticPaths() {
  const allCitiesCollection = await getCollection('cities');
  const allCitiesData = allCitiesCollection.map(entry => entry.data);

  return allCitiesData.map(city => ({
    params: { slug: city.slug },
    props: { city }
  }));
}

const { city } = Astro.props;
const cityName = city.name;
const stateName = city.state;
const description = city.desc;
const phone = city.phone;
const areas = city.areas;
const nearby = city.nearby;
const itFocus = city.it_focus;
const seniorFocus = city.senior_focus;
const branchDets = city.branch_dets;
const localFaqs = city.local_faqs;

const pageUrl = `https://insurancesupport.online/locations/${city.slug}/`;
const phoneFormatted = phone.replace(/\s/g, '');
---

<BaseLayout title={`Insurance Advisor in ${cityName}, ${stateName} – Plans, Claims & Free Review | Hari Kotian`} description={description} keywords={`insurance advisor ${cityName}, ${cityName} insurance agent, insurance claim help ${cityName}, buy insurance ${cityName}, LIC agent ${cityName}, health insurance ${cityName}, insurance agent in ${stateName}`} skipGlobalLocationSchema={true} skipGlobalOrgSchema={true}>
  <BreadcrumbJsonLd items={[
    { label: 'Home', url: 'https://insurancesupport.online' },
    { label: 'Locations', url: 'https://insurancesupport.online/locations' },
    { label: `${cityName}, ${stateName}`, url: pageUrl }
  ]} />
  <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "InsuranceAgency",
          "@id": "https://insurancesupport.online/#organization",
          "name": "Insurance Support",
          "description": description,
          "url": "https://insurancesupport.online/",
          "logo": "https://insurancesupport.online/logo.png",
          "telephone": phone,
          "areaServed": areas,
          "hasCredential": {
            "@type": "EducationalOccupationalCredential",
            "credentialCategory": "Insurance Broker License",
            "recognizedBy": {
              "@type": "Organization",
              "name": "IRDAI",
              "url": "https://www.irdai.gov.in/"
            }
          }
        })} />
      <script type="application/ld+json" set:html={JSON.stringify({
              "@context": "https://schema.org",
              "@type": "WebPage",
              "name": `Insurance Advisor in ${cityName}, ${stateName}`,
              "description": description,
              "url": pageUrl,
              "isPartOf": {
                "@type": "WebPage",
                "@id": "https://insurancesupport.online/claim-recovery/",
                "name": "Insurance Claim Recovery Hub"
              },
              "about": {
                "@type": "Thing",
                "name": "Insurance advisory and claim recovery in India"
              },
              "author": {
                "@type": "Person",
                "@id": "https://insurancesupport.online/about-hari-kotian/#person",
                "name": "Hari Kotian",
                "jobTitle": "IRDAI Certified Insurance Advisor",
                "url": "https://insurancesupport.online/about-hari-kotian/"
              },
              "potentialAction": {
                "@type": "ContactAction",
                "target": {
                  "@type": "EntryPoint",
                  "urlTemplate": pageUrl,
                  "actionPlatform": [
                    "http://schema.org/DesktopWebPlatform",
                    "http://schema.org/MobileWebPlatform"
                  ]
                },
                "name": "Contact Insurance Support"
              }
            })} />
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Place",
        "name": `${cityName}, ${stateName}`,
        "description": `Insurance advisory services in ${cityName}, ${stateName} by IRDAI-certified advisor Hari Kotian`,
        "url": pageUrl,
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": city.lat || 12.9716,
          "longitude": city.lng || 77.5946
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": cityName,
          "addressRegion": stateName,
          "addressCountry": "IN"
        },
        "containedInPlace": {
          "@type": "AdministrativeArea",
          "name": "Karnataka",
          "addressCountry": "IN"
        }
      })} />
      <!-- Location-specific LocalBusiness schema for GMB alignment -->
            <script type="application/ld+json" set:html={JSON.stringify({
              "@context": "https://schema.org",
              "@type": ["InsuranceAgency", "LocalBusiness"],
              "@id": `https://insurancesupport.online/locations/${city.slug}/#localbusiness`,
              "name": `Insurance Support - ${cityName}`,
