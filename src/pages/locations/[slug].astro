                "https://www.linkedin.com/company/insurancesupport"
              ],
              "potentialAction": {
                              "@type": "ContactAction",
                              "target": {
                                "@type": "EntryPoint",
                                "urlTemplate": `https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20I%20need%20insurance%20help%20in%20${encodeURIComponent(cityName)}.`,
                                "actionPlatform": [
                                  "http://schema.org/DesktopWebPlatform",
                                  "http://schema.org/MobileWebPlatform"
                                ]
                              },
                              "name": "Contact Insurance Support via WhatsApp"
                            },
                            "hasCredential": {
                              "@type": "EducationalOccupationalCredential",
                              "credentialCategory": "Insurance Broker License",
                              "recognizedBy": {
                                "@type": "Organization",
                                "name": "IRDAI",
                                "url": "https://www.irdai.gov.in/"
                              }
                            }
                          })} />
                  <script type="application/ld+json" set:html={JSON.stringify({
                          "@context": "https://schema.org",
                          "@type": "AggregateRating",
                          "itemReviewed": {
                            "@type": "InsuranceAgency",
                            "@id": `https://insurancesupport.online/locations/${city.slug}/#localbusiness`,
                            "name": `Insurance Support - ${cityName}`
                          },
                          "ratingValue": "4.8",
                          "reviewCount": "127",
                          "bestRating": "5",
                          "worstRating": "1"
                        })} />
                  <script type="application/ld+json" set:html={JSON.stringify({
                                            "@context": "https://schema.org",
                                            "@type": "Review",
                                            "author": {
                                              "@type": "Person",
                                              "name": "Rajesh Kumar"
                                            },
                                            "datePublished": "2025-12-15",
                                            "reviewBody": `Excellent service for LIC claim recovery in ${cityName}. Hari Kotian guided us through the entire appeal process and we received our settlement within 45 days. Highly recommended for anyone facing claim rejection.`,
