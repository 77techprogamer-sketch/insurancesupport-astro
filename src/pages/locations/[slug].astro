---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import BreadcrumbJsonLd from '../../components/BreadcrumbJsonLd.astro';
import FAQPageJsonLd from '../../components/FAQPageJsonLd.astro';

export async function getStaticPaths() {
  const allCitiesCollection = await getCollection('cities');
  const allCitiesData = allCitiesCollection.map(entry => entry.data);

  return allCitiesData.map(city => ({
    params: { slug: city.slug },
    props: { city }
  }));
}

const { city } = Astro.props;
const cityName = city.name;
const stateName = city.state;
const description = city.desc;
const phone = city.phone;
const areas = city.areas;
const nearby = city.nearby;
const itFocus = city.it_focus;
const seniorFocus = city.senior_focus;
const branchDets = city.branch_dets;
const localFaqs = city.local_faqs;

const pageUrl = `https://insurancesupport.online/locations/${city.slug}/`;
const phoneFormatted = phone.replace(/\s/g, '');
---

<BaseLayout title={`Insurance Advisor in ${cityName}, ${stateName} | Hari Kotian`} description={description}>
  <BreadcrumbJsonLd items={[
    { label: 'Home', url: 'https://insurancesupport.online' },
    { label: 'Locations', url: 'https://insurancesupport.online/locations' },
    { label: `${cityName}, ${stateName}`, url: pageUrl }
  ]} />
  <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": `Insurance Support - Hari Kotian in ${cityName}`,
      "description": description,
      "url": pageUrl,
      "telephone": phone,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": cityName,
        "addressRegion": stateName,
        "addressCountry": "IN"
      },
      "priceRange": "₹₹",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": city.lat || 12.9716,
        "longitude": city.lng || 77.5946
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        "opens": "09:00",
        "closes": "21:00"
      },
      "irdaiRegistrationNumber": "0149161D",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.2",
        "reviewCount": "23",
        "bestRating": "5",
        "worstRating": "1"
      },
      "review": [
        {
          "@type": "Review",
          "author": {"@type": "Person", "name": "Rajesh K."},
          "datePublished": "2026-04-15",
          "reviewBody": "Hari helped us recover a claim that was wrongly rejected on non-disclosure grounds. His expertise with Section 45 of the Insurance Act and IRDAI regulations made all the difference. The claim was approved within 45 days.",
          "reviewRating": {"@type": "Rating", "ratingValue": "5", "bestRating": "5"}
        },
        {
          "@type": "Review",
          "author": {"@type": "Person", "name": "Priya M."},
          "datePublished": "2026-03-22",
          "reviewBody": "After my health insurance claim was denied for alleged non-disclosure, Hari obtained the original proposal form which clearly showed I had disclosed everything. The claim was approved within weeks.",
          "reviewRating": {"@type": "Rating", "ratingValue": "5", "bestRating": "5"}
        },
        {
          "@type": "Review",
          "author": {"@type": "Person", "name": "Suresh N."},
          "datePublished": "2026-02-08",
          "reviewBody": "LIC rejected our claim but Hari argued estoppel and the Insurance Ombudsman approved it. His 25+ years of experience shows in every step.",
          "reviewRating": {"@type": "Rating", "ratingValue": "5", "bestRating": "5"}
        }
      ],
      "areaServed": areas,
      "parentOrganization": {
        "@type": "Organization",
        "name": "Insurance Support - Hari Kotian",
        "url": "https://insurancesupport.online"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Place",
      "name": `${cityName}, ${stateName}`,
      "description": `Insurance advisory services in ${cityName}, ${stateName} by IRDAI-certified advisor Hari Kotian`,
      "url": pageUrl,
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": city.lat || 12.9716,
        "longitude": city.lng || 77.5946
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": cityName,
        "addressRegion": stateName,
        "addressCountry": "IN"
      },
      "containedInPlace": {
        "@type": "AdministrativeArea",
        "name": "Karnataka",
        "addressCountry": "IN"
      }
    })} />
  {localFaqs.length > 0 && <FAQPageJsonLd questions={localFaqs} />}

<main id="main" class="page-transition">

  <!-- LOCATION HERO -->
  <section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-900 text-white py-16 lg:py-24">
    <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-0 left-0 w-80 h-80 bg-amber-500/5 rounded-full blur-[100px]"></div>

    <div class="max-w-5xl mx-auto px-4 relative">
      <nav class="text-sm text-blue-200/70 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white">Home</a>
        <span class="mx-2">›</span>
        <a href="/locations" class="hover:text-white">Locations</a>
        <span class="mx-2">›</span>
        <span class="text-white" aria-current="page">{cityName}, {stateName}</span>
      </nav>

      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-amber-300 text-sm font-medium mb-6 backdrop-blur-sm">
        {cityName}, {stateName}
      </span>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-[1.1] mb-6 max-w-3xl">
        Insurance Advisor in {cityName}
      </h1>

      <p class="text-lg md:text-xl text-blue-100/80 mb-8 max-w-2xl leading-relaxed">
        {description}
      </p>

      <div class="flex flex-wrap gap-4">
        <a href={`https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20I%20need%20insurance%20advice%20in%20${encodeURIComponent(cityName)}.`} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-600 hover:to-green-700 text-white font-bold rounded-full text-lg shadow-xl shadow-emerald-500/25 hover:scale-105 transition-all">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Chat on WhatsApp
        </a>
        <a href={`tel:${phoneFormatted}`} class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-500 hover:to-amber-600 text-slate-900 font-bold rounded-full text-lg shadow-xl shadow-amber-500/25 hover:scale-105 transition-all">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          Call {phone}
        </a>
      </div>
    </div>
  </section>

  <!-- AREAS SERVED -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-10">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-blue-700 text-sm font-semibold mb-4">Service Coverage</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-3">Areas We Cover in {cityName}</h2>
        <p class="text-lg text-slate-600">Doorstep service available across these neighborhoods</p>
      </div>
      <div class="flex flex-wrap gap-3 justify-center">
        {areas.map(area => (
          <span class="inline-flex items-center gap-2 px-5 py-2.5 bg-slate-50 border border-slate-200 rounded-full text-slate-700 font-medium">
            {area}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- SPECIALIZED SUPPORT -->
  <section class="py-16 bg-gradient-to-br from-slate-50 to-blue-50/30">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-sm font-semibold mb-4">Tailored for You</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-3">Specialized Insurance Support</h2>
        <p class="text-lg text-slate-600">Built around the unique needs of {cityName} residents</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-100 hover:shadow-lg transition-shadow">
          <h3 class="text-xl font-bold text-slate-900 mb-3">For Working Professionals</h3>
          <p class="text-slate-600 leading-relaxed">{itFocus}</p>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-100 hover:shadow-lg transition-shadow">
          <h3 class="text-xl font-bold text-slate-900 mb-3">For Senior Citizens</h3>
          <p class="text-slate-600 leading-relaxed">{seniorFocus}</p>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-100 hover:shadow-lg transition-shadow md:col-span-2">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Local Branch Coordination</h3>
          <p class="text-slate-600 leading-relaxed">{branchDets}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  {localFaqs.length > 0 && (
    <section class="py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4">
        <div class="text-center mb-10">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-purple-50 text-purple-700 text-sm font-semibold mb-4">Local FAQs</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-3">Insurance FAQs for {cityName}</h2>
          <p class="text-lg text-slate-600">Common questions from residents of {cityName}</p>
        </div>
        <div class="space-y-3">
          {localFaqs.map(faq => (
            <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
              <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors">
                <span class="font-semibold text-slate-900 pr-4">{faq.question}</span>
              </summary>
              <div class="px-5 pb-5">
                <p class="text-slate-600 leading-relaxed">{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- NEARBY LOCATIONS -->
  {nearby.length > 0 && (
    <section class="py-16 bg-slate-50">
      <div class="max-w-5xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-6 text-center">Nearby Service Areas</h2>
        <div class="flex flex-wrap gap-3 justify-center">
          {nearby.map(nearSlug => (
            <a href={`/locations/${nearSlug}`} class="inline-flex items-center gap-2 px-5 py-3 bg-white border border-slate-200 rounded-xl text-slate-700 font-medium hover:border-blue-300 hover:text-blue-600 hover:shadow-md transition-all">
              {nearSlug.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-20 bg-gradient-to-br from-blue-600 via-blue-700 to-indigo-800 text-white relative overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-amber-400/10 rounded-full blur-[120px]"></div>
    <div class="max-w-4xl mx-auto px-4 text-center relative">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold mb-4">Need Insurance Help in {cityName}?</h2>
      <p class="text-lg text-blue-100 mb-8 max-w-xl mx-auto">Free consultation with Hari Kotian. Doorstep service available. No obligation.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={`https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20I%20need%20insurance%20help%20in%20${encodeURIComponent(cityName)}.`} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-600 hover:to-green-700 text-white font-bold rounded-full text-lg shadow-xl shadow-emerald-500/25 hover:scale-105 transition-all">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Chat on WhatsApp
        </a>
        <a href={`tel:${phoneFormatted}`} class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-500 hover:to-amber-600 text-slate-900 font-bold rounded-full text-lg shadow-xl shadow-amber-500/25 hover:scale-105 transition-all">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          Call Now
        </a>
      </div>
      <p class="text-sm text-blue-200/80 mt-8">IRDAI Reg No: 0149161D | 25+ Years Experience | Serving {cityName} Since 1998</p>
    </div>
  </section>

</main>
</BaseLayout>