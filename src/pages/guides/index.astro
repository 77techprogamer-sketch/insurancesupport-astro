---
import BaseLayout from '../../layouts/BaseLayout.astro';
import posts from '../../data/blogs.json';
import { PILLARS, postsInPillar } from '../../utils/pillars';

const pillars = PILLARS.map((pillar) => {
  const members = postsInPillar(pillar, posts);
  return { ...pillar, count: members.length, latest: members[0] };
}).sort((a, b) => b.count - a.count);

const totalGuides = pillars.reduce((n, p) => n + p.count, 0);
---

<BaseLayout
  title="Insurance Guides by Topic (2026) | Insurance Support"
  description="Six clusters of insurance guides: claim rejection and appeals, Ombudsman and IRDAI escalation, LIC and Section 45, health and cashless claims, motor and travel, and NRI and business cover."
  keywords="insurance guides India, claim rejection guides, ombudsman guides, LIC claim guides, health insurance guides, motor claim guides, NRI insurance"
  canonical="https://insurancesupport.online/guides/"
>
  <main id="main" class="min-h-screen bg-slate-900 text-white relative overflow-hidden py-16 lg:py-24">
    <div class="absolute top-10 right-1/4 w-96 h-96 bg-blue-600/20 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute bottom-10 left-1/4 w-96 h-96 bg-amber-500/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <nav class="text-sm text-slate-400 mb-10" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-300">Home</a>
        <span class="mx-2">›</span>
        <span class="text-slate-200" aria-current="page">Guides</span>
      </nav>

      <div class="max-w-3xl mb-14">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-400/20 text-amber-300 text-sm font-semibold mb-4 border border-amber-400/30">
          {totalGuides} guides · 6 clusters
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-6">
          Every guide, grouped the way a claim actually unfolds
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Nothing here is organised by product brochure. Each cluster follows one question a policyholder actually asks — why was I refused, who do I escalate to, is this clause on my side — and every guide in it is written to be quoted back at an insurer.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {pillars.map((pillar) => (
          <a
            href={`/guides/${pillar.slug}/`}
            class="group bg-white/5 backdrop-blur-xl rounded-3xl p-8 border border-white/10 hover:border-amber-400/50 hover:bg-white/10 transition-all duration-300"
          >
            <div class="flex items-start justify-between gap-4 mb-3">
              <h2 class="text-xl font-bold text-white group-hover:text-amber-300 transition-colors">{pillar.title}</h2>
              <span class="shrink-0 text-xs font-bold text-amber-300 bg-amber-400/10 border border-amber-400/20 rounded-full px-3 py-1">{pillar.count}</span>
            </div>
            <p class="text-slate-300 text-sm leading-relaxed mb-4">{pillar.description}</p>
            {pillar.latest && (
              <p class="text-xs text-slate-400">
                Latest: <span class="text-slate-300">{pillar.latest.title}</span>
              </p>
            )}
          </a>
        ))}
      </div>

      <div class="mt-14 bg-white/5 border border-white/10 rounded-2xl p-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <p class="text-slate-300">
          Looking for a document rather than a guide? The <a href="/resources/" class="text-amber-300 underline">checklists and templates</a> are there, and the <a href="/claim-recovery/" class="text-amber-300 underline">claim recovery hub</a> is the shortest path to action.
        </p>
        <a href="/contact" class="shrink-0 inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-900 font-bold rounded-full hover:scale-105 transition-transform">
          Free case review
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
