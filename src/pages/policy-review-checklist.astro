---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadMagnetForm from '../components/LeadMagnetForm.astro';
import LocalBusinessJsonLd from '../components/LocalBusinessJsonLd.astro';
---

<BaseLayout title="Printable Insurance Policy Review Checklist | Insurance Support" description="Get a free printable insurance policy review checklist to organize policy documents, coverage limits, exclusions, renewal details, nominees, and claim records in India." keywords="insurance policy review checklist, insurance coverage review, policy document checklist India, health life motor insurance review">
  <LocalBusinessJsonLd />


  <section class="min-h-screen py-20 bg-gradient-to-br from-slate-50 to-white">
    <div class="max-w-5xl mx-auto px-4">
      <!-- Hero Section -->
      <div class="text-center mb-16">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-50 text-amber-600 text-sm font-semibold mb-4">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4.518a9 9 0 1113.876-4.518M9 17h.01M9 12h.01M9 7h.01"></path>
          </svg>
          Free Resource
        </span>
        <h1 class="text-4xl md:text-5xl font-extrabold text-blue-900 mb-6">
          Free Printable Insurance Policy Review Checklist
        </h1>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto">
          Use this 12-point worksheet to review your policy documents, coverage limits, exclusions, renewals, and claim records. Confirm policy-specific questions directly with your insurer.
        </p>
      </div>

      <!-- Value Proposition -->
      <div class="bg-white shadow-xl rounded-3xl p-8 md:p-12 mb-16">
        <h2 class="text-2xl font-bold text-center text-slate-900 mb-8">What You'll Get Inside:</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
              <span class="text-blue-600 font-bold text-sm">1</span>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 mb-1">Coverage and Limits Review</h3>
              <p class="text-sm text-slate-600">Record the cover amount, benefits, limits, and sub-limits in the policy.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
              <span class="text-blue-600 font-bold text-sm">2</span>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 mb-1">Nominee Details</h3>
              <p class="text-sm text-slate-600">Check the recorded nominee information where the policy has a nominee.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
              <span class="text-blue-600 font-bold text-sm">3</span>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 mb-1">Claim Record Readiness</h3>
              <p class="text-sm text-slate-600">Keep the policy, insurer contacts, and claim instructions accessible.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
              <span class="text-blue-600 font-bold text-sm">4</span>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 mb-1">Questions to Verify</h3>
              <p class="text-sm text-slate-600">Note policy or tax questions to confirm with the insurer or a qualified professional.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
              <span class="text-blue-600 font-bold text-sm">5</span>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 mb-1">Policy Terms and Conditions</h3>
              <p class="text-sm text-slate-600">Find exclusions, waiting periods, co-payments, and other conditions.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
              <span class="text-blue-600 font-bold text-sm">6</span>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 mb-1">Renewal and Payment Details</h3>
              <p class="text-sm text-slate-600">Record renewal dates, payment instructions, and reminders.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Form Section -->
      <div class="bg-gradient-to-br from-blue-600 to-indigo-700 rounded-3xl shadow-2xl p-8 md:p-12 text-center text-white">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">Download Your Free Checklist Now</h2>
        <p class="text-blue-100 mb-8 max-w-xl mx-auto">Enter your details to unlock the printable checklist on this page.</p>
        <LeadMagnetForm
          fields={["name", "email", "phone"]}
          ctaText="Get My Free Checklist"
          magnetSlug="policy-review-checklist"
          thankYouMessage="Your printable policy review checklist is ready below."
          downloadUrl="/downloads/policy-review-checklist.html"
          variant="inline"
        />
      </div>

      <!-- Trust Signals -->
      <div class="text-center mt-12">
        <p class="text-sm text-slate-500 mb-4">Insurance guidance and claim support from Bengaluru</p>
        <div class="flex items-center justify-center gap-4 flex-wrap">
          <span class="text-xs text-slate-400">IRDAI Reg: 0149161D</span>
          <span class="text-slate-300">|</span>
          <span class="text-xs text-slate-400">Policy and claim guidance</span>
          <span class="text-slate-300">|</span>
          <span class="text-xs text-slate-400">Claim outcomes depend on policy terms</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
