---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbJsonLd from '../components/BreadcrumbJsonLd.astro';

// Keep the registration identifier consistent with the site's other advisor references.
---
<BaseLayout
  title="About Hari Kotian | Insurance Support"
  description="Learn about Hari Kotian (IRDAI registration number 0149161D) and Insurance Support, a Bengaluru-based insurance guidance and claim assistance service."
  canonical="https://insurancesupport.online/about/"
  dateModified="2026-10-05"
>
  <BreadcrumbJsonLd items={[{ label: 'Home', url: 'https://insurancesupport.online/' }, { label: 'About Hari Kotian', url: 'https://insurancesupport.online/about/' }]} />
  <main id="main" class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold text-slate-900 mb-4">About Hari Kotian</h1>
    <p class="text-lg text-slate-600 mb-8 leading-relaxed">Hari Kotian (IRDAI registration number <strong>0149161D</strong>) leads Insurance Support, a Bengaluru-based service offering insurance guidance and claim assistance.</p>

    <section class="rounded-2xl border border-slate-200 bg-white p-7 mb-8" aria-labelledby="about-insurance-support">
      <h2 id="about-insurance-support" class="text-2xl font-bold text-slate-900 mb-4">What does Insurance Support do?</h2>
      <p class="text-slate-700 leading-relaxed">Insurance Support helps people understand policy terms, organize claim documents, review insurer correspondence, and navigate follow-up. The insurer decides each claim under the issued policy and the evidence provided. Complaint forums have separate eligibility requirements and time limits.</p>
    </section>

    <section class="mb-10" aria-labelledby="services-provided">
      <h2 id="services-provided" class="text-2xl font-bold text-slate-900 mb-4">Insurance guidance and claim assistance</h2>
      <ul class="list-disc list-inside space-y-2 text-slate-700">
        <li>Life, term, health, and motor policy guidance.</li>
        <li>Help organizing documents for an insurance claim.</li>
        <li>Review of an insurer’s written claim decision and related policy terms.</li>
        <li>Guidance on insurer grievance and external complaint information.</li>
        <li>Policy review and servicing questions.</li>
      </ul>
    </section>

    <section class="rounded-2xl bg-slate-50 border border-slate-200 p-7 mb-10" aria-labelledby="business-details">
      <h2 id="business-details" class="text-2xl font-bold text-slate-900 mb-4">Business details</h2>
      <dl class="grid sm:grid-cols-2 gap-4 text-slate-700">
        <div><dt class="font-semibold">Business</dt><dd>Insurance Support</dd></div>
        <div><dt class="font-semibold">Lead advisor</dt><dd>Hari Kotian</dd></div>
        <div><dt class="font-semibold">IRDAI registration number</dt><dd>0149161D</dd></div>
        <div><dt class="font-semibold">Location</dt><dd>Bahubali Nagar, Jalahalli, Bengaluru, Karnataka 560013, India</dd></div>
        <div><dt class="font-semibold">Phone</dt><dd><a class="text-blue-700 underline" href="tel:+919986634506">+91 99866 34506</a></dd></div>
      </dl>
    </section>

    <p class="text-sm text-slate-500 mb-8">Insurance information is general guidance. Check your issued policy and current insurer or regulator instructions for your situation. Claim outcomes are determined by the insurer under the policy terms.</p>

    <div class="text-center">
      <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 bg-blue-600 text-white font-bold rounded-full text-lg hover:bg-blue-700 transition-colors shadow-lg">Contact Insurance Support</a>
    </div>
  </main>
</BaseLayout>
