---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbJsonLd from '../components/BreadcrumbJsonLd.astro';
import ClaimRecoveryTicker from '../components/ClaimRecoveryTicker.astro';

const TITLE = "Insurance Claim Recovery Hub: Every Guide to Fight a Denied Claim (2026)";
const DESCRIPTION = "Claim denied, delayed, or short-paid? Every guide from a 25-year claim-recovery veteran — health, LIC, motor, travel, mis-selling, nominee — organised by your exact problem. Free consultation.";
const KEYWORDS = "insurance claim recovery India, claim denied what to do, claim rejection help, insurance ombudsman guide, claim appeal guides India";
const CANONICAL_URL = "https://insurancesupport.online/claim-recovery/";

const HUB_FAMILY = [
  { title: 'Health Insurance Hub: Complete 2026 Guide to Medical Coverage, Claims & Portability', url: '/blog/health-insurance-hub-complete-2026-guide/' },
  { title: 'LIC Policy Hub: Complete 2026 Guide to LIC Policies (2026)', url: '/blog/lic-policy-hub-complete-guide-2026/' },
];
const GUIDES = [
  {
    group: "Health insurance claims",
    items: [
      { title: "Cashless Claim Denied at the Hospital? First 60 Minutes", desc: "Minute-by-minute action plan: written denial, parallel escalation, protecting your reimbursement rights.", url: "/blog/cashless-health-insurance-claim-denied-hospital-2026/" },
      { title: "Health Claim Rejected? Step-by-Step Appeal Guide", desc: "From the repudiation letter to GRO, Bima Bharosa, and the Ombudsman — with document checklist.", url: "/blog/health-insurance-claim-rejected-appeal-guide-2026/" },
      { title: "15 Reasons Health Claims Get Rejected", desc: "Every common denial ground — and the prevention for each, before admission.", url: "/blog/health-insurance-claim-rejection-15-reasons/" },
      { title: "Health Portability Rejected or Delayed?", desc: "The 45-day rule, the 15-day decision window, and fighting punitive loadings.", url: "/blog/health-insurance-portability-rejected-2026/" },
      { title: "Group (Employer) Policy Claim Problems", desc: "Why corporate cover denies claims — dependant rosters, annual resets, and the exit trap.", url: "/blog/group-health-policy-claim-issues-2026/" },
    ],
  },
  {
    group: "Life insurance & LIC claims",
    items: [
      { title: "LIC Death Claim Rejected or Delayed? Nominee's Guide", desc: "Forms 3783/3801, documents, the 30-day standard, and repudiation-ground rebuttals.", url: "/blog/lic-death-claim-rejected-nominee-guide-2026/" },
      { title: "LIC Claim Rejection Letter: How to Respond", desc: "The written reply structure that gets repudiations reopened.", url: "/blog/lic-claim-rejection-response-guide/" },
      { title: "Nominee vs Legal Heirs: Who Gets the Money?", desc: "What the 2022 Insurance Act amendment changed — and ending the family fight.", url: "/blog/nominee-vs-legal-heirs-claim-dispute-2026/" },
    ],
  },
  {
    group: "Motor, travel & money disputes",
    items: [
      { title: "Motor Claim Denied? Dispute the Surveyor Report", desc: "Your right to the report, depreciation heads decoded, and the IDV battle.", url: "/blog/motor-insurance-claim-denied-surveyor-dispute-2026/" },
      { title: "Travel Claim Denied? Recovery Guide", desc: "Medical exclusions, baggage PIRs, trip cancellations — fixed from abroad.", url: "/blog/travel-insurance-claim-denied-2026/" },
      { title: "Mis-Sold a Policy? Complaint & Refund Guide", desc: "Free-look cancellation, evidence that holds, and the escalation playbook.", url: "/blog/insurance-mis-selling-complaint-refund-2026/" },
    ],
  },
  {
    group: "Escalation & prevention",
    items: [
      { title: "Insurance Ombudsman: Complete Filing Guide", desc: "Free grievance route, eligibility rules, and how to prepare a complaint.", url: "/blog/insurance-ombudsman-india-guide/" },
      { title: "Policy Review Checklist", desc: "Find the rejection causes in your own policy before they find you.", url: "/policy-review-checklist/" },
      { title: "Term Insurance Claim Settlement Ratios 2026", desc: "Which insurers actually pay — data before you buy.", url: "/blog/term-insurance-claim-settlement-ratio-2026/" },
    ],
  },
];

const TOTAL_GUIDES = GUIDES.reduce((n, g) => n + g.items.length, 0);

const FAQ = [
  {
    question: "My insurance claim was just denied — what do I do first?",
    answer: "Get the denial in writing and read the exact clause invoked. Then file a written grievance with the insurer's Grievance Redressal Officer (GRO) citing your claim number and the denial ground. Keep an acknowledgement with a file number. Most recoverable claims turn on the written record, not on phone calls."
  },
  {
    question: "How long does an insurer have to respond to my complaint?",
    answer: "An insurer's GRO must act on a grievance within 15 days, and in any case within 30 days. If there is no resolution in that window, you can escalate to IRDAI's Bima Bharosa portal and then to the Insurance Ombudsman. Deadlines run from the date you file the grievance in writing, so file early and keep proof of filing."
  },
  {
    question: "What is the difference between a grievance and the Insurance Ombudsman?",
    answer: "A grievance is the insurer's own internal process. The Insurance Ombudsman is an independent forum for eligible complaints. First write to the insurer; you may approach the Ombudsman if the insurer rejects your complaint, you are dissatisfied with its reply, or you receive no reply within one month. The amended Rules provide for awards up to ₹50 lakh including relevant expenses; check the current eligibility rules before filing."
  },
  {
    question: "Is the Insurance Ombudsman free, and do I need a lawyer?",
    answer: "Filing a complaint with the Insurance Ombudsman is free, and policyholders can file directly without a lawyer. The amended Rules provide for awards up to ₹50 lakh including relevant expenses. Eligibility depends on the complaint and current rules, so check the official guidance before filing."
  },
  {
    question: "Can I appeal a claim denial after 30 days?",
    answer: "Yes. There is no fixed statutory cut-off for filing a grievance or Ombudsman complaint, but delays weaken your position and can affect interest on delayed settlements. If you received a written repudiation, file the written reply and grievance as soon as you can, attaching the denial letter and your evidence."
  },
  {
    question: "What documents should I attach to a claim appeal?",
    answer: "The denial (repudiation) letter, your policy document or certificate, the claim form and claim number, and the evidence that counters the denial ground — discharge summaries, doctor certificates, original bills, the surveyor report if it's a motor claim, or the challenger documents for a title dispute. A checklist-style cover letter listing each attachment helps the file move faster."
  },
  {
    question: "Does IRDAI penalise insurers for wrongly denying claims?",
    answer: "IRDAI can act against insurers for service deficiencies, including wrongful repudiation and delays beyond the claim settlement standard. The practical effect for you is the escalation path: a written grievance, then IRDAI's Bima Bharosa portal, then the Ombudsman. The regulator's interest is one reason insurers take a properly filed written grievance seriously."
  },
  {
    question: "Where do I start if my problem is not one of the guides listed here?",
    answer: "Start with the symptom-based list at the top of this page — pick the sentence closest to your situation and it will take you to the most relevant guide. If nothing matches exactly, the escalation ladder and document checklist on this page still apply. You can also ask me directly: send the denial letter or claim status on WhatsApp or by phone, and I will tell you the fastest legitimate next step."
  }
];
---

<BaseLayout title={TITLE} description={DESCRIPTION} keywords={KEYWORDS} canonical={CANONICAL_URL}>
  <BreadcrumbJsonLd items={[
    { label: 'Home', url: 'https://insurancesupport.online' },
    { label: 'Claim Recovery Hub', url: CANONICAL_URL }
  ]} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": TITLE,
    "description": DESCRIPTION,
    "url": CANONICAL_URL,
    "isPartOf": { "@type": "WebSite", "name": "Insurance Support", "url": "https://insurancesupport.online" },
    "about": { "@type": "Thing", "name": "Insurance claim recovery in India" },
    "author": { "@type": "Person", "name": "Hari Kotian", "jobTitle": "IRDAI Certified Insurance Advisor" },
    "hasPart": [
      ...GUIDES.flatMap(g => g.items).map(i => ({
        "@type": "Article",
        "headline": i.title,
        "url": `https://insurancesupport.online${i.url}`
      })),
      ...HUB_FAMILY.map(h => ({
        "@type": "Article",
        "headline": h.title,
        "url": `https://insurancesupport.online${h.url}`
      }))
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": FAQ.map(q => ({
      "@type": "Question",
      "name": q.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": q.answer
      }
    }))
  })} />

  <main id="main" class="page-transition">

    <!-- Hero -->
    <section class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 text-white py-16 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px]" />
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-amber-500/5 rounded-full blur-[100px]" />
      <div class="max-w-4xl mx-auto px-4 relative">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/10 text-amber-300 text-sm font-semibold mb-6">
          Claim Recovery Hub
        </span>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold mb-5 leading-tight">Claim Denied, Delayed, or Short-Paid? Start Here.</h1>
        <p class="text-lg text-blue-100/85 leading-relaxed mb-6">
          Every guide below comes from my own case files — 25+ years of recovering rejected and stuck claims for policyholders across India. No theory, no recycled listicles: the exact steps that get insurers to reopen files and Ombudsman complaints to succeed.
        </p>
        <p class="text-sm text-blue-200/70">— <strong class="text-white">Hari Kotian</strong>, IRDAI Certified Insurance Advisor (Reg 0149161D)</p>
      </div>
    </section>

    <div class="max-w-4xl mx-auto px-4 py-12">

      <!-- Symptom-based start -->
      <section class="mb-12">
        <!-- Sibling content hubs -->
        <div class="mb-10">
          <h2 class="text-lg font-bold text-blue-900 mb-3">The rest of the insurance hub family</h2>
          <p class="text-sm text-slate-500 mb-4">Three pillar guides, cross-linked. Start wherever your problem is — each one links to the other two.</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {HUB_FAMILY.map(h => (
              <a href={h.url} class="group block bg-white rounded-xl border border-blue-100 hover:border-blue-300 hover:shadow-md transition-all p-5">
                <h4 class="text-sm font-bold text-slate-900 mb-1 leading-snug group-hover:text-blue-700 transition-colors">{h.title}</h4>
                <span class="text-xs text-blue-600 font-semibold">Read the pillar hub →</span>
              </a>
            ))}
          </div>
        </div>

        <h2 class="text-2xl font-extrabold text-slate-900 mb-2">Find your exact problem</h2>
        <p class="text-sm text-slate-500 mb-6">Pick the sentence closest to what you are dealing with right now.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {[
            { q: "The hospital just refused cashless treatment", url: "/blog/cashless-health-insurance-claim-denied-hospital-2026/" },
            { q: "My health claim was rejected in writing", url: "/blog/health-insurance-claim-rejected-appeal-guide-2026/" },
            { q: "My spouse's/parent's LIC death claim is stuck", url: "/blog/lic-death-claim-rejected-nominee-guide-2026/" },
            { q: "The insurer paid far less than my repair bill", url: "/blog/motor-insurance-claim-denied-surveyor-dispute-2026/" },
            { q: "I was promised something the policy doesn't deliver", url: "/blog/insurance-mis-selling-complaint-refund-2026/" },
            { q: "My employer's group policy failed my family", url: "/blog/group-health-policy-claim-issues-2026/" },
            { q: "The family is fighting over the claim money", url: "/blog/nominee-vs-legal-heirs-claim-dispute-2026/" },
            { q: "The claim happened while I was abroad", url: "/blog/travel-insurance-claim-denied-2026/" },
          ].map(s => (
            <a href={s.url} class="group flex items-center justify-between gap-3 bg-white border border-slate-200 hover:border-blue-300 hover:shadow-md rounded-xl px-5 py-4 transition-all">
              <span class="text-sm font-semibold text-slate-700 group-hover:text-blue-700 transition-colors">“{s.q}”</span>
              <svg class="w-4 h-4 text-blue-500 shrink-0 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
          ))}
        </div>
      </section>

      <!-- Full library -->
      <section class="mb-12">
        <h2 class="text-2xl font-extrabold text-slate-900 mb-2">The complete guide library</h2>
        <p class="text-sm text-slate-500 mb-6">{TOTAL_GUIDES} expert guides, organised by claim type.</p>
        {GUIDES.map(g => (
          <div class="mb-8">
            <h3 class="text-lg font-bold text-blue-900 mb-3 pb-2 border-b border-blue-100">{g.group}</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {g.items.map(i => (
                <a href={i.url} class="group block bg-white rounded-xl border border-slate-200 hover:border-blue-300 hover:shadow-lg transition-all p-5">
                  <h4 class="text-base font-bold text-slate-900 mb-1.5 leading-snug group-hover:text-blue-700 transition-colors">{i.title}</h4>
                  <p class="text-sm text-slate-500 leading-relaxed">{i.desc}</p>
                </a>
              ))}
            </div>
          </div>
        ))}
      </section>

      <!-- Escalation ladder -->
      <section class="mb-12 bg-blue-50/60 border border-blue-100 rounded-2xl p-8">
        <h2 class="text-2xl font-extrabold text-blue-900 mb-4">The escalation ladder every guide uses</h2>
        <ol class="space-y-3 text-slate-700">
          <li class="flex gap-3"><span class="shrink-0 w-7 h-7 bg-blue-600 text-white rounded-full flex items-center justify-center text-sm font-bold">1</span><span><strong>Grievance Redressal Officer (GRO)</strong> — every insurer must resolve within 15 days (30 days max). Always in writing, always with a file number.</span></li>
          <li class="flex gap-3"><span class="shrink-0 w-7 h-7 bg-blue-600 text-white rounded-full flex items-center justify-center text-sm font-bold">2</span><span><strong>IRDAI Bima Bharosa portal</strong> — the regulator's complaint system once the insurer stalls or refuses.</span></li>
          <li class="flex gap-3"><span class="shrink-0 w-7 h-7 bg-blue-600 text-white rounded-full flex items-center justify-center text-sm font-bold">3</span><span><strong>Insurance Ombudsman</strong> — free, no lawyer required, with eligibility and award limits set by the current Rules. <a href="/blog/insurance-ombudsman-india-guide/" class="text-blue-600 underline">How to file it properly →</a></span></li>
        </ol>
      </section>

      <ClaimRecoveryTicker />

      <!-- FAQ Section (visible accordion + FAQPage JSON-LD from shared data) -->
      <div class="max-w-3xl mx-auto px-4 mt-12">
        <h3 class="text-xl font-bold text-slate-900 mb-6">Frequently Asked Questions</h3>
        <div class="space-y-3">
          {FAQ.map(q => (
            <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
              <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors">
                <span class="font-semibold text-slate-900 pr-4">{q.question}</span>
                <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-5 pb-5">
                <p class="text-slate-600 leading-relaxed">{q.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-12 bg-gradient-to-r from-blue-600 to-indigo-600 p-8 rounded-2xl text-white text-center">
        <h2 class="text-2xl font-bold mb-3">Rather Have an Expert Read Your Case?</h2>
        <p class="text-blue-100 mb-6">Guides tell you the path — I walk it with you. Send me the denial letter or claim status and get a same-day, no-obligation review from 25+ years of claim recovery practice.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="https://wa.me/919986634506?text=Hi%20Hari%2C%20I%20need%20help%20with%20an%20insurance%20claim." target="_blank" rel="noopener noreferrer" class="bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-6 rounded-lg transition-colors">
            WhatsApp Your Case
          </a>
          <a href="tel:+919986634506" class="bg-white hover:bg-blue-50 text-blue-900 font-bold py-3 px-6 rounded-lg transition-colors">
            Call +91-99866 34506
          </a>
        </div>
      </div>

    </div>
  </main>
</BaseLayout>
