---
// src/pages/case-studies/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';


import Breadcrumbs from '../../components/Breadcrumbs.astro';
import caseStudies from '../../data/case-studies.json';

const featured = caseStudies.filter(c => c.featured);
const all = caseStudies;
---

<BaseLayout
  title="Case Studies — Real Claim Recovery Stories"
  description="See how Hari Kotian helped families recover rejected and delayed insurance claims in Bangalore. Real stories, real results."
>

  <Breadcrumbs currentPage="Case Studies" />

  <main class="page-transition">
    <!-- Hero -->
    <section class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 text-white py-16 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px]" />
      <div class="max-w-6xl mx-auto px-4 relative text-center">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-400/20 text-amber-300 text-sm font-semibold mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
          Real Stories, Real Results
        </span>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold leading-tight mb-4">
          How We Recover <span class="text-amber-300">50+ Crores</span> in Rejected Claims
        </h1>
        <p class="text-lg text-blue-100/80 mb-8 max-w-2xl mx-auto leading-relaxed">
          Every rejected claim has a story. Read how we helped real families in Bangalore get their rightful insurance payouts — and how we can help you.
        </p>

        <div class="flex flex-wrap justify-center gap-8 text-center">
          <div>
            <div class="text-3xl font-extrabold text-amber-300">1000+</div>
            <div class="text-sm text-blue-200/70">Families Helped</div>
          </div>
          <div>
            <div class="text-3xl font-extrabold text-amber-300">92%</div>
            <div class="text-sm text-blue-200/70">Success Rate</div>
          </div>
          <div>
            <div class="text-3xl font-extrabold text-amber-300">25+</div>
            <div class="text-sm text-blue-200/70">Years Experience</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Case Studies -->
    {featured.length > 0 && (
      <section class="py-16 bg-white">
        <div class="max-w-6xl mx-auto px-4">
          <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-3">Featured Case Studies</h2>
          <p class="text-slate-600 mb-10 text-lg">Our most impactful claim recoveries</p>

          <div class="grid md:grid-cols-2 gap-8">
            {featured.map(cs => (
              <a href={`/case-studies/${cs.slug}`} class="block bg-gradient-to-br from-slate-50 to-blue-50 rounded-2xl p-8 border border-slate-100 hover:shadow-xl hover:border-blue-200 transition-all group">
                <div class="flex flex-wrap items-center gap-3 mb-4">
                  <span class="px-3 py-1 bg-blue-600 text-white text-xs font-semibold rounded-full">{cs.category}</span>
                  <span class="text-sm text-slate-500">{cs.date}</span>
                  <span class="text-sm text-slate-500">| {cs.location}</span>
                </div>
                <h3 class="text-xl md:text-2xl font-extrabold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors leading-tight">{cs.title}</h3>
                <p class="text-slate-600 mb-4 line-clamp-3 leading-relaxed">{cs.summary}</p>
                <div class="flex flex-wrap gap-3 mb-4 text-sm">
                  <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full font-medium">Denied: {cs.originalDenialReason.slice(0, 40)}...</span>
                  <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full font-medium">Result: {cs.result}</span>
                </div>
                <span class="inline-flex items-center gap-2 text-sm font-semibold text-blue-600 group-hover:gap-3 transition-all">
                  Read Full Story
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- All Case Studies -->
    <section class="py-16 bg-slate-50">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-3">All Case Studies</h2>
        <p class="text-slate-600 mb-10 text-lg">Browse by category</p>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {all.map(cs => (
            <a href={`/case-studies/${cs.slug}`} class="block bg-white rounded-xl border border-slate-200 p-6 hover:shadow-lg hover:border-blue-200 transition-all group">
              <div class="flex items-center gap-2 mb-3">
                <span class="px-2 py-0.5 bg-blue-50 text-blue-600 text-xs font-medium rounded">{cs.category}</span>
                <span class="text-xs text-slate-400">{cs.location}</span>
              </div>
              <h3 class="text-base font-bold text-slate-900 mb-2 leading-snug line-clamp-2 group-hover:text-blue-600 transition-colors">{cs.title}</h3>
              <p class="text-sm text-slate-500 mb-3 line-clamp-2">{cs.summary}</p>
              <div class="flex items-center justify-between text-xs">
                <span class="font-semibold text-green-600">✓ {cs.result}</span>
                <span class="text-slate-400">{cs.resolutionTime}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-4">Your Claim Could Be Next</h2>
        <p class="text-lg text-slate-600 mb-8">Every claim story starts with a conversation. Get a free 15-minute audit of your rejection letter — no obligation, no sales pitch.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-900 font-bold rounded-full text-lg shadow-lg hover:shadow-xl hover:scale-105 transition-all btn-glow">
            Get Free Claim Audit
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
          <a href="https://wa.me/919986634506?text=Hi%20Hari%2C%20I%20have%20a%20rejected%20insurance%20claim.%20Can%20you%20help%3F" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-8 py-4 bg-white border border-slate-200 text-slate-700 font-semibold rounded-full hover:bg-slate-50 hover:border-slate-300 transition-all shadow-sm">
            <svg class="w-5 h-5 text-green-600" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            WhatsApp Us Now
          </a>
        </div>
      </div>
    </section>
  </main>

</BaseLayout>