---
// src/pages/case-studies/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';


import Breadcrumbs from '../../components/Breadcrumbs.astro';
import caseStudies from '../../data/case-studies.json';

export function getStaticPaths() {
  return caseStudies.map((cs) => ({ params: { slug: cs.slug } }));
}

const { slug } = Astro.params;
const cs = caseStudies.find((c) => c.slug === slug);

if (!cs) {
  throw new Error('Case study not found');
}

// Find related case studies
const related = cs.relatedCaseStudies
  .map((slug) => caseStudies.find((c) => c.slug === slug))
  .filter(Boolean);
---

<BaseLayout
  title={`${cs.title} | Case Study`}
  description={cs.seo.metaDescription}
>

  <Breadcrumbs currentPage={cs.title} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CaseStudy",
    name: cs.title,
    description: cs.summary,
    datePublished: cs.date,
    author: { "@type": "Person", name: cs.author },
    about: {
      "@type": "LocalBusiness",
      name: "Insurance Support - Hari Kotian",
      url: "https://insurancesupport.online"
    },
    review: {
      "@type": "Review",
      author: { "@type": "Person", name: cs.clientQuote.split(' ').slice(0, 2).join(' ') },
      reviewBody: cs.clientQuote,
      reviewRating: { "@type": "Rating", ratingValue: "5" }
    }
  })} />

  <main class="page-transition">
    <!-- Hero -->
    <section class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 text-white py-16 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px]" />
      <div class="max-w-4xl mx-auto px-4 relative">
        <a href="/case-studies" class="inline-flex items-center gap-2 text-sm text-blue-200/70 hover:text-white mb-6 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
          All Case Studies
        </a>

        <div class="flex flex-wrap gap-3 mb-4">
          <span class="px-3 py-1 bg-blue-500/20 border border-blue-400/30 text-amber-300 text-xs font-semibold rounded-full">{cs.category}</span>
          <span class="px-3 py-1 bg-white/10 border border-white/10 text-blue-200 text-xs font-medium rounded-full">{cs.location}</span>
          <span class="px-3 py-1 bg-white/10 border border-white/10 text-blue-200 text-xs font-medium rounded-full">{cs.insurer}</span>
        </div>

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold leading-tight mb-4">{cs.title}</h1>
        <p class="text-lg text-blue-100/80 mb-8 leading-relaxed">{cs.subtitle}</p>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center backdrop-blur-sm">
            <div class="text-xs text-blue-200/70 mb-1">Claim Amount</div>
            <div class="text-lg font-extrabold text-amber-300">Rs.{cs.claimAmount}</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center backdrop-blur-sm">
            <div class="text-xs text-blue-200/70 mb-1">Denial Reason</div>
            <div class="text-sm font-semibold text-white">{cs.originalDenialReason.slice(0, 30)}...</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center backdrop-blur-sm">
            <div class="text-xs text-blue-200/70 mb-1">Resolution Time</div>
            <div class="text-lg font-extrabold text-amber-300">{cs.resolutionTime}</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center backdrop-blur-sm">
            <div class="text-xs text-blue-200/70 mb-1">Result</div>
            <div class="text-lg font-extrabold text-green-400">{cs.result}</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Case Study Content -->
    <article class="py-12 lg:py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4">

        <!-- Summary -->
        <section class="mb-12">
          <h2 class="text-2xl font-extrabold text-slate-900 mb-4 pb-3 border-b border-slate-100">Summary</h2>
          <p class="text-slate-600 leading-relaxed text-[15px]">{cs.summary}</p>
        </section>

        <!-- STAR Framework -->
        <section class="mb-12">
          <h2 class="text-2xl font-extrabold text-slate-900 mb-6 pb-3 border-b border-slate-100">How We Solved It</h2>

          <div class="space-y-6">
            <div class="bg-slate-50 rounded-xl p-6 border border-slate-100">
              <h3 class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
                <span class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold">S</span>
                Situation
              </h3>
              <p class="text-slate-600 leading-relaxed text-[15px]">{cs.situation}</p>
            </div>

            <div class="bg-slate-50 rounded-xl p-6 border border-slate-100">
              <h3 class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
                <span class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold">T</span>
                Task
              </h3>
              <p class="text-slate-600 leading-relaxed text-[15px]">{cs.task}</p>
            </div>

            <div class="bg-blue-50 rounded-xl p-6 border border-blue-100">
              <h3 class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
                <span class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold">A</span>
                Action
              </h3>
              <ol class="space-y-3 text-slate-600 leading-relaxed text-[15px]">
                {cs.action.map((item, i) => (
                  <li class="flex gap-3">
                    <span class="text-blue-600 font-bold shrink-0">{i + 1}.</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ol>
            </div>

            <div class="bg-green-50 rounded-xl p-6 border border-green-100">
              <h3 class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
                <span class="w-8 h-8 rounded-full bg-green-600 text-white flex items-center justify-center text-sm font-bold">R</span>
                Result
              </h3>
              <p class="text-slate-600 leading-relaxed text-[15px]">{cs.resultDetails}</p>
            </div>
          </div>
        </section>

        <!-- Lessons Learned -->
        <section class="mb-12">
          <h2 class="text-2xl font-extrabold text-slate-900 mb-6 pb-3 border-b border-slate-100">Lessons Learned</h2>
          <div class="bg-amber-50 rounded-xl p-6 border border-amber-100">
            <ul class="space-y-3">
              {cs.lessons.map((lesson) => (
                <li class="flex items-start gap-3 text-slate-700 text-[15px]">
                  <svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                  <span>{lesson}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <!-- Client Testimonial -->
        <section class="mb-12">
          <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-8 border border-blue-100">
            <div class="flex items-start gap-4">
              <div class="w-16 h-16 rounded-full bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-white font-bold text-xl shrink-0 shadow-lg">
                {cs.clientQuote.split(' ').slice(0, 2).map(w => w[0]).join('').slice(0, 2).toUpperCase()}
              </div>
              <div>
                <p class="text-slate-700 italic leading-relaxed mb-4">"{cs.clientQuote}"</p>
                <p class="text-sm font-semibold text-blue-600">— {cs.clientQuote.split(' ').slice(0, 2).join(' ')} | {cs.location}</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Related Case Studies -->
        {related.length > 0 && (
          <section class="mb-12">
            <h2 class="text-xl font-extrabold text-slate-900 mb-6">Related Case Studies</h2>
            <div class="grid md:grid-cols-2 gap-6">
              {related.map((rel) => rel && (
                <a href={`/case-studies/${rel.slug}`} class="block bg-white rounded-xl border border-slate-200 p-5 hover:shadow-lg hover:border-blue-200 transition-all group">
                  <span class="text-xs text-slate-400">{rel.category}</span>
                  <h3 class="text-sm font-bold text-slate-900 mb-2 line-clamp-2 group-hover:text-blue-600 transition-colors">{rel.title}</h3>
                  <span class="text-xs font-semibold text-green-600">Result: {rel.result}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- CTA -->
        <section class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 rounded-2xl p-8 md:p-10 text-center text-white relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/10 rounded-full blur-[100px]" />
          <h3 class="text-2xl md:text-3xl font-extrabold mb-3 relative">Have a similar situation?</h3>
          <p class="text-blue-200/80 mb-6 relative max-w-xl mx-auto">{cs.consultationCta}</p>
          <div class="flex flex-wrap justify-center gap-4 relative">
            <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-900 font-bold rounded-full text-lg shadow-lg hover:shadow-xl hover:scale-105 transition-all">
              Book Free Consultation
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
            <a href="https://wa.me/919986634506?text=Hi%20Hari%2C%20I%20have%20a%20situation%20similar%20to%20your%20case%20study.%20Can%20you%20help%3F" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-8 py-4 bg-white/10 border border-white/20 text-white font-semibold rounded-full hover:bg-white/20 transition-all">
              WhatsApp Us
            </a>
          </div>
        </section>
      </div>
    </article>
  </main>

</BaseLayout>