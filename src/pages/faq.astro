---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQPageJsonLd from '../components/FAQPageJsonLd.astro';

const faqs = [
  // General Insurance
  { category: "General Insurance", question: "How much does insurance cost and what affects the premium?", answer: "Premiums vary based on coverage type, sum assured, age, health condition, occupation, and location. GST of 18% is applicable on most insurance premiums. For life insurance, terms under 5 years are typically tax-free. Health insurance premiums include GST, and NCB (No Claim Bonus) can reduce motor insurance costs. Personal accident insurance is affordable starting from just ₹10 per day." },
  { category: "General Insurance", question: "How do I know which insurance is best for my family and needs?", answer: "The best insurance depends on your family size, age, income, existing assets, health conditions, and goals. For families with children, consider term insurance with child riders for education funding. For health coverage, choose between individual and family floater plans based on budget. Motor insurance should include third-party liability and comprehensive coverage. Personal accident insurance is crucial for working adults." },
  { category: "General Insurance", question: "Do you charge for insurance consultation?", answer: "Our initial consultation is completely free. We earn commissions from insurance companies when you purchase a policy through us, so there is no cost to you for advisory services." },
  { category: "General Insurance", question: "Can I buy insurance online through you?", answer: "Yes, we facilitate online policy purchases for multiple insurers including LIC, HDFC Life, ICICI Prudential, and others. We handle the entire process from comparison to application submission and policy issuance." },

  // Life Insurance
  { category: "Life Insurance", question: "What is the difference between term insurance and whole life insurance?", answer: "Term insurance provides coverage for a specified period (10-40 years) with lower premiums, paying a fixed sum if death occurs during the term. Whole life insurance provides lifelong coverage with premiums that increase with age, includes cash value accumulation, and continues until age 99. Term is suitable for those seeking high coverage at low cost for specific financial goals like children's education or mortgage protection." },
  { category: "Life Insurance", question: "How much life insurance coverage do I need?", answer: "A common rule is 10-15 times your annual income, plus outstanding debts, future goals (children's education, marriage), and inflation-adjusted living expenses for dependents. We provide personalized calculation during consultation." },
  { category: "Life Insurance", question: "What riders should I add to my term insurance?", answer: "Recommended riders: Critical Illness (lump sum on diagnosis), Accidental Death Benefit (additional payout), Waiver of Premium (premiums waived on disability), and Terminal Illness (advance payout on terminal diagnosis)." },
  { category: "Life Insurance", question: "Is medical test mandatory for term insurance?", answer: "For high sum assured (usually above ₹50-75 lakh) or age above 40, medical tests are typically required. Many insurers now offer tele-medical or home-based tests for convenience." },
  { category: "Life Insurance", question: "Can NRIs buy term insurance in India?", answer: "Yes, NRIs can buy term insurance from Indian insurers. The process requires medical tests (can be done abroad at empaneled centers), and premiums are paid in INR. Coverage is worldwide. We assist NRIs with the entire process." },

  // Health Insurance
  { category: "Health Insurance", question: "What is the waiting period for pre-existing diseases?", answer: "Typically 2-4 years depending on the insurer and policy. Under IRDAI's moratorium, after 8 years of continuous coverage without claims, insurers cannot deny claims for pre-existing conditions." },
  { category: "Health Insurance", question: "Should I choose individual or family floater health insurance?", answer: "Family floater is cost-effective for young families. Individual plans are better if a family member has pre-existing conditions or if you want separate sum assured for each member. We help you decide based on your family profile." },
  { category: "Health Insurance", question: "What is room rent capping and how does it affect claims?", answer: "Most policies cap daily room rent (e.g., ₹5,000/day). If you choose a room above this limit, the insurer applies proportionate deduction — reducing all claim amounts proportionally. We recommend policies with no room rent limits or high limits." },
  { category: "Health Insurance", question: "Can I port my health insurance to another insurer?", answer: "Yes, IRDAI allows health insurance portability. You can switch insurers without losing continuity benefits (waiting period credit for pre-existing diseases). We handle the entire porting process for you." },
  { category: "Health Insurance", question: "What is No Claim Bonus (NCB) in health insurance?", answer: "NCB increases your sum assured by 10-50% for each claim-free year, up to a maximum (usually 100%). It rewards healthy policyholders with enhanced coverage at no extra cost." },
  { category: "Health Insurance", question: "Does health insurance cover OPD expenses?", answer: "Standard policies cover hospitalization (24+ hours). Some plans offer OPD add-ons covering doctor consultations, diagnostics, and pharmacy bills. We can help you find policies with OPD benefits." },

  // Motor Insurance
  { category: "Motor Insurance", question: "What is the difference between third-party and comprehensive motor insurance?", answer: "Third-party covers only liability for damage to others — mandatory by law. Comprehensive covers third-party plus own damage (accident, theft, fire, natural calamities). We strongly recommend comprehensive for complete protection." },
  { category: "Motor Insurance", question: "What is IDV and how does it affect my premium?", answer: "Insured Declared Value (IDV) is the maximum claim amount for total loss/theft — essentially your vehicle's current market value. Higher IDV = higher premium but better coverage. We help you set the optimal IDV." },
  { category: "Motor Insurance", question: "Should I buy zero depreciation add-on?", answer: "Yes, especially for cars under 5 years. Without it, insurer deducts depreciation on replaced parts (50% for plastic, 30% for rubber, etc.). Zero depreciation covers full replacement cost. Highly recommended." },
  { category: "Motor Insurance", question: "What is NCB in motor insurance?", answer: "No Claim Bonus gives 20-50% discount on own-damage premium for each claim-free year, up to 50%. It's transferable when switching insurers or vehicles. We ensure your NCB is preserved." },
  { category: "Motor Insurance", question: "How do I file a motor insurance claim?", answer: "1) Inform insurer immediately, 2) File FIR for theft/major accidents, 3) Get surveyor inspection, 4) Submit documents, 5) Repair at network garage (cashless) or any garage (reimbursement). We assist with the entire process." },

  // Claim Support
  { category: "Claim Support", question: "My claim was rejected. Can you help?", answer: "Yes, this is our core expertise. We analyze the rejection reason, review your policy terms, gather supporting evidence, and represent you through the insurer's grievance process, IRDAI's IGMS portal, and the Insurance Ombudsman. We've recovered ₹50Cr+ in rejected claims." },
  { category: "Claim Support", question: "What documents are needed for a claim?", answer: "Common: Claim form, policy document, ID proof, medical reports/bills (health), FIR and survey report (motor), death certificate (life). Specific requirements vary by claim type. We provide a customized checklist." },
  { category: "Claim Support", question: "How long does claim settlement take?", answer: "IRDAI mandates: 30 days for straightforward claims, up to 90 days if investigation needed. With our assistance, we expedite by ensuring complete documentation upfront and regular follow-up. Most claims settle in 15-30 days." },
  { category: "Claim Support", question: "What if the insurer delays my claim?", answer: "Insurers must settle within timelines. For delays, we escalate to the Grievance Redressal Officer, then IRDAI IGMS, then Ombudsman. Interest is payable by insurer for delays beyond 30 days (for non-investigated claims)." },

  // Policy Review
  { category: "Policy Review", question: "Why should I review my insurance policies?", answer: "Life changes (marriage, children, job change, income increase) create coverage gaps. Policies bought years ago may have outdated sum assured, missing riders, or poor terms. Regular reviews ensure your coverage matches current needs and identify potential savings." },
  { category: "Policy Review", question: "How often should I review my policies?", answer: "Annually, or after major life events: marriage, childbirth, job change, home purchase, salary hike, parents' aging, loan closure, or when insurers announce new products/rates. We offer complimentary reviews twice a year for clients." },
  { category: "Policy Review", question: "Can you help me switch to a better policy?", answer: "Yes. We compare your current policy with market alternatives for better coverage, lower premiums, higher claim settlement ratios, and favorable terms. We handle the switching process including porting health insurance and surrendering/replacing life policies." },

  // IRDAI & Regulatory
  { category: "IRDAI & Regulatory", question: "What is IRDAI and what does it do?", answer: "Insurance Regulatory and Development Authority of India (IRDAI) is the apex body regulating insurance in India. It protects policyholder interests, sets regulations, monitors claim settlement ratios, and operates the IGMS grievance portal." },
  { category: "IRDAI & Regulatory", question: "How do I file a complaint with IRDAI?", answer: "File online at igms.irda.gov.in or call 1800-425-4732. You need your policy details and complaint description. IRDAI forwards it to the insurer for resolution within 15 days. We can file and follow up on your behalf." },
  { category: "IRDAI & Regulatory", question: "What is the Insurance Ombudsman?", answer: "A quasi-judicial body providing free, fair resolution of insurance disputes up to ₹30 lakh. You can approach after insurer's final rejection or 30 days of no response. No lawyer needed. We represent clients at Ombudsman hearings." },
];

const categories = [...new Set(faqs.map(f => f.category))].sort();
---

<BaseLayout title="Insurance FAQ | 50+ Questions Answered | Hari Kotian" description="50+ frequently asked insurance questions answered by Hari Kotian, IRDAI certified advisor. Covers life, health, motor, claims, policy review, and IRDAI regulations.">
  <FAQPageJsonLd questions={faqs} />
  <main class="max-w-5xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold text-slate-900 mb-8">Frequently Asked Questions</h1>
    <p class="text-slate-600 mb-12">Get answers to the most common questions about insurance planning, claims, and policy management from an IRDAI-certified advisor with 25+ years experience.</p>

    <!-- Category Navigation -->
    <nav class="mb-8 flex flex-wrap gap-2" aria-label="FAQ Categories">
      {categories.map(cat => (
        <a href={`#${cat.toLowerCase().replace(/&/g, '').replace(/\s+/g, '-')}`} class="px-4 py-2 bg-blue-50 text-blue-700 rounded-full text-sm font-medium hover:bg-blue-100 transition-colors">
          {cat}
        </a>
      ))}
    </nav>

    {categories.map(category => (
      <section id={category.toLowerCase().replace(/&/g, '').replace(/\s+/g, '-')} class="mb-16">
        <h2 class="text-2xl font-bold text-slate-900 mb-6 pb-2 border-b-2 border-blue-100">{category}</h2>
        <div class="space-y-3">
          {faqs.filter(f => f.category === category).map(faq => (
            <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
              <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors">
                <span class="font-semibold text-slate-900 pr-4">{faq.question}</span>
                <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-5 pb-5">
                <p class="text-slate-600 leading-relaxed">{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </section>
    ))}

    <!-- CTA -->
    <div class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 rounded-2xl p-8 md:p-10 text-center text-white relative overflow-hidden">
      <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/10 rounded-full blur-[100px]" />
      <h3 class="text-2xl md:text-3xl font-extrabold mb-3 relative">Still have questions?</h3>
      <p class="text-blue-200/80 mb-6 relative">Get personalized answers from Hari Kotian. Free consultation, no obligation.</p>
      <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-900 font-bold rounded-full text-lg shadow-lg shadow-amber-500/25 hover:shadow-xl hover:scale-105 transition-all">
        Book Free Consultation
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>
  </main>
</BaseLayout>