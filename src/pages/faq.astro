---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Insurance FAQ | Hari Kotian" description="50+ frequently asked insurance questions answered by Hari Kotian.">
  <main class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold text-slate-900 mb-8">Frequently Asked Questions</h1>
    <p class="text-slate-600 mb-12">Get answers to the most common questions about insurance planning, claims, and policy management.</p>
    <!-- Content would be mapped from faqData.ts -->
    <p class="text-center p-12 border-2 border-dashed border-slate-200 rounded-xl">FAQ content mapping in progress.</p>
  </main>
</BaseLayout>