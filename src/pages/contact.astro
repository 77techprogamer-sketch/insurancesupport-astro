---
import GoogleRating from '../components/GoogleRating.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import GoogleReviewCta from '../components/GoogleReviewCta.astro';
---

<BaseLayout 
  title="Contact an Insurance Advisor in Bengaluru | 99866 34506" 
  description="Call or WhatsApp +91 99866 34506. IRDAI-registered advisor in Bengaluru — free first review of a rejected claim, a policy or a renewal. Office in Jalahalli."
  pageType="contact"
  keywords="contact insurance advisor Bangalore, insurance agent phone number Bengaluru, claim help contact Bangalore, Hari Kotian contact, insurance advisor near me Bengaluru"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Contact Insurance Support — Hari Kotian",
    "description": "Get in touch with Hari Kotian, IRDAI-certified insurance advisor in Bengaluru with 25+ years experience. Free consultation for all insurance needs.",
    "url": "https://insurancesupport.online/contact/",
    "isPartOf": {
      "@type": "WebPage",
      "@id": "https://insurancesupport.online/claim-recovery/",
      "name": "Insurance Claim Recovery Hub"
    },
    "author": {
      "@type": "Person",
      "name": "Hari Kotian",
      "jobTitle": "IRDAI Certified Insurance Advisor"
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "@id": "https://insurancesupport.online/contact/#contactpage",
    "url": "https://insurancesupport.online/contact/",
    "name": "Contact an insurance advisor in Bengaluru",
    "about": { "@id": "https://insurancesupport.online/#organization" },
    "mainEntity": {
      "@type": "InsuranceAgency",
      "@id": "https://insurancesupport.online/#organization",
      "name": "Insurance Support",
      "telephone": "+919986634506",
      "email": "hari@insurancesupport.online",
      "url": "https://insurancesupport.online/",
      "sameAs": ["https://g.page/r/CRDgJanrKjRhEBM", "https://www.google.com/maps/place/LIC+-+Hari+Kotian/@13.0464375,77.5508125,17z/data=!4m6!3m5!1s0x3bae3d5028b4c20b:0x61342aeba925e010!8m2!3d13.0464375!4d77.5508125!16s%2Fg%2F1pv16s2jp"],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Bahubali Nagar, Jalahalli",
        "addressLocality": "Bengaluru",
        "addressRegion": "Karnataka",
        "postalCode": "560013",
        "addressCountry": "IN"
      },
      "geo": { "@type": "GeoCoordinates", "latitude": 13.0464375, "longitude": 77.5508125 },
      "openingHoursSpecification": [{
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
        "opens": "09:30",
        "closes": "21:00"
      }],
      "availableLanguage": ["English", "Hindi", "Kannada"]
    }
  })} />
  <main id="main" class="min-h-screen bg-slate-900 text-white relative overflow-hidden py-16 lg:py-24">
    <!-- Decorative background glows -->
    <div class="absolute top-10 left-1/4 w-96 h-96 bg-blue-600/20 rounded-full blur-[140px] pointer-events-none" />
    <div class="absolute bottom-10 right-1/4 w-96 h-96 bg-amber-500/10 rounded-full blur-[140px] pointer-events-none" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Page Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-400/20 text-amber-300 text-sm font-semibold mb-4 backdrop-blur-sm border border-amber-400/30">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          Get in Touch With Us
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-6">
          Contact an <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-200">insurance advisor in Bengaluru</span>
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          A stuck claim, a policy that lapsed, a renewal you do not understand — call, message or write.
          Hari Kotian answers personally, and the first review of your documents is free.
        </p>
        <p class="mt-5 text-slate-300">
          <a href="tel:+919986634506" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-white/10 border border-white/25 font-semibold hover:bg-white/20 transition-colors">Call +91 99866 34506</a>
          <a href="https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20I%20need%20insurance%20help." target="_blank" rel="noopener noreferrer" class="ml-2 inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-emerald-500 text-white font-semibold hover:bg-emerald-400 transition-colors">WhatsApp</a>
        </p>
        <div class="mt-6 text-slate-200">
          <GoogleRating />
        </div>
      </div>

      <!-- Main Contact Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Left Column: Quick Contact Cards -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Phone Card -->
          <a href="tel:+919986634506" class="group block bg-white/5 backdrop-blur-xl rounded-2xl p-6 border border-white/10 hover:border-amber-400/50 hover:bg-white/10 transition-all duration-300 shadow-xl">
            <div class="flex items-center gap-4">
              <div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-emerald-500 to-green-600 flex items-center justify-center shrink-0 shadow-lg group-hover:scale-110 transition-transform">
                <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold mb-1">Call Directly</p>
                <h3 class="text-xl font-bold text-white group-hover:text-amber-300 transition-colors">+91-99866 34506</h3>
                <p class="text-xs text-slate-400 mt-1">Mon – Sat: 9:00 AM – 9:00 PM</p>
              </div>
            </div>
          </a>

          <!-- WhatsApp Card -->
          <a href="https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20I%20need%20insurance%20consultation." target="_blank" rel="noopener noreferrer" class="group block bg-white/5 backdrop-blur-xl rounded-2xl p-6 border border-white/10 hover:border-emerald-400/50 hover:bg-white/10 transition-all duration-300 shadow-xl">
            <div class="flex items-center gap-4">
              <div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-green-500 to-emerald-600 flex items-center justify-center shrink-0 shadow-lg group-hover:scale-110 transition-transform">
                <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold mb-1">Instant Chat</p>
                <h3 class="text-xl font-bold text-white group-hover:text-emerald-300 transition-colors">Chat on WhatsApp</h3>
                <p class="text-xs text-slate-400 mt-1">Quick response guaranteed</p>
              </div>
            </div>
          </a>



          <!-- Office & IRDAI Badge -->
          <div class="bg-white/5 backdrop-blur-xl rounded-2xl p-6 border border-white/10 shadow-xl space-y-4">
            <div class="flex items-center gap-3">
              <div class="h-10 w-10 rounded-xl bg-amber-400/20 flex items-center justify-center text-amber-300 font-bold">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
              </div>
              <div>
                <h4 class="font-bold text-white">IRDAI Certified Advisor</h4>
                <p class="text-xs text-slate-400">Reg No: <span class="text-amber-300 font-semibold">0149161D</span></p>
              </div>
            </div>
            <hr class="border-white/10" />
            <div>
              <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold mb-1">Office Location</p>
              <p class="text-sm text-slate-200">Bahubali Nagar, Jalahalli, Bengaluru, Karnataka 560013</p>
            </div>
          </div>

        </div>

        <!-- Right Column: Rich Interactive Message Form -->
        <div class="lg:col-span-7">
          <div class="bg-white/10 backdrop-blur-xl rounded-3xl p-8 sm:p-10 border border-white/20 shadow-2xl relative">
            <div class="absolute -top-3 -right-3 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-900 font-bold text-xs px-4 py-1 rounded-full shadow-lg">
              Free Consultation
            </div>

            <h3 class="text-2xl font-bold text-white mb-2">Send a Message</h3>
            <p class="text-slate-300 text-sm mb-8">Fill out the form below and Hari Kotian will get back to you promptly.</p>

            <form id="contactForm" class="space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="contact-name" class="block text-sm font-medium text-slate-200 mb-2">Your Name *</label>
                  <input type="text" id="contact-name" name="name" required class="w-full px-4 py-3.5 bg-white/5 border border-white/20 rounded-xl text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition-all" placeholder="Enter your full name" />
                </div>
                <div>
                  <label for="contact-phone" class="block text-sm font-medium text-slate-200 mb-2">Phone Number *</label>
                  <input type="tel" id="contact-phone" name="phone" required class="w-full px-4 py-3.5 bg-white/5 border border-white/20 rounded-xl text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition-all" placeholder="+91 99866 34506" />
                </div>
              </div>

              <div>
                <label for="contact-email" class="block text-sm font-medium text-slate-200 mb-2">Email Address</label>
                <input type="email" id="contact-email" name="email" class="w-full px-4 py-3.5 bg-white/5 border border-white/20 rounded-xl text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition-all" placeholder="name@example.com" />
              </div>

              <div>
                <label for="insurance-type" class="block text-sm font-medium text-slate-200 mb-2">Insurance Category</label>
                <select id="insurance-type" name="category" class="w-full px-4 py-3.5 bg-slate-800 border border-white/20 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition-all">
                  <option value="Life & Term Insurance" class="bg-slate-900 text-white">Life & Term Insurance</option>
                  <option value="Health Insurance" class="bg-slate-900 text-white">Health Insurance</option>
                  <option value="Motor Insurance" class="bg-slate-900 text-white">Motor Insurance</option>
                  <option value="Claim Rejection / Support" class="bg-slate-900 text-white">Claim Rejection / Support</option>
                  <option value="Policy Revival / Review" class="bg-slate-900 text-white">Policy Revival / Review</option>
                  <option value="Other Inquiry" class="bg-slate-900 text-white">Other Inquiry</option>
                </select>
              </div>

              <div>
                <label for="contact-message" class="block text-sm font-medium text-slate-200 mb-2">How can we help you? *</label>
                <textarea id="contact-message" name="message" rows="4" required class="w-full px-4 py-3.5 bg-white/5 border border-white/20 rounded-xl text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition-all" placeholder="Describe your requirement or question in detail..."></textarea>
              </div>

              <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-500 hover:to-amber-600 text-slate-900 font-bold rounded-xl text-lg shadow-xl shadow-amber-500/20 hover:scale-[1.01] active:scale-[0.99] transition-all" aria-label="Send consultation request">
                              Send Consultation Request
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
              </button>

              <div id="formSuccess" class="hidden p-4 bg-emerald-500/20 border border-emerald-500/40 rounded-xl text-emerald-300 text-center font-medium">
                Thank you! Your message has been sent. Hari Kotian will contact you shortly.
              </div>
              <div id="formError" class="hidden p-4 bg-red-500/20 border border-red-500/40 rounded-xl text-red-300 text-center font-medium"></div>
            </form>
          </div>
        </div>

        <GoogleReviewCta
          heading="Already a client? Leave a Google review"
          body="If we have already helped with a claim, a policy review or a rejection, a short Google review is the most useful thing you can give us — it is how the next family decides whether to call."
        />
      </div>

      <!-- What to send -->
      <section class="mt-20" aria-labelledby="what-to-send">
        <h2 id="what-to-send" class="text-3xl font-bold text-white mb-3">What to send, so the first call is useful</h2>
        <p class="text-slate-300 max-w-3xl mb-8">
          You do not need a complete file to start. These three documents answer most questions on their own,
          and anything missing can follow.
        </p>
        <div class="grid md:grid-cols-3 gap-6">
          <article class="rounded-2xl bg-white/5 border border-white/10 p-6">
            <h3 class="font-bold text-white mb-2">If a claim was rejected</h3>
            <ul class="text-sm text-slate-300 space-y-1.5 list-disc list-inside">
              <li>the rejection letter, every version</li>
              <li>the policy schedule and wording</li>
              <li>the claim form you submitted</li>
            </ul>
          </article>
          <article class="rounded-2xl bg-white/5 border border-white/10 p-6">
            <h3 class="font-bold text-white mb-2">If it is a LIC policy</h3>
            <ul class="text-sm text-slate-300 space-y-1.5 list-disc list-inside">
              <li>policy number and issue date</li>
              <li>any revival endorsement</li>
              <li>premium receipts for the last three years</li>
            </ul>
          </article>
          <article class="rounded-2xl bg-white/5 border border-white/10 p-6">
            <h3 class="font-bold text-white mb-2">If you are only planning</h3>
            <ul class="text-sm text-slate-300 space-y-1.5 list-disc list-inside">
              <li>age of the people to be covered</li>
              <li>existing policies and sums insured</li>
              <li>the hospitals you would use</li>
            </ul>
          </article>
        </div>
      </section>

      <!-- What happens next -->
      <section class="mt-16" aria-labelledby="what-happens">
        <h2 id="what-happens" class="text-3xl font-bold text-white mb-6">What happens after you get in touch</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="rounded-2xl border border-white/10 p-6 bg-white/5">
            <p class="text-amber-300 font-bold mb-2">1 · The same day, usually</p>
            <p class="text-sm text-slate-300">A call or a written reply, whichever you asked for. You deal with Hari Kotian, not a call centre.</p>
          </div>
          <div class="rounded-2xl border border-white/10 p-6 bg-white/5">
            <p class="text-amber-300 font-bold mb-2">2 · A plain read of the file</p>
            <p class="text-sm text-slate-300">Whether the decision holds, what the clause actually says, and which forum applies — the Ombudsman, Bima Bharosa or a consumer commission.</p>
          </div>
          <div class="rounded-2xl border border-white/10 p-6 bg-white/5">
            <p class="text-amber-300 font-bold mb-2">3 · A decision, in writing</p>
            <p class="text-sm text-slate-300">What the next step is, what it costs if anything, and what you would have to do yourself. No fee is charged for the first read.</p>
          </div>
        </div>
      </section>

      <!-- NAP -->
      <section class="mt-16 rounded-2xl bg-white/5 border border-white/10 p-8" aria-labelledby="office">
        <h2 id="office" class="text-2xl font-bold text-white mb-6">Office, hours and languages</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 text-sm">
          <div>
            <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold mb-1">Address</p>
            <address class="not-italic text-slate-200 leading-relaxed">
              Insurance Support<br />
              Bahubali Nagar, Jalahalli<br />
              Bengaluru, Karnataka 560013<br />
              India
            </address>
          </div>
          <div>
            <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold mb-1">Phone and email</p>
            <p class="text-slate-200 leading-relaxed">
              <a href="tel:+919986634506" class="hover:text-amber-300">+91 99866 34506</a><br />
              <a href="mailto:hari@insurancesupport.online" class="hover:text-amber-300 break-all">hari@insurancesupport.online</a>
            </p>
          </div>
          <div>
            <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold mb-1">Hours</p>
            <p class="text-slate-200 leading-relaxed">Monday to Saturday<br />9:30 am – 6:00 pm IST<br />Sunday: closed</p>
          </div>
          <div>
            <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold mb-1">Languages</p>
            <p class="text-slate-200 leading-relaxed">English, Hindi, Kannada<br />IRDAI Reg. No. 0149161D<br /><a href="https://g.page/r/CRDgJanrKjRhEBM" target="_blank" rel="noopener noreferrer" class="hover:text-amber-300">Google listing</a> · <a href="https://www.google.com/maps/place/LIC+-+Hari+Kotian/@13.0464375,77.5508125,17z/data=!4m6!3m5!1s0x3bae3d5028b4c20b:0x61342aeba925e010!8m2!3d13.0464375!4d77.5508125!16s%2Fg%2F1pv16s2jp" target="_blank" rel="noopener noreferrer" class="hover:text-amber-300">Directions</a></p>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="mt-16" aria-labelledby="contact-faq">
        <h2 id="contact-faq" class="text-3xl font-bold text-white mb-6">Before you call</h2>
        <div class="space-y-3 max-w-3xl">
          <details class="rounded-xl border border-white/10 bg-white/5 p-5">
            <summary class="cursor-pointer font-semibold text-white list-none">Is the first consultation really free?</summary>
            <p class="mt-3 text-sm text-slate-300 leading-relaxed">Yes. Send the documents and you get an answer about whether the decision holds and which route applies. Any fee after that is agreed in writing before work starts.</p>
          </details>
          <details class="rounded-xl border border-white/10 bg-white/5 p-5">
            <summary class="cursor-pointer font-semibold text-white list-none">Do I have to come to Bengaluru?</summary>
            <p class="mt-3 text-sm text-slate-300 leading-relaxed">No. Most files are handled remotely by email and WhatsApp, and the Ombudsman increasingly hears matters by video. If you prefer to meet, the office is in Jalahalli, north Bengaluru.</p>
          </details>
          <details class="rounded-xl border border-white/10 bg-white/5 p-5">
            <summary class="cursor-pointer font-semibold text-white list-none">What if my policy is from another city or state?</summary>
            <p class="mt-3 text-sm text-slate-300 leading-relaxed">The rules are national. What changes is the Ombudsman zone, which follows your address and the insurer's office handling the claim — so a policy bought elsewhere is still handled from where you live.</p>
          </details>
          <details class="rounded-xl border border-white/10 bg-white/5 p-5">
            <summary class="cursor-pointer font-semibold text-white list-none">Can you guarantee my claim will be paid?</summary>
            <p class="mt-3 text-sm text-slate-300 leading-relaxed">No, and nobody honestly can. The insurer decides the claim; the Ombudsman or a consumer commission decides a dispute. What can be guaranteed is that the file is put together properly and the right forum is used.</p>
          </details>
        </div>
      </section>

    </div>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is the first consultation really free?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Send the documents and you get an answer about whether the decision holds and which route applies. Any fee after that is agreed in writing before work starts." }
      },
      {
        "@type": "Question",
        "name": "Do I have to come to Bengaluru?",
        "acceptedAnswer": { "@type": "Answer", "text": "No. Most files are handled remotely by email and WhatsApp, and the Ombudsman increasingly hears matters by video. If you prefer to meet, the office is in Jalahalli, north Bengaluru." }
      },
      {
        "@type": "Question",
        "name": "What if my policy is from another city or state?",
        "acceptedAnswer": { "@type": "Answer", "text": "The rules are national. What changes is the Ombudsman zone, which follows your address and the insurer's office handling the claim, so a policy bought elsewhere is still handled from where you live." }
      },
      {
        "@type": "Question",
        "name": "Can you guarantee my claim will be paid?",
        "acceptedAnswer": { "@type": "Answer", "text": "No. The insurer decides the claim; the Ombudsman or a consumer commission decides a dispute. What can be done is to put the file together properly and use the right forum." }
      }
    ]
  })} />

  <script is:inline>
    document.getElementById('contactForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      const form = this;
      const btn = form.querySelector('button[type="submit"]');
      const successDiv = document.getElementById('formSuccess');
      const errorDiv = document.getElementById('formError');
      const origHtml = btn.innerHTML;
      if (errorDiv) errorDiv.classList.add('hidden');
      btn.disabled = true;
      btn.innerHTML = '<span class="w-5 h-5 border-2 border-slate-900/20 border-t-slate-900 rounded-full animate-spin" /> Sending...';
      try {
        const formData = new FormData(form);
        const data = Object.fromEntries(formData);
        const res = await fetch('/contact-submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: data.name, phone: data.phone, email: data.email || '', category: data.category || '', message: data.message })
        });
        const json = await res.json();
        if (!res.ok || !json.success) throw new Error(json.error || 'Submission failed');
        if (successDiv) { successDiv.classList.remove('hidden'); setTimeout(() => successDiv.classList.add('hidden'), 6000); }
        // Google Ads Conversion Event
        if (typeof gtag !== 'undefined') {
          gtag('event', 'conversion', {'send_to': 'AW-18269976114/6yFgCKyx8uQcELLs5odE'});
        }
        form.reset();
      } catch (err) {
        if (errorDiv) { errorDiv.textContent = err.message || 'Something went wrong. Please try again.'; errorDiv.classList.remove('hidden'); setTimeout(() => errorDiv.classList.add('hidden'), 6000); }
      } finally {
        btn.disabled = false;
        btn.innerHTML = origHtml;
      }
    });
  </script>
</BaseLayout>
