        }
      },
      {
        "@type": "Question",
        "name": "What are the most common reasons cashless requests are rejected in India?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The top reasons are: policy not active or premiums unpaid, treatment falling inside a waiting period, pre-existing disease declarations under review, insufficient sum insured after earlier claims, room rent beyond the eligible category, and missing or incomplete clinical details in the pre-authorisation form."
        }
      },
      {
        "@type": "Question",
        "name": "Should I dispute the denial at the hospital or with the insurance company?",
        "acceptedAnswer": {
