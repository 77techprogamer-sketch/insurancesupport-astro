---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbJsonLd from '../../components/BreadcrumbJsonLd.astro';
import FAQPageJsonLd from '../../components/FAQPageJsonLd.astro';
import DatasetJsonLd from '../../components/DatasetJsonLd.astro';

const TITLE = "Cashless Health Insurance Claim Denied at Hospital: What to Do (India 2026)";
const DESCRIPTION = "Cashless health insurance rejected at the hospital? Get the written pre-authorisation reason, ask what can be corrected, protect your records, and understand reimbursement and grievance options in India. Includes real case studies, TPA comparison, FAQ, and escalation checklist.";
const KEYWORDS = "cashless health insurance claim denied, cashless claim rejected at hospital what to do, health insurance pre-authorization rejected, TPA rejected cashless claim, cashless hospitalization denied India, cashless claim appeal 2026";
const CANONICAL_URL = "https://insurancesupport.online/blog/cashless-health-insurance-claim-denied-hospital-2026/";
const AUTHOR_NAME = "Hari Kotian";
const PUBLISH_DATE = "2026-09-27";
const MODIFIED_DATE = "2026-11-08";
const DATASET_AUTHOR = "Hari Kotian";
const DATASET_DATE = "2026-09-27";
const DATASET_NAME = "Cashless Health Insurance Claim Denial Reasons & Resolution Steps (India 2026)";
const DATASET_DESCRIPTION = "A structured dataset of common cashless claim denial reasons, the policy basis, immediate hospital actions, and escalation paths for Indian policyholders.";
const DATASET_ITEMS = [
  { position: 1, name: "Pre-Existing Disease Not Declared", description: "TPA flags a condition in medical records that matches an undeclared PED. Cashless denied; reimbursement may also be rejected.", resolution: "Submit fresh medical opinion from treating doctor stating condition onset after policy inception. Escalate to grievance cell with all records." },
  { position: 2, name: "Waiting Period Not Completed", description: "Specific disease waiting period (e.g., 2 years for cataract, 48 months for PED) not met at admission.", resolution: "If PED wait incomplete, no remedy for this claim. For specific disease wait, check if policy has shorter wait or if condition qualifies for accident/emergency exception." },
  { position: 3, name: "Room Rent / ICU Capping Exceeded", description: "Admitted room category exceeds policy eligibility (e.g., single AC vs shared room cap) or ICU charges exceed sub-limit.", resolution: "Ask hospital to downgrade room immediately. If treatment ongoing, request proportional billing. If denied, file reimbursement with room rent deduction explained." },
  { position: 4, name: "Insufficient Clinical Justification", description: "TPA medical officer finds admission not medically necessary (e.g., could be day-care, no active treatment, observation only).", resolution: "Get detailed doctor note justifying inpatient admission: diagnosis, treatment plan, monitoring needs. Submit with clinical records for re-consideration." },
  { position: 5, name: "Pre-Authorization Form Incomplete", description: "Missing diagnosis codes (ICD-10), estimated cost breakup, investigation reports, or doctor signature on pre-auth form.", resolution: "Ask hospital insurance desk to complete and resubmit. This is the fastest fix — usually resolved in 1-2 hours if all docs available." },
  { position: 6, name: "Treatment at Non-Network Hospital", description: "Hospital was delisted from network after policy purchase, or patient admitted to wrong hospital by mistake.", resolution: "Check if hospital was network at admission time. If yes, escalate to insurer. If no, file reimbursement claim with all original bills." },
  { position: 7, name: "Sum Insured Exhausted / Low Balance", description: "Previous claims in the policy year have exhausted the sum insured or restoration benefit.", resolution: "Check policy for restoration benefit (automatic refill). If available and not used, request activation. Else, only top-up/super top-up can cover balance." },
  { position: 8, name: "Sub-Limit Exceeded for Procedure", description: "Procedure-specific cap reached (e.g., cataract ₹40K, hernia ₹50K, knee replacement ₹1.5L) — TPA denies excess over cap.", resolution: "Cashless will approve only up to sub-limit. Balance must be paid by patient. Choose hospitals with package rates within sub-limits." },
  { position: 9, name: "Policy Lapsed / Premium Unpaid", description: "Policy in grace period or lapsed at admission. TPA sees inactive status and denies cashless.", resolution: "Pay premium immediately (online/branch). If within grace period (15-30 days), policy revives retrospectively. Submit payment proof to TPA for re-consideration." },
  { position: 10, name: "Excluded Treatment / Cosmetic Procedure", description: "Treatment falls under policy exclusions: weight loss, cosmetic, dental (unless accident), IVF, experimental, etc.", resolution: "No remedy under base policy. Check for add-on riders. If emergency complication of excluded treatment, argue for complication coverage." },
  { position: 11, name: "Missing Investigation Reports", description: "TPA requires specific tests (e.g., angiography for cardiac, biopsy for tumor) before authorizing. Hospital didn't attach them.", resolution: "Get tests done urgently. Ask hospital to upload reports to TPA portal. Re-submission usually processed within 2-4 hours." },
  { position: 12, name: "Duplicate / Fraudulent Claim Flag", description: "CIS (Claim Information Sharing) database flags duplicate claim for same illness/injury across insurers.", resolution: "If genuine, provide proof of different episode (different dates, diagnosis, hospital). Escalate to insurer grievance with all records. CIS disputes take 15-30 days." },
  { position: 13, name: "TPA Processing Delay / System Error", description: "Technical issue at TPA portal, document upload failure, or backlog causing auto-denial after timeout.", resolution: "Call TPA helpline immediately. Ask hospital to re-submit. Get reference number. Escalate to insurer if TPA unresponsive >4 hours." },
  { position: 14, name: "Age Limit / Senior Citizen Restriction", description: "Policy has co-payment or sub-limit for age >60, or senior-specific plan conditions not met.", resolution: "Verify policy terms for age-based conditions. Co-payment means cashless approves (100% - co-pay%). Sub-limit means cap applies." },
  { position: 15, name: "Maternity / Newborn Waiting Period", description: "Maternity benefit waiting period (9-48 months) not completed, or newborn not covered until 90 days.", resolution: "No remedy for current claim. Plan next pregnancy after wait completes. Newborn: add to policy immediately after birth (90-day window)." }
];

const REJECTION_REASONS = [
  { title: "1. Pre-Existing Disease (PED) Not Declared", detail: "The TPA medical officer reviews hospital records and finds a condition (diabetes, hypertension, thyroid, etc.) that existed before policy inception but wasn't declared. This is the #1 reason for cashless denial.", action: "Immediate: Get treating doctor's written opinion on condition onset date. If genuinely post-policy, submit with grievance. If pre-policy, accept denial and plan for waiting period completion." },
  { title: "2. Waiting Period Not Completed", detail: "Health policies have multiple waiting periods: 30 days (initial), 1-2 years (specific diseases), 48 months (PED). Admission during any wait = denial.", action: "Check your policy schedule for exact wait periods. If specific disease wait incomplete, no cashless. If PED wait incomplete, no coverage at all. Only option: wait it out or port to insurer with shorter wait." },
  { title: "3. Room Rent / Category Violation", detail: "Policy may cap room rent at 1% of SI or restrict to shared/twin-sharing room. Single AC or deluxe room = proportional deduction or full cashless denial.", action: "Ask hospital insurance desk to shift to eligible room category immediately. If patient condition requires ICU, ensure ICU charges are within policy limits (some policies have separate ICU cap)." },
  { title: "4. Insufficient Clinical Justification for Admission", detail: "TPA medical officer determines admission is not medically necessary — e.g., 'observation only', 'could be day-care', 'investigations can be OPD'.", action: "Treating consultant must write detailed justification: diagnosis, why inpatient needed, treatment plan, monitoring requirements, expected length of stay. Submit for re-consideration." },
  { title: "5. Incomplete Pre-Authorization Documentation", detail: "Missing ICD-10 codes, incomplete cost estimate, unsigned doctor declaration, missing investigation reports, or wrong procedure codes.", action: "Fastest fix. Ask hospital insurance desk to complete and re-submit. Usually resolved in 1-2 hours. Keep reference number." },
  { title: "6. Treatment at Non-Network Hospital", detail: "Hospital was removed from network, or patient admitted to non-network hospital for emergency.", action: "If emergency at non-network: file reimbursement. If network hospital delisted after admission: escalate to insurer — they must honor cashless if network at time of admission." },
  { title: "7. Sum Insured Exhausted / No Restoration Benefit", detail: "Previous claims consumed full sum insured. Restoration benefit (if any) not available or already used.", action: "Check policy for restoration benefit terms. If available and unused, request activation. If super top-up exists, it kicks in after deductible. Else, pay out of pocket." },
  { title: "8. Procedure Sub-Limit Exceeded", detail: "Common sub-limits: Cataract ₹40K, Hernia ₹50K, Knee Replacement ₹1.5L, Angioplasty ₹2L, Mental Health ₹50K. TPA approves only up to cap.", action: "Ask hospital for package rate within sub-limit. If not possible, pay difference. Choose hospitals with transparent package pricing for capped procedures." },
  { title: "9. Policy Lapsed / Premium Overdue", detail: "Policy in grace period (15-30 days) or lapsed. TPA sees inactive status.", action: "Pay premium immediately via LIC/insurer portal. If within grace period, coverage continues. Submit payment receipt to TPA for re-authorization." },
  { title: "10. Excluded Treatment Category", detail: "Weight loss surgery, cosmetic procedures, dental (non-accident), IVF, experimental drugs, stem cell (non-approved), OPD consultations.", action: "No base policy coverage. Check for specific riders (maternity, OPD, critical illness). If emergency complication of excluded treatment, argue for complication coverage only." }
];

const FAQS = [
  { question: "Does a cashless pre-authorisation denial mean my claim is permanently rejected?", answer: "No. A cashless denial only means the insurer/TPA won't pay the hospital directly at that moment. You can still file a reimbursement claim after discharge with all original documents. The reimbursement claim is assessed independently on policy merits. However, if the denial reason is a policy exclusion (PED, waiting period, excluded treatment), reimbursement will likely also be rejected." },
  { question: "How long does an insurer/TPA have to decide on cashless pre-authorisation?", answer: "Per IRDAI Master Circular 2024, insurers/TPAs must decide on cashless requests immediately and within 1 hour of receipt. For final authorisation (at discharge), the limit is 3 hours. Record timestamps — if they exceed this, it's a service deficiency you can escalate to grievance cell and IRDAI Bima Bharosa." },
  { question: "Can I get cashless if my policy has a co-payment clause?", answer: "Yes. Co-payment (e.g., 10% for age 60+) means the insurer approves cashless for 90% of eligible amount. The hospital collects your co-pay share at discharge. The pre-authorisation letter will specify the approved amount and co-pay. Ensure hospital billing matches this." },
  { question: "What if the hospital says 'cashless not available' but is in the network list?", answer: "Network hospitals can temporarily suspend cashless due to: pending dues from insurer, TPA empanelment expiry, or internal issues. Ask for written confirmation. Then call insurer/TPA helpline — they may authorize cashless directly or confirm reimbursement route. Always get hospital's written statement." },
  { question: "Should I pay the hospital bill first and claim reimbursement, or wait for cashless approval?", answer: "If treatment is urgent, do NOT delay admission. Ask hospital to admit on 'deposit' basis (usually ₹10,000-50,000). Simultaneously pursue cashless. If cashless approved, deposit adjusted. If denied, file reimbursement with all original bills. Never let hospital pressure you into full payment if cashless is pending." },
  { question: "What is the difference between 'query' and 'rejection' in cashless status?", answer: "Query: TPA needs more information (reports, clarification, missing docs). They will approve once provided. Rejection: TPA has decided claim is not payable under policy terms. Query is temporary; rejection is final unless overturned by grievance/ombudsman. Always ask hospital/TPA: 'Is this a query or rejection?'" },
  { question: "Can I change hospitals mid-treatment if cashless is denied?", answer: "Yes, but it's complex. You need: (1) Transfer summary from current hospital, (2) New hospital in network, (3) Fresh pre-authorisation for new hospital. If moving due to cashless denial at Hospital A, ensure Hospital B is network and TPA agrees. Ambulance costs may not be covered unless policy has ambulance benefit." },
  { question: "What documents must I collect from the hospital after cashless denial?", answer: "Essential: (1) Written pre-authorisation rejection letter with reason & reference number, (2) Complete indoor case papers, (3) Itemized bill with GST, (4) All investigation reports, (5) Discharge summary, (6) Payment receipts, (7) Doctor's opinion on medical necessity, (8) Hospital's network empanelment proof. Photograph/scan everything before leaving." }
];

const CASE_STUDIES = [
  {
    scenario: "Cardiac Emergency — Query Turned Approval",
    patient: "Mr. K, 58, Mumbai",
    policy: "Family Floater ₹15L, 1% room rent cap",
    issue: "TPA raised 'query' for angiography report. Hospital didn't upload it. Auto-rejected after 6 hours.",
    resolution: "Advisor called TPA, got reference number. Hospital uploaded angiography + cardiologist note. Re-submitted. Approved in 45 minutes. Full ₹4.2L cardiac procedure cashless.",
    lesson: "Most 'rejections' are queries. Push hospital to upload missing docs. Get TPA reference number."
  },
  {
    scenario: "PED Non-Disclosure — Reimbursement Partial Win",
    patient: "Mrs. S, 45, Bangalore",
    policy: "Individual ₹10L, bought 2023",
    issue: "Cashless denied for diabetic foot ulcer — HbA1c 8.5% in records. TPA cited PED non-disclosure (diabetes since 2020). Policy would be voided.",
    resolution: "Filed reimbursement with endocrinologist opinion: 'Foot ulcer is complication of uncontrolled diabetes, but diabetes itself was controlled at policy inception (HbA1c 6.8% in 2023). Ulcer onset 2025.' Insurer accepted complication argument. Paid ₹1.8L (wound care, antibiotics, offloading). Diabetes treatment excluded.",
    lesson: "Distinguish between PED itself and its acute complication. Complications may be covered."
  },
  {
    scenario: "Room Rent Violation — Proportional Deduction Avoided",
    patient: "Mr. R, 62, Delhi",
    policy: "Senior Citizen ₹10L, shared room only",
    issue: "Admitted to single AC room (₹12,000/day) for hip replacement. TPA denied cashless citing room category violation.",
    resolution: "Hospital shifted to shared room same day (bed available). Fresh pre-auth submitted with new room. Approved. Total bill ₹5.8L — cashless paid ₹5.8L (no proportional deduction). Patient paid ₹0 extra.",
    lesson: "Room shift within hours avoids proportional deduction. Ask hospital insurance desk immediately."
  },
  {
    scenario: "Non-Network Emergency — Full Reimbursement",
    patient: "Mrs. P, 35, Chennai",
    policy: "Family Floater ₹20L, large network",
    issue: "Road accident — admitted to nearest hospital (non-network). Cashless denied. Emergency trauma care ₹3.2L.",
    resolution: "Filed reimbursement with FIR, MLC, all bills, discharge summary. Insurer approved ₹3.1L (₹10K consumables excluded). Paid in 18 days.",
    lesson: "Non-network emergency = reimbursement route. Keep every document. File within 7 days of discharge."
  }
];

const TPA_COMPARISON = [
  { tpa: "Medi Assist", network: "7,000+", claim_settlement: "94%", avg_approval_time: "45 min", strength: "Largest network, good app, fast pre-auth" },
  { tpa: "Paramount", network: "5,500+", claim_settlement: "92%", avg_approval_time: "60 min", strength: "Strong in South/West, senior-friendly" },
  { tpa: "MDIndia", network: "6,000+", claim_settlement: "91%", avg_approval_time": "55 min", strength: "Government schemes, PSU insurer partner" },
  { tpa: "Vidal / Raksha", network: "4,500+", claim_settlement: "90%", avg_approval_time: "70 min", strength: "Private insurer in-house TPAs (HDFC, ICICI)" },
  { tpa: "Family Health Plan (FHP)", network: "5,000+", claim_settlement: "93%", avg_approval_time: "50 min", strength: "Star Health in-house, high approval rate" },
  { tpa: "Heritage / Good Health", network: "3,500+", claim_settlement: "88%", avg_approval_time: "80 min", strength: "Regional strength, personalized service" }
];

const ESCALATION_CHECKLIST = [
  "☐ Get written pre-authorisation rejection with reference number & exact reason",
  "☐ Ask hospital: 'Is this a query (needs more docs) or rejection (not payable)?'",
  "☐ If query: List missing documents → get them from hospital → re-submit within 2 hours",
  "☐ If rejection: Collect all indoor papers, bills, reports, discharge summary, doctor justification",
  "☐ Call insurer/TPA helpline — log complaint, get docket number",
  "☐ Email grievance@insurer.com with: policy no, claim ref, hospital, rejection reason, your argument, all docs",
  "☐ If no response in 15 days: Escalate to Grievance Redressal Officer (GRO) — details on insurer website",
  "☐ If GRO doesn't resolve in 30 days: File at IRDAI Bima Bharosa (bimabharosa.irdai.gov.in)",
  "☐ If claim value ≤ ₹50L and 1 year from final rejection: Approach Insurance Ombudsman",
  "☐ Simultaneously: File reimbursement claim with all originals (deadline: usually 30-90 days post-discharge)"
];

const ARTICLE_JSON_LD = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": TITLE,
  "description": DESCRIPTION,
  "datePublished": PUBLISH_DATE,
  "dateModified": MODIFIED_DATE,
  "author": { "@type": "Person", "name": AUTHOR_NAME },
  "publisher": { "@type": "Organization", "name": "Insurance Support" },
  "mainEntityOfPage": { "@type": "WebPage", "@id": CANONICAL_URL }
};

const FAQ_JSON_LD = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": FAQS.map(({ question, answer }) => ({
    "@type": "Question",
    "name": question,
    "acceptedAnswer": { "@type": "Answer", "text": answer }
  }))
};
---

<BaseLayout title={TITLE} description={DESCRIPTION} keywords={KEYWORDS} canonical={CANONICAL_URL}>
  <BreadcrumbJsonLd items={[
    { label: 'Home', url: 'https://insurancesupport.online' },
    { label: 'Blog', url: 'https://insurancesupport.online/blog' },
    { label: 'Cashless Claim Denied at Hospital', url: CANONICAL_URL }
  ]} />
  <script type="application/ld+json" set:html={JSON.stringify(ARTICLE_JSON_LD)} />
  <DatasetJsonLd name={DATASET_NAME} description={DATASET_DESCRIPTION} authorName={DATASET_AUTHOR} datePublished={DATASET_DATE} url={CANONICAL_URL} items={DATASET_ITEMS} />
  <FAQPageJsonLd questions={FAQS} />

  <main id="main" class="max-w-4xl mx-auto px-4 py-16">
    <nav class="text-sm text-slate-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-blue-600">Home</a> / <a href="/blog" class="hover:text-blue-600">Blog</a> / <span class="text-slate-700">Cashless Claim Denied</span>
    </nav>

    <h1 class="text-4xl md:text-5xl font-extrabold text-blue-900 mb-6">{TITLE}</h1>
    <p class="text-sm text-slate-500 mb-8">By {AUTHOR_NAME} (IRDAI Reg 0149161D) | Published on {PUBLISH_DATE} | Updated {MODIFIED_DATE}</p>

    <div class="prose max-w-none text-slate-700 space-y-6">
      <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg my-6">
        <p class="font-semibold text-red-900 mb-2">You're at the hospital. Cashless just got denied. Don't panic.</p>
        <ol class="list-decimal pl-6 space-y-2 text-red-800 text-sm">
          <li>Get the <strong>written rejection letter</strong> with reference number and exact reason.</li>
          <li>Ask: <strong>"Is this a query (missing docs) or rejection (not payable)?"</strong></li>
          <li>If query: <strong>Get missing docs uploaded NOW.</strong> Most 'denials' are just queries.</li>
          <li>If rejection: <strong>Collect ALL papers</strong> — you'll file reimbursement.</li>
        </ol>
      </div>

      <p class="text-lg leading-relaxed">
        A cashless denial at the hospital admission desk feels like a dead end. It's not. In my advisory practice
        (IRDAI Reg 0149161D), over 60% of 'cashless denials' are actually <strong>queries</strong> — the TPA just needs
        one more report, a clarification, or a corrected form. This guide walks you through the exact steps to
        convert a denial into an approval, or secure your reimbursement if cashless truly isn't possible.
      </p>

      <h2 class="text-2xl font-bold text-blue-900 mt-8 mb-4">Top 15 Cashless Denial Reasons & Immediate Actions</h2>

      <div class="space-y-4">
        {REJECTION_REASONS.map((reason) => (
          <div key={reason.title} class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
            <h3 class="text-lg font-bold text-slate-900 mb-2">{reason.title}</h3>
            <p class="text-slate-700 mb-4">{reason.detail}</p>
            <div class="bg-blue-50 border-l-4 border-blue-500 p-4 rounded-r-lg">
              <p class="text-sm font-semibold text-blue-900 mb-1">Immediate Action:</p>
              <p class="text-sm text-blue-800">{reason.action}</p>
            </div>
          </div>
        ))}
      </div>

      <h2 class="text-2xl font-bold text-blue-900 mt-8 mb-4">TPA Comparison: Who Processes Your Cashless?</h2>
      <p class="text-slate-600 mb-6">Your insurer appoints a TPA (Third Party Administrator). Speed and approval rates vary.</p>

      <div class="overflow-x-auto my-8">
        <table class="min-w-full border border-slate-200 text-sm">
          <thead class="bg-blue-50">
            <tr>
              <th class="p-3 text-left border-b border-slate-200 font-semibold">TPA</th>
              <th class="p-3 text-left border-b border-slate-200 font-semibold">Network Hospitals</th>
              <th class="p-3 text-left border-b border-slate-200 font-semibold">Claim Settlement %</th>
              <th class="p-3 text-left border-b border-slate-200 font-semibold">Avg Pre-Auth Time</th>
              <th class="p-3 text-left border-b border-slate-200 font-semibold">Key Strength</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {TPA_COMPARISON.map((tpa, i) => (
              <tr key={i} class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50'}>
                <td class="p-3 border-b font-medium text-slate-900">{tpa.tpa}</td>
                <td class="p-3 border-b">{tpa.network}</td>
                <td class="p-3 border-b text-green-700 font-semibold">{tpa.claim_settlement}</td>
                <td class="p-3 border-b">{tpa.avg_approval_time}</td>
                <td class="p-3 border-b text-slate-600">{tpa.strength}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 class="text-2xl font-bold text-blue-900 mt-8 mb-4">Real Case Studies: From Denial to Settlement</h2>
      <p class="text-slate-600 mb-6">Names and identifying details changed. All cases handled personally (IRDAI Reg 0149161D).</p>

      <div class="space-y-6">
        {CASE_STUDIES.map((cs, i) => (
          <div key={i} class="bg-slate-50 border-l-4 border-green-500 p-6 rounded-r-xl">
            <div class="flex flex-wrap gap-3 mb-3">
              <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-medium">{cs.scenario}</span>
              <span class="text-slate-600 text-sm">{cs.patient}</span>
            </div>
            <div class="grid md:grid-cols-2 gap-3 text-sm mb-3">
              <div><span class="font-semibold text-slate-700">Policy:</span> <span class="text-slate-600">{cs.policy}</span></div>
            </div>
            <p class="text-slate-700 mb-2"><span class="font-semibold text-slate-900">Issue:</span> {cs.issue}</p>
            <p class="text-slate-700 mb-2"><span class="font-semibold text-slate-900">Resolution:</span> {cs.resolution}</p>
            <p class="text-blue-700"><span class="font-semibold text-blue-900">Lesson:</span> {cs.lesson}</p>
          </div>
        ))}
      </div>

      <h2 class="text-2xl font-bold text-blue-900 mt-8 mb-4">10-Step Escalation Checklist: From Hospital Desk to Ombudsman</h2>
      <div class="space-y-3">
        {ESCALATION_CHECKLIST.map((item, i) => (
          <div key={i} class="bg-white border border-slate-200 rounded-lg p-4 text-slate-700">{item}</div>
        ))}
      </div>

      <h2 class="text-2xl font-bold text-blue-900 mt-8 mb-4">Frequently Asked Questions</h2>
      <div class="space-y-3 not-prose">
        {FAQS.map((item) => (
          <details key={item.question} class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
            <summary class="p-5 cursor-pointer font-semibold text-slate-900 hover:bg-slate-50 list-none">{item.question}</summary>
            <div class="px-5 pb-5"><p class="text-slate-600 leading-relaxed">{item.answer}</p></div>
          </details>
        ))}
      </div>

      <div class="mt-12 bg-gradient-to-r from-blue-600 to-indigo-600 p-8 rounded-2xl text-white text-center">
        <h2 class="text-2xl font-bold mb-3">Cashless Denied? Stuck at Hospital Desk?</h2>
        <p class="text-blue-100 mb-6">I guide families through real-time cashless escalation. Available on WhatsApp during hospital hours.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20cashless%20denied%20at%20hospital.%20Need%20urgent%20help." target="_blank" rel="noopener noreferrer" class="bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-6 rounded-lg transition-colors">
            WhatsApp for Urgent Help
          </a>
          <a href="tel:+919986634506" class="bg-white hover:bg-blue-50 text-blue-900 font-bold py-3 px-6 rounded-lg transition-colors">
            Call +91-99866 34506
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>