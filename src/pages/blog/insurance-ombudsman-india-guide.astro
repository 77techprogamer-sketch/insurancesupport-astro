  { city: "Chennai", address: "Office of the Insurance Ombudsman, 3rd Floor, No.24, Kachukonda Street, Navallur, Chennai – 600130", phone: "044-27444200" },
  { city: "Delhi", address: "Office of the Insurance Ombudsman, 2nd Floor, 459-460, Dr. B. R. Ambedkar Marg, Opp. Hanuman Mandir, Rajinder Nagar, New Delhi – 110060", phone: "011-27416652" },
  { city: "Guwahati", address: "Office of the Insurance Ombudsman, 'Swaraj' Building, 2nd Floor, G & K Avenue, Near Bengbazar, Fancy Bazar, Guwahati – 781001", phone: "0361-2733143" },
  { city: "Hyderabad", address: "Office of the Insurance Ombudsman, 6-2-46, 1st Floor, M. J. Road, Near South Indian Hotel, AC Guards, Hyderabad – 500004", phone: "040-23312122" },
  { city: "Jaipur", address: "Office of the Insurance Ombudsman, Ground Floor, Jeevan Nidhi-II, Bhawani Singh Road, Near折to Ram Mandir, Amer Road, Jaipur – 302005", phone: "0141-2741871" },
  { city: "Kolkata", address: "Office of the Insurance Ombudsman, 4th Floor, Hindustan Building, 4th Floor, 2nd Cross Street, Sovaram B. N. Street, Kolkata – 700007", phone: "033-25638923" },
  { city: "Mumbai", address: "Office of the Insurance Ombudsman, 3rd Floor, Hind Tata Road, Near Century Bazar, Near Seawoods Cross Road, Sector 11, Nerul, Navi Mumbai – 400706", phone: "022-27612852" },
  { city: "Pune", address: "Office of the Insurance Ombudsman, 3rd Floor, 117, Karve Road, Near折to Deccan, Kothrud, Pune – 411038", phone: "020-27409470" },
];
---

<BaseLayout
  title={TITLE}
  description={DESCRIPTION}
  keywords={KEYWORDS}
  canonical={CANONICAL_URL}
>
  <main id="main" class="max-w-4xl mx-auto px-4 py-16">
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/blog" class="hover:text-blue-600">Blog</a>
      <span class="mx-2">/</span>
      <span class="text-slate-700">Insurance Ombudsman Guide</span>
    </nav>

    <h1 class="text-4xl md:text-5xl font-extrabold text-blue-900 mb-6">{TITLE}</h1>
    <p class="text-sm text-slate-500 mb-8">By {AUTHOR_NAME} | Published on {PUBLISH_DATE}</p>

    <p class="text-lg text-slate-700 leading-relaxed mb-8">
      The Insurance Ombudsman is a free, quasi-judicial forum for resolving policyholders' disputes 
      with insurance companies. If you have exhausted all internal grievance channels and still 
      received no satisfaction, the Ombudsman is your next powerful step.
    </p>

    <h2 class="text-3xl font-bold text-slate-900 mb-4">Eligibility: When Can You Approach the Ombudsman?</h2>
    <p class="text-slate-700 mb-4">
      You can file a complaint with the Insurance Ombudsman if:
    </p>
    <ul class="list-disc list-inside text-slate-700 mb-6 space-y-1">
      <li>The dispute value is <strong>up to Rs. 30 lakhs</strong> (for 2024-26 cycle).</li>
      <li>The grievance has been already been raised with the insurer and <strong>30 days have passed</strong> without a satisfactory resolution.</li>
      <li>The complaint is not being heard in any other forum or court.</li>
    </ul>

    <h2 class="text-3xl font-bold text-slate-900 mb-4">How to File an Ombudsman Complaint</h2>
    <ol class="space-y-4 text-slate-700 mb-8">
      <li><strong>Step 1: Write a complaint letter</strong> — Clearly state the facts, the amount claimed, the rejection reason, and the relief sought.</li>
      <li><strong>Step 2: Attach all supporting documents</strong> — Policy document, rejection letter, grievance reference number, all correspondence with the insurer.</li>
      <li><strong>Step 3: Submit online or offline</strong> — File via the <strong>IOB portal</strong> (https://www.cioins.co.in/complaint) or submit physically at the nearest Ombudsman office.</li>
      <li><strong>Step 4: Await hearing notice</strong> — The Ombudsman will schedule a hearing within 15 days and issue a decision within 30 days.</li>
      <li><strong>Step 5: Receive decision</strong> — The Ombudsman's decision is <strong>binding on the insurance company</strong> but not on you — you can still approach a court if unsatisfied.</li>
    </ol>

    <h2 class="text-3xl font-bold text-slate-900 mb-4">Insurance Ombudsman Offices in India</h2>
    <div class="space-y-4 mb-8">
      {OMBUDSMEN_OFFICES.map((office) => (
        <div class="bg-white border border-slate-200 rounded-lg p-4">
          <h3 class="font-bold text-blue-900">{office.city}</h3>
          <p class="text-sm text-slate-600 mt-1">{office.address}</p>
          <p class="text-sm text-slate-500 mt-1">Phone: {office.phone}</p>
        </div>
      ))}
    </div>

    <div class="bg-blue-900 p-8 rounded-2xl text-white text-center">
      <h2 class="text-2xl font-bold mb-3">Need Help Filing Your Ombudsman Complaint?</h2>
      <p class="text-blue-100 mb-6">I have helped clients win Ombudsman cases. Let me review your case and prepare the strongest possible complaint.</p>
      <a href="https://wa.me/919986634506" class="inline-block bg-amber-400 text-slate-900 font-bold py-3 px-6 rounded-lg hover:bg-amber-300 transition-colors">
        WhatsApp for Expert Help
      </a>
    </div>
  </main>
</BaseLayout>