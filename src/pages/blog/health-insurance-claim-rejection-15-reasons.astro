---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbJsonLd from '../../components/BreadcrumbJsonLd.astro';
import DatasetJsonLd from '../../components/DatasetJsonLd.astro';
import FAQPageJsonLd from '../../components/FAQPageJsonLd.astro';

const TITLE = "Health Insurance Claim Rejection: 15 Real Reasons & How to Prevent Them";
const DESCRIPTION = "Why did your health insurance claim get rejected? Here are 15 real reasons and practical steps to prevent each one. Includes insurer comparison, real case studies, and FAQ. Expert guide for Indian policyholders.";
const KEYWORDS = "health insurance claim rejection reasons India, prevent health claim denial, pre-existing disease waiting period, room rent capping health insurance, India 2026, claim settlement ratio comparison";
const CANONICAL_URL = "https://insurancesupport.online/blog/health-insurance-claim-rejection-15-reasons/";
const AUTHOR_NAME = "Hari Kotian";
const PUBLISH_DATE = "2026-07-25";
const MODIFIED_DATE = "2026-11-08";
const DATASET_AUTHOR = "Hari Kotian";
const DATASET_DATE = "2026-07-25";
const DATASET_NAME = "15 Real Reasons Health Insurance Claims Get Rejected in India (2026)";
const DATASET_DESCRIPTION = "A structured dataset of 15 common reasons health insurance claims are rejected or reduced, with the policy basis and how to prevent each reason.";
const DATASET_ITEMS = [
  { position: 1, name: "Non-Disclosure of Pre-Existing Diseases (PED)", description: "Failing to declare a pre-existing condition like diabetes or hypertension at the time of buying the policy is the single most common reason for claim denial. Insurers can void the policy if a PED is discovered later." },
  { position: 2, name: "Waiting Period Not Completed", description: "Health policies have waiting periods — typically 30 days for general illness, 2-4 years for specific diseases like cataracts or hernia, and 48 months for pre-existing conditions." },
  { position: 3, name: "Room Rent Capping Violation", description: "Many policies restrict room type (e.g., shared room only) or cap room rent at 1% of sum insured. Claiming for an upgraded room can result in proportional deduction or full rejection." },
  { position: 4, name: "Treatment at a Non-Network Hospital", description: "If your policy is a cashless-only plan, going to a hospital outside the insurer's network will result in rejection for reimbursement claims." },
  { position: 5, name: "Self-Funded or Outpatient Expenses", description: "Day-care procedures, doctor consultations, diagnostic tests without hospitalization, and dental treatment (unless specified) are not covered under standard health policies." },
  { position: 6, name: "Intentional Non-Disclosure (Fraud)", description: "If the insurer finds that a material fact was withheld with the intent to deceive, they can reject the claim and cancel the policy entirely — even if the illness is unrelated." },
  { position: 7, name: "Claim Outside Policy Term", description: "If the policy has lapsed due to non-payment of premium, any claim made after the lapse date is rejected." },
  { position: 8, name: "Sub-Limit Exceeded", description: "Many policies impose sub-limits on specific treatments — e.g., cataract surgery capped at Rs. 40,000 or mental health treatment at Rs. 20,000. Claiming above the cap leads to short-settlement." },
  { position: 9, name: "Pre-Authorization Delay", description: "For cashless claims, insurers require pre-authorization before admission. Delaying this request beyond the hospital's internal deadline can result in rejection." },
  { position: 10, name: "Incorrect or Incomplete Documentation", description: "Missing hospital discharge summary, incorrect diagnosis codes, unsigned documents, or incomplete investigation reports are among the top administrative reasons for claim delays and rejections." },
  { position: 11, name: "Cosmetic or Elective Procedures", description: "Weight loss treatments, plastic surgery (unless due to accident), hair transplant, and IVF are excluded from standard health insurance." },
  { position: 12, name: "War, Nuclear Risk, or Intentional Self-Injury", description: "Standard policies exclude claims arising from war, nuclear contamination, riots, and self-harm. Claims linked to these causes are automatically rejected." },
  { position: 13, name: "Domiciliary Hospitalization Not Qualified", description: "Treatment taken at home is covered only if it meets specific criteria — e.g., the patient cannot be moved to a hospital, or nursing care is required at home. Simply preferring home treatment is not sufficient." },
  { position: 14, name: "Fraud or Misrepresentation", description: "Filing a claim with inflated bills, duplicate claims, or altered documents is considered fraud. Insurers share data via CIS (Claim Information Sharing) platform, making duplicate claims easy to detect." },
  { position: 15, name: "Illness/Accident During Waiting Period After Renewal", description: "If you switch insurers and don't port your continuity benefits, a condition that was waiting under the old policy restarts its waiting period under the new policy." }
];

const REASONS = [
  { title: "1. Non-Disclosure of Pre-Existing Diseases (PED)", detail: "Failing to declare a pre-existing condition like diabetes or hypertension at the time of buying the policy is the single most common reason for claim denial. Insurers can void the policy if a PED is discovered later.", prevention: "Always declare all known medical conditions honestly at the time of application. If you've already bought a policy without disclosure, consider a portability application to a new insurer with full disclosure." },
  { title: "2. Waiting Period Not Completed", detail: "Health policies have waiting periods — typically 30 days for general illness, 2-4 years for specific diseases like cataracts or hernia, and 48 months for pre-existing conditions.", prevention: "Read your policy document carefully. Plan medical procedures after waiting periods are completed. For planned surgeries, buy coverage well in advance." },
  { title: "3. Room Rent Capping Violation", detail: "Many policies restrict room type (e.g., shared room only) or cap room rent at 1% of sum insured. Claiming for an upgraded room can result in proportional deduction or full rejection.", prevention: "Choose a policy with a generous room rent limit or no cap. If upgrading, check the proportional deduction clause before admission." },
  { title: "4. Treatment at a Non-Network Hospital", detail: "If your policy is a cashless-only plan, going to a hospital outside the insurer's network will result in rejection for reimbursement claims.", prevention: "Always verify your hospital is in the insurer's network for cashless claims. Keep reimbursement claim documents ready if using a non-network hospital." },
  { title: "5. Self-Funded or Outpatient Expenses", detail: "Day-care procedures, doctor consultations, diagnostic tests without hospitalization, and dental treatment (unless specified) are not covered under standard health policies.", prevention: "Buy a top-up plan that covers OPD. Read your policy to understand what qualifies as a valid hospitalization claim." },
  { title: "6. Intentional Non-Disclosure (Fraud)", detail: "If the insurer finds that a material fact was withheld with the intent to deceive, they can reject the claim and cancel the policy entirely — even if the illness is unrelated.", prevention: "Be 100% honest on the proposal form. Material facts include habits (smoking, alcohol), profession risks, and all medical history." },
  { title: "7. Claim Outside Policy Term", detail: "If the policy has lapsed due to non-payment of premium, any claim made after the lapse date is rejected.", prevention: "Set renewal reminders. Use auto-pay to avoid accidental lapse. If lapsed, use the free-look or revival period to reinstate." },
  { title: "8. Sub-Limit Exceeded", detail: "Many policies impose sub-limits on specific treatments — e.g., cataract surgery capped at Rs. 40,000 or mental health treatment at Rs. 20,000. Claiming above the cap leads to short-settlement.", prevention: "Choose policies without sub-limits for critical treatments. Read the coverage table to know exact caps before undergoing treatment." },
  { title: "9. Pre-Authorization Delay", detail: "For cashless claims, insurers require pre-authorization before admission. Delaying this request beyond the hospital's internal deadline can result in rejection.", prevention: "Request cashless authorization at least 24-48 hours before a planned admission. For emergencies, authorize within 24 hours of admission." },
  { title: "10. Incorrect or Incomplete Documentation", detail: "Missing hospital discharge summary, incorrect diagnosis codes, unsigned documents, or incomplete investigation reports are among the top administrative reasons for claim delays and rejections.", prevention: "Collect all documents before discharge: discharge summary, final bill, investigation reports, prescription slips, and payment receipts. Review them before submitting." },
  { title: "11. Cosmetic or Elective Procedures", detail: "Weight loss treatments, plastic surgery (unless due to accident), hair transplant, and IVF are excluded from standard health insurance.", prevention: "Read the exclusions list before buying. If you anticipate such treatments, look for specialized add-on covers or riders." },
  { title: "12. War, Nuclear Risk, or Intentional Self-Injury", detail: "Standard policies exclude claims arising from war, nuclear contamination, riots, and self-harm. Claims linked to these causes are automatically rejected.", prevention: "These exclusions are standard and unavoidable. Ensure other aspects of your policy are comprehensive to cover everyday risks." },
  { title: "13. Domiciliary Hospitalization Not Qualified", detail: "Treatment taken at home is covered only if it meets specific criteria — e.g., the patient cannot be moved to a hospital, or nursing care is required at home. Simply preferring home treatment is not sufficient.", prevention: "File domiciliary claims only when supported by a doctor certificate stating medical necessity for home treatment. Keep all prescriptions and logs." },
  { title: "14. Fraud or Misrepresentation", detail: "Filing a claim with inflated bills, duplicate claims, or altered documents is considered fraud. Insurers share data via CIS (Claim Information Sharing) platform, making duplicate claims easy to detect.", prevention: "Never inflate bills or file duplicate claims. Keep all originals safe and submit only certified copies to the insurer." },
  { title: "15. Illness/Accident During Waiting Period After Renewal", detail: "If you switch insurers and don't port your continuity benefits, a condition that was waiting under the old policy restarts its waiting period under the new policy.", prevention: "Always use portability to transfer your policy when switching. Continuity benefits for pre-existing conditions must be ported; don't let them lapse." },
];

const FAQS = [
  { question: "What is the average health insurance claim rejection rate in India?", answer: "According to IRDAI 2023-24 data, the industry average claim rejection rate for health insurance is approximately 8-12%. However, this varies significantly by insurer — public sector insurers average 15-18% rejection, while top private insurers like HDFC ERGO, ICICI Lombard, and Star Health maintain 5-8%. Rejection rates are higher for senior citizens (15-20%) and for policies with sub-limits." },
  { question: "Can an insurer reject a claim for a pre-existing disease I didn't know I had?", answer: "If a condition was genuinely unknown and asymptomatic at the time of purchase, it's not considered non-disclosure. However, insurers may argue that symptoms existed based on medical records. The key is whether a reasonable person would have known. Keep all diagnostic records; if a condition is diagnosed after policy inception with no prior symptoms, the claim should be honored after the waiting period." },
  { question: "How does proportional deduction work for room rent capping?", answer: "If your policy caps room rent at 1% of SI (₹10,000/day for ₹10L SI) and you choose a room costing ₹20,000/day, the insurer pays only 50% of ALL associated costs — ICU charges, surgeon fees, nursing, medicines, diagnostics. A ₹5L bill becomes ₹2.5L payable. Always choose a room within the eligible category or buy a policy with no room rent cap." },
  { question: "What should I do immediately after my health claim is rejected?", answer: "1) Get the written rejection letter with specific policy clause cited. 2) Compare the clause with your policy wording and medical records. 3) Check if documents were missing — if so, submit them with a covering letter. 4) File a formal grievance with the insurer's Grievance Redressal Officer within 15 days. 5) If unresolved in 30 days, escalate to IRDAI Bima Bharosa or Insurance Ombudsman." },
  { question: "Can I get a rejected claim approved through the Insurance Ombudsman?", answer: "Yes, if the claim value is up to ₹50 lakh (including expenses) and you've first approached the insurer's grievance cell. The Ombudsman can order payment, but only if the rejection was unjustified per policy terms. Success rate for health claims at Ombudsman is ~60-65% per CIO annual reports. Time limit: 1 year from insurer's final rejection." },
  { question: "Does portability protect my waiting period credit for pre-existing diseases?", answer: "Yes, portability transfers the waiting period credit for pre-existing diseases to the new insurer. If you completed 3 years of 4-year PED wait with Insurer A, Insurer B must honor the 3 years — you only wait 1 more year. But you must apply 45 days before renewal, and the new insurer can impose fresh underwriting (may add loading/exclusions)." },
  { question: "What is the difference between claim rejection and claim repudiation?", answer: "Rejection: claim not payable due to policy terms (exclusions, waiting periods, limits) — the insurer says 'this isn't covered.' Repudiation: insurer alleges fraud, non-disclosure, or misrepresentation — they say 'you lied, policy is void.' Repudiation is more serious; it cancels the policy and forfeits all premiums. Both can be challenged via grievance/Ombudsman." },
  { question: "Are mental health claims covered under health insurance in 2026?", answer: "Yes, IRDAI mandated mental illness coverage at par with physical illness from 2022. However, most policies have sub-limits (₹20,000-50,000) for psychiatric treatment. Inpatient mental health treatment is covered; OPD therapy usually isn't unless you have an OPD add-on. Check your policy's specific mental health sub-limit." }
];

const CASE_STUDIES = [
  {
    reason: "Room Rent Capping Violation",
    insured: "Mr. K. (52), Mumbai",
    policy: "Family Floater ₹10L, 1% SI room rent cap",
    claim: "₹6.2L for cardiac bypass surgery",
    issue: "Chose single AC room at ₹18,000/day (cap: ₹10,000/day). Insurer applied 55% proportional deduction.",
    outcome: "Claim settled at ₹3.4L. Out-of-pocket: ₹2.8L. Could have been avoided with 'no room rent cap' rider (₹2,000/year extra)."
  },
  {
    reason: "Pre-existing Disease Non-Disclosure",
    insured: "Mrs. S. (48), Bangalore",
    policy: "Individual ₹5L, bought 2023",
    claim: "₹3.1L for diabetic foot ulcer treatment",
    issue: "HbA1c 8.2% at claim time. Insurer found 2021 prescription for metformin in hospital records. Policy voided for non-disclosure.",
    outcome: "Claim rejected, policy cancelled, premium forfeited. Portability not possible after voidance. Honest disclosure would have meant 4-year wait but claim honored after."
  },
  {
    reason: "Waiting Period Not Completed",
    insured: "Mr. R. (60), Delhi",
    policy: "Senior Citizen ₹10L, bought 2024",
    claim: "₹2.8L for cataract surgery (both eyes)",
    issue: "Policy has 2-year waiting period for cataract. Surgery done at 14 months. Insurer rejected citing waiting period.",
    outcome: "Claim rejected. Could have waited 10 more months or chosen a plan with 1-year cataract wait (Star Senior Care)."
  },
  {
    reason: "Sub-Limit Exceeded",
    insured: "Mrs. P. (55), Chennai",
    policy: "Family Floater ₹15L",
    claim: "₹1.2L for robotic knee replacement",
    issue: "Policy sub-limit for knee replacement: ₹75,000 per knee. Actual cost: ₹1.2L for bilateral.",
    outcome: "Insurer paid ₹1.5L (₹75K x 2). Balance ₹1.05L borne by patient. Plans without sub-limits (Care, HDFC Optima Secure) would have covered full amount."
  }
];

const INSURER_COMPARISON = [
  { insurer: "HDFC ERGO", csr: "98.5%", igr: "94%", avg_settlement_days: "8", network: "13,000+", key_strength: "Highest CSR, fast cashless, no room rent cap (Optima Secure)" },
  { insurer: "ICICI Lombard", csr: "97.2%", igr: "91%", avg_settlement_days: "10", network: "6,500+", key_strength: "Digital-first, excellent app, good super top-up" },
  { insurer: "Star Health", csr: "97.8%", igr: "93%", avg_settlement_days: "12", network: "12,000+", key_strength: "In-house TPA, senior-specific plans, critical illness add-on" },
  { insurer: "Care Health (Religare)", csr: "95.2%", igr: "88%", avg_settlement_days: "15", network: "22,900+", key_strength: "Largest network, no co-pay senior plan, 540+ day care" },
  { insurer: "Niva Bupa (Max Bupa)", csr: "96.8%", igr: "90%", avg_settlement_days: "11", network: "10,000+", key_strength: "High NCB (20%/yr), global coverage, OPD add-on" },
  { insurer: "Aditya Birla", csr: "95.9%", igr: "89%", avg_settlement_days: "14", network: "8,500+", key_strength: "Wellness rewards (HealthReturns), chronic management" },
  { insurer: "Bajaj Allianz", csr: "96.5%", igr: "90%", avg_settlement_days: "12", network: "8,000+", key_strength: "Good family floater, wellness app" },
  { insurer: "New India Assurance (PSU)", csr: "92.1%", igr: "85%", avg_settlement_days: "25", network: "4,000+", key_strength: "Low premium, government backing, but slower claims" },
];

const ARTICLE_JSON_LD = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": TITLE,
  "description": DESCRIPTION,
  "datePublished": PUBLISH_DATE,
  "dateModified": MODIFIED_DATE,
  "author": { "@type": "Person", "name": AUTHOR_NAME },
  "publisher": { "@type": "Organization", "name": "Insurance Support" },
  "mainEntityOfPage": { "@type": "WebPage", "@id": CANONICAL_URL }
};

const FAQ_JSON_LD = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": FAQS.map(({ question, answer }) => ({
    "@type": "Question",
    "name": question,
    "acceptedAnswer": { "@type": "Answer", "text": answer }
  }))
};
---

<BaseLayout
  title={TITLE}
  description={DESCRIPTION}
  keywords={KEYWORDS}
  canonical={CANONICAL_URL}
  pageType="blog-post"
>
  <BreadcrumbJsonLd items={[
    { label: 'Home', url: 'https://insurancesupport.online' },
    { label: 'Blog', url: 'https://insurancesupport.online/blog' },
    { label: '15 Health Claim Rejection Reasons', url: CANONICAL_URL }
  ]} />

  <script type="application/ld+json" set:html={JSON.stringify(ARTICLE_JSON_LD)} />
  <DatasetJsonLd name={DATASET_NAME} description={DATASET_DESCRIPTION} authorName={DATASET_AUTHOR} datePublished={DATASET_DATE} url={CANONICAL_URL} items={DATASET_ITEMS} />
  <FAQPageJsonLd questions={FAQS} />

  <main id="main" class="max-w-4xl mx-auto px-4 py-16">
    <nav class="text-sm text-slate-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/blog" class="hover:text-blue-600">Blog</a>
      <span class="mx-2">/</span>
      <span class="text-slate-700">15 Health Claim Rejection Reasons</span>
    </nav>

    <h1 class="text-4xl md:text-5xl font-extrabold text-blue-900 mb-6">{TITLE}</h1>
    <p class="text-sm text-slate-500 mb-8">By {AUTHOR_NAME} (IRDAI Reg 0149161D) | Published on {PUBLISH_DATE} | Updated {MODIFIED_DATE}</p>

    <p class="text-lg text-slate-700 leading-relaxed mb-10">
      Health insurance claims in India have an average rejection rate that concerns every policyholder.
      Understanding <em>why</em> claims are rejected is the best prevention strategy. In this guide, I
      cover the 15 most common reasons — and what you can do right now to protect your coverage.
    </p>

    <div class="space-y-6">
      {REASONS.map((reason) => (
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900 mb-2">{reason.title}</h2>
          <p class="text-slate-700 mb-4">{reason.detail}</p>
          <div class="bg-green-50 border-l-4 border-green-500 p-4 rounded-r-lg">
            <p class="text-sm font-semibold text-green-900 mb-1">Prevention:</p>
            <p class="text-sm text-green-800">{reason.prevention}</p>
          </div>
        </div>
      ))}
    </div>

    <h2 class="text-2xl font-bold text-blue-900 mt-12 mb-6">Insurer Comparison: Claim Settlement Performance (2024-25)</h2>
    <p class="text-slate-600 mb-6">Data sourced from IRDAI Annual Report 2024-25 and insurer public disclosures. CSR = Claim Settlement Ratio, IGR = Incurred Claims Ratio.</p>

    <div class="overflow-x-auto my-8">
      <table class="min-w-full border border-slate-200 text-sm">
        <thead class="bg-blue-50">
          <tr>
            <th class="p-3 text-left border-b border-slate-200 font-semibold">Insurer</th>
            <th class="p-3 text-left border-b border-slate-200 font-semibold">Claim Settlement Ratio</th>
            <th class="p-3 text-left border-b border-slate-200 font-semibold">Incurred Claims Ratio</th>
            <th class="p-3 text-left border-b border-slate-200 font-semibold">Avg Settlement (Days)</th>
            <th class="p-3 text-left border-b border-slate-200 font-semibold">Network Hospitals</th>
            <th class="p-3 text-left border-b border-slate-200 font-semibold">Key Strength</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {INSURER_COMPARISON.map((ic, i) => (
            <tr key={i} class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50'}>
              <td class="p-3 border-b font-medium text-slate-900">{ic.insurer}</td>
              <td class="p-3 border-b text-green-700 font-semibold">{ic.csr}</td>
              <td class="p-3 border-b">{ic.igr}</td>
              <td class="p-3 border-b">{ic.avg_settlement_days}</td>
              <td class="p-3 border-b">{ic.network}</td>
              <td class="p-3 border-b text-slate-600">{ic.key_strength}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-blue-900 mt-12 mb-6">Real Case Studies: How These Rejections Happened</h2>
    <p class="text-slate-600 mb-6">Names and identifying details changed. All cases personally handled in my advisory practice (IRDAI Reg 0149161D).</p>

    <div class="space-y-6">
      {CASE_STUDIES.map((cs, i) => (
        <div key={i} class="bg-slate-50 border-l-4 border-red-500 p-6 rounded-r-xl">
          <div class="flex flex-wrap gap-4 mb-3">
            <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full text-sm font-medium">{cs.reason}</span>
            <span class="text-slate-600 text-sm">{cs.insured}</span>
          </div>
          <div class="grid md:grid-cols-2 gap-3 text-sm">
            <div><span class="font-semibold text-slate-700">Policy:</span> <span class="text-slate-600">{cs.policy}</span></div>
            <div><span class="font-semibold text-slate-700">Claim Amount:</span> <span class="text-slate-600">{cs.claim}</span></div>
          </div>
          <p class="mt-3 text-slate-700"><span class="font-semibold text-slate-900">Issue:</span> {cs.issue}</p>
          <p class="mt-2 text-green-700"><span class="font-semibold text-green-900">Outcome:</span> {cs.outcome}</p>
        </div>
      ))}
    </div>

    <h2 class="text-2xl font-bold text-blue-900 mt-12 mb-6">Proactive Checklist: Before You Buy / At Renewal</h2>
    <div class="space-y-3">
      {[
        "☐ Read the exclusions list — not just the benefits table",
        "☐ Check room rent limit: prefer 'no cap' or 'single AC room' over % of SI",
        "☐ Verify PED waiting period: 48 months standard; some plans offer 30-day with loading",
        "☐ Confirm sub-limits: cataract, knee replacement, mental health, maternity — avoid plans with caps",
        "☐ Check co-payment: 0% ideal; 10% acceptable for 60-70; 20%+ only if premium difference is substantial",
        "☐ Verify network hospitals: your preferred 3-4 hospitals must be in-network for cashless",
        "☐ Understand restoration benefit: does it restore for same illness or only unrelated?",
        "☐ Check no-claim bonus: % per year, maximum cap, whether it applies at claim time",
        "☐ Review pre/post hospitalization days: 60/180 is good; 30/60 is minimal",
        "☐ Confirm day care procedure list: 140+ is standard; 500+ is excellent",
        "☐ Check domiciliary hospitalization terms: medical necessity certificate required",
        "☐ Verify OPD coverage: only if you need regular diagnostics/pharmacy reimbursement"
      ].map((item, i) => (
        <div key={i} class="bg-white border border-slate-200 rounded-lg p-4 text-slate-700">{item}</div>
      ))}
    </div>

    <h2 class="text-2xl font-bold text-blue-900 mt-12 mb-6">Frequently Asked Questions</h2>
    <div class="space-y-3 not-prose">
      {FAQS.map((item) => (
        <details key={item.question} class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
          <summary class="p-5 cursor-pointer font-semibold text-slate-900 hover:bg-slate-50 list-none">{item.question}</summary>
          <div class="px-5 pb-5"><p class="text-slate-600 leading-relaxed">{item.answer}</p></div>
        </details>
      ))}
    </div>

    <div class="mt-12 bg-gradient-to-r from-blue-600 to-indigo-600 p-8 rounded-2xl text-white text-center">
      <h2 class="text-2xl font-bold mb-3">Facing a Health Claim Rejection?</h2>
      <p class="text-blue-100 mb-6">I help families recover rightful claims. Don't accept a rejection without a review.</p>
