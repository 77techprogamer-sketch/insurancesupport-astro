---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import posts from '../../../data/blogs.json';


const POSTS_PER_PAGE = 12;
const sorted = posts.sort((a, b) => new Date(b.date) - new Date(a.date));
const totalPages = Math.ceil(sorted.length / POSTS_PER_PAGE);

// NOTE: getStaticPaths is hoisted above module-level consts by the Astro
// compiler, so it must NOT reference POSTS_PER_PAGE/sorted/totalPages
// (temporal dead zone). It computes everything from the imported data.
export function getStaticPaths() {
  const POSTS_PER_PAGE_LOCAL = 12;
  const sortedPosts = posts.slice().sort((a, b) => new Date(b.date) - new Date(a.date));
  const total = Math.ceil(sortedPosts.length / POSTS_PER_PAGE_LOCAL);
  const paths = [];
  for (let page = 2; page <= total; page++) {
    paths.push({ params: { page: String(page) }, props: { page } });
  }
  return paths;
}

const { page } = Astro.props;
const pageNum = Number(page);
const start = (pageNum - 1) * POSTS_PER_PAGE;
const end = start + POSTS_PER_PAGE;
const pagePosts = sorted.slice(start, end);
const hasPrev = pageNum > 1;
const hasNext = pageNum < totalPages;
const prevUrl = pageNum === 2 ? '/blog/' : `/blog/page/${pageNum - 1}/`;
const nextUrl = hasNext ? `/blog/page/${pageNum + 1}/` : null;
---

<BaseLayout title={`Insurance Blog — Page ${pageNum} of ${totalPages} | Hari Kotian`} description={`Expert insurance guides, claim process tips, and IRDAI updates from Hari Kotian. Page ${pageNum} of ${totalPages}.`}>

  <main id="main" class="page-transition">

    <!-- Hero (compact) -->
    <section class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 text-white py-12 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px]" />
      <div class="max-w-6xl mx-auto px-4 text-center relative">
        <h1 class="text-3xl md:text-4xl font-extrabold mb-2">Insurance Guides & Insights</h1>
        <p class="text-blue-100/70">Page {pageNum} of {totalPages} — {sorted.length} articles total</p>
      </div>
    </section>

    <div class="max-w-6xl mx-auto px-4 py-12">

      <!-- Blog Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {pagePosts.map((post, i) => (
          <a href={`/blog/${post.slug}`} class="group block bg-white rounded-xl border border-slate-200 overflow-hidden hover:shadow-xl hover:border-blue-200 transition-all duration-300 card-hover" style={`transition-delay: ${i * 0.05}s`}>
            <div class="h-1.5 bg-gradient-to-r from-blue-500 to-indigo-500" />
            <div class="p-6">
              <div class="flex flex-wrap gap-1.5 mb-3">
                {(post.categories || []).slice(0, 2).map(cat => (
                  <span class="px-2 py-0.5 bg-blue-50 text-blue-600 text-[10px] font-semibold rounded-md uppercase tracking-wide">{cat}</span>
                ))}
              </div>
              <h2 class="text-lg font-bold text-slate-900 mb-2 leading-snug group-hover:text-blue-600 transition-colors line-clamp-3">
                {post.title}
              </h2>
              <p class="text-sm text-slate-500 leading-relaxed mb-4 line-clamp-3">
                {post.summary}
              </p>
              <div class="flex items-center justify-between pt-3 border-t border-slate-100">
                <span class="text-xs text-slate-400">{post.date}</span>
                <span class="text-xs font-semibold text-blue-600 flex items-center gap-1 group-hover:gap-2 transition-all">
                  Read More
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Pagination -->
      <nav class="mt-12 flex items-center justify-between" aria-label="Blog pagination">
        {hasPrev ? (
          <a href={prevUrl} class="inline-flex items-center gap-2 px-6 py-3 bg-white border border-slate-200 text-slate-700 font-semibold rounded-full hover:border-blue-300 hover:text-blue-600 transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
            Newer Posts
          </a>
        ) : <span />}
        <span class="text-sm text-slate-400">Page {pageNum} of {totalPages}</span>
        {hasNext ? (
          <a href={nextUrl} class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white font-semibold rounded-full hover:bg-blue-700 transition-colors shadow-sm">
            Older Posts
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        ) : <span />}
      </nav>

      <!-- Page Number Links -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
        {Array.from({ length: totalPages }, (_, i) => i + 1).map(p => (
          <a
            href={p === 1 ? '/blog/' : `/blog/page/${p}/`}
            class:list={[
              'w-9 h-9 flex items-center justify-center rounded-lg text-sm font-medium transition-colors',
              p === pageNum
                ? 'bg-blue-600 text-white'
                : 'bg-white border border-slate-200 text-slate-600 hover:border-blue-300 hover:text-blue-600'
            ]}
            aria-current={p === pageNum ? 'page' : undefined}
          >
            {p}
          </a>
        ))}
      </div>

      <!-- Bottom CTA -->
      <div class="mt-16 text-center">
        <div class="bg-gradient-to-br from-slate-50 to-blue-50/50 rounded-2xl p-8 md:p-10 border border-slate-100">
          <h3 class="text-xl md:text-2xl font-extrabold text-slate-900 mb-3">Have a specific insurance question?</h3>
          <p class="text-slate-600 mb-6">Get personalized answers from Hari Kotian, IRDAI certified advisor with 25+ years of experience.</p>
          <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-900 font-bold rounded-full text-lg shadow-lg shadow-amber-500/25 hover:shadow-xl hover:scale-105 transition-all btn-glow">
            Consult Hari Kotian
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>
      </div>
    </div>
  </main>

</BaseLayout>
