---
import BaseLayout from '../../layouts/BaseLayout.astro';

const TITLE = "LIC Jeevan Labh Maturity Calculator: Calculate Your Returns (2026 Guide)";
const DESCRIPTION = "Understand how to calculate the maturity amount for your LIC Jeevan Labh policy. Use our simple guide and examples for 2026 bonus rates.";
const KEYWORDS = "LIC Jeevan Labh maturity calculator, Jeevan Labh returns, LIC policy benefits, LIC bonus rates 2026, Jeevan Labh example";
const CANONICAL_URL = "https://insurancesupport.online/blog/lic-jeevan-labh-maturity-calculator-guide";
const AUTHOR_NAME = "Hari Kotian";
const PUBLISH_DATE = "2026-07-25"; // Today's date
const MODIFIED_DATE = "2026-06-28";

const FAQ_SCHEMA = [
  {
    "@type": "Question",
    "name": "What is LIC Jeevan Labh policy?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "LIC Jeevan Labh (Plan No. 936) is a limited premium paying, non-linked, participating, individual life assurance savings plan. It offers a combination of protection and savings, providing financial support for the family in case of unfortunate demise of the policyholder before maturity and a lumpsum amount at the time of maturity for the surviving policyholder."
    }
  },
  {
    "@type": "Question",
    "name": "How is the Jeevan Labh maturity amount calculated?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "The maturity amount for LIC Jeevan Labh is calculated as: Sum Assured on Maturity + Vested Simple Reversionary Bonuses + Final Additional Bonus (if any). The Sum Assured on Maturity is equal to the Basic Sum Assured. Bonuses depend on LIC’s profits and are declared annually."
    }
  },
  {
    "@type": "Question",
    "name": "What are Simple Reversionary Bonuses (SRB)?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Simple Reversionary Bonuses are declared per Rs. 1000 of Sum Assured by LIC every year. Once declared, they are guaranteed to be paid at maturity or death. They accumulate over the policy term."
    }
  },
  {
    "@type": "Question",
    "name": "Is there a Final Additional Bonus (FAB) in Jeevan Labh?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "A Final Additional Bonus (FAB) may be declared by LIC at the time of policy maturity or death claim, provided the policy has run for a certain minimum number of years (usually 15 years or more). FAB is a one-time bonus and is not guaranteed."
    }
  },
  {
    "@type": "Question",
    "name": "How can I get a precise maturity calculation for my policy?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "For a precise and personalized maturity calculation based on your specific policy details (Basic Sum Assured, policy term, premium paying term, and actual bonus rates applicable to your policy), it is best to contact an IRDAI-certified LIC agent like Hari Kotian. You can also check your annual LIC statement or log in to the LIC India portal."
    }
  }
];
