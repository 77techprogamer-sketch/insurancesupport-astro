---
import BaseLayout from '../../layouts/BaseLayout.astro';
import posts from '../../data/blogs.json';
import languagesData from '../../data/languages.json';
import LanguageSidebar from '../../components/LanguageSidebar.astro';

const INDIAN_LANGUAGES = ['hi', 'bn', 'ta', 'te', 'mr', 'gu', 'kn', 'ml'];

// Only show English posts in the main listing
const englishPosts = posts.filter(p => (p.lang || 'en') === 'en');
const sorted = englishPosts.sort((a, b) => new Date(b.date) - new Date(a.date));
const allCategories = [...new Set(sorted.flatMap(p => p.categories || []))].sort();
const latestPost = sorted[0];
const remainingPosts = sorted.slice(1);

// Helper to format date in English
function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<BaseLayout title="Insurance Blog | Expert Guides & Tips | Hari Kotian" description="Expert insurance guides, claim process tips, IRDAI updates, and advisory from Hari Kotian. 25+ years of insurance experience." skipDefaultHreflang={true}>
  {/* English blog index hreflang cluster: en-IN self + x-default + all 8 language indexes */}
  <link rel="alternate" hreflang="en-IN" href="https://insurancesupport.online/blog/" />
  <link rel="alternate" hreflang="x-default" href="https://insurancesupport.online/blog/" />
  {['hi', 'bn', 'ta', 'te', 'mr', 'gu', 'kn', 'ml'].map(l => (
    <link rel="alternate" hreflang={`${l}-IN`} href={`https://insurancesupport.online/blog/${l}/`} />
  ))}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Insurance Blog | Expert Guides & Tips",
    "description": "Expert insurance guides, claim process tips, IRDAI updates, and advisory from Hari Kotian.",
    "url": "https://insurancesupport.online/blog/",
    "isPartOf": { "@type": "WebSite", "name": "Insurance Support", "url": "https://insurancesupport.online" },
    "about": { "@type": "Person", "name": "Hari Kotian", "jobTitle": "IRDAI Certified Insurance Advisor" },
    "hasPart": sorted.slice(0, 10).map(p => ({
      "@type": "BlogPosting",
      "headline": p.title,
      "url": `https://insurancesupport.online/blog/${p.slug}`,
      "datePublished": p.date,
      "author": { "@type": "Person", "name": p.author || "Hari Kotian" }
    }))
  })} />

  <main id="main" class="page-transition">

    <!-- Hero -->
    <section class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 text-white py-16 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px]" />
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-amber-500/5 rounded-full blur-[100px]" />

      <div class="max-w-6xl mx-auto px-4 text-center relative">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/10 text-amber-300 text-sm font-semibold mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
          Expert Insurance Blog
        </span>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold mb-4">Insurance Guides & Insights</h1>
        <p class="text-lg text-blue-100/80 max-w-2xl mx-auto">Expert guides, claim tips, and insurance insights from Hari Kotian, IRDAI certified advisor with 25+ years experience.</p>
        <p class="text-sm text-blue-200/60 mt-3">{sorted.length} expert articles published</p>
      </div>
    </section>

    <div class="max-w-6xl mx-auto px-4 py-12">

      <!-- Featured Post -->
      {latestPost && (
        <a href={`/blog/${latestPost.slug}`} class="block bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-8 md:p-10 border border-blue-100 hover:shadow-xl hover:border-blue-200 transition-all mb-12 group">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class="px-3 py-1 bg-blue-600 text-white text-xs font-semibold rounded-full">Latest Guide</span>
            <span class="text-sm text-slate-500">{formatDate(latestPost.date)}</span>
            <span class="text-sm text-slate-500">By {latestPost.author || 'Hari Kotian'}</span>
          </div>
          <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors leading-tight">{latestPost.title}</h2>
          <p class="text-slate-600 mb-4 line-clamp-2 leading-relaxed">{latestPost.summary}</p>
          <div class="flex flex-wrap gap-2 mb-4">
            {(latestPost.categories || []).slice(0, 3).map(cat => (
              <span class="px-2 py-1 bg-white text-blue-600 text-xs font-medium rounded-lg border border-blue-100">{cat}</span>
            ))}
          </div>
          <span class="inline-flex items-center gap-2 text-sm font-semibold text-blue-600 group-hover:gap-3 transition-all">
            Read Full Article
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </span>
        </a>
      )}

      <section class="mb-12" aria-labelledby="pillar-guides-title">
        <div class="mb-5 max-w-3xl">
          <p class="text-xs font-bold uppercase tracking-[.16em] text-blue-700">Start here</p>
          <h2 id="pillar-guides-title" class="mt-2 text-2xl font-extrabold text-slate-900">Core Insurance Guides</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Three in-depth guides explain the main decisions and next steps. Each links to focused resources for a particular policy or claim situation.</p>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          {[
            { title: 'Health Insurance in India', desc: 'Compare cover, understand policy terms, use cashless and reimbursement claims, and review portability.', url: '/blog/health-insurance-hub-complete-2026-guide/' },
            { title: 'Insurance Claim Recovery', desc: 'Build a clear claim file, challenge a decision, and understand insurer and external grievance routes.', url: '/blog/claim-recovery-hub-complete-2026-guide/' },
            { title: 'LIC Policies and Claims', desc: 'Understand policy types, servicing, missed premiums, maturity, and death claim steps.', url: '/blog/lic-policy-hub-complete-guide-2026/' },
          ].map(pillar => (
            <a href={pillar.url} class="group rounded-xl border border-blue-100 bg-gradient-to-br from-blue-50/80 to-white p-5 transition hover:border-blue-300 hover:shadow-md">
              <h3 class="text-lg font-bold text-slate-900 transition group-hover:text-blue-700">{pillar.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{pillar.desc}</p>
              <span class="mt-4 inline-flex text-sm font-semibold text-blue-700">Read the guide <span class="ml-1 transition-transform group-hover:translate-x-1">→</span></span>
            </a>
          ))}
        </div>
      </section>

      <!-- Expert Guides (deep standalone resources) -->
      <section class="mb-12">
        <h2 class="text-xl md:text-2xl font-extrabold text-slate-900 mb-2">Expert Claim Recovery Guides</h2>
        <p class="text-sm text-slate-500 mb-6">Step-by-step claim recovery playbooks from 25+ years of hands-on experience — written from the policyholder side of the desk.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {[
            { title: 'Cashless Claim Denied at the Hospital?', desc: 'The first 60 minutes: written denial, escalation, reimbursement file.', url: '/blog/cashless-health-insurance-claim-denied-hospital-2026/', tag: 'Health' },
            { title: 'LIC Death Claim Rejected or Delayed?', desc: 'Forms 3783/3801, documents, deadlines, and the nominee escalation ladder.', url: '/blog/lic-death-claim-rejected-nominee-guide-2026/', tag: 'LIC' },
            { title: 'Motor Claim Denied? Dispute the Surveyor', desc: 'Get the surveyor report, rebut depreciation heads, win the IDV battle.', url: '/blog/motor-insurance-claim-denied-surveyor-dispute-2026/', tag: 'Motor' },
            { title: 'Health Claim Rejected? Appeal Guide', desc: 'Grievance → Bima Bharosa → Ombudsman, with document checklist.', url: '/blog/health-insurance-claim-rejected-appeal-guide-2026/', tag: 'Health' },
            { title: 'LIC Claim Rejection Letter: How to Respond', desc: 'The written reply structure that gets repudiations reopened.', url: '/blog/lic-claim-rejection-response-guide/', tag: 'LIC' },
            { title: 'Insurance Ombudsman: Complete Filing Guide', desc: 'Eligibility, documents, and how to prepare a complaint.', url: '/blog/insurance-ombudsman-india-guide/', tag: 'Escalation' },
            { title: 'Health Portability Rejected or Delayed?', desc: 'The 45-day rule, the 15-day decision window, and how to fight a loading.', url: '/blog/health-insurance-portability-rejected-2026/', tag: 'Health' },
            { title: 'Mis-Sold a Policy? Get Your Money Back', desc: 'Free-look cancellation, evidence that holds, and the refund playbook.', url: '/blog/insurance-mis-selling-complaint-refund-2026/', tag: 'Mis-selling' },
            { title: 'Travel Claim Denied Abroad?', desc: 'Medical exclusions, baggage PIRs, and recovering the claim from overseas.', url: '/blog/travel-insurance-claim-denied-2026/', tag: 'Travel' },
            { title: 'Group Policy Claim Problems', desc: 'Why employer cover denies claims — and the exit trap when you change jobs.', url: '/blog/group-health-policy-claim-issues-2026/', tag: 'Health' },
            { title: 'Nominee vs Legal Heirs: Who Gets the Money?', desc: 'What the 2022 amendment actually changed, and ending the family fight.', url: '/blog/nominee-vs-legal-heirs-claim-dispute-2026/', tag: 'Claims' },
          ].map(g => (
            <a href={g.url} class="group block bg-white rounded-xl border border-amber-200/60 hover:border-amber-300 hover:shadow-lg transition-all p-5">
              <span class="inline-block px-2 py-0.5 bg-amber-50 text-amber-700 text-[10px] font-bold rounded-md uppercase tracking-wide mb-2">{g.tag} · Guide</span>
              <h3 class="text-base font-bold text-slate-900 mb-1.5 leading-snug group-hover:text-blue-700 transition-colors">{g.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed">{g.desc}</p>
            </a>
          ))}
        </div>
        <p class="mt-5 text-sm"><a href="/claim-recovery/" class="text-blue-600 font-semibold hover:underline">Browse all guides in the Claim Recovery Hub →</a></p>
      </section>

      <!-- Filter & Search Bar -->
      <div class="mb-10 flex flex-col md:flex-row gap-4 items-center justify-between">
        <div class="w-full md:w-96 relative">
          <input
            type="text"
            id="blog-filter"
            placeholder="Filter articles by keyword..."
            class="w-full px-4 py-3 pl-10 bg-white border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 shadow-sm"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
        </div>

        <div class="flex flex-wrap gap-2 w-full md:w-auto">
          <button data-cat="all" class="cat-btn px-3 py-1.5 bg-blue-600 text-white text-xs font-semibold rounded-lg transition-all" aria-label="All topics">All Topics</button>
          {allCategories.slice(0, 5).map(cat => (
            <button data-cat={cat} class="cat-btn px-3 py-1.5 bg-white border border-slate-200 text-slate-700 text-xs font-semibold rounded-lg hover:border-blue-300 transition-all" aria-label={cat}>{cat}</button>
          ))}
        </div>
      </div>

      <!-- Blog Grid -->
      <div id="blog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {remainingPosts.map((post, i) => (
          <div class="blog-card" data-title={post.title.toLowerCase()} data-summary={post.summary.toLowerCase()} data-categories={JSON.stringify(post.categories || [])}>
            <a href={`/blog/${post.slug}`} class="group block bg-white rounded-xl border border-slate-200 overflow-hidden hover:shadow-xl hover:border-blue-200 transition-all duration-300 h-full flex flex-col justify-between">
              <div>
                <div class="h-1.5 bg-gradient-to-r from-blue-500 to-indigo-500" />
                <div class="p-6">
                  <div class="flex flex-wrap gap-1.5 mb-3">
                    {(post.categories || []).slice(0, 2).map(cat => (
                      <span class="px-2 py-0.5 bg-blue-50 text-blue-600 text-[10px] font-semibold rounded-md uppercase tracking-wide">{cat}</span>
                    ))}
                  </div>
                  <h2 class="text-lg font-bold text-slate-900 mb-2 leading-snug group-hover:text-blue-600 transition-colors line-clamp-3">
                    {post.title}
                  </h2>
                  <p class="text-sm text-slate-500 leading-relaxed mb-4 line-clamp-3">
                    {post.summary}
                  </p>
                </div>
              </div>
              <div class="px-6 pb-6 pt-0">
                <div class="flex items-center justify-between pt-3 border-t border-slate-100">
                  <span class="text-xs text-slate-400">{formatDate(post.date)}</span>
                  <span class="text-xs font-semibold text-blue-600 flex items-center gap-1 group-hover:gap-2 transition-all">
                    Read More
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                  </span>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>

      <!-- Bottom CTA -->
      <div class="mt-16 text-center">
        <div class="bg-gradient-to-br from-slate-50 to-blue-50/50 rounded-2xl p-8 md:p-10 border border-slate-100">
          <h3 class="text-xl md:text-2xl font-extrabold text-slate-900 mb-3">Have a specific insurance question?</h3>
          <p class="text-slate-600 mb-6">Get personalized answers from Hari Kotian, IRDAI certified advisor with 25+ years of experience.</p>
          <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-900 font-bold rounded-full text-lg shadow-lg shadow-amber-500/25 hover:shadow-xl hover:scale-105 transition-all btn-glow">
            Consult Hari Kotian
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>
      </div>

    </div><!-- close max-w-6xl -->

    <LanguageSidebar lang="en" />
  </main>

</BaseLayout>

<script is:inline>
  const filterInput = document.getElementById('blog-filter');
  const cards = document.querySelectorAll('.blog-card');
  const catButtons = document.querySelectorAll('.cat-btn');

  let activeCategory = 'all';

  function filterCards() {
    const query = filterInput?.value.toLowerCase().trim() || '';

    cards.forEach(card => {
      const title = card.getAttribute('data-title') || '';
      const summary = card.getAttribute('data-summary') || '';
      const categories = JSON.parse(card.getAttribute('data-categories') || '[]');

      const matchesQuery = !query || title.includes(query) || summary.includes(query);
      const matchesCategory = activeCategory === 'all' || categories.includes(activeCategory);

      if (matchesQuery && matchesCategory) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }

  filterInput?.addEventListener('input', filterCards);

  catButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      catButtons.forEach(b => {
        b.classList.remove('bg-blue-600', 'text-white');
        b.classList.add('bg-white', 'border', 'border-slate-200', 'text-slate-700');
      });
      btn.classList.add('bg-blue-600', 'text-white');
      btn.classList.remove('bg-white', 'border', 'border-slate-200', 'text-slate-700');

      activeCategory = btn.getAttribute('data-cat') || 'all';
      filterCards();
    });
  });
</script>
