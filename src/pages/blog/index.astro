---
import BaseLayout from '../../layouts/BaseLayout.astro';
import posts from '../../data/blogs.json';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const sorted = posts.sort((a, b) => new Date(b.date) - new Date(a.date));
const allCategories = [...new Set(sorted.flatMap(p => p.categories || []))].sort();
const latestPost = sorted[0];
const recentPosts = sorted.slice(0, 12);
---

<BaseLayout title="Insurance Blog | Expert Guides & Tips | Hari Kotian" description="Expert insurance guides, claim process tips, IRDAI updates, and advisory from Hari Kotian. 25+ years of insurance experience.">
  <Header />

  <main class="page-transition">

    <!-- Hero -->
    <section class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 text-white py-16 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px]" />
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-amber-500/5 rounded-full blur-[100px]" />

      <div class="max-w-6xl mx-auto px-4 text-center relative">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/10 text-amber-300 text-sm font-semibold mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
          Expert Insurance Blog
        </span>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold mb-4">Insurance Guides & Insights</h1>
        <p class="text-lg text-blue-100/80 max-w-2xl mx-auto">Expert guides, claim tips, and insurance insights from Hari Kotian, IRDAI certified advisor with 25+ years experience.</p>
      </div>
    </section>

    <div class="max-w-6xl mx-auto px-4 py-12">

      <!-- Featured Post -->
      {latestPost && (
        <a href={`/blog/${latestPost.slug}`} class="block bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-8 md:p-10 border border-blue-100 hover:shadow-xl hover:border-blue-200 transition-all mb-12 group">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class="px-3 py-1 bg-blue-600 text-white text-xs font-semibold rounded-full">Latest</span>
            <span class="text-sm text-slate-500">{latestPost.date}</span>
            <span class="text-sm text-slate-500">By {latestPost.author || 'Hari Kotian'}</span>
          </div>
          <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors leading-tight">{latestPost.title}</h2>
          <p class="text-slate-600 mb-4 line-clamp-2 leading-relaxed">{latestPost.summary}</p>
          <div class="flex flex-wrap gap-2 mb-4">
            {(latestPost.categories || []).slice(0, 3).map(cat => (
              <span class="px-2 py-1 bg-white text-blue-600 text-xs font-medium rounded-lg border border-blue-100">{cat}</span>
            ))}
          </div>
          <span class="inline-flex items-center gap-2 text-sm font-semibold text-blue-600 group-hover:gap-3 transition-all">
            Read Full Article
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </span>
        </a>
      )}

      <!-- Category Filter -->
      <div class="flex flex-wrap gap-2 mb-8">
        <span class="px-4 py-2 bg-blue-600 text-white rounded-full text-sm font-medium shadow-sm">All Posts</span>
        {allCategories.map(cat => (
          <span class="px-4 py-2 bg-slate-100 text-slate-600 rounded-full text-sm font-medium hover:bg-blue-50 hover:text-blue-700 transition-colors cursor-default">{cat}</span>
        ))}
      </div>

      <!-- Blog Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentPosts.map((post, i) => (
          <a href={`/blog/${post.slug}`} class="group block bg-white rounded-xl border border-slate-200 overflow-hidden hover:shadow-xl hover:border-blue-200 transition-all duration-300 card-hover" style={`transition-delay: ${i * 0.05}s`}>
            <!-- Color bar top -->
            <div class="h-1.5 bg-gradient-to-r from-blue-500 to-indigo-500" />

            <div class="p-6">
              <!-- Categories -->
              <div class="flex flex-wrap gap-1.5 mb-3">
                {(post.categories || []).slice(0, 2).map(cat => (
                  <span class="px-2 py-0.5 bg-blue-50 text-blue-600 text-[10px] font-semibold rounded-md uppercase tracking-wide">{cat}</span>
                ))}
              </div>

              <!-- Title -->
              <h2 class="text-lg font-bold text-slate-900 mb-2 leading-snug group-hover:text-blue-600 transition-colors line-clamp-3">
                {post.title}
              </h2>

              <!-- Summary -->
              <p class="text-sm text-slate-500 leading-relaxed mb-4 line-clamp-3">
                {post.summary}
              </p>

              <!-- Footer -->
              <div class="flex items-center justify-between pt-3 border-t border-slate-100">
                <div class="text-xs text-slate-400">
                  <span>{post.date}</span>
                </div>
                <span class="text-xs font-semibold text-blue-600 flex items-center gap-1 group-hover:gap-2 transition-all">
                  Read More
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Bottom CTA -->
      <div class="mt-16 text-center">
        <div class="bg-gradient-to-br from-slate-50 to-blue-50/50 rounded-2xl p-8 md:p-10 border border-slate-100">
          <h3 class="text-xl md:text-2xl font-extrabold text-slate-900 mb-3">Have a specific insurance question?</h3>
          <p class="text-slate-600 mb-6">Get personalized answers from Hari Kotian, IRDAI certified advisor with 25+ years of experience.</p>
          <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-900 font-bold rounded-full text-lg shadow-lg shadow-amber-500/25 hover:shadow-xl hover:scale-105 transition-all btn-glow">
            Consult Hari Kotian
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>