---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import posts from '../../../data/blogs.json';
import languagesData from '../../../data/languages.json';
import { INDIAN_LANGUAGES } from '../../../data/languages';
import ArticleJsonLd from '../../../components/ArticleJsonLd.astro';
import LanguageSidebar from '../../../components/LanguageSidebar.astro';
import BreadcrumbJsonLd from '../../../components/BreadcrumbJsonLd.astro';
import FAQPageJsonLd from '../../../components/FAQPageJsonLd.astro';
import { marked } from 'marked';

// Generate static paths for all translated posts
export function getStaticPaths() {
  const paths = [];
  for (const post of posts) {
    if (post.lang && post.lang !== 'en' && post.translatedFrom) {
      paths.push({
        params: {
          lang: post.lang,
          slug: post.translatedFrom
        },
        props: { post }
      });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params;
const post = Astro.props.post;

const langInfo = languagesData.languages.find(l => l.code === lang);
const langName = langInfo ? langInfo.name : lang;

if (!post) {
  return Astro.redirect(`/blog/${slug}`);
}

const safeSlug = post.slug.replace(/[/\\?%*:|"<>]/g, '-');
const ogImageUrl = `https://insurancesupport.online/images/og/${safeSlug}.png`;

// Configure marked
marked.setOptions({ gfm: true, breaks: false });
const renderer = new marked.Renderer();
renderer.table = function({ header, rows }) {
  const ths = header.map(cell => `<th class="px-4 py-3 text-left text-xs font-bold text-slate-600 uppercase tracking-wider bg-slate-50 border-b border-slate-200">${cell.text}</th>`).join('');
  const trs = rows.map(row => {
    const tds = row.map(cell => `<td class="px-4 py-3 text-sm text-slate-700 border-b border-slate-100">${cell.text}</td>`).join('');
    return `<tr class="hover:bg-slate-50/50 transition-colors">${tds}</tr>`;
  }).join('');
  return `<div class="overflow-x-auto my-8 rounded-xl border border-slate-200 shadow-sm"><table class="min-w-full"><thead><tr>${ths}</tr></thead><tbody>${trs}</tbody></table></div>`;
};
renderer.blockquote = function({ raw, text }) {
  return `<blockquote class="border-l-4 border-blue-500 bg-blue-50/50 rounded-r-xl px-6 py-4 my-6 text-slate-700 italic leading-relaxed">${text}</blockquote>`;
};
renderer.code = function({ text, lang: code }) {
  return `<pre class="bg-slate-900 text-slate-100 rounded-xl p-5 my-6 overflow-x-auto text-sm leading-relaxed"><code>${text}</code></pre>`;
};
renderer.codespan = function({ text }) {
  return `<code class="bg-blue-50 text-blue-700 px-1.5 py-0.5 rounded text-sm font-mono">${text}</code>`;
};
renderer.link = function({ href, title, text }) {
  const t = title ? ` title="${title}"` : '';
  return `<a href="${href}"${t} class="text-blue-600 hover:text-blue-800 underline decoration-blue-300/50 hover:decoration-blue-500 transition-colors">${text}</a>`;
};
renderer.image = function({ href, title, text }) {
  const t = title ? ` title="${title}"` : '';
  return `<figure class="my-8"><img src="${href}" alt="${text || ''}"${t} class="w-full h-auto rounded-xl shadow-md" width="1200" height="630" loading="lazy" decoding="async" />${text ? `<figcaption class="text-center text-sm text-slate-500 mt-2">${text}</figcaption>` : ''}</figure>`;
};
renderer.heading = function({ text, depth }) {
  const cls = {
    1: 'text-3xl font-extrabold text-slate-900 mt-12 mb-5 leading-tight',
    2: 'text-2xl font-bold text-slate-900 mt-12 mb-4 pb-3 border-b border-slate-100',
    3: 'text-xl font-bold text-slate-900 mt-8 mb-3',
    4: 'text-lg font-bold text-slate-900 mt-6 mb-2',
  };
  return `<h${depth} class="${cls[depth] || cls[4]}">${text}</h${depth}>`;
};
renderer.list = function({ ordered, items }) {
  const tag = ordered ? 'ol' : 'ul';
  const style = ordered ? 'list-decimal' : 'list-disc';
  const lis = items.map(item => `<li class="pl-1">${item.text}</li>`).join('');
  return `<${tag} class="${style} pl-6 my-5 space-y-2 text-slate-600 leading-relaxed text-[15px]">${lis}</${tag}>`;
};
renderer.hr = function() { return `<hr class="my-10 border-t border-slate-200" />`; };
renderer.paragraph = function({ text }) {
  if (text.startsWith('<div') || text.startsWith('<table') || text.startsWith('<ul') || text.startsWith('<ol') || text.startsWith('<blockquote') || text.startsWith('<pre') || text.startsWith('<figure') || text.startsWith('<hr') || text.startsWith('<h')) return text;
  return `<p class="text-slate-600 leading-relaxed mb-5 text-[15px]">${text}</p>`;
};
marked.use({ renderer });
const htmlContent = marked.parse(post.content || '');

const faqs = [];
const faqSection = (post.content || '').split(/^##\s*FAQ\s*$/im)[1];
if (faqSection) {
  const qBlocks = faqSection.split(/\*\*Q:/).slice(1);
  for (const block of qBlocks) {
    const qEnd = block.indexOf('**');
    const question = block.slice(0, qEnd).trim();
    const answer = block.slice(qEnd + 2).trim().split(/\n\s*\n/)[0].replace(/\*\*/g, '').trim();
    if (question && answer) faqs.push({ question, answer });
  }
}

const readTime = Math.ceil((post.content || '').split(/\s+/).length / 200);

const faqLabel: Record<string, string> = {
  hi: "अक्सर पूछे जाने वाले प्रश्न",
  bn: "বারম্বার জিজ্ঞাসিত প্রশ্ন",
  ta: "அடிக்கடி கேட்கப்படும் கேள்விகள்",
  te: "తరచుగా అడిగే ప్రశ్నలు",
  mr: "वारंवार विचारले जाणारे प्रश्न",
  gu: "ઘારાયક પૂછાય છે પ્રશ્નો",
  kn: "ಆಗಾಗ ಕೇಳಲಾಗುವ ಪ್ರಶ್ನೆಗಳು",
  ml: "സാധാരണയായി ചോദിക്കുന്ന ചോദ്യങ്ങൾ"
};

const backText: Record<string, string> = {
  hi: "ब्लॉग पर वापस",
  bn: "ব্লগে ফিরে যান",
  ta: "வலைப்பதிவுக்குத் திரும்புங்கள்",
  te: "బ్లాగ్‌కు తిరిగి",
  mr: "ब्लॉगवर परत",
  gu: "બ્લગ પર પાછા",
  kn: "ಬ್ಲಾಗ್‌ಗೆ ಮರಳಿ",
  ml: "ബ്ലോഗിലേക്ക് തിരികെ"
};

const ctaText: Record<string, string> = {
  hi: "ज़रूरत पर्सनलाइज्ड बीमा सल्ला?",
  bn: "ব্যক্তিগত বিমা পরামর্শ চাই?",
  ta: "தனிப்பட்ட காப்புத் திட்ட ஆலோசனை தேவையா?",
  te: "వ్యక్తిగత బీమా సలహా కావాలా?",
  mr: "पर्सनलाइझ्ड विती सल्ला आवश्यक?",
  gu: "વ્યક્તિગત વીમા સલ્લા જોઈએ?",
  kn: "ವೈಯಕ್ತಿಕ ಬೀಮಾ ಸಲಹೆ ಬೇಕೇ?",
  ml: "വ്യക്തിഗത ഇൻസ്യൂറൻസ് ഉപദേശം വേണോ?"
};

const ctaSubtext: Record<string, string> = {
  hi: "Hari Kotian के साथ मुफ़्त परामर्श। कोई बाध्यता नहीं।",
  bn: "Hari Kotian এর সাথে বিনামূল্যে পরামর্শ। কোনো বাধ্যবাধকতা নেই।",
  ta: "Hari Kotian உடன் இலவு ஆலோசனை. எந்த கட்டுப்பாடும் இல்லை.",
  te: "Hari Kotian తో ఉచిత సలహా. ఎటువంటి బాధ్యత లేదు.",
  mr: "Hari Kotian यांच्यासह मोफत सल्ला. कोणतीही बाध्यता नाही.",
  gu: "Hari Kotian સાથે મફત સલ્લા. કોઈ બાધ્યતા નથી.",
  kn: "Hari Kotian ಜೊತೆ ಉಚಿತ ಸಲಹೆ. ಯಾವುದೇ ಬಾಧ್ಯತೆ ಇಲ್ಲ.",
  ml: "Hari Kotian നൊടൊപ്പം സൗജന്യ ഉപദേശം. ബാധ്യതയൊന്നും ഇല്ല."
};

const ctaButton: Record<string, string> = {
  hi: "मुफ़्त परामर्श पाएं",
  bn: "বিনামূল্যে পরামর্শ পান",
  ta: "இலவு ஆலோசனை பெறுங்கள்",
  te: "ఉచిత సలహా పొందండి",
  mr: "मोफत सल्ला मिळवा",
  gu: "મફત સલ્લા મેળવો",
  kn: "ಉಚಿತ ಸಲಹೆ ಪಡೆಯಿರಿ",
  ml: "സൗജന്യ ഉപദേശം നേടുക"
};

const altLangText: Record<string, string> = {
  hi: "अन्य भाषाओं में पढ़ें",
  bn: "অন্য ভাষায় পড়ুন",
  ta: "மற்ற மொழிகளில் படிக்கவும்",
  te: "ఇతర భాషల్లో చదవండి",
  mr: "इतर भाषांमध्ये वाचा",
  gu: "અન્ય ભાષાઓમાં વાંચો",
  kn: "ಇತರ ಭಾಷೆಗಳಲ್ಲಿ ಓದಿ",
  ml: "മറ്റ് ഭാഷകളിൽ വായിക്കുക"
};
const canonical = `https://insurancesupport.online/blog/${lang}/${post.translatedFrom || slug}/`;
---
  <BaseLayout title={post.title} description={post.summary} ogImage={ogImageUrl} keywords={(post.tags || []).join(', ')} canonical={canonical || Astro.url.href} skipDefaultHreflang={true}>
  {/*
    HREFLANG FIX: translated posts have slugs like "hi-health-insurance-...". Using post.slug here
    produced URLs like /blog/hi/hi-health-insurance-... (double prefix) which 404. The clean english
    slug is post.translatedFrom, giving /blog/{lang}/{englishSlug}/ which is the real page URL.
  */}
  <link rel="alternate" hreflang="en-IN" href={`https://insurancesupport.online/blog/${post.translatedFrom || post.slug}/`} />
  <link rel="alternate" hreflang="x-default" href={`https://insurancesupport.online/blog/${post.translatedFrom || post.slug}/`} />
  {INDIAN_LANGUAGES.filter(l => l !== lang).map(l => (
    <link rel="alternate" hreflang={l} href={`https://insurancesupport.online/blog/${l}/${post.translatedFrom || post.slug}/`} />
  ))}
  {INDIAN_LANGUAGES.filter(l => l === lang).map(l => (
    <link rel="alternate" hreflang={l} href={`https://insurancesupport.online/blog/${l}/${post.translatedFrom || post.slug}/`} />
  ))}

  <ArticleJsonLd title={post.title} description={post.summary} url={`https://insurancesupport.online/blog/${lang}/${post.translatedFrom || slug}/`} date={post.date} modifiedDate={post.modifiedDate || post.date} authorName={post.author || 'Hari Kotian'} />
  {faqs.length > 0 && <FAQPageJsonLd questions={faqs} />}
  <BreadcrumbJsonLd items={[{ label: 'Home', url: 'https://insurancesupport.online/' }, { label: 'Blog', url: 'https://insurancesupport.online/blog/' }, { label: `${langName} Blog`, url: `https://insurancesupport.online/blog/${lang}/` }, { label: post.title, url: `https://insurancesupport.online/blog/${lang}/${slug}/` }]} />

  <main id="main" class="page-transition">
    <!-- Hero Banner -->
    <section class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 text-white py-16 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px]" />
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-amber-500/5 rounded-full blur-[100px]" />
      <div class="max-w-4xl mx-auto px-4 relative">
        <a href={`/blog/${lang}/`} class="inline-flex items-center gap-2 text-sm text-blue-200/70 hover:text-white mb-6 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
          {backText[lang] || 'Back to Blog'}
        </a>
        <div class="flex flex-wrap gap-2 mb-4">
          {(post.categories || []).slice(0, 3).map(cat => (
            <span class="px-3 py-1 bg-white/10 border border-white/10 text-amber-300 text-xs font-semibold rounded-full backdrop-blur-sm">
              {cat}
            </span>
          ))}
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold leading-tight mb-6">
          {post.title}
        </h1>
        <p class="text-lg text-blue-100/80 mb-6 max-w-3xl leading-relaxed">
          {post.summary}
        </p>
        <div class="flex flex-wrap items-center gap-4 text-sm text-blue-200/70">
          <span class="text-white font-medium">{post.author || 'Hari Kotian'}</span>
          <span class="text-blue-300/40">|</span>
          <time>{post.date}</time>
          <span class="text-blue-300/40">|</span>
          <span>{readTime} min</span>
        </div>
      </div>
    </section>

    <!-- Article Body -->
    <article class="py-12 lg:py-16 bg-white">
      <div class="max-w-3xl mx-auto px-4 blog-content" set:html={htmlContent} />

      <!-- Keyword Tags (SEO + User Signal) -->
      {post.tags && post.tags.length > 0 && (
        <div class="max-w-3xl mx-auto px-4 mt-10">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Related Topics</p>
          <div class="flex flex-wrap gap-2">
            {post.tags.slice(0, 20).map(tag => (
              <span class="px-3 py-1 bg-slate-100 text-slate-600 text-xs font-medium rounded-full hover:bg-blue-50 hover:text-blue-700 transition-colors cursor-default">{tag}</span>
            ))}
          </div>
        </div>
      )}

      <div class="max-w-3xl mx-auto px-4 mt-8">
        <div class="border-t border-slate-200 pt-6">
          <p class="text-sm text-slate-500 mb-3">Language: {langName}</p>
          <p class="text-sm text-slate-600">
            <a href={`/blog/${post.translatedFrom || slug}/`} class="text-blue-600 hover:text-blue-800 font-medium">Read in English</a>
          </p>
        </div>
      </div>

      <!-- FAQ Section -->
      {faqs.length > 0 && (
        <div class="max-w-3xl mx-auto px-4 mt-12">
          <h3 class="text-xl font-bold text-slate-900 mb-6">{faqLabel[lang] || 'FAQ'}</h3>
          <div class="space-y-3">
            {faqs.map(faq => (
              <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
                <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors">
                  <span class="font-semibold text-slate-900 pr-4">{faq.question}</span>
                  <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="px-5 pb-5">
                  <p class="text-slate-600 leading-relaxed">{faq.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      )}

      <!-- CTA -->
      <div class="max-w-3xl mx-auto px-4 mt-16 mb-8">
        <div class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 rounded-2xl p-8 md:p-10 text-center text-white relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/10 rounded-full blur-[100px]" />
          <h3 class="text-2xl md:text-3xl font-extrabold mb-3 relative">{ctaText[lang] || 'Need personalized insurance advice?'}</h3>
          <p class="text-blue-200/80 mb-6 relative">{ctaSubtext[lang] || 'Free consultation with Hari Kotian. No obligation.'}</p>
          <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-900 font-bold rounded-full text-lg shadow-lg shadow-amber-500/25 hover:shadow-xl hover:scale-105 transition-all btn-glow relative">
            {ctaButton[lang] || 'Book Free Consultation'}
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>
      </div>
    </article>

    <!-- Language Switcher -->
    <div class="max-w-3xl mx-auto px-4 mt-12 mb-16">
      <div class="bg-blue-50 rounded-xl p-6 border border-blue-100">
        <h3 class="text-lg font-bold text-slate-900 mb-3">{altLangText[lang] || 'Read in other languages'}</h3>
        <p class="text-sm text-slate-600 mb-4">This article is available in multiple Indian languages.</p>
        <div class="flex flex-wrap gap-2">
          <a href={`/blog/${post.translatedFrom || slug}/`} class="px-4 py-2 bg-white text-blue-600 font-medium rounded-lg border border-blue-200 hover:bg-blue-50 transition-colors text-sm">English</a>
          {INDIAN_LANGUAGES.filter(l => l !== lang).map(l => {
          const li = languagesData.languages.find(x => x.code === l);
            return (
              <a href={`/blog/${l}/${slug}/`} class="px-4 py-2 bg-slate-100 text-slate-600 font-medium rounded-lg border border-slate-200 text-sm" key={l}>{li ? li.nativeName : l}</a>
            );
          })}
        </div>
      </div>
    </div>
  </main>

  <LanguageSidebar lang={lang} />
</BaseLayout>

<style is:global>
  .blog-content { @apply text-slate-600; }
  .blog-content table { @apply min-w-full text-sm border-collapse; }
  .blog-content thead tr { @apply border-b-2 border-slate-200; }
  .blog-content tbody tr:last-child { @apply border-b-0; }
  .blog-content img { @apply max-w-full h-auto rounded-xl shadow-md my-8; }
  .blog-content a { @apply text-blue-600 hover:text-blue-800 underline decoration-blue-300/50 hover:decoration-blue-500 transition-colors; }
  .blog-content strong { @apply text-slate-800 font-bold; }
  .blog-content blockquote { @apply border-l-4 border-blue-500 bg-blue-50/50 rounded-r-xl px-6 py-4 my-6 italic text-slate-700; }
  .blog-content pre { @apply bg-slate-900 text-slate-100 rounded-xl p-5 my-6 overflow-x-auto text-sm; }
  .blog-content code { @apply bg-blue-50 text-blue-700 px-1.5 py-0.5 rounded text-sm font-mono; }
  .blog-content pre code { @apply bg-transparent text-slate-100 p-0; }
</style>
