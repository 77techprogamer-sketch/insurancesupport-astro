---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import posts from '../../../data/blogs.json';
import languagesData from '../../../data/languages.json';
import { INDIAN_LANGUAGES } from '../../../data/languages';

// Generate static paths for each language index
export function getStaticPaths() {
  return INDIAN_LANGUAGES.map(code => ({
    params: { lang: code }
  }));
}

const { lang } = Astro.params;

if (!INDIAN_LANGUAGES.includes(lang)) {
  return Astro.redirect('/blog');
}

const langInfo = languagesData.languages.find(l => l.code === lang);
const langName = langInfo?.name || lang;
const langNativeName = langInfo?.nativeName || lang;

// Localized UI strings per language
const ui: Record<string, { readMore: string; latestGuide: string; allTopics: string; filterPlaceholder: string; readFull: string; noPosts: string; goToEnglish: string; haveQuestion: string; getAdvice: string; talkToHari: string; byAuthor: string; }> = {
  hi: { readMore: 'पूरा पढ़ें', latestGuide: 'नवीनतम गाइड', allTopics: 'सभी विषय', filterPlaceholder: 'कीवर्ड द्वारा फ़िल्टर करें...', readFull: 'पूरा पढ़ें', noPosts: 'इस भाषा में कोई लेख उपलब्ध नहीं है।', goToEnglish: 'English ब्लॉग पर जाएं', haveQuestion: 'कोई बीमा प्रश्न है?', getAdvice: 'Hari Kotian से व्यक्तिगत सलाह लें', talkToHari: 'Hari Kotian से सलाह लें', byAuthor: 'लेखक' },
  bn: { readMore: 'পুরো পড়ুন', latestGuide: 'সর্বশেষ গাইড', allTopics: 'সব বিষয়', filterPlaceholder: 'কীওয়ার্ড দিয়ে ফিল্টার করুন...', readFull: 'পুরো পড়ুন', noPosts: 'এই ভাষায় কোনো নিবন্ধ পাওয়া যায়নি।', goToEnglish: 'ইংরেজি ব্লগে যান', haveQuestion: 'কোনো বিমা প্রশ্ন আছে?', getAdvice: 'Hari Kotian থেকে ব্যক্তিগত পরামর্শ নিন', talkToHari: 'Hari Kotian থেকে পরামর্শ নিন', byAuthor: 'লেখক' },
  ta: { readMore: 'முழுவதும் படிக்கவும்', latestGuide: 'சபசே नवीनतम मार्गदर्शक', allTopics: 'அனைத்து தலைப்புகள்', filterPlaceholder: 'சொற்களால் வடிகட்டு...', readFull: 'முழுவதும் படிக்கவும்', noPosts: 'இந்த மொழியில் எந்த கட்டுரைகளும் இல்லை।', goToEnglish: 'ஆங்கில வலைப்பதிவிற்கு செல்லவும்', haveQuestion: 'எந்த காப்பு கேள்வியும் உள்ளதா?', getAdvice: 'Hari Kotian லிருந்து தனிப்பட்ட ஆலோசனை', talkToHari: 'Hari Kotian லிருந்து ஆலோசனை', byAuthor: 'எழுத்தாளர்' },
  te: { readMore: 'మுழுவதును చదవండి', latestGuide: 'అత్యవసరమైన గైడ్', allTopics: 'అన్ని தலைப்புகள்', filterPlaceholder: 'కీవర్డ్ ద్వారా ఫిల్టర్ చేయండి...', readFull: 'మுழுவதును చదవండి', noPosts: 'ఈ భాషలో ఏ مضامين కనిపించలేదు।', goToEnglish: 'ఇంగ్లీష్ బ్లాగ్‌కు వెళ్ళండి', haveQuestion: 'ఏమైనా బీమా ప్రశ్న ఉందా?', getAdvice: 'Hari Kotian నుండి వ్యక్తిగత సలహా', talkToHari: 'Hari Kotian నుండి సలహా', byAuthor: 'రచయిత' },
  mr: { readMore: 'पूर्ण वाचा', latestGuide: 'नवीनतम मार्गदर्शक', allTopics: 'सर्व विषय', filterPlaceholder: 'कीवर्डद्वारे फिल्टर करा...', readFull: 'पूर्ण वाचा', noPosts: 'या भाषेत कोणतेही लेख उपलब्ध नाहीत।', goToEnglish: 'इंग्रजी ब्लॉगवर जा', haveQuestion: 'काहीच विमा प्रश्न आहे?', getAdvice: 'Hari Kotian कडून वैयक्तिक सल्ला', talkToHari: 'Hari Kotian कडून सल्ला', byAuthor: 'लेखक' },
  gu: { readMore: 'સંપૂર્ણ વાંચો', latestGuide: 'નવીનતમ માર્ગદર્શિકા', allTopics: 'બધા વિષયો', filterPlaceholder: 'કીવર્ડ દ્વારા ફિલ્ટર કરો...', readFull: 'સંપૂર્ણ વાંચો', noPosts: 'આ ભાષામાં કોઈ લેખ ઉપલબ્ધ નથી।', goToEnglish: 'અંગ્રેજી બ્લૉગ પર જાઓ', haveQuestion: 'શું તમારે કોઈ વીમા પ્રશ્ન છે?', getAdvice: 'Hari Kotian થી વ્યક્તિગત સલ્લા', talkToHari: 'Hari Kotian થી સલ્લા', byAuthor: 'લેખક' },
  kn: { readMore: 'ಸಂಪೂರ್ಣ ಓದಿ', latestGuide: 'ನವीनತಮ ಮಾರ್ಗದರ್ಶಿ', allTopics: 'ಎಲ್ಲಾ ವಿಷಯಗಳು', filterPlaceholder: 'ಪದಗಳ ನೆರವಿನಿಂದ ಫಿಲ್ಟರ್ ಮಾಡಿ...', readFull: 'ಸಂಪೂರ್ಣ ಓದಿ', noPosts: 'ಈ ಭಾಷೆಯಲ್ಲಿ ಯಾವುದೇ ಲೇಖನಗಳು ಲಭ್ಯವಿಲ್ಲ।', goToEnglish: 'ಇಂಗ್ಲೀಷ್ ಬ್ಲಾಗ್‌ಗೆ ಹೋಗಿ', haveQuestion: 'ಯಾವುದೇ ವಿಮಾ ಪ್ರಶ್ನೆ ಇದೆಯೇ?', getAdvice: 'Hari Kotianರಿಂದ ವೈಯಕ್ತಿಕ ಸಲಹೆ', talkToHari: 'Hari Kotianರಿಂದ ಸಲಹೆ', byAuthor: 'ಲೇಖಕ' },
  ml: { readMore: 'പൂർണ്ണമായി വായിക്കുക', latestGuide: 'നവീനതമ മാർഗനിർദ്ദേശം', allTopics: 'എല്ലാ വിഷയങ്ങൾ', filterPlaceholder: 'കീവേഡുകൾ ഉപയോഗിച്ച് ഫിൽട്ടർ ചെയ്യുക...', readFull: 'പൂർണ്ണമായി വായിക്കുക', noPosts: 'ഈ ഭാഷയിൽ ഏതെങ്കിലും ലേഖനങ്ങൾ ലഭ്യമല്ല।', goToEnglish: 'ഇംഗ്ലീഷ് ബ്ലോഗ്‌ക്ക് പോകുക', haveQuestion: 'നിനക്ക് ഏതെങ്കിലും ഇൻഷുറൻസ് ചോദ്യം ഉണ്ട്?', getAdvice: 'Hari Kotian ൽ നിന്നുള്ള വ്യക്തിഗത ഉപദേശം', talkToHari: 'Hari Kotian ൽ നിന്നുള്ള ഉപദേശം', byAuthor: 'രചയിതാവ്' },
};

// Helper to format date in target language
function formatDate(dateStr: string, lang: string) {
  const date = new Date(dateStr);
  const opts: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: 'numeric' };
  try {
    return new Intl.DateTimeFormat(lang === 'hi' ? 'hi-IN' : lang === 'bn' ? 'bn-IN' : lang === 'ta' ? 'ta-IN' : lang === 'te' ? 'te-IN' : lang === 'mr' ? 'mr-IN' : lang === 'gu' ? 'gu-IN' : lang === 'kn' ? 'kn-IN' : 'ml-IN', opts).format(date);
  } catch {
    return date.toLocaleDateString('en-IN', opts);
  }
}

// Get translated posts for this language
const langPosts = posts.filter(p => p.lang === lang).sort((a, b) => new Date(b.date) - new Date(a.date));
const allCategories = [...new Set(langPosts.flatMap(p => p.categories || []))].sort();
const latestPost = langPosts[0];
const remainingPosts = langPosts.slice(1);

const currentUi = ui[lang] || ui.hi;
const langRegion: Record<string, string> = {
  hi: "hi-IN", bn: "bn-IN", ta: "ta-IN", te: "te-IN",
  mr: "mr-IN", gu: "gu-IN", kn: "kn-IN", ml: "ml-IN"
};
const ogLocaleMap: Record<string, string> = {
  hi: "hi_IN", bn: "bn_IN", ta: "ta_IN", te: "te_IN",
  mr: "mr_IN", gu: "gu_IN", kn: "kn_IN", ml: "ml_IN"
};
---

<BaseLayout title={`${langName} Insurance Blog | विशेषज्ञ गाइड | Hari Kotian`} description={`${langName} में बीमा गाइड, दावा प्रक्रिया युक्तियाँ, IRDAI अपडेट, और Hari Kotian से सलाह। 25+ वर्षों का अनुभव।`} ogImage={`https://insurancesupport.online/images/og/${lang}-blog.jpg`} skipDefaultHreflang={true} pageLang={langRegion[lang] || "en-IN"} ogLocale={ogLocaleMap[lang] || "en_IN"}>
  {/* Language index hreflang set: self + English index + x-default + all other 7 language indexes */}
  <link rel="alternate" hreflang={langRegion[lang] || "en-IN"} href={`https://insurancesupport.online/blog/${lang}/`} />
  <link rel="alternate" hreflang="en-IN" href="https://insurancesupport.online/blog/" />
  <link rel="alternate" hreflang="x-default" href="https://insurancesupport.online/blog/" />
  {INDIAN_LANGUAGES.filter(l => l !== lang).map(l => (
    <link rel="alternate" hreflang={langRegion[l] || `${l}-IN`} href={`https://insurancesupport.online/blog/${l}/`} />
  ))}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": `${langName} Insurance Blog`,
    "description": `Expert insurance guides in ${langName}. Claim tips, IRDAI updates, advisory.`,
    "url": `https://insurancesupport.online/blog/${lang}/`,
    "isPartOf": { "@type": "WebSite", "name": "Insurance Support", "url": "https://insurancesupport.online" },
    "about": { "@type": "Person", "name": "Hari Kotian", "jobTitle": "IRDAI Certified Insurance Advisor" },
    "hasPart": langPosts.slice(0, 10).map(p => ({
      "@type": "BlogPosting",
      "headline": p.title,
      "url": `https://insurancesupport.online/blog/${lang}/${p.translatedFrom || p.slug}/`,
      "datePublished": p.date,
      "author": { "@type": "Person", "name": p.author || "Hari Kotian" },
      "inLanguage": lang
    }))
  })} />

  <main id="main" class="page-transition">

    <!-- Hero -->
    <section class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 text-white py-16 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px]" />
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-amber-500/5 rounded-full blur-[100px]" />

      <div class="max-w-6xl mx-auto px-4 text-center relative">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/10 text-amber-300 text-sm font-semibold mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
          {langName} Insurance Blog
        </span>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold mb-4">{langNativeName} बीमा गाइड और इनसाइट्स</h1>
        <p class="text-lg text-blue-100/80 max-w-2xl mx-auto">Hari Kotian के विशेषज्ञ गाइड {langNativeName} में - IRDAI प्रमाणित सलाहकार, 25+ साल का अनुभव।</p>
        <p class="text-sm text-blue-200/60 mt-3">{langPosts.length} लेख उपलब्ध</p>
      </div>
    </section>

    <div class="max-w-6xl mx-auto px-4 py-12">

      <!-- Featured Post -->
      {latestPost && (
        <a href={`/blog/${lang}/${latestPost.translatedFrom || latestPost.slug}`} class="block bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-8 md:p-10 border border-blue-100 hover:shadow-xl hover:border-blue-200 transition-all mb-12 group">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class="px-3 py-1 bg-blue-600 text-white text-xs font-semibold rounded-full">{currentUi.latestGuide}</span>
            <span class="text-sm text-slate-500">{formatDate(latestPost.date, lang)}</span>
            <span class="text-sm text-slate-500">{currentUi.byAuthor}: {latestPost.author || 'Hari Kotian'}</span>
          </div>
          <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors leading-tight">{latestPost.title}</h2>
          <p class="text-slate-600 mb-4 line-clamp-2 leading-relaxed">{latestPost.summary}</p>
          <div class="flex flex-wrap gap-2 mb-4">
            {(latestPost.categories || []).slice(0, 3).map(cat => (
              <span class="px-2 py-1 bg-white text-blue-600 text-xs font-medium rounded-lg border border-blue-100">{cat}</span>
            ))}
          </div>
          <span class="inline-flex items-center gap-2 text-sm font-semibold text-blue-600 group-hover:gap-3 transition-all">
            {currentUi.readFull}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </span>
        </a>
      )}

      <!-- Filter & Search Bar -->
      <div class="mb-10 flex flex-col md:flex-row gap-4 items-center justify-between">
        <div class="w-full md:w-96 relative">
          <input
            type="text"
            id="blog-filter"
            placeholder={currentUi.filterPlaceholder}
            class="w-full px-4 py-3 pl-10 bg-white border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 shadow-sm"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
        </div>

        <div class="flex flex-wrap gap-2 w-full md:w-auto">
          <button data-cat="all" class="cat-btn px-3 py-1.5 bg-blue-600 text-white text-xs font-semibold rounded-lg transition-all" aria-label="All topics">{currentUi.allTopics}</button>
          {allCategories.slice(0, 5).map(cat => (
            <button data-cat={cat} class="cat-btn px-3 py-1.5 bg-white border border-slate-200 text-slate-700 text-xs font-semibold rounded-lg hover:border-blue-300 transition-all" aria-label={cat}>{cat}</button>
          ))}
        </div>
      </div>

      <!-- Blog Grid -->
      <div id="blog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {remainingPosts.map((post, i) => (
          <div class="blog-card" data-title={post.title.toLowerCase()} data-summary={post.summary.toLowerCase()} data-categories={JSON.stringify(post.categories || [])}>
            <a href={`/blog/${lang}/${post.translatedFrom || post.slug}`} class="group block bg-white rounded-xl border border-slate-200 overflow-hidden hover:shadow-xl hover:border-blue-200 transition-all duration-300 h-full flex flex-col justify-between">
              <div>
                <div class="h-1.5 bg-gradient-to-r from-blue-500 to-indigo-500" />
                <div class="p-6">
                  <div class="flex flex-wrap gap-1.5 mb-3">
                    {(post.categories || []).slice(0, 2).map(cat => (
                      <span class="px-2 py-0.5 bg-blue-50 text-blue-600 text-[10px] font-semibold rounded-md uppercase tracking-wide">{cat}</span>
                    ))}
                  </div>
                  <h2 class="text-lg font-bold text-slate-900 mb-2 leading-snug group-hover:text-blue-600 transition-colors line-clamp-3">
                    {post.title}
                  </h2>
                  <p class="text-sm text-slate-500 leading-relaxed mb-4 line-clamp-3">
                    {post.summary}
                  </p>
                </div>
              </div>
              <div class="px-6 pb-6 pt-0">
                <div class="flex items-center justify-between pt-3 border-t border-slate-100">
                  <span class="text-xs text-slate-400">{formatDate(post.date, lang)}</span>
                  <span class="text-xs font-semibold text-blue-600 flex items-center gap-1 group-hover:gap-2 transition-all">
                    {currentUi.readMore}
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                  </span>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>

      {langPosts.length === 0 && (
        <div class="text-center py-16">
          <p class="text-slate-600 mb-4">{currentUi.noPosts}</p>
          <a href="/blog" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors">{currentUi.goToEnglish}</a>
        </div>
      )}

      <!-- Bottom CTA -->
      <div class="mt-16 text-center">
        <div class="bg-gradient-to-br from-slate-50 to-blue-50/50 rounded-2xl p-8 md:p-10 border border-slate-100">
          <h3 class="text-xl md:text-2xl font-extrabold text-slate-900 mb-3">{currentUi.haveQuestion}</h3>
          <p class="text-slate-600 mb-6">{currentUi.getAdvice}</p>
          <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-900 font-bold rounded-full text-lg shadow-lg shadow-amber-500/25 hover:shadow-xl hover:scale-105 transition-all btn-glow">
            {currentUi.talkToHari}
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>
      </div>
    </div>
  </main>

</BaseLayout>

<script is:inline>
  const filterInput = document.getElementById('blog-filter');
  const cards = document.querySelectorAll('.blog-card');
  const catButtons = document.querySelectorAll('.cat-btn');

  let activeCategory = 'all';

  function filterCards() {
    const query = filterInput?.value.toLowerCase().trim() || '';

    cards.forEach(card => {
      const title = card.getAttribute('data-title') || '';
      const summary = card.getAttribute('data-summary') || '';
      const categories = JSON.parse(card.getAttribute('data-categories') || '[]');

      const matchesQuery = !query || title.includes(query) || summary.includes(query);
      const matchesCategory = activeCategory === 'all' || categories.includes(activeCategory);

      if (matchesQuery && matchesCategory) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }

  filterInput?.addEventListener('input', filterCards);

  catButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      catButtons.forEach(b => {
        b.classList.remove('bg-blue-600', 'text-white');
        b.classList.add('bg-white', 'border', 'border-slate-200', 'text-slate-700');
      });
      btn.classList.add('bg-blue-600', 'text-white');
      btn.classList.remove('bg-white', 'border', 'border-slate-200', 'text-slate-700');

      activeCategory = btn.getAttribute('data-cat') || 'all';
      filterCards();
    });
  });
</script>