---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/sections/ContactSection.astro';
---

<BaseLayout 
  title="Insurance Resources, Checklists & Guides | Insurance Support" 
  description="Free insurance resources, claim appeal checklists, IRDAI guidelines, and expert guides by Hari Kotian to help you navigate policies and claims in India."
>
  <main class="min-h-screen bg-slate-900 text-white relative overflow-hidden py-16 lg:py-24">
    <!-- Decorative background glows -->
    <div class="absolute top-10 right-1/4 w-96 h-96 bg-blue-600/20 rounded-full blur-[140px] pointer-events-none" />
    <div class="absolute bottom-10 left-1/4 w-96 h-96 bg-amber-500/10 rounded-full blur-[140px] pointer-events-none" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Page Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-400/20 text-amber-300 text-sm font-semibold mb-4 backdrop-blur-sm border border-amber-400/30">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
          Knowledge & Tools Hub
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-6">
          Insurance <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-200">Resources & Guides</span>
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Empower yourself with expert checklists, claim appeal guides, IRDAI regulatory insights, and comparison tools curated by Hari Kotian (25+ years experience).
        </p>
      </div>

      <!-- Section 1: Core Hub Links (FAQ, Blog, Support) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
        <a href="/faq" class="group bg-white/5 backdrop-blur-xl rounded-3xl p-8 border border-white/10 hover:border-amber-400/50 hover:bg-white/10 transition-all duration-300 shadow-xl">
          <div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center mb-6 shadow-lg group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-amber-300 transition-colors">Frequently Asked Questions</h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-6">Get answers to top questions regarding claim rejections, policy lapses, waiting periods, and grievance redressal.</p>
          <span class="inline-flex items-center gap-2 text-amber-300 font-semibold text-sm group-hover:translate-x-1 transition-transform">
            Browse FAQs &rarr;
          </span>
        </a>

        <a href="/blog" class="group bg-white/5 backdrop-blur-xl rounded-3xl p-8 border border-white/10 hover:border-amber-400/50 hover:bg-white/10 transition-all duration-300 shadow-xl">
          <div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center mb-6 shadow-lg group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
          </div>
          <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-amber-300 transition-colors">Expert Blog & Articles</h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-6">In-depth guides on LIC policy maturity calculators, Ombudsman appeal processes, health insurance riders, and claim settlements.</p>
          <span class="inline-flex items-center gap-2 text-amber-300 font-semibold text-sm group-hover:translate-x-1 transition-transform">
            Read Expert Articles &rarr;
          </span>
        </a>

        <a href="/support" class="group bg-white/5 backdrop-blur-xl rounded-3xl p-8 border border-white/10 hover:border-amber-400/50 hover:bg-white/10 transition-all duration-300 shadow-xl">
          <div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center mb-6 shadow-lg group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
          </div>
          <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-amber-300 transition-colors">Claim Support Desk</h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-6">Stuck with a rejected claim or delayed payout? Get direct assistance from our claim recovery desk in Bengaluru.</p>
          <span class="inline-flex items-center gap-2 text-amber-300 font-semibold text-sm group-hover:translate-x-1 transition-transform">
            Get Claim Help &rarr;
          </span>
        </a>
      </div>

      <!-- Section 2: Essential Downloadable Checklists & Guides -->
      <div class="bg-white/5 backdrop-blur-xl rounded-3xl p-8 sm:p-12 border border-white/10 mb-20 shadow-2xl">
        <div class="max-w-3xl mb-10">
          <span class="text-amber-400 font-semibold text-sm uppercase tracking-wider mb-2 block">Actionable Toolkits</span>
          <h2 class="text-3xl font-bold text-white mb-4">Essential Insurance Checklists</h2>
          <p class="text-slate-300">Use these proven frameworks before filing claims, purchasing policies, or raising disputes.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-slate-800/60 rounded-2xl p-6 border border-white/10">
            <div class="flex items-center gap-3 mb-4">
              <div class="h-10 w-10 rounded-xl bg-blue-500/20 text-blue-400 flex items-center justify-center font-bold">1</div>
              <h4 class="text-xl font-bold text-white">Claim Rejection Appeal Checklist</h4>
            </div>
            <p class="text-slate-300 text-sm leading-relaxed mb-4">
              Step-by-step actions to take immediately when an insurer rejects your claim on grounds of non-disclosure or exclusion. Includes grievance escalation timeline.
            </p>
            <a href="/contact" class="inline-flex items-center gap-2 text-amber-300 text-sm font-semibold hover:text-amber-200">
              Request Free Consultation &rarr;
            </a>
          </div>

          <div class="bg-slate-800/60 rounded-2xl p-6 border border-white/10">
            <div class="flex items-center gap-3 mb-4">
              <div class="h-10 w-10 rounded-xl bg-blue-500/20 text-blue-400 flex items-center justify-center font-bold">2</div>
              <h4 class="text-xl font-bold text-white">Term Insurance Buying Guide</h4>
            </div>
            <p class="text-slate-300 text-sm leading-relaxed mb-4">
              How to calculate your exact cover amount (HLV method), rider selection, claim settlement ratio evaluation, and medical underwriting disclosures.
            </p>
            <a href="/services/term-insurance" class="inline-flex items-center gap-2 text-amber-300 text-sm font-semibold hover:text-amber-200">
              Explore Term Plans &rarr;
            </a>
          </div>
        </div>
      </div>

      <!-- Section 3: Official Regulatory & Consumer Portals -->
      <div class="mb-20">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl font-bold text-white mb-4">Official Regulatory Portals</h2>
          <p class="text-slate-300">Verify your advisor, check regulations, or escalate grievances directly through official Indian insurance bodies.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <a href="https://www.irdai.gov.in" target="_blank" rel="noopener noreferrer" class="bg-white/5 backdrop-blur-xl rounded-2xl p-6 border border-white/10 hover:border-blue-400/50 text-center transition-all group">
            <h4 class="text-lg font-bold text-white mb-2 group-hover:text-amber-300 transition-colors">IRDAI Official Portal</h4>
            <p class="text-slate-400 text-xs">Insurance Regulatory and Development Authority of India</p>
          </a>

          <a href="https://www.cioins.co.in" target="_blank" rel="noopener noreferrer" class="bg-white/5 backdrop-blur-xl rounded-2xl p-6 border border-white/10 hover:border-blue-400/50 text-center transition-all group">
            <h4 class="text-lg font-bold text-white mb-2 group-hover:text-amber-300 transition-colors">Insurance Ombudsman</h4>
            <p class="text-slate-400 text-xs">Council for Insurance Ombudsmen grievance resolution</p>
          </a>

          <a href="https://igms.irda.gov.in" target="_blank" rel="noopener noreferrer" class="bg-white/5 backdrop-blur-xl rounded-2xl p-6 border border-white/10 hover:border-blue-400/50 text-center transition-all group">
            <h4 class="text-lg font-bold text-white mb-2 group-hover:text-amber-300 transition-colors">IGMS Portal</h4>
            <p class="text-slate-400 text-xs">Integrated Grievance Management System</p>
          </a>
        </div>
      </div>

      <!-- Contact CTA Section -->
      <ContactSection />

    </div>
  </main>
</BaseLayout>
