---
// src/pages/lead-magnets/[slug].astro
import LeadMagnetLayout from '../../layouts/LeadMagnetLayout.astro';
import LeadMagnetForm from '../../components/LeadMagnetForm.astro';
import FAQPageJsonLd from '../../components/FAQPageJsonLd.astro';
import magnets from '../../data/lead-magnets.json';

export function getStaticPaths() {
  return magnets.map((m) => ({ params: { slug: m.slug } }));
}

const { slug } = Astro.params;
const magnet = magnets.find((m) => m.slug === slug);

if (!magnet) {
  throw new Error(`Lead magnet not found: ${slug}`);
}
const pageUrl = `https://insurancesupport.online/lead-magnets/${magnet.slug}`;
---

<LeadMagnetLayout
  title={magnet.title}
  description={magnet.description}
  keywords={magnet.keywords}
  canonical={pageUrl}
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-blue-900 via-blue-800 to-slate-900 text-white py-16 lg:py-20 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px]" />
    <div class="absolute bottom-0 left-0 w-80 h-80 bg-amber-500/10 rounded-full blur-[100px]" />

    <div class="max-w-6xl mx-auto px-4 relative grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-400/20 text-amber-300 text-sm font-semibold mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
          Free Resource
        </span>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold leading-tight mb-4">{magnet.title}</h1>
        <p class="text-lg text-blue-100/90 mb-8 leading-relaxed">{magnet.subtitle}</p>

        <div class="flex flex-wrap gap-4 mb-8">
          <span class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 border border-white/10 rounded-full text-sm backdrop-blur-sm">
            <svg class="w-4 h-4 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            {magnet.format}
          </span>
          <span class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 border border-white/10 rounded-full text-sm backdrop-blur-sm">
            <svg class="w-4 h-4 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            {magnet.delivery}
          </span>
        </div>

        <p class="max-w-xl text-sm text-blue-100/80">Created by Insurance Support in Bengaluru. This guide helps you organize information; it is not a promise of claim approval or a substitute for checking your policy and current official guidance.</p>
      </div>

      <div>
        <LeadMagnetForm
          fields={magnet.fields}
          ctaText={magnet.ctaText}
          magnetSlug={magnet.slug}
          thankYouMessage={magnet.thankYouMessage}
          downloadUrl={magnet.downloadUrl}
        />
      </div>
    </div>
  </section>

  <section class="bg-white py-12" aria-labelledby="quick-answer">
    <div class="mx-auto max-w-4xl px-4">
      <h2 id="quick-answer" class="mb-4 text-2xl font-bold text-slate-900">{magnet.title}: what this free guide helps you do</h2>
      <p class="text-lg leading-relaxed text-slate-700">{magnet.description} Download the PDF to organize your records and prepare informed questions. The insurer or eligible complaint forum determines outcomes based on the policy, evidence, and applicable rules.</p>
      {magnet.relatedUrl && <a class="mt-4 inline-block font-semibold text-blue-700 underline" href={magnet.relatedUrl}>{magnet.relatedLabel} →</a>}
    </div>
  </section>

  <!-- What's Inside -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-3">What's Inside</h2>
      <p class="text-slate-600 mb-10 text-lg">Use this practical checklist to organize documents, understand the next step, and keep a clear record.</p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {magnet.benefits.map((benefit, i) => (
          <div class="flex items-start gap-4 p-5 bg-slate-50 rounded-xl border border-slate-100 hover:border-blue-200 hover:shadow-md transition-all">
            <div class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-lg shrink-0">{i + 1}</div>
            <p class="text-slate-700 leading-relaxed font-medium">{benefit}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {magnet.relatedUrl && (
    <section class="bg-blue-50 py-12">
      <div class="mx-auto max-w-4xl px-4">
        <h2 class="mb-3 text-2xl font-bold text-slate-900">Related insurance help and tools</h2>
        <p class="text-slate-700">Continue with relevant guidance from Insurance Support:</p>
        <a class="mt-3 inline-block font-semibold text-blue-700 underline" href={magnet.relatedUrl}>{magnet.relatedLabel} →</a>
        <p class="mt-4 text-sm text-slate-600">For individualized help, see <a class="underline" href="/support">insurance claim support</a> or <a class="underline" href="/contact">contact our Bengaluru-based advisor</a>.</p>
      </div>
    </section>
  )}

  <!-- Who It's For -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-3">This Is For You If...</h2>
      <p class="text-slate-600 mb-10 text-lg">You're in one of these situations:</p>

      <div class="grid md:grid-cols-3 gap-6">
        {magnet.idealFor.map((item) => (
          <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-all">
            <div class="w-12 h-12 rounded-full bg-amber-100 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            </div>
            <p class="text-slate-700 font-medium leading-relaxed">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Trust Us -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="bg-gradient-to-br from-slate-900 to-blue-900 rounded-2xl p-8 md:p-12 text-white grid md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2">
          <h2 class="text-2xl md:text-3xl font-extrabold mb-4">Why Trust Hari Kotian?</h2>
          <p class="text-blue-100/80 leading-relaxed mb-6">
            Insurance Support provides guidance on policy documents, claim records, and insurer grievance processes. Hari Kotian is listed as an IRDAI-registered insurance advisor (Reg. 0149161D). This resource is general information; the insurer or eligible complaint forum decides each case.
          </p>
          <div class="flex flex-wrap gap-6 text-sm">
            <div><span class="block text-2xl font-extrabold text-amber-300">Policy guidance</span><span class="text-blue-200/70">Terms and coverage questions</span></div>
            <div><span class="block text-2xl font-extrabold text-amber-300">Claim support</span><span class="text-blue-200/70">Documents and follow-up</span></div>
            <div><span class="block text-2xl font-extrabold text-amber-300">IRDAI</span><span class="text-blue-200/70">Reg. No. 0149161D</span></div>
          </div>
        </div>
        <div class="text-center">
          <div class="w-24 h-24 rounded-full bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-white font-bold text-3xl mx-auto mb-4 shadow-lg">HK</div>
          <p class="font-semibold">Hari Kotian</p>
          <p class="text-sm text-blue-200/70">IRDAI Certified Advisor</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-8 text-center">Quick Questions</h2>
      <div class="space-y-3">
        <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
          <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors">
            <span class="font-semibold text-slate-900 pr-4">Is this really free?</span>
            <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-5 pb-5"><p class="text-slate-600 leading-relaxed">Yes. There is no charge for the guide, and the form does not require payment details.</p></div>
        </details>
        <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
          <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors">
            <span class="font-semibold text-slate-900 pr-4">How do I receive it?</span>
            <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-5 pb-5"><p class="text-slate-600 leading-relaxed">After you submit the form, the download button appears on this page. No email delivery is required.</p></div>
        </details>
        <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
          <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors">
            <span class="font-semibold text-slate-900 pr-4">Will you call me if I submit?</span>
            <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-5 pb-5"><p class="text-slate-600 leading-relaxed">Submitting the form does not sign you up for a call. Use the contact options on our support page if you want to discuss your situation.</p></div>
        </details>
        <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
          <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors">
            <span class="font-semibold text-slate-900 pr-4">Do you guarantee results?</span>
            <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-5 pb-5"><p class="text-slate-600 leading-relaxed">No. The guide is general information. Claim outcomes depend on policy wording, case facts, evidence, and the insurer or eligible complaint forum.</p></div>
        </details>
      </div>
    </div>
  </section>

  {magnet.faqs?.length > 0 && (
    <>
      <FAQPageJsonLd questions={magnet.faqs} />
      <section class="bg-slate-50 py-16" aria-labelledby="resource-faq">
        <div class="mx-auto max-w-4xl px-4">
          <h2 id="resource-faq" class="mb-8 text-center text-2xl font-extrabold text-slate-900">Frequently asked questions</h2>
          <div class="space-y-3">
            {magnet.faqs.map((faq) => (
              <details class="group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                <summary class="cursor-pointer p-5 font-semibold text-slate-900">{faq.question}</summary>
                <p class="px-5 pb-5 leading-relaxed text-slate-600">{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    </>
  )}
</LeadMagnetLayout>
