---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you are looking for does not exist.">
  <main id="main" class="max-w-7xl mx-auto px-4 py-24 text-center">
    <h1 class="text-6xl font-extrabold text-blue-900 mb-6">404</h1>
    <p class="text-2xl text-slate-600 mb-8">Oops! The page you're looking for doesn't exist.</p>
    <a href="/" class="inline-block px-8 py-4 bg-blue-600 text-white font-bold rounded-lg hover:bg-blue-700 transition-colors">
      Go Back Home
    </a>
  </main>
</BaseLayout>
