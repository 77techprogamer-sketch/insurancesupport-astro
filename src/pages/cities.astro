<BaseLayout
  title="LIC Agent Bangalore — All Areas Served | Insurance Support"
  description="Hari Kotian provides LIC insurance advisory across 83+ Bangalore areas. Find your local expert for life, health, term insurance and claim recovery. IRDAI Reg No: 0149161D."
>
  <main class="max-w-6xl mx-auto px-4 py-12">
    <header class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-extrabold text-blue-900 mb-4">
        LIC Insurance Advisor Across Bangalore
      </h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        Door-step service across 83+ Bangalore neighborhoods. Select your area below for local contact details, recommended plans, and free consultation booking.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      {AREAS.map((area) => (
        <a
          href={`/cities/${area.slug}`}
          class="group block p-5 border border-slate-200 rounded-xl hover:border-blue-300 hover:shadow-lg hover:-translate-y-1 transition-all duration-200 bg-white"
        >
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white font-bold text-sm">
              {area.name.charAt(0)}
            </div>
            <div>
              <h3 class="font-bold text-slate-900 group-hover:text-blue-700 transition-colors">
                {area.name}
              </h3>
              <p class="text-sm text-slate-500 mt-1">{area.highlight}</p>
            </div>
          </div>
          <div class="mt-3 pt-3 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs font-medium text-blue-600">View Details</span>
            <svg class="w-4 h-4 text-slate-400 group-hover:text-blue-500 group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>

    <section class="mt-16 p-8 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-2xl text-white text-center">
      <h2 class="text-2xl md:text-3xl font-extrabold mb-3">Don't See Your Area?</h2>
      <p class="text-blue-100 mb-6 max-w-xl mx-auto">
        I serve all of Bangalore and surrounding regions. If your locality isn't listed, I still provide door-step consultation — just reach out.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="https://wa.me/919986634506" class="inline-flex items-center gap-2 bg-green-500 text-white font-bold py-3 px-6 rounded-lg hover:bg-green-600 transition-colors">
          WhatsApp Me
        </a>
        <a href="tel:+919986634506" class="inline-flex items-center gap-2 bg-white text-blue-900 font-bold py-3 px-6 rounded-lg hover:bg-blue-50 transition-colors">
          Call Now
        </a>
        <a href="/contact" class="inline-flex items-center gap-2 bg-amber-400 text-slate-900 font-bold py-3 px-6 rounded-lg hover:bg-amber-300 transition-colors">
          Book Free Consultation
        </a>
      </div>
    </section>

    <footer class="mt-12 text-center text-sm text-slate-500">
      <p>IRDAI Reg No: 0149161D | 25+ Years Experience | 1000+ Families Served | INR 50Cr+ Claims Recovered</p>
    </footer>
  </main>
</BaseLayout>