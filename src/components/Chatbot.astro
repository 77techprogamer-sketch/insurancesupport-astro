---
// Insurance Support RAG Chatbot widget.
// Fetches answers from the RAG backend (/rag_answer) which is LLM-free and
// serves grounded content from the Google-Drive-hosted vector store.
// API base is configurable via the PUBLIC_RAG_API env var (Astro exposes
// PUBLIC_* vars to the browser). Falls back to the local dev backend.
const apiBase = import.meta.env.PUBLIC_RAG_API || "http://127.0.0.1:8000";
---

<div id="is-chatbot-root" class="is-chatbot-root">
  <!-- Launcher button -->
  <button id="is-chatbot-launcher" class="is-chatbot-launcher" aria-label="Open insurance chatbot" type="button">
    <span class="is-chatbot-logo">💬</span>
  </button>

  <!-- Chat panel (hidden by default) -->
  <div id="is-chatbot-panel" class="is-chatbot-panel" hidden>
    <div class="is-chatbot-header">
      <span class="is-chatbot-header-title">Ask Insurance Support</span>
      <button id="is-chatbot-close" class="is-chatbot-close" aria-label="Close chat" type="button">&times;</button>
    </div>
    <div id="is-chatbot-messages" class="is-chatbot-messages">
      <div class="is-msg is-msg-bot">Hello! I can answer questions about LIC, ICICI Lombard and Care Health insurance products.</div>
    </div>
    <div id="is-chatbot-suggestions" class="is-chatbot-suggestions"></div>
    <form id="is-chatbot-form" class="is-chatbot-form">
      <textarea id="is-chatbot-input" rows="1" placeholder="Type your question…" aria-label="Your question"></textarea>
      <button type="submit" aria-label="Send" class="is-chatbot-send">➤</button>
    </form>
  </div>
</div>

<style is:global>
  /* Root container */
  .is-chatbot-root {
    position: fixed;
    right: 16px;
    bottom: 104px;  /* sits above the WhatsApp floating button */
    z-index: 9999;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  /* Launcher (round button) */
  .is-chatbot-launcher {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: none;
    background: linear-gradient(135deg, #0f4c81, #1d70b8);
    color: #fff;
    font-size: 26px;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(15, 76, 129, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }
  .is-chatbot-launcher:hover { transform: scale(1.08); }

  /* Panel */
  .is-chatbot-panel {
    position: fixed;
    right: 16px;
    bottom: 170px;
    width: 360px;
    max-width: calc(100vw - 32px);
    max-height: 70vh;
    background: #fff;
    border: 1px solid #dde3ee;
    border-radius: 14px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    z-index: 10000;
  }
  .is-chatbot-panel[hidden] { display: none; }

  .is-chatbot-header {
    background: linear-gradient(135deg, #0f4c81, #1d70b8);
    color: #fff;
    padding: 12px 14px;
    font-weight: 600;
    font-size: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .is-chatbot-close {
    background: transparent;
    border: none;
    color: #fff;
    font-size: 22px;
    cursor: pointer;
    line-height: 1;
  }

  .is-chatbot-messages {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    background: #f6f8fc;
    max-height: 45vh;
  }

  .is-msg {
    max-width: 88%;
    padding: 10px 12px;
    border-radius: 12px;
    margin: 6px 0;
    line-height: 1.45;
    font-size: 14px;
    white-space: pre-wrap;
    word-wrap: break-word;
  }
  .is-msg-user {
    margin-left: auto;
    background: #0f4c81;
    color: #fff;
    border-bottom-right-radius: 4px;
    text-align: right;
  }
  .is-msg-bot {
    background: #fff;
    border: 1px solid #dde3ee;
    border-bottom-left-radius: 4px;
  }
  .is-msg-bot a { color: #1d70b8; }

  /* Typing indicator */
  .is-typing { display: flex; gap: 4px; padding: 10px 0 4px; }
  .is-typing span {
    width: 8px; height: 8px; border-radius: 50%;
    background: #1d70b8; animation: is-blink 1.2s infinite;
  }
  .is-typing span:nth-child(2) { animation-delay: 0.2s; }
  .is-typing span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes is-blink { 0%,80%,100% {opacity:.25} 40% {opacity:1} }

  /* Suggestions */
  .is-chatbot-suggestions {
    display: flex; gap: 6px; flex-wrap: wrap;
    padding: 6px 10px;
    border-top: 1px solid #eef1f6;
  }
  .is-chatbot-suggestions button {
    border: 1px solid #dde3ee;
    background: #f8fafc;
    color: #0f4c81;
    border-radius: 14px;
    padding: 5px 10px;
    font-size: 12px;
    cursor: pointer;
  }
  .is-chatbot-suggestions button:hover { background: #e8f1fb; border-color: #1d70b8; }

  /* Form */
  .is-chatbot-form {
    display: flex;
    gap: 8px;
    padding: 10px;
    border-top: 1px solid #eef1f6;
    background: #fff;
  }
  .is-chatbot-form textarea {
    flex: 1;
    resize: none;
    border: 1px solid #dde3ee;
    border-radius: 18px;
    padding: 9px 12px;
    font: inherit;
    font-size: 14px;
    max-height: 100px;
    outline: none;
    background: #f8fafc;
  }
  .is-chatbot-form textarea:focus { border-color: #1d70b8; background: #fff; }
  .is-chatbot-send {
    width: 44px; height: 44px;
    border: none; border-radius: 50%;
    background: #0f4c81; color: #fff; font-size: 16px;
    cursor: pointer; flex-shrink: 0;
  }
  .is-chatbot-send:hover { background: #1d70b8; }

  @media (max-width: 480px) {
    .is-chatbot-panel { width: 100vw; right: 0; bottom: 0; max-height: 85vh; border-radius: 14px 14px 0 0; }
    .is-chatbot-messages { max-height: 55vh; }
  }
</style>

<script is:inline set:html={() => `
(function () {
  const API_BASE = ${JSON.stringify(apiBase)};
  const root = document.getElementById('is-chatbot-root');
  if (!root) return;
  const launcher = document.getElementById('is-chatbot-launcher');
  const panel = document.getElementById('is-chatbot-panel');
  const closeBtn = document.getElementById('is-chatbot-close');
  const messages = document.getElementById('is-chatbot-messages');
  const suggestionsBox = document.getElementById('is-chatbot-suggestions');
  const form = document.getElementById('is-chatbot-form');
  const input = document.getElementById('is-chatbot-input');

  const SUGGESTIONS = [
    "What are the key benefits of LIC Jeevan Anand?",
    "Compare ICICI Lombard health plans for a family of 4",
    "What is the pre-existing disease waiting period in Care Health policies?"
  ];

  launcher.addEventListener('click', () => {
    panel.hidden = !panel.hidden;
    if (!panel.hidden) input.focus();
  });
  closeBtn.addEventListener('click', () => { panel.hidden = true; });

  function renderSuggestions() {
    SUGGESTIONS.forEach(function (s) {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = s;
      b.addEventListener('click', function () { ask(s); });
      suggestionsBox.appendChild(b);
    });
  }

  function addMsg(text, role) {
    const div = document.createElement('div');
    div.className = 'is-msg is-msg-' + role;
    div.textContent = text;
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
    return div;
  }

  function showTyping() {
    const div = document.createElement('div');
    div.className = 'is-typing';
    div.innerHTML = '<span></span><span></span><span></span>';
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
    return div;
  }

  function addSources(sources) {
    if (!sources || !sources.length) return;
    const box = document.createElement('div');
    box.style.cssText = 'font-size:12px;color:#55627a;margin-top:6px;padding-top:6px;border-top:1px dashed #dde3ee;';
    box.textContent = 'Sources:';
    sources.forEach(function (s) {
      const a = document.createElement('a');
      a.href = s.url || '#';
      a.target = '_blank';
      a.rel = 'noopener';
      a.style.cssText = 'display:block;margin-top:2px;color:#1d70b8;text-decoration:none;';
      a.textContent = (s.product_name || s.insurer) + ' (' + s.insurer + ')';
      box.appendChild(a);
    });
    messages.appendChild(box);
    messages.scrollTop = messages.scrollHeight;
  }

  async function ask(q) {
    addMsg(q, 'user');
    input.value = '';
    const typing = showTyping();
    try {
      const res = await fetch(API_BASE + '/rag_answer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query: q, include_signature: true })
      });
      if (!res.ok) throw new Error('bad ' + res.status);
      const data = await res.json();
      typing.remove();
      addMsg(data.answer || 'Sorry, no answer found.', 'bot');
      addSources(data.sources);
    } catch (e) {
      typing.remove();
      addMsg('Sorry, I could not reach the answer service. Please try again later.', 'bot');
    }
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    const q = input.value.trim();
    if (q) ask(q);
  });
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
  });

  renderSuggestions();
})();
`} />
