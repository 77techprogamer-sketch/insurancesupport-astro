---
/**
 * Floating contact buttons.
 *
 * This used to be a React component with Framer Motion, hydrated with
 * client:visible on every page. That shipped the React runtime, Framer Motion
 * and lucide-react — roughly 270 KB of JavaScript — to every visitor in order
 * to fade in three buttons after 300 pixels of scroll.
 *
 * It is now plain HTML, CSS transitions and fourteen lines of inline script.
 * The visual result is the same; the main-thread cost on a mid-range Android
 * phone is not.
 */
interface Props {
  phoneNumber?: string;
}

const { phoneNumber = '+919986634506' } = Astro.props;
const tel = phoneNumber.replace(/[^+\d]/g, '');
---

<div class="floating-cta" id="floatingCta" aria-hidden="true">
  <a
    href="/contact"
    class="fc-quote"
    tabindex="-1"
  >
    <span>Get a Quote</span>
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0l-6-6m6 6l-6 6" />
    </svg>
  </a>

  <a href={`tel:${tel}`} class="fc-round fc-call" aria-label="Call Insurance Support" tabindex="-1">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.6a1 1 0 01.95.68l1.2 3.6a1 1 0 01-.5 1.2l-1.7.85a11 11 0 005.52 5.52l.85-1.7a1 1 0 011.2-.5l3.6 1.2a1 1 0 01.68.95V19a2 2 0 01-2 2h-.5C9.6 21 3 14.4 3 5.5V5z" />
    </svg>
  </a>

  <a
    href="https://wa.me/919986634506?text=Hi%20Hari%2C%20I%20need%20help%20with%20insurance."
    target="_blank"
    rel="noopener noreferrer"
    class="fc-round fc-whatsapp"
    aria-label="Chat on WhatsApp"
    tabindex="-1"
  >
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path d="M12.05 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.14 1.59 5.94L.06 24l6.3-1.65a11.9 11.9 0 005.68 1.45c6.55 0 11.89-5.34 11.89-11.9C23.94 5.35 18.6 0 12.05 0zm0 21.78h-.01a9.9 9.9 0 01-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 01-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 012.89 6.99c0 5.45-4.44 9.88-9.88 9.88zm5.42-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.47-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.87 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35z" />
    </svg>
  </a>
</div>

<style>
  .floating-cta {
    position: fixed;
    right: 1rem;
    bottom: 5rem;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    opacity: 0;
    transform: translateY(24px);
    pointer-events: none;
    transition: opacity 240ms ease, transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .floating-cta.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .fc-quote {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    border-radius: 9999px;
    background: linear-gradient(90deg, #10b981, #047857);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 4px 20px rgba(16, 185, 129, 0.4);
    transition: transform 160ms ease, filter 160ms ease;
  }

  .fc-quote:hover {
    transform: translateY(-2px) scale(1.03);
    filter: brightness(1.06);
  }

  .fc-quote svg {
    transition: transform 160ms ease;
  }

  .fc-quote:hover svg {
    transform: translateX(3px);
  }

  .fc-round {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 9999px;
    color: #fff;
    text-decoration: none;
    transition: transform 160ms ease, background 160ms ease;
  }

  .fc-round:hover {
    transform: scale(1.08);
  }

  .fc-call {
    background: rgba(15, 23, 42, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.22);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(10px);
  }

  .fc-call:hover {
    background: rgba(15, 23, 42, 0.95);
  }

  .fc-whatsapp {
    background: #25d366;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .fc-whatsapp:hover {
    background: #1fb954;
  }

  @media (min-width: 640px) {
    .floating-cta {
      right: 1.5rem;
      bottom: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-cta {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var el = document.getElementById('floatingCta');
    if (!el) return;

    var shown = false;
    var ticking = false;

    function update() {
      var on = window.scrollY > 300;
      if (on === shown) return;
      shown = on;
      el.classList.toggle('is-visible', on);
      el.setAttribute('aria-hidden', on ? 'false' : 'true');
      var links = el.querySelectorAll('a');
      for (var i = 0; i < links.length; i++) {
        links[i].setAttribute('tabindex', on ? '0' : '-1');
      }
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () {
        update();
        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  })();
</script>
