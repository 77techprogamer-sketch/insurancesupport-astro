---
const trustBadges = [
  {
    label: "Claim Support",
    detail: "Help understanding next steps",
    icon: "M13 16V3L4 14h7v7l9-11h-7z"
  },
  {
    label: "Policy Guidance",
    detail: "Understand coverage and exclusions",
    icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
  },
  {
    label: "Claim Documents",
    detail: "Organize relevant records",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
  },
  {
    label: "Insurer Follow-up",
    detail: "Understand available routes",
    icon: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
  }
];
---

<section class="bg-[#000] py-12 relative overflow-hidden">
  <div class="absolute inset-0 opacity-10 bg-aurora-grid" />
  <div class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-[#10b981]/40 to-transparent" />
  <div class="max-w-7xl mx-auto px-4 py-8 md:py-12 relative z-10">
    <h3 class="text-3xl md:text-4xl lg:text-5xl text-white text-center mb-12 font-extrabold" style={{ fontFamily: "'Plus Jakarta Sans', sans-serif" }}>
      Why Clients Choose Us
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
      {trustBadges.map((badge, i) => (
        <div class="reveal card-aurora">
          <div class="flex flex-col items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-[rgba(16,185,129,0.12)] border border-[rgba(16,185,129,0.2)] flex items-center justify-center text-white font-bold text-2xl" style={{ color: '#10b981' }}>
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d={badge.icon} />
              </svg>
            </div>
            <h4 class="text-lg md:text-xl font-medium text-white text-center mb-2" style={{ fontFamily: "'Plus Jakarta Sans', sans-serif" }}>{badge.label}</h4>
            <p class="text-sm text-[rgba(255,255,255,0.55)] font-medium text-center" style={{ fontFamily: "'Inter', sans-serif" }}>{badge.detail}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
