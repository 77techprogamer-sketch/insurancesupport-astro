---
// src/components/MobileStickyBar.astro
// Acko/Policybazaar style mobile sticky action bar for immediate conversions
import Icon from '../components/icons/Icon.astro';
---

<div class="fixed bottom-0 left-0 right-0 z-50 bg-surface/95 backdrop-blur-md border-t border-border px-4 py-3 flex items-center justify-between gap-3 md:hidden shadow-2xl">
  <a href="tel:+919986634506" class="flex-1 flex items-center justify-center gap-2 bg-bg-muted hover:bg-bg-alt text-dark font-semibold py-2.5 px-4 rounded-xl text-sm transition-colors border border-border">
    <Icon name="phone" size="sm" class="text-accent" />
    Call Now
  </a>
  <a href="/contact" class="flex-1 flex items-center justify-center gap-2 btn btn-primary text-white font-bold py-2.5 px-4 rounded-xl text-sm transition-all shadow-lg">
    Free Consultation
    <Icon name="arrow-right" size="sm" />
  </a>
</div>
