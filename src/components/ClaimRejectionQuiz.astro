---
// src/components/ClaimRejectionQuiz.astro
// Interactive quiz to assess claim appeal potential.
import Icon from '../components/icons/Icon.astro';
import CallbackForm from './CallbackForm.astro';

// The quiz used to render five numbered boxes with no question text and empty
// selects (the "inject via JS" placeholder was never implemented). Questions and
// options now render server-side so the form is usable, indexable and accessible.
const questions = [
  {
    n: 1, name: 'insurer', label: 'Which insurer rejected the claim?',
    options: ['LIC of India', 'Star Health', 'HDFC ERGO', 'ICICI Lombard', 'Niva Bupa',
              'New India Assurance', 'Bajaj Allianz', 'Care Health', 'SBI General',
              'Tata AIG', 'Max Life', 'Other insurer'],
  },
  {
    n: 2, name: 'policyType', label: 'What kind of policy is it?',
    options: ['Health Insurance', 'Life Insurance', 'Term Insurance', 'Motor Insurance'],
  },
  {
    n: 3, name: 'rejectionReason', label: 'What reason did the insurer give?',
    options: ['Non-disclosure', 'Exclusion', 'Waiting Period', 'Lapse', 'Documentation', 'Other'],
  },
  {
    n: 4, name: 'claimAmount', label: 'Roughly how much was the claim for?',
    options: ['Under 1L', '1-5L', '5-20L', '20L+'],
  },
  {
    n: 5, name: 'rejectionDate', label: 'When was the rejection?',
    options: ['<30 days', '30-90 days', '>90 days'],
  },
];
---

<div id="claimRejectionQuiz" class="max-w-xl mx-auto rounded-3xl overflow-hidden shadow-2xl border border-border mb-12 bg-surface">
  <!-- Quiz Header -->
  <div class="bg-primary-bg p-8 text-white relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-accent/10 rounded-full blur-3xl" />
    <div class="absolute bottom-0 left-0 w-40 h-40 bg-accent/5 rounded-full blur-2xl" />
    <div class="relative">
      <span class="label-aurora mb-4" style="text-transform: none; letter-spacing: 0.02em; font-size: 13px; color: white;">
        <Icon name="shield-check" size="sm" />
        Free Assessment
      </span>
      <h2 class="text-3xl font-bold mb-3 text-dark" style={{ fontFamily: "'Plus Jakarta Sans', sans-serif" }}>Claim Rejection Quiz</h2>
      <p class="text-muted leading-relaxed" style={{ fontFamily: "'Inter', sans-serif" }}>Answer a few quick questions to assess your claim appeal potential.</p>
    </div>
  </div>

  <!-- Quiz Body -->
  <div class="p-8" style={{ fontFamily: "'Inter', sans-serif" }}>
    <form id="quizForm" class="space-y-6">
      <!-- Questions -->
      {questions.map((q) => (
        <div class="card p-5" key={q.name}>
          <label for={`q${q.n}`} class="block font-semibold text-dark mb-3">
            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-accent text-white text-sm font-bold mr-2 flex-shrink-0" style={{ fontFamily: "'Inter', sans-serif" }}>{q.n}</span>
            <span class="text-secondary">{q.label}</span>
          </label>
          <select id={`q${q.n}`} name={q.name} required class="input w-full">
            <option value="">Select...</option>
            {q.options.map((opt) => (
              <option value={opt}>{opt}</option>
            ))}
          </select>
        </div>
      ))}

      <button type="submit" class="btn btn-primary w-full" style={{ padding: '14px 26px', fontSize: '14px' }} aria-label="Assess my claim potential">
        Assess My Claim Potential
        <Icon name="arrow-right" size="sm" />
      </button>
    </form>

    <!-- Result -->
    <div id="quizResult" class="hidden mt-8">
      <div class="bg-accent-bg border-2 border-accent-border rounded-2xl p-8 text-center shadow-lg">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-accent/20 mb-4">
          <Icon name="shield-check" size="xl" class="text-accent" />
        </div>
        <h3 class="text-2xl font-bold text-dark mb-2" style={{ fontFamily: "'Plus Jakarta Sans', sans-serif" }}>Your Claim Appeal Potential</h3>
        <div class="text-5xl font-extrabold text-accent mb-3" style={{ fontFamily: "'Plus Jakarta Sans', sans-serif" }}><span id="potentialScore"></span></div>
        <div class="w-full bg-accent/10 rounded-full h-3 mb-6 overflow-hidden">
          <div id="potentialBar" class="h-full bg-accent rounded-full transition-all duration-1000" style="width:0%"></div>
        </div>
        <p id="potentialMessage" class="text-secondary mb-6 leading-relaxed" style={{ fontFamily: "'Inter', sans-serif" }}></p>

        <div class="mt-6 rounded-2xl border border-border bg-surface p-5">
          <CallbackForm
            source="quiz:claim-rejection"
            heading="Want a human to check this?"
            subheading="Leave your number — we will go through your answers and tell you what to file first."
            buttonLabel="Review my case"
            variant="bare"
            showTimeSlot={false}
            leadType="quiz"
            captureQuiz={true}
          />
        </div>
        <a id="whatsappCta" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 btn btn-accent hover:scale-105 transition-all" style={{ fontFamily: "'Inter', sans-serif", fontSize: '14px' }}>
          <Icon name="whatsapp" size="md" />
          Get Expert Help on WhatsApp
        </a>
        <p class="mt-4 text-xs text-muted leading-relaxed">
          This is an indication based on your answers, not a prediction or a guarantee. The policy
          wording and the claim file decide the outcome.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const quizForm = document.getElementById('quizForm');
    const quizResult = document.getElementById('quizResult');
    const potentialScore = document.getElementById('potentialScore');
    const potentialBar = document.getElementById('potentialBar');
    const potentialMessage = document.getElementById('potentialMessage');
    const whatsappCta = document.getElementById('whatsappCta');

    if (!quizForm) return;

    (quizForm as HTMLFormElement).addEventListener('submit', (event) => {
      event.preventDefault();

      const formData = new FormData(quizForm);
      const insurer = formData.get('insurer');
      const policyType = formData.get('policyType');
      const rejectionReason = formData.get('rejectionReason');
      const claimAmount = formData.get('claimAmount');
      const rejectionDate = formData.get('rejectionDate');

      let score = 0;
      let message = "";

      // Scoring Logic
      if (rejectionReason === 'Non-disclosure') score += 20;
      if (rejectionReason === 'Lapse') score += 10;
      if (rejectionReason === 'Exclusion') score += 30;
      if (rejectionReason === 'Waiting Period') score += 25;
      if (rejectionReason === 'Documentation') score += 40;
      if (rejectionReason === 'Other') score += 15;

      if (policyType === 'Life Insurance' || policyType === 'Health Insurance') score += 15;
      if (policyType === 'Term Insurance') score += 20;
      if (policyType === 'Motor Insurance') score += 5;

      if (claimAmount === '20L+') score += 20;
      else if (claimAmount === '5-20L') score += 15;
      else if (claimAmount === '1-5L') score += 10;

      if (rejectionDate === '<30 days') score += 30;
      else if (rejectionDate === '30-90 days') score += 20;
      else if (rejectionDate === '>90 days') score += 10;

      // Cap at 100 and describe the grounds, never a promised outcome.
      score = Math.min(score, 100);
      if (score >= 80) {
        message = "Strong grounds to review: the rejection reason, the policy type and the timing all work in your favour.";
      } else if (score >= 50) {
        message = "Worth reviewing: there are points here that a clause-level check could challenge.";
      } else {
        message = "Fewer obvious grounds on these answers — but the documents often tell a different story. A review is still free.";
      }

      if (potentialScore) potentialScore.textContent = `${score}%`;
      if (potentialBar) {
        potentialBar.style.width = '0%';
        requestAnimationFrame(() => requestAnimationFrame(() => { potentialBar.style.width = `${score}%`; }));
      }
      if (potentialMessage) potentialMessage.textContent = message;

      const whatsappMessage = `Hi Hari, I just took the Claim Rejection Quiz. My claim from ${insurer} for a ${policyType} was rejected due to ${rejectionReason}. The amount was ${claimAmount} and it was rejected ${rejectionDate}. My appeal potential is ${score}%. Can you help?`;
      if (whatsappCta) (whatsappCta as HTMLAnchorElement).href = `https://wa.me/919986634506?text=${encodeURIComponent(whatsappMessage)}`;

      if (quizResult) {
        quizResult.classList.remove('hidden');
        quizResult.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
</script>
