---
// RelatedCaseStudies.astro
//
// Surfaces Hari Kotian's own settled cases on the articles they are relevant
// to. This is first-hand experience — a rejected claim we actually got paid,
// with the insurer, the amount and the reason it was refused. It is the one
// thing content-farm competitors cannot manufacture, and it is the strongest
// Experience signal the site has.
//
// Matching is keyword-scored against the post's title, summary, categories and
// tags, mirroring the EXPERT_GUIDES approach already used in the article
// template. Only cases scoring a match are shown; articles with no relevant
// case render nothing at all.

import cases from '../data/case-studies.json';

interface Props {
  title: string;
  summary?: string;
  categories?: string[];
  tags?: string[];
}

const { title, summary = '', categories = [], tags = [] } = Astro.props;

const haystack = [title, summary, ...categories, ...tags].join(' ').toLowerCase();

// Each case contributes keywords it should match on: insurer, claim type,
// locality and tags. A case needs at least three hits to be shown, so a stray
// word match does not attach an unrelated case to an article.
const scored = cases
  .map((c) => {
    const kws = [
      ...(c.tags || []),
      c.insurer,
      c.claimType,
      'claim',
      'rejected',
      'recovery',
    ]
      .filter(Boolean)
      .map((k: string) => k.toLowerCase());
    const score = kws.reduce((n: number, kw: string) => n + (haystack.includes(kw) ? 1 : 0), 0);
    return { ...c, score };
  })
  .filter((c) => c.score >= 3)
  .sort((a, b) => b.score - a.score)
  .slice(0, 2);

// "42,85,000" -> "₹42.85 lakh"; "1,00,00,000" -> "₹1 crore"
function formatAmount(raw: string): string {
  const n = Number(String(raw).replace(/,/g, ''));
  if (!Number.isFinite(n)) return String(raw);
  if (n >= 10000000) return '₹' + (n / 10000000).toFixed(n % 10000000 === 0 ? 0 : 2) + ' crore';
  if (n >= 100000) return '₹' + (n / 100000).toFixed(n % 100000 === 0 ? 0 : 2) + ' lakh';
  return '₹' + n.toLocaleString('en-IN');
}
---

{scored.length > 0 && (
  <aside class="max-w-3xl mx-auto px-4 mt-12" aria-labelledby="related-cases">
    <div class="rounded-2xl border border-amber-200 bg-gradient-to-br from-amber-50 to-white overflow-hidden">
      <div class="px-6 pt-6 pb-4">
        <p class="text-xs font-semibold text-amber-700 uppercase tracking-wider mb-1" id="related-cases">
          Cases we have actually settled
        </p>
        <h2 class="text-lg font-bold text-slate-900">
          Claims we recovered for clients in Bengaluru
        </h2>
      </div>

      <ul class="divide-y divide-amber-100 border-t border-amber-100">
        {scored.map((c) => (
          <li class="px-6 py-5">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
              <span class="text-xl font-extrabold text-emerald-700">{formatAmount(c.claimAmount)}</span>
              <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-full px-2 py-0.5">
                recovered
              </span>
              <span class="text-xs text-slate-500">{c.insurer} &middot; {c.claimType}</span>
            </div>

            <a
              href={`/case-studies/${c.slug}/`}
              class="font-semibold text-slate-900 hover:text-blue-700 transition-colors"
            >
              {c.title}
            </a>

            <dl class="mt-3 grid sm:grid-cols-2 gap-x-6 gap-y-2 text-sm">
              <div>
                <dt class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Why it was refused</dt>
                <dd class="text-slate-600">{c.originalDenialReason}</dd>
              </div>
              <div>
                <dt class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Where</dt>
                <dd class="text-slate-600">{c.location}</dd>
              </div>
            </dl>

            <p class="mt-3 text-sm text-slate-600 leading-relaxed">{c.subtitle}</p>
          </li>
        ))}
      </ul>

      <div class="px-6 py-4 bg-amber-50/60 border-t border-amber-100 flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-slate-600">
          <strong class="text-slate-900">Hari Kotian</strong> &middot; IRDAI Registration No. 0149161D &middot; 25+ years
        </p>
        <a
          href="/case-studies/"
          class="text-sm font-semibold text-blue-700 hover:text-blue-900 inline-flex items-center gap-1.5"
        >
          See all case studies
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </aside>
)}
