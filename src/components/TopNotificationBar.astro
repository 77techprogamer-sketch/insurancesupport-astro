---
// src/components/TopNotificationBar.astro
---

<div id="notification-bar" class="hidden bg-slate-900 text-white relative overflow-hidden transition-all duration-500 ease-in-out">
  <div class="absolute inset-0 opacity-10 bg-[url('/grid.svg')] bg-center" />
  
  <div class="container mx-auto px-4 py-2.5 flex items-center justify-center gap-4 sm:gap-8 relative z-10">
    <div class="flex items-center gap-2 text-sm sm:text-base font-medium text-center sm:text-left">
      <span class="animate-pulse hidden sm:inline">✨</span>
      <span><strong>Limited Time Offer:</strong> Get a free 15-minute expert policy review</span>
    </div>
    
    <a href="/contact" class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold bg-amber-500 text-slate-900 px-4 py-1.5 rounded-full hover:bg-amber-400 transition-all shadow-lg shadow-amber-500/20 whitespace-nowrap">
      Claim Now
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>

  <button id="close-notification" class="absolute right-4 top-1/2 -translate-y-1/2 p-1.5 text-white/60 hover:text-white hover:bg-white/10 rounded-full transition-colors" aria-label="Dismiss notification">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
</div>

<script is:inline>
  (function() {
    const bar = document.getElementById('notification-bar');
    const closeBtn = document.getElementById('close-notification');
    
    // Check if previously dismissed
    if (!localStorage.getItem('notification_bar_dismissed')) {
      bar.classList.remove('hidden');
      bar.classList.add('block');
    }

    closeBtn.addEventListener('click', () => {
      bar.style.height = '0';
      bar.style.opacity = '0';
      setTimeout(() => {
        bar.classList.add('hidden');
        localStorage.setItem('notification_bar_dismissed', 'true');
      }, 500);
    });
  })();
</script>