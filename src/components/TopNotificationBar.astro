---
// src/components/TopNotificationBar.astro
---
<div class="bg-amber-500 text-slate-900 text-xs py-2 text-center font-bold" id="notification-bar">
  📢 Important: 18% GST applies on all insurance premiums as per Government of India.
  <button id="close-notification" class="ml-4 opacity-70 hover:opacity-100">✕</button>
</div>

<script is:inline>
  const bar = document.getElementById('notification-bar');
  document.getElementById('close-notification').addEventListener('click', () => {
    bar.style.display = 'none';
  });
</script>