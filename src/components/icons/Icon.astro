---
// Icon.astro — Reusable SVG icon components
// All icons use currentColor for stroke/fill so they inherit text color

interface Props {
  name: 'heart-pulse' | 'user-check' | 'car' | 'gavel' | 'briefcase' | 'map-pin' | 'book-open' | 'shield-check' | 'user' | 'whatsapp' | 'phone' | 'check' | 'info' | 'arrow-right' | 'shield' | 'star' | 'location' | 'clock' | 'document' | 'phone-simple' | 'menu' | 'close' | 'linkedin' | 'twitter';
  class?: string;
  'aria-hidden'?: boolean;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
}

const { name, class: className = '', 'aria-hidden': ariaHidden = true, size = 'md' } = Astro.props;

const sizeClasses = {
  xs: 'w-4 h-4',
  sm: 'w-5 h-5',
  md: 'w-6 h-6',
  lg: 'w-8 h-8',
  xl: 'w-10 h-10',
};
---

<div class={`inline-flex shrink-0 ${sizeClasses[size]}`}>
  {{
    'heart-pulse': (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden={ariaHidden}>
        <path d="M21 12.79A9 9 0 1 1 12.21 3 7 7 0 0 0 3 12.79" />
        <path d="M14 7v7l-3 3-3-3v-7" />
      </svg>
    ),
    'user-check': (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden={ariaHidden}>
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <polyline points="17 11 19 13 23 9" />
      </svg>
    ),
    'car': (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden={ariaHidden}>
        <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2" />
        <circle cx="7" cy="17" r="2" />
        <circle cx="17" cy="17" r="2" />
      </svg>
    ),
    'gavel': (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden={ariaHidden}>
        <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
        <polyline points="14 2 14 8 20 8" />
      </svg>
    ),
    'briefcase': (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden={ariaHidden}>
        <path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
        <rect x="2" y="6" width="20" height="14" rx="2" />
