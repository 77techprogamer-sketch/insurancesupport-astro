---
// src/components/sections/FeaturesSection.astro
import { Star, Briefcase, Users, ShieldCheck } from 'lucide-react';

// Simplified translation helper (will be replaced by actual i18n logic if needed)
const t = (key) => key; 
---

<section id="features" class="py-20 sm:py-32 bg-[#000] overflow-hidden relative">
    <div class="absolute inset-0 opacity-10 bg-aurora-grid" />
    <div class="absolute top-0 right-0 w-96 h-96 bg-[#10b981]/10 rounded-full blur-[80px]" />
    <div class="absolute bottom-0 left-0 w-80 h-80 bg-[#10b981]/5 rounded-full blur-[60px]" />
    <div class="container mx-auto px-4 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <!-- Left Content -->
            <div class="space-y-8 reveal">
                <div class="label-aurora">
                    <Star class="h-4 w-4 fill-[#10b981]" />
                    <span>Insurance guidance</span>
                </div>
                <h2 class="text-4xl sm:text-5xl md:text-6xl font-bold leading-[1.1] text-white" style="font-family: 'Plus Jakarta Sans', sans-serif;">
                    Strategic <span style="color: #10b981;">Protection</span> for Your Family
                </h2>
                <p class="text-xl text-[rgba(255,255,255,0.6)] max-w-xl leading-relaxed" style="font-family: 'Inter', sans-serif;">
                    Insurance guidance and claim assistance to help you understand policy terms, organize records, and review possible next steps.
                </p>
                <div class="grid grid-cols-2 gap-8 pt-4">
                    <div class="space-y-2">
                        <div class="text-xl sm:text-2xl font-bold text-white" style={{ fontFamily: "'Plus Jakarta Sans', sans-serif" }}>Policy review</div>
                        <div class="text-xs text-[rgba(255,255,255,0.4)] uppercase tracking-[0.2em] font-bold" style={{ fontFamily: "'Inter', sans-serif" }}>Coverage, terms, and exclusions</div>
                    </div>
                    <div class="space-y-2">
                        <div class="text-xl sm:text-2xl font-bold text-white" style={{ fontFamily: "'Plus Jakarta Sans', sans-serif" }}>Claim support</div>
                        <div class="text-xs text-[rgba(255,255,255,0.4)] uppercase tracking-[0.2em] font-bold" style={{ fontFamily: "'Inter', sans-serif" }}>Documents and insurer follow-up</div>
                    </div>
                </div>
            </div>

            <!-- Right Content -->
            <div class="relative group reveal">
                <div class="absolute inset-0 bg-[#10b981]/10 blur-[100px] rounded-full -z-10 group-hover:bg-[#10b981]/15 transition-colors"></div>
                <div class="bg-[rgba(255,255,255,0.03)] backdrop-blur-xl rounded-3xl border border-[rgba(255,255,255,0.08)] p-10 flex flex-col justify-center gap-10 relative overflow-hidden shadow-2xl transition-all duration-500 group-hover:border-[rgba(255,255,255,0.15)] group-hover:translate-y-[-10px]">
                    <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-[#10b981]/10 rounded-full blur-3xl"></div>
                    
                    <div class="flex gap-6 items-start">
                        <div class="h-14 w-14 rounded-2xl bg-[rgba(16,185,129,0.12)] border border-[rgba(16,185,129,0.2)] flex items-center justify-center shrink-0 shadow-lg shadow-[#10b981]/20 group-hover:rotate-12 transition-transform duration-500" style={{ color: '#10b981' }}>
                            <Briefcase class="h-7 w-7" />
                        </div>
                        <div>
                            <h3 class="text-2xl font-bold mb-2 text-white group-hover:text-[#10b981] transition-colors" style={{ fontFamily: "'Plus Jakarta Sans', sans-serif" }}>Strategic Advisory</h3>
                            <p class="text-[rgba(255,255,255,0.6)] text-base leading-relaxed" style={{ fontFamily: "'Inter', sans-serif" }}>Tailored plans to meet your specific financial goals and risk profile.</p>
                        </div>
                    </div>
                    
                    <div class="flex gap-6 items-start">
                        <div class="h-14 w-14 rounded-2xl bg-[rgba(16,185,129,0.12)] border border-[rgba(16,185,129,0.2)] flex items-center justify-center shrink-0 shadow-lg shadow-[#10b981]/20 group-hover:rotate-12 transition-transform duration-500" style={{ color: '#10b981' }}>
                            <Users class="h-7 w-7" />
                        </div>
                        <div>
                            <h3 class="text-2xl font-bold mb-2 text-white group-hover:text-[#10b981] transition-colors" style={{ fontFamily: "'Plus Jakarta Sans', sans-serif" }}>Legacy Planning</h3>
                            <p class="text-[rgba(255,255,255,0.6)] text-base leading-relaxed" style={{ fontFamily: "'Inter', sans-serif" }}>Ensure your wealth and assets are passed down to your family exactly as planned.</p>
                        </div>
                    </div>
                    
                    <div class="flex gap-6 items-start">
                        <div class="h-14 w-14 rounded-2xl bg-[rgba(16,185,129,0.12)] border border-[rgba(16,185,129,0.2)] flex items-center justify-center shrink-0 shadow-lg shadow-[#10b981]/20 group-hover:rotate-12 transition-transform duration-500" style={{ color: '#10b981' }}>
                            <ShieldCheck class="h-7 w-7" />
                        </div>
                        <div>
                            <h3 class="text-2xl font-bold mb-2 text-white group-hover:text-[#10b981] transition-colors" style={{ fontFamily: "'Plus Jakarta Sans', sans-serif" }}>Claim Support</h3>
                            <p class="text-[rgba(255,255,255,0.6)] text-base leading-relaxed" style={{ fontFamily: "'Inter', sans-serif" }}>Help organizing claim records and understanding available grievance routes.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
