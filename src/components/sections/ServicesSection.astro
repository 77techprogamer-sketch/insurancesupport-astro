<!-- Services Section -->
<section id="services" class="py-20 lg:py-28 bg-[#0a0a0a] relative overflow-hidden">
  <div class="absolute inset-0 opacity-10 bg-aurora-grid" />
  <div class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-[#10b981]/40 to-transparent" />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="label-aurora mb-4" style="textTransform: 'uppercase', letterSpacing: '0.12em', fontSize: '12.5px'">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        Our Services
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white font-jakarta mb-4" style={{ fontFamily: "'Plus Jakarta Sans', sans-serif" }}>
        Complete Insurance Solutions
      </h2>
      <p class="text-lg text-[rgba(255,255,255,0.6)] max-w-2xl mx-auto" style={{ fontFamily: "'Inter', sans-serif" }}>
        From life and health to motor and travel — we offer comprehensive insurance advisory across all categories with 25+ years of expertise.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6">
      {services.map((service) => (
        <a
          href={service.href}
          class="group relative card-aurora hover:-translate-y-1"
        >
          <!-- Icon -->
          <div class={`inline-flex items-center justify-center h-12 w-12 rounded-xl bg-[rgba(16,185,129,0.12)] text-[#10b981] mb-4 group-hover:scale-110 transition-transform`} style={{ fontFamily: "'Inter', sans-serif" }}>
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={service.icon} />
            </svg>
          </div>

          <!-- Content -->
          <h3 class="text-lg font-bold text-white mb-2 group-hover:text-[#10b981] transition-colors" style={{ fontFamily: "'Plus Jakarta Sans', sans-serif" }}>
            {service.title}
          </h3>
          <p class="text-sm text-[rgba(255,255,255,0.55)] leading-relaxed mb-4" style={{ fontFamily: "'Inter', sans-serif" }}>
            {service.description}
          </p>

          <!-- Arrow -->
          <div class="flex items-center gap-1 text-sm font-medium text-[#10b981] group-hover:gap-2 transition-all" style={{ fontFamily: "'Inter', sans-serif" }}>
            Learn more
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </div>
        </a>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <a
        href="/services"
        class="btn-aurora-cta"
      >
        View All Services
        <svg class="w-5 h-5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>