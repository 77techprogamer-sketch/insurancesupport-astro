---

<!-- Contact Section -->
<section id="contact" class="relative py-20 lg:py-28 bg-gradient-to-br from-blue-900 via-slate-900 to-indigo-900 text-white overflow-hidden">
  <div class="absolute inset-0 z-0 opacity-10" style="background-image: url('https://images.unsplash.com/photo-1517245386807-bb43f8e5ee6b?q=80&w=1974&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D'); background-size: cover; background-position: center;"></div>
  <div class="absolute top-20 left-10 w-64 h-64 bg-amber-400/[0.08] rounded-full blur-3xl animate-blob-bounce-1" />
  <div class="absolute bottom-20 right-10 w-80 h-80 bg-blue-500/[0.06] rounded-full blur-3xl animate-blob-bounce-2" />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-400/20 text-amber-300 text-sm font-medium mb-4 backdrop-blur-sm">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Get in Touch
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white font-jakarta mb-4">
        Let's Talk About Your Insurance
      </h2>
      <p class="text-lg text-blue-100/80 max-w-2xl mx-auto">
        Whether you need a new policy, want to renew an existing one, or need help with a claim — Hari Kotian is here to help. Free, no-obligation consultation.
      </p>
    </div>

    <!-- Contact Methods Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto mb-16">
      <div class="bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 p-8 shadow-xl">
        <h3 class="text-2xl font-bold text-white mb-6">Send Us a Message</h3>
        <form action="#" method="POST" class="space-y-4">
          <div>
            <label for="name" class="block text-sm font-medium text-blue-100/90 mb-2">Your Name</label>
            <input type="text" id="name" name="name" class="w-full p-3 rounded-lg bg-white/5 border border-white/20 text-white placeholder-blue-200/50 focus:ring-amber-400 focus:border-amber-400" placeholder="John Doe" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-blue-100/90 mb-2">Your Email</label>
            <input type="email" id="email" name="email" class="w-full p-3 rounded-lg bg-white/5 border border-white/20 text-white placeholder-blue-200/50 focus:ring-amber-400 focus:border-amber-400" placeholder="john.doe@example.com" />
          </div>
          <div>
            <label for="phone" class="block text-sm font-medium text-blue-100/90 mb-2">Phone Number (Optional)</label>
            <input type="tel" id="phone" name="phone" class="w-full p-3 rounded-lg bg-white/5 border border-white/20 text-white placeholder-blue-200/50 focus:ring-amber-400 focus:border-amber-400" placeholder="+91 98765 43210" />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-blue-100/90 mb-2">Your Message</label>
            <textarea id="message" name="message" rows="5" class="w-full p-3 rounded-lg bg-white/5 border border-white/20 text-white placeholder-blue-200/50 focus:ring-amber-400 focus:border-amber-400" placeholder="I need help with..." />
          </div>
          <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-900 font-bold rounded-full text-lg shadow-lg hover:shadow-xl hover:scale-105 active:scale-95 transition-all duration-300">
            Send Message
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </button>
          <p class="text-xs text-blue-200/70 mt-3 text-center">Your information is kept confidential and used only for contact purposes.</p>
        </form>
      </div>

      <div class="space-y-6 flex flex-col justify-between">
        <div class="bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 p-8 shadow-xl">
          <h3 class="text-2xl font-bold text-white mb-4">Our Office</h3>
          <p class="text-blue-100/90 mb-4">Visit us during working hours for a face-to-face consultation.</p>
          <p class="text-white font-semibold mb-2">Address:</p>
          <address class="text-blue-100/80 not-italic mb-4">
            Bahubali Nagar, Jalahalli<br />
            Bengaluru, Karnataka<br />
            560013, India
          </address>
          <a href="https://maps.app.goo.gl/YourGoogleMapsLink" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-amber-300 hover:text-amber-400 font-medium transition-colors">
            Get Directions
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>
        </div>

        <div class="bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 p-8 shadow-xl">
          <h3 class="text-2xl font-bold text-white mb-4">Working Hours</h3>
          <p class="text-blue-100/90 mb-4">We are available to assist you during the following hours:</p>
          <ul class="text-blue-100/80 space-y-2">
            <li><strong class="text-white">Monday – Saturday:</strong> 9:00 AM – 9:00 PM</li>
            <li><strong class="text-white">Sunday:</strong> By appointment only</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .footer-marquee {
    animation: footer-marquee 50s linear infinite;
  }
  @keyframes footer-marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.33%); }
  }
</style>