---
const contactMethods = [
  {
    icon: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
    label: "Call Us",
    value: "+91-99866 34506",
    href: "tel:+919986634506",
    description: "Mon - Sat, 9:00 AM - 9:00 PM",
    color: "from-emerald-500 to-green-600",
  },
  {
    icon: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
    label: "Email Us",
    value: "contact@insurancesupport.online",
    href: "mailto:contact@insurancesupport.online",
    description: "We respond within 24 hours",
    color: "from-blue-500 to-indigo-600",
  },
  {
    icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z",
    label: "Visit Us",
    value: "Bahubali Nagar, Jalahalli, Bengaluru",
    href: "https://maps.google.com/?q=13.0159,77.5522",
    description: "Karnataka - 560013, India",
    color: "from-amber-500 to-orange-600",
  },
  {
    icon: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z",
    label: "WhatsApp",
    value: "+91-99866 34506",
    href: "https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20I%27m%20interested%20in%20insurance%20consultation.",
    description: "Quick response guaranteed",
    color: "from-green-500 to-emerald-600",
  },
];
---

<!-- Contact Section -->
<section id="contact" class="py-20 lg:py-28 bg-gradient-to-br from-slate-50 to-blue-50/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-blue-700 text-sm font-medium mb-4">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Get in Touch
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 font-jakarta mb-4">
        Let's Talk About Your Insurance
      </h2>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        Whether you need a new policy, want to renew an existing one, or need help with a claim — Hari Kotian is here to help. Free, no-obligation consultation.
      </p>
    </div>

    <!-- Contact Methods Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {contactMethods.map((method) => (
        <a
          href={method.href}
          target={method.href.startsWith("http") ? "_blank" : undefined}
          rel={method.href.startsWith("http") ? "noopener noreferrer" : undefined}
          class="group bg-white rounded-2xl p-6 border border-slate-200 hover:shadow-xl hover:border-slate-300 transition-all duration-300 hover:-translate-y-1 text-center"
        >
          <div class={`inline-flex items-center justify-center h-14 w-14 rounded-2xl bg-gradient-to-br ${method.color} mb-4 group-hover:scale-110 transition-transform shadow-lg`}>
            <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={method.icon} />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-1">{method.label}</h3>
          <p class="text-sm font-medium text-blue-600 mb-1 break-all">{method.value}</p>
          <p class="text-xs text-slate-500">{method.description}</p>
        </a>
      ))}
    </div>

    <!-- IRDAI Trust Note -->
    <div class="bg-white rounded-2xl border border-slate-200 p-8 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center justify-center h-12 w-12 rounded-xl bg-blue-50 mb-4">
        <svg class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
      </div>
      <h3 class="text-xl font-bold text-slate-900 mb-2">IRDAI Certified Advisor</h3>
      <p class="text-slate-600 mb-4">
        Hari Kotian is a certified insurance advisor registered with the Insurance Regulatory and Development Authority of India (IRDAI).
        Registration No: <strong class="text-white">0149161D</strong>
      </p>
      <div class="flex flex-wrap justify-center gap-4 text-sm text-slate-500">
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          Free Consultation
        </span>
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          No Hidden Fees
        </span>
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          25+ Years Experience
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .footer-marquee {
    animation: footer-marquee 50s linear infinite;
  }
  @keyframes footer-marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.33%); }
  }
</style>