---
const contactMethods = [
  {
    icon: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
    label: "Call Us",
    value: "+91-99866 34506",
    href: "tel:+919986634506",
    description: "Mon - Sat, 9:00 AM - 9:00 PM",
    color: "from-emerald-500 to-green-600",
  },
  {
    icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z",
    label: "Visit Us",
    value: "Bahubali Nagar, Jalahalli, Bengaluru",
    href: "https://maps.google.com/?q=13.0159,77.5522",
    description: "Karnataka - 560013, India",
    color: "from-amber-500 to-orange-600",
  },
  {
    icon: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z",
    label: "WhatsApp",
    value: "+91-99866 34506",
    href: "https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20I%27m%20interested%20in%20insurance%20consultation.",
    description: "Quick response guaranteed",
    color: "from-green-500 to-emerald-600",
  },
];
---

<!-- Contact Section -->
<section id="contact" class="relative py-20 lg:py-28 bg-[#000] overflow-hidden">
  <div class="absolute inset-0 opacity-10 bg-aurora-grid" />
  <div class="absolute top-[10%] right-[10%] w-96 h-96 bg-[#10b981]/10 rounded-full blur-[60px]" />
  <div class="absolute bottom-[15%] left-[8%] w-80 h-80 bg-[#10b981]/5 rounded-full blur-[50px]" />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="label-aurora mb-4">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Get in Touch
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white font-jakarta mb-4" style={{ fontFamily: "'Plus Jakarta Sans', sans-serif" }}>
        Let's Talk About Your Insurance
      </h2>
      <p class="text-lg text-[rgba(255,255,255,0.6)] max-w-2xl mx-auto" style={{ fontFamily: "'Inter', sans-serif" }}>
        Whether you need a new policy, want to renew an existing one, or need help with a claim — Hari Kotian is here to help. Free, no-obligation consultation.
      </p>
    </div>

    <!-- Contact Methods Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto mb-16">
      <div class="bg-[rgba(255,255,255,0.04)] backdrop-blur-md rounded-2xl border border-[rgba(255,255,255,0.1)] p-8 shadow-xl">
        <h3 class="text-2xl font-bold text-white mb-6" style={{ fontFamily: "'Plus Jakarta Sans', sans-serif" }}>Send Us a Message</h3>
        <form id="contactSectionForm" class="space-y-4" novalidate>
          <div>
            <label for="name" class="block text-sm font-medium text-[rgba(255,255,255,0.7)] mb-2" style={{ fontFamily: "'Inter', sans-serif" }}>Your Name</label>
            <input type="text" id="name" name="name" required class="w-full p-3 rounded-lg bg-[rgba(255,255,255,0.05)] border border-[rgba(255,255,255,0.15)] text-white placeholder-[rgba(255,255,255,0.3)] focus:ring-2 focus:ring-[#10b981] focus:border-[#10b981] transition-all" placeholder="John Doe" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-[rgba(255,255,255,0.7)] mb-2" style={{ fontFamily: "'Inter', sans-serif" }}>Your Email</label>
            <input type="email" id="email" name="email" required class="w-full p-3 rounded-lg bg-[rgba(255,255,255,0.05)] border border-[rgba(255,255,255,0.15)] text-white placeholder-[rgba(255,255,255,0.3)] focus:ring-2 focus:ring-[#10b981] focus:border-[#10b981] transition-all" placeholder="john.doe@example.com" />
          </div>
          <div>
            <label for="phone" class="block text-sm font-medium text-[rgba(255,255,255,0.7)] mb-2" style={{ fontFamily: "'Inter', sans-serif" }}>Phone Number (Optional)</label>
            <input type="tel" id="phone" name="phone" class="w-full p-3 rounded-lg bg-[rgba(255,255,255,0.05)] border border-[rgba(255,255,255,0.15)] text-white placeholder-[rgba(255,255,255,0.3)] focus:ring-2 focus:ring-[#10b981] focus:border-[#10b981] transition-all" placeholder="+91 98765 43210" />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-[rgba(255,255,255,0.7)] mb-2" style={{ fontFamily: "'Inter', sans-serif" }}>Your Message</label>
            <textarea id="message" name="message" rows="5" required class="w-full p-3 rounded-lg bg-[rgba(255,255,255,0.05)] border border-[rgba(255,255,255,0.15)] text-white placeholder-[rgba(255,255,255,0.3)] focus:ring-2 focus:ring-[#10b981] focus:border-[#10b981] transition-all" placeholder="I need help with..."></textarea>
          </div>
          <button type="submit" class="btn-aurora-cta" style={{ padding: '14px 26px', fontSize: '14px' }} aria-label="Send your message">
            Send Message
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </button>
          <p class="text-xs text-[rgba(255,255,255,0.4)] mt-3 text-center" style={{ fontFamily: "'Inter', sans-serif" }}>Your information is kept confidential and used only for contact purposes.</p>
          <div id="contactSectionSuccess" class="hidden p-4 bg-[#10b981]/10 border border-[#10b981]/20 rounded-xl text-[#10b981] text-center font-medium">Thank you! Your message has been sent. We will contact you shortly.</div>
          <div id="contactSectionError" class="hidden p-4 bg-red-500/10 border border-red-500/20 rounded-xl text-red-400 text-center font-medium"></div>
        </form>
      </div>

      <div class="space-y-6 flex flex-col justify-between">
        <div class="bg-[rgba(255,255,255,0.04)] backdrop-blur-md rounded-2xl border border-[rgba(255,255,255,0.1)] p-8 shadow-xl">
          <h3 class="text-2xl font-bold text-white mb-4" style={{ fontFamily: "'Plus Jakarta Sans', sans-serif" }}>Our Office</h3>
          <p class="text-[rgba(255,255,255,0.6)] mb-4" style={{ fontFamily: "'Inter', sans-serif" }}>Visit us during working hours for a face-to-face consultation.</p>
          <p class="text-white font-semibold mb-2" style={{ fontFamily: "'Inter', sans-serif" }}>Address:</p>
          <address class="text-[rgba(255,255,255,0.6)] not-italic mb-4" style={{ fontFamily: "'Inter', sans-serif" }}>
            Bahubali Nagar, Jalahalli<br />
            Bengaluru, Karnataka<br />
            560013, India
          </address>
          <a href="https://maps.app.goo.gl/rdzYYpenUBBK3nkb9" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-[#10b981] hover:text-[#0d9f6a] font-medium transition-colors" style={{ fontFamily: "'Inter', sans-serif" }}>
            Get Directions
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>
        </div>

        <div class="bg-[rgba(255,255,255,0.04)] backdrop-blur-md rounded-2xl border border-[rgba(255,255,255,0.1)] p-8 shadow-xl">
          <h3 class="text-2xl font-bold text-white mb-4" style={{ fontFamily: "'Plus Jakarta Sans', sans-serif" }}>Working Hours</h3>
          <p class="text-[rgba(255,255,255,0.6)] mb-4" style={{ fontFamily: "'Inter', sans-serif" }}>We are available to assist you during the following hours:</p>
          <ul class="text-[rgba(255,255,255,0.6)] space-y-2" style={{ fontFamily: "'Inter', sans-serif" }}>
            <li><strong class="text-white" style={{ fontFamily: "'Inter', sans-serif" }}>Monday – Saturday:</strong> 9:00 AM – 9:00 PM</li>
            <li><strong class="text-white" style={{ fontFamily: "'Inter', sans-serif" }}>Sunday:</strong> By appointment only</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.getElementById('contactSectionForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const form = this;
    const btn = form.querySelector('button[type="submit"]');
    const successDiv = document.getElementById('contactSectionSuccess');
    const errorDiv = document.getElementById('contactSectionError');
    const origHtml = btn.innerHTML;
    if (errorDiv) errorDiv.classList.add('hidden');
    btn.disabled = true;
    btn.innerHTML = '<span class="w-5 h-5 border-2 border-white/20 border-t-white rounded-full animate-spin" /> Sending...';
    try {
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);
      const res = await fetch('/contact-submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: data.name, phone: data.phone, email: data.email || '', message: data.message })
      });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.error || 'Submission failed');
      if (successDiv) { successDiv.classList.remove('hidden'); setTimeout(() => successDiv.classList.add('hidden'), 6000); }
      form.reset();
    } catch (err) {
      if (errorDiv) { errorDiv.textContent = err.message || 'Something went wrong. Please try again.'; errorDiv.classList.remove('hidden'); setTimeout(() => errorDiv.classList.add('hidden'), 6000); }
    } finally {
      btn.disabled = false;
      btn.innerHTML = origHtml;
    }
  });
</script>
