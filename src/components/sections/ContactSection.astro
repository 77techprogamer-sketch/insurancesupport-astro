    label: "Call Us",
    value: "+91-99866 34506",
    href: "tel:+919986634506",
    description: "Mon - Sat, 9:00 AM - 9:00 PM",
    color: "from-emerald-500 to-green-600",
  },

  {
    icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z",
    label: "Visit Us",
    value: "Bahubali Nagar, Jalahalli, Bengaluru",
    href: "https://maps.google.com/?q=13.0159,77.5522",
    description: "Karnataka - 560013, India",
    color: "from-amber-500 to-orange-600",
  },
  {
    icon: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z",
    label: "WhatsApp",
    value: "+91-99866 34506",
    href: "https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20I%27m%20interested%20in%20insurance%20consultation.",
