---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

const navLinks = [
  {
    label: "Services",
    href: "/services",
    dropdown: [
      { label: "Life Insurance", href: "/services/life-insurance" },
      { label: "Health Insurance", href: "/services/health-insurance" },
      { label: "Motor Insurance", href: "/services/motor-insurance" },
      { label: "Term Insurance", href: "/services/term-insurance" },
      { label: "Personal Accident", href: "/services/personal-accident" },
      { label: "Travel Insurance", href: "/services/travel-insurance" },
      { label: "Home Insurance", href: "/services/home-insurance" },
      { label: "Corporate Insurance", href: "/services/corporate-insurance" },
      { label: "Child Education Plan", href: "/services/child-education-plan" },
      { label: "Retirement / Pension", href: "/services/retirement-pension" },
    ],
  },
  { label: "Support", href: "/support" },
  { label: "Resources", href: "/resources" },
  { label: "Expert Insights", href: "/expert-insights" },
];
---

<!-- Top Notification Bar -->
<div class="bg-gradient-to-r from-blue-900 via-blue-800 to-indigo-900 text-white text-xs py-1.5 overflow-hidden">
  <div class="marquee whitespace-nowrap">
    <span class="inline-block px-8">
      📢 Important: GST rates on insurance premiums — Health Insurance: 18% GST applicable | Motor Insurance: 18% GST applicable
      | Term Insurance: 18% GST applicable | Claim Settlement: 100% support provided | Updated as per Government of India notifications
      &nbsp;&nbsp;|&nbsp;&nbsp;
      📢 Important: GST rates on insurance premiums — Health Insurance: 18% GST applicable | Motor Insurance: 18% GST applicable
      | Term Insurance: 18% GST applicable | Claim Settlement: 100% support provided | Updated as per Government of India notifications
      &nbsp;&nbsp;|&nbsp;&nbsp;
      📢 Important: GST rates on insurance premiums — Health Insurance: 18% GST applicable | Motor Insurance: 18% GST applicable
      | Term Insurance: 18% GST applicable | Claim Settlement: 100% support provided | Updated as per Government of India notifications
    </span>
  </div>
</div>

<!-- Main Header -->
<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200/60 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <Image
          src={logo}
          alt="Insurance Support - Hari Kotian"
          class="h-10 w-10 lg:h-12 lg:w-12 rounded-lg object-contain transition-transform group-hover:scale-105"
          width={48}
          height={48}
          loading="eager"
        />
        <div class="hidden sm:block">
          <div class="text-lg font-bold text-blue-900 leading-tight font-jakarta">Insurance Support</div>
          <div class="text-[10px] text-slate-500 leading-tight tracking-wide">IRDAI Certified • Est. 1998</div>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
        {navLinks.map((link) =>
          link.dropdown ? (
            <div class="relative group">
              <a
                href={link.href}
                class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-slate-700 hover:text-blue-700 rounded-lg hover:bg-blue-50/60 transition-colors"
              >
                {link.label}
                <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </a>
              <!-- Dropdown -->
              <div class="absolute left-0 top-full pt-2 hidden group-hover:block z-50">
                <div class="bg-white rounded-xl shadow-xl border border-slate-100 py-2 min-w-[240px]">
                  {link.dropdown.map((item) => (
                    <a
                      href={item.href}
                      class="block px-4 py-2.5 text-sm text-slate-600 hover:text-blue-700 hover:bg-blue-50/60 transition-colors"
                    >
                      {item.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class="px-3 py-2 text-sm font-medium text-slate-700 hover:text-blue-700 rounded-lg hover:bg-blue-50/60 transition-colors"
            >
              {link.label}
            </a>
          )
        )}
      </nav>

      <!-- Right Side: Google Review Badge + CTA -->
      <div class="flex items-center gap-3">
        <!-- Google Review Badge -->
        <a
          href="https://g.page/r/insurancesupport/review"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden md:flex items-center gap-2 px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg hover:bg-slate-100 transition-colors"
        >
          <span class="text-sm font-bold text-slate-800">4.2</span>
          <div class="flex gap-0.5">
            {[1, 2, 3, 4].map(() => (
              <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
            <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
              <defs>
                <linearGradient id="half-star">
                  <stop offset="20%" stop-color="currentColor" />
                  <stop offset="20%" stop-color="#e2e8f0" />
                </linearGradient>
              </defs>
              <path fill="url(#half-star)" d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          </div>
          <span class="text-xs text-slate-500">23 reviews</span>
        </a>

        <!-- Contact CTA -->
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-sm font-semibold rounded-xl hover:from-blue-700 hover:to-indigo-700 transition-all shadow-md shadow-blue-500/20 hover:shadow-lg hover:shadow-blue-500/30"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="hidden sm:inline">Contact Us</span>
          <span class="sm:hidden">Call</span>
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100 transition-colors"
          aria-label="Toggle mobile menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-slate-100 bg-white">
    <div class="max-w-7xl mx-auto px-4 py-4 space-y-1">
      {navLinks.map((link) =>
        link.dropdown ? (
          <div>
            <a
              href={link.href}
              class="flex items-center justify-between px-4 py-3 text-sm font-medium text-slate-700 hover:bg-blue-50/60 rounded-lg"
            >
              {link.label}
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <div class="pl-4 space-y-0.5">
              {link.dropdown.map((item) => (
                <a
                  href={item.href}
                  class="block px-4 py-2 text-sm text-slate-500 hover:text-blue-700 hover:bg-blue-50/40 rounded-lg"
                >
                  {item.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class="block px-4 py-3 text-sm font-medium text-slate-700 hover:bg-blue-50/60 rounded-lg"
          >
            {link.label}
          </a>
        )
      )}
      <!-- Mobile Google Review Badge -->
      <a
        href="https://g.page/r/insurancesupport/review"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-4 py-3 mt-2 text-sm text-slate-600"
      >
        <span class="font-bold">4.2 ★</span>
        <span class="text-slate-400">|</span>
        <span>23 Google Reviews</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener("click", () => {
      mobileMenu.classList.toggle("hidden");
    });
  }
</script>

<style>
  .marquee {
    animation: marquee 40s linear infinite;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.33%);
    }
  }
</style>
