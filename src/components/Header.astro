---
// src/components/Header.astro
import { Image } from 'astro:assets';
import TopNotificationBar from './TopNotificationBar.astro';
import { slugify } from '@/utils/slugify';
import { formatLabel } from '@/utils/formatText';
---

<div class="w-full sticky top-0 z-50">
  <TopNotificationBar />
  <header class="w-full bg-white/95 backdrop-blur-md shadow-sm border-b border-slate-100">
    <div class="container mx-auto px-4 h-16 flex justify-between items-center">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group" aria-label="Insurance Support">
        <div class="h-9 w-9 rounded-lg overflow-hidden shrink-0 group-hover:opacity-90 transition-opacity">
          <img src="/logo.png" alt="Insurance Support" width={36} height={36} class="object-cover" />
        </div>
        <span class="text-xl font-bold tracking-tight text-blue-900 group-hover:text-blue-700 transition-colors">
          Insurance Support
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-6 text-sm font-medium text-slate-700">
        
        <!-- Services Dropdown -->
        <div class="relative group">
          <button class="flex items-center gap-1 hover:text-blue-600 transition-colors" aria-label="Services offered">
            Services
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="absolute left-0 mt-2 w-56 bg-white border border-slate-100 rounded-xl shadow-xl z-10 hidden group-hover:block p-2">
            {[
              "life_insurance", "health_insurance", "term_insurance", "motor_insurance", 
              "sme_insurance", "travel_insurance", "pension_plans", "ulip_plans"
            ].map((key) => (
              <a href={`/services/${slugify(key)}`} class="block px-4 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-700 rounded-lg">
                {formatLabel(key)}
              </a>
            ))}
          </div>
        </div>

        <a href="/support" class="hover:text-blue-600 transition-colors">Support</a>
        <a href="/resources" class="hover:text-blue-600 transition-colors">Resources</a>
        <a href="/blog" class="hover:text-blue-600 transition-colors">Blog</a>

        <div class="flex items-center gap-3 pl-4 border-l border-slate-200">
          <a href="/contact" class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-full font-semibold transition-all hover:shadow-lg hover:scale-105">
            Contact
          </a>
        </div>
      </nav>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="lg:hidden p-2 text-slate-600" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
    </div>
  </header>
</div>

<!-- Mobile Menu -->
<div id="mobile-menu" class="lg:hidden hidden border-t border-slate-100 bg-white p-4 space-y-2">
  <a href="/services" class="block p-3 hover:bg-blue-50 rounded-lg">Services</a>
  <a href="/support" class="block p-3 hover:bg-blue-50 rounded-lg">Support</a>
  <a href="/blog" class="block p-3 hover:bg-blue-50 rounded-lg">Blog</a>
  <a href="/contact" class="block p-3 bg-blue-600 text-white rounded-lg text-center font-bold">Contact</a>
</div>

<script is:inline>
  document.getElementById('mobile-menu-btn').addEventListener('click', () => {
    document.getElementById('mobile-menu').classList.toggle('hidden');
  });
</script>
