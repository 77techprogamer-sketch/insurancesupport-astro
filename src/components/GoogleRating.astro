---
/**
 * The rating, as a badge you can drop anywhere.
 *
 * Text plus stars plus a link out. No markup, no schema, no "trusted by
 * thousands" — just the number the reader can verify in one tap.
 */
import { GBP } from '../data/google-profile';

interface Props {
  variant?: 'inline' | 'card';
  class?: string;
}

const { variant = 'inline', class: className = '' } = Astro.props;
const pct = Math.max(0, Math.min(100, (GBP.rating / 5) * 100));
const checked = new Date(GBP.checkedOn).toLocaleDateString('en-IN', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<a
  class:list={['google-rating', `google-rating--${variant}`, className]}
  href={GBP.mapsUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${GBP.rating} out of 5 from ${GBP.reviewCount} Google reviews — open the Google Business Profile`}
>
  <span class="google-rating__stars" aria-hidden="true">
    <span class="google-rating__stars-track">★★★★★</span>
    <span class="google-rating__stars-fill" style={`width:${pct}%`}>★★★★★</span>
  </span>
  <span class="google-rating__score">{GBP.rating.toFixed(1)}</span>
  <span class="google-rating__count">
    from {GBP.reviewCount} Google reviews
    {variant === 'card' && <span class="google-rating__verified"> · checked {checked}</span>}
  </span>
</a>

<style>
  .google-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    line-height: 1.3;
  }

  .google-rating__stars {
    position: relative;
    display: inline-block;
    font-size: 0.9375rem;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .google-rating__stars-track {
    color: #cbd5e1;
  }

  .google-rating__stars-fill {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
    color: #f59e0b;
  }

  .google-rating__score {
    font-weight: 700;
    color: inherit;
    font-family: var(--font-display);
  }

  .google-rating__count {
    font-size: 0.875rem;
    color: inherit;
    opacity: 0.85;
  }

  .google-rating--card {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius-lg, 0.75rem);
    background: var(--color-surface, #fff);
    flex-wrap: wrap;
    row-gap: 0.25rem;
  }

  .google-rating:hover .google-rating__count {
    text-decoration: underline;
    opacity: 1;
  }
</style>
