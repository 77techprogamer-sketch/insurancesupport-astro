---
// src/components/LanguageSwitcher.astro
import languagesData from '../data/languages.json';

const INDIAN_LANGUAGES = ['hi', 'bn', 'ta', 'te', 'mr', 'gu', 'kn', 'ml'];

const currentLang = Astro.url.searchParams.get('lang') || 'en';
const currentUrl = Astro.url.href;
const baseUrl = currentUrl.split('?')[0];
---

<!-- Language Switcher Dropdown -->
<div class="relative" id="language-switcher">
  <button
    type="button"
    class="flex items-center gap-2 px-3 py-1.5 bg-white/10 border border-white/20 text-white text-sm font-medium rounded-full hover:bg-white/20 transition-all backdrop-blur-sm"
    aria-label="Select language"
    aria-expanded="false"
    aria-haspopup="true"
    id="lang-switcher-btn"
  >
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
    </svg>
    <span class="hidden sm:inline">{currentLang === 'en' ? 'English' : languagesData.languages.find(l => l.code === currentLang)?.nativeName || currentLang}</span>
    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
  </button>

  <div class="absolute right-0 mt-2 w-48 bg-white border border-slate-100 rounded-xl shadow-xl z-10 hidden" id="lang-dropdown" role="menu">
    <a
      href={`${baseUrl}?lang=en`}
      class="block px-4 py-2 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-700 transition-colors {currentLang === 'en' ? 'bg-blue-50 text-blue-700 font-medium' : ''}"
      role="menuitem"
    >
      English
    </a>
    {INDIAN_LANGUAGES.map(code => {
      const lang = languagesData.languages.find(l => l.code === code);
      return (
        <a
          href={`${baseUrl}?lang=${code}`}
          class="block px-4 py-2 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-700 transition-colors {currentLang === code ? 'bg-blue-50 text-blue-700 font-medium' : ''}"
          role="menuitem"
        >
          {lang?.nativeName || code} ({lang?.name || code})
        </a>
      );
    })}
  </div>
</div>

<script is:inline>
  const btn = document.getElementById('lang-switcher-btn');
  const dropdown = document.getElementById('lang-dropdown');

  if (btn && dropdown) {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = dropdown.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', !isOpen);
    });

    document.addEventListener('click', (e) => {
      if (!btn.contains(e.target) && !dropdown.contains(e.target)) {
        dropdown.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        dropdown.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>