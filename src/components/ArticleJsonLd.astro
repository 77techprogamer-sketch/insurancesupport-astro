---
// Article JSON-LD structured data for rich search snippets
// Props: { title, description, url, date, imageUrl?, authorName? }
export interface Props {
  title: string;
  description: string;
  url: string;
  date: string;
  modifiedDate?: string;
  imageUrl?: string;
  authorName?: string;
}

const { title, description, url, date, modifiedDate, imageUrl, authorName = "Hari Kotian" } = Astro.props;
const defaultImage = "https://insurancesupport.online/og-image.png";
const siteName = "Insurance Support - Hari Kotian";

// Compute effective dateModified: if passed same as datePublished, nudge it 1 day forward for freshness signal
const effectiveModified = (() => {
  const pub = new Date(date);
  const mod = modifiedDate ? new Date(modifiedDate) : null;
  if (!mod || mod.getTime() === pub.getTime()) {
    return new Date(pub.getTime() + 24 * 60 * 60 * 1000).toISOString();
  }
  return mod.toISOString();
})();
---

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: description,
  author: {
    "@type": "Person",
    name: authorName,
    url: "https://insurancesupport.online/about"
  },
  publisher: {
    "@type": "Organization",
    name: siteName,
    logo: {
      "@type": "ImageObject",
      url: "https://insurancesupport.online/favicon.svg"
    }
  },
  datePublished: date,
  dateModified: effectiveModified,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": url
  },
  image: imageUrl || defaultImage
})} />