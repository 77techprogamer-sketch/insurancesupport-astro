---
// Article JSON-LD structured data for rich search snippets
// Props: { title, description, url, date, imageUrl?, authorName? }
export interface Props {
  title: string;
  description: string;
  url: string;
  date: string;
  modifiedDate?: string;
  imageUrl?: string;
  authorName?: string;
  isPartOf?: { "@type": string; "@id": string; name?: string };
}

const { title, description, url, date, modifiedDate, imageUrl, authorName = "Hari Kotian", isPartOf } = Astro.props;
const defaultImage = "https://insurancesupport.online/og-image.png";
const siteName = "Insurance Support";

// Never invent a later modified date. If the page has not been revised, use its publication date.
const effectiveModified = modifiedDate || date;
---

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: description,
  author: {
    "@type": "Person",
    "@id": "https://insurancesupport.online/about-hari-kotian/#person",
    name: authorName,
    url: "https://insurancesupport.online/about-hari-kotian/",
    jobTitle: "IRDAI-Registered Insurance Advisor",
    description: "IRDAI-registered insurance advisor (Reg No: 0149161D) with 25+ years of experience helping families and businesses across India with insurance planning, policy review, and claim support.",
    knowsAbout: ["Insurance Planning", "Claim Assistance", "Policy Review", "IRDAI Compliance", "Health Insurance", "Life Insurance", "Motor Insurance", "Insurance Grievance Redressal"],
    credential: {
      "@type": "EducationalOccupationalCredential",
      credentialCategory: "Insurance Advisor Registration",
      recognizedBy: {
        "@type": "Organization",
        "name": "IRDAI",
        "url": "https://www.irdai.gov.in/"
      },
      identifier: "0149161D"
    }
  },
  publisher: {
    "@type": "Organization",
    "@id": "https://insurancesupport.online/#organization",
    name: siteName,
    logo: {
      "@type": "ImageObject",
      url: "https://insurancesupport.online/logo.png"
    }
  },
  datePublished: date,
  dateModified: effectiveModified,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": url
  },
  ...(isPartOf ? { isPartOf } : {}),
  image: imageUrl || defaultImage
})} />
