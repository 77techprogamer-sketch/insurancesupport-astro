---
// FAQPage JSON-LD structured data
interface FAQItem {
  question: string;
  answer: string;
}

const { questions = [] as FAQItem[] } = Astro.props;
---
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": questions.map((q: FAQItem) => ({
    "@type": "Question",
    "name": q.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": q.answer
    }
  }))
})} />
