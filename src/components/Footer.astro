---
const currentYear = new Date().getFullYear();

import Icon from '../components/icons/Icon.astro';

const footerLinks = {
  quick: [
    { label: 'Home', href: '/' },
    { label: 'Services', href: '/services' },
    { label: 'Locations', href: '/locations' },
    { label: 'Resources', href: '/blog' },
    { label: 'Claim Help', href: '/claim-recovery' },
    { label: 'About Hari Kotian', href: '/about-hari-kotian' },
  ],
  services: [
    { label: 'Health Insurance', href: '/services/health-insurance' },
    { label: 'Life Insurance', href: '/services/life-insurance' },
    { label: 'Motor Insurance', href: '/services/motor-insurance' },
    { label: 'Term Insurance', href: '/services/term-insurance' },
    { label: 'Claim Support', href: '/services/claim-support' },
    { label: 'Policy Review', href: '/services/policy-review' },
  ],
  resources: [
    { label: 'Blog & Guides', href: '/blog' },
    { label: 'Claim Rejection Appeal', href: '/blog/claim-recovery-hub-complete-2026-guide' },
    { label: 'Motor Claim Process', href: '/blog/icici-lombard-cashless-denied-hospital-guide-2026' },
    { label: 'Insurance Ombudsman', href: '/blog/insurance-ombudsman-bangalore-guide-2026' },
    { label: 'Bima Bharosa', href: '/blog/irdai-bima-bharosa-complaint-filing-2026' },
    { label: 'LIC Policy Guide', href: '/blog/lic-policy-hub-complete-guide-2026' },
  ],
  legal: [
      { label: 'Privacy Policy', href: '/privacy-policy' },
      { label: 'Terms of Service', href: '/terms' },
      { label: 'Disclaimer', href: '/disclaimer' },
    ],
};

const socialLinks = [
  { name: 'LinkedIn', href: 'https://linkedin.com/in/hari-kotian', icon: 'linkedin' },
  { name: 'Twitter', href: 'https://twitter.com/harikotian', icon: 'twitter' },
  { name: 'WhatsApp', href: 'https://wa.me/919986634506', icon: 'whatsapp' },
];
---

<!-- Main Footer -->
<footer class="footer" role="contentinfo">
  <div class="container">
    <!-- Footer Grid -->
    <div class="footer-grid">
      <!-- Column 1: Brand -->
      <div class="footer-brand">
        <div class="footer-logo">
          <span class="footer-logo-mark" aria-hidden="true">IS</span>
          <span class="footer-brand-name" style="font-family: var(--font-display);">Insurance Support</span>
        </div>
        <p class="footer-brand-tagline" style="font-family: var(--font-sans);">By Hari Kotian</p>
        <p class="footer-brand-desc" style="font-family: var(--font-sans);">
          Insurance Support by Hari Kotian provides insurance guidance and claim assistance from Bengaluru. IRDAI Registered Advisor (Reg No: 0149161D).
        </p>
        <div class="footer-contact" style="font-family: var(--font-sans);">
                                  <a href="tel:+919986634506" aria-label="Call +91 99866 34506">
                                    <Icon name="phone" size="sm" />
                                    +91 99866 34506
                                  </a>
                                  <a href="https://wa.me/919986634506?text=Hi%20Hari%20Kotian%2C%20I%20need%20help%20with%20my%20insurance%20claim." target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
                                    <Icon name="whatsapp" size="sm" />
                                    Chat on WhatsApp
                                  </a>
                                </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h3 class="footer-heading" style="font-family: var(--font-display);">Quick Links</h3>
        <ul class="footer-links" style="font-family: var(--font-sans);">
          {footerLinks.quick.map(link => (
            <li>
              <a href={link.href} class="footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Services -->
      <div>
        <h3 class="footer-heading" style="font-family: var(--font-display);">Our Services</h3>
        <ul class="footer-links" style="font-family: var(--font-sans);">
          {footerLinks.services.map(link => (
            <li>
              <a href={link.href} class="footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Resources -->
      <div>
        <h3 class="footer-heading" style="font-family: var(--font-display);">Resources</h3>
        <ul class="footer-links" style="font-family: var(--font-sans);">
          {footerLinks.resources.map(link => (
            <li>
              <a href={link.href} class="footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <p class="footer-copyright" style="font-family: var(--font-sans);">
        &copy; {currentYear} Insurance Support by Hari Kotian. All rights reserved.
      </p>
      <div class="footer-legal" style="font-family: var(--font-sans);">
        {footerLinks.legal.map((link, i) => (
          <a href={link.href} key={link.href}>{link.label}{i < footerLinks.legal.length - 1 && ' · '}</a>
        ))}
      </div>
    </div>

    <!-- Social Links -->
        <div class="flex items-center justify-center gap-4" style="margin-top: var(--space-8); padding-top: var(--space-8); border-top: 1px solid var(--color-border);">
          {socialLinks.map(social => (
            <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.name} class="footer-social" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: var(--radius-full); background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text-secondary); transition: all var(--transition-fast);">
              <Icon name={social.icon} size="sm" />
            </a>
          ))}
        </div>
  </div>
</footer>

<style>
  .footer-social:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-text-inverse);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .footer-brand { max-width: none; }
  }
</style>