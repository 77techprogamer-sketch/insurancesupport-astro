---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services" },
  { label: "About Us", href: "/about" },
  { label: "Expert Insights", href: "/expert-insights" },
  { label: "Contact", href: "/contact" },
  { label: "Support", href: "/support" },
];

const compareAlternatives = [
  { label: "ICICI Lombard vs HDFC ERGO", href: "/compare/icici-lombard-vs-hdfc-ergo" },
  { label: "Term Insurance Comparison", href: "/compare/term-insurance" },
  { label: "Health Insurance Comparison", href: "/compare/health-insurance" },
  { label: "Motor Insurance Comparison", href: "/compare/motor-insurance" },
  { label: "Best Insurance Plans 2025", href: "/compare/best-plans-2025" },
];


---

<!-- GST Info Banner -->
<div class="bg-[#0a0a0a] border-y border-[rgba(255,255,255,0.08)] text-white px-4 py-3 text-center">
  <div class="text-sm font-medium tracking-wide flex items-center justify-center gap-2">
    <svg class="w-4 h-4 text-[#10b981]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
    <span>GST treatment depends on the insurance product and policy type.</span>
    <a href="https://gstcouncil.gov.in/sites/default/files/2025-09/faq_0.pdf" target="_blank" rel="noopener noreferrer" class="text-[#10b981] hover:text-[#0d9f6a] underline underline-offset-2 decoration-[#10b981]/30 hover:decoration-[#10b981]/60 transition-all" style={{ fontFamily: "'Inter', sans-serif" }}>Check current GST Council guidance</a>.
  </div>
</div>

<!-- Main Footer -->
<footer class="bg-[#0a0a0a] text-[rgba(255,255,255,0.6)] relative overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute top-0 left-0 w-full h-20 bg-gradient-to-b from-[#10b981]/5 to-transparent pointer-events-none"></div>
  <div class="absolute -bottom-24 left-0 w-96 h-96 bg-[#10b981]/3 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 right-0 w-96 h-96 bg-[#10b981]/2 rounded-full blur-3xl pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Column 1: Company Info -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="relative h-12 w-12 rounded-xl overflow-hidden" style="background: linear-gradient(135deg, #10b981, #047857);">
            <div class="h-full w-full flex items-center justify-center text-white font-bold text-xl" style="text-shadow: 0 2px 4px rgba(0,0,0,0.2);">
              IS
            </div>
            <div class="absolute inset-0 bg-gradient-to-br from-white/10 to-transparent rounded-xl"></div>
          </div>
          <div>
            <div class="text-white font-bold text-xl tracking-tight" style={{ fontFamily: "'Plus Jakarta Sans', sans-serif" }}>Insurance Support</div>
            <div class="text-[rgba(255,255,255,0.5)] text-sm font-medium" style={{ fontFamily: "'Inter', sans-serif" }}>By Hari Kotian</div>
          </div>
        </div>
        <p class="text-sm text-[rgba(255,255,255,0.5)] mb-6 leading-relaxed" style={{ fontFamily: "'Inter', sans-serif" }}>
          Insurance Support by Hari Kotian provides insurance guidance and claim assistance from Bengaluru.
        </p>
        <div class="space-y-2 text-sm" style={{ fontFamily: "'Inter', sans-serif" }}>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#10b981] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span class="text-[rgba(255,255,255,0.55)]">Insurance guidance and claim assistance</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#10b981] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:+919986634506" class="hover:text-[#10b981] transition-colors" style={{ color: 'rgba(255,255,255,0.7)' }}>+91-99866 34506</a>
          </div>

        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-5 flex items-center gap-2" style={{ fontFamily: "'Inter', sans-serif" }}>
          <svg class="w-4 h-4 text-[#10b981]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
          Quick Links
        </h3>
        <ul class="space-y-2.5" style={{ fontFamily: "'Inter', sans-serif" }}>
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-[rgba(255,255,255,0.55)] hover:text-[#10b981] transition-all duration-200 flex items-center gap-2 group">
                <svg class="w-3.5 h-3.5 text-[rgba(255,255,255,0.3)] group-hover:text-[#10b981] transition-colors duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
                <span class="group-hover:translate-x-1 transition-transform duration-200">{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Compare Alternatives -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-6" style={{ fontFamily: "'Inter', sans-serif" }}>Compare Alternatives</h3>
        <ul class="space-y-3" style={{ fontFamily: "'Inter', sans-serif" }}>
          {compareAlternatives.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-[rgba(255,255,255,0.55)] hover:text-[#10b981] transition-all duration-200 flex items-center gap-2 group">
                <svg class="w-3.5 h-3.5 text-[rgba(255,255,255,0.3)] group-hover:text-[#10b981] transition-colors duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
                <span class="group-hover:translate-x-1 transition-transform duration-200">{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Contact -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-5 flex items-center gap-2" style={{ fontFamily: "'Inter', sans-serif" }}>
          <svg class="w-4 h-4 text-[#10b981]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          Contact
        </h3>
        <div class="space-y-5" style={{ fontFamily: "'Inter', sans-serif" }}>
          <div>
            <p class="text-sm text-[rgba(255,255,255,0.5)] mb-1.5 flex items-center gap-2">
              <svg class="w-4 h-4 text-[#10b981] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              Office Address
            </p>
            <p class="text-sm text-[rgba(255,255,255,0.7)] leading-relaxed">Bahubali Nagar, Jalahalli<br />Bengaluru, Karnataka 560013<br />India</p>
          </div>
          <div>
            <p class="text-sm text-[rgba(255,255,255,0.5)] mb-1.5 flex items-center gap-2">
              <svg class="w-4 h-4 text-[#10b981] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              Working Hours
            </p>
            <div class="space-y-1">
              <p class="text-sm text-[rgba(255,255,255,0.7)] flex justify-between">
                <span>Mon – Sat</span>
                <span class="font-medium text-white" style={{ fontFamily: "'Inter', sans-serif" }}>9:00 AM – 9:00 PM</span>
              </p>
              <p class="text-sm text-[rgba(255,255,255,0.7)] flex justify-between">
                <span>Sunday</span>
                <span class="font-medium text-[#10b981]" style={{ fontFamily: "'Inter', sans-serif" }}>By appointment</span>
              </p>
            </div>
          </div>
          <a href="tel:+919986634506" class="inline-flex items-center gap-2 text-sm font-medium text-[#10b981] hover:text-[#0d9f6a] transition-colors group" style={{ fontFamily: "'Inter', sans-serif" }}>
            <svg class="w-4 h-4 group-hover:scale-110 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            <span class="hover:underline" style={{ textDecorationColor: 'rgba(16,185,129,0.3)' }}>+91-99866 34506</span>
          </a>
        </div>
      </div>
    </div>

  <!-- Bottom Bar -->
  <div class="border-t border-[rgba(255,255,255,0.08)] mt-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-sm" style={{ fontFamily: "'Inter', sans-serif" }}>
        <div class="text-[rgba(255,255,255,0.4)]">
          <p class="text-[rgba(255,255,255,0.5)]">
            © {currentYear} Insurance Support. All rights reserved.
          </p>
          <p class="text-xs text-[rgba(255,255,255,0.35)] mt-1 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#10b981]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <span>IRDAI Registration No: <strong class="text-[rgba(255,255,255,0.5)]">0149161D</strong></span>
          </p>
        </div>
        <div class="flex items-center gap-4 text-xs">
          <div class="hidden md:flex items-center gap-2 text-[rgba(255,255,255,0.35)]">
            <span class="text-[rgba(255,255,255,0.4)]">Legacy</span>
            <svg class="w-3.5 h-3.5 text-[rgba(255,255,255,0.2)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            <span class="text-[rgba(255,255,255,0.4)]">Trust</span>
            <svg class="w-3.5 h-3.5 text-[rgba(255,255,255,0.2)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            <span class="text-[rgba(255,255,255,0.4)]">Excellence</span>
          </div>
          <div class="flex items-center gap-4">
            <a href="/privacy-policy" class="text-[rgba(255,255,255,0.4)] hover:text-white hover:bg-[rgba(255,255,255,0.05)] px-3 py-1.5 rounded-lg transition-all duration-200">Privacy</a>
            <a href="/terms" class="text-[rgba(255,255,255,0.4)] hover:text-white hover:bg-[rgba(255,255,255,0.05)] px-3 py-1.5 rounded-lg transition-all duration-200">Terms</a>
            <a href="/disclaimer" class="text-[rgba(255,255,255,0.4)] hover:text-white hover:bg-[rgba(255,255,255,0.05)] px-3 py-1.5 rounded-lg transition-all duration-200">Disclaimer</a>
            <a href="/rss.xml" class="text-[rgba(255,255,255,0.4)] hover:text-white hover:bg-[rgba(255,255,255,0.05)] px-3 py-1.5 rounded-lg transition-all duration-200 flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2v6m0 0a5 5 0 005 5h2a5 5 0 005-5V2m0 0a5 5 0 015 5v6a5 5 0 01-5 5h-2a5 5 0 01-5-5V2m0 0a5 5 0 00-5 5h-2a5 5 0 00-5-5V2m0 0a5 5 0 015-5m-2 4l2 2h4l-2-2a5 5 0 10-5-5z" /></svg>
              <span class="hidden sm:inline">RSS</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>


<style>
  @keyframes slide-up {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-slide-up {
    animation: slide-up 0.3s ease-out forwards;
  }
</style>
