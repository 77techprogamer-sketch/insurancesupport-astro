---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services" },
  { label: "About Us", href: "/about" },
  { label: "Expert Insights", href: "/expert-insights" },
  { label: "Contact", href: "/contact" },
  { label: "Support", href: "/support" },
