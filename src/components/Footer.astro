---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services" },
  { label: "About Us", href: "/about" },
  { label: "Expert Insights", href: "/expert-insights" },
  { label: "Contact", href: "/contact" },
  { label: "Support", href: "/support" },
];

const compareAlternatives = [
  { label: "ICICI Lombard vs HDFC ERGO", href: "/compare/icici-lombard-vs-hdfc-ergo" },
  { label: "Term Insurance Comparison", href: "/compare/term-insurance" },
  { label: "Health Insurance Comparison", href: "/compare/health-insurance" },
  { label: "Motor Insurance Comparison", href: "/compare/motor-insurance" },
  { label: "Best Insurance Plans 2025", href: "/compare/best-plans-2025" },
];


---

<!-- GST Marquee Banner -->
<div class="bg-primary text-primary-foreground overflow-hidden">
  <div class="footer-marquee whitespace-nowrap">
    <span class="inline-block px-8 text-sm font-bold tracking-wide">
      ⚠️ GST Update: 18% GST applies on all insurance premiums as per Government of India. | Health Insurance: 18% | Motor Insurance: 18% | Term Insurance: 18% | Life Insurance: 18% | Claim Support: Free Assistance | Contact us for transparent pricing.
      &nbsp;&nbsp;•&nbsp;&nbsp;
      ⚠️ GST Update: 18% GST applies on all insurance premiums as per Government of India. | Health Insurance: 18% | Motor Insurance: 18% | Term Insurance: 18% | Life Insurance: 18% | Claim Support: Free Assistance | Contact us for transparent pricing.
      &nbsp;&nbsp;•&nbsp;&nbsp;
      ⚠️ GST Update: 18% GST applies on all insurance premiums as per Government of India. | Health Insurance: 18% | Motor Insurance: 18% | Term Insurance: 18% | Life Insurance: 18% | Claim Support: Free Assistance | Contact us for transparent pricing.
    </span>
  </div>
</div>

<!-- Main Footer -->
<footer class="bg-slate-900 text-slate-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Column 1: Company Info -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="h-10 w-10 rounded-lg bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white font-bold text-lg">
            IS
          </div>
          <div>
            <div class="text-white font-bold text-lg font-jakarta">Insurance Support</div>
            <div class="text-slate-500 text-xs">By Hari Kotian</div>
          </div>
        </div>
        <p class="text-sm text-slate-400 mb-6 leading-relaxed">
          IRDAI-certified independent insurance advisor with 25+ years of experience. Helping families make informed insurance decisions across Bengaluru and India.
        </p>
        <div class="space-y-2 text-sm">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>IRDAI Reg No: <strong class="text-white">0149161D</strong></span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:+919986634506" class="hover:text-white transition-colors">+91-99866 34506</a>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:contact@insurancesupport.online" class="hover:text-white transition-colors">contact@insurancesupport.online</a>
          </div>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-6">Quick Links</h3>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-slate-400 hover:text-white transition-colors flex items-center gap-2">
                <svg class="w-3 h-3 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Compare Alternatives -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-6">Compare Alternatives</h3>
        <ul class="space-y-3">
          {compareAlternatives.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-slate-400 hover:text-white transition-colors flex items-center gap-2">
                <svg class="w-3 h-3 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Contact & Share -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-6">Contact</h3>
        <div class="space-y-4">
          <div>
            <p class="text-sm text-slate-400 mb-1">Office Address</p>
            <p class="text-sm text-slate-300">Bahubali Nagar, Jalahalli<br />Bengaluru, Karnataka<br />560013, India</p>
          </div>
          <div>
            <p class="text-sm text-slate-400 mb-1">Working Hours</p>
            <p class="text-sm text-slate-300">Mon – Sat: 9:00 AM – 9:00 PM</p>
            <p class="text-sm text-slate-300">Sunday: By appointment</p>
          </div>
          <!-- Share Button -->
          <div class="pt-2">
            <button id="share-site-button" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-full shadow-lg transition-colors">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6L15.316 6.095m0 0a3 3 0 110-2.684 3 3 0 010 2.684m0 0l.046-.073A.978.978 0 0015.623 4H15.32a.977.977 0 00-.704.293L11.809 9.916m7.135-9.135A9.999 9.999 0 0112 12 9.999 9.999 0 013.866 20.076V19.5c0-1.293.493-2.502 1.353-3.447L9.44 10.59m-9.44 9.44a3 3 0 110-5.368 3 3 0 010 5.368zM21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              Share Site
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="text-sm text-slate-500">
          © {currentYear} Insurance Support - Hari Kotian. All rights reserved. IRDAI Reg No: 0149161D
        </div>
        <div class="flex items-center gap-2 text-sm text-slate-500">
          <span class="font-medium text-slate-400">Legacy</span>
          <span class="text-slate-700">|</span>
          <span class="font-medium text-slate-400">Trust</span>
          <span class="text-slate-700">|</span>
          <span class="font-medium text-slate-400">Excellence</span>
        </div>
        <div class="flex items-center gap-4 text-xs text-slate-500">
          <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a>
          <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
          <a href="/disclaimer" class="hover:text-white transition-colors">Disclaimer</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  document.getElementById('share-site-button')?.addEventListener('click', async () => {
    const shareData = {
      title: 'Insurance Support by Hari Kotian',
      text: 'Check out Insurance Support — IRDAI certified insurance advisory and claim recovery experts in Bengaluru.',
      url: window.location.href
    };
    if (navigator.share) {
      try {
        await navigator.share(shareData);
      } catch (err) {
        if (err.name !== 'AbortError') console.error(err);
      }
    } else {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const btn = document.getElementById('share-site-button');
        const originalText = btn.innerHTML;
        btn.innerHTML = `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg> Link Copied!`;
        setTimeout(() => { btn.innerHTML = originalText; }, 2500);
      } catch (err) {
        alert('Copy failed. You can copy the URL from your browser address bar.');
      }
    }
  });
</script>

<style>
  .footer-marquee {
    animation: footer-marquee 50s linear infinite;
  }
  @keyframes footer-marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.33%);
    }
  }
</style>
